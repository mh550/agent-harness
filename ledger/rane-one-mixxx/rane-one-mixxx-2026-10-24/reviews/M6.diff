diff --git a/tests/helpers/fake-mixxx.mjs b/tests/helpers/fake-mixxx.mjs
new file mode 100644
index 0000000..1782af4
--- /dev/null
+++ b/tests/helpers/fake-mixxx.mjs
@@ -0,0 +1,230 @@
+// A fake Mixxx 2.5 for the mapping's Node tests (M6 plan, Test harness): it loads a mapping XML and its
+// <scriptfiles> into a vm with a recording `engine` and a `midi` that throws, then dispatches MIDI messages through
+// the XML's <control> table the way Mixxx does.
+//
+// Components (midi-components-0.0.js) and common-controller-scripts.js are Mixxx's own files, read from the
+// installed Flatpak (`flatpak info --show-location org.mixxx.Mixxx`/files/share/mixxx/controllers/), or from
+// RANE_MIXXX_CONTROLLERS when set. When they are missing, loadMapping() returns { skip: "<why>" } instead of a
+// harness, and the tests pass that to test(name, { skip }): an explicit skip, never a failure.
+import { spawnSync } from "node:child_process";
+import { existsSync, readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import vm from "node:vm";
+import { parseXml, all, child } from "./xml.mjs";
+
+export const MAPPING_DIR = join(dirname(fileURLToPath(import.meta.url)), "..", "..", "mapping");
+export const MAPPING_XML = join(MAPPING_DIR, "Rane-One.midi.xml");
+const REQUIRED = ["common-controller-scripts.js", "midi-components-0.0.js"];
+
+let flatpakDir;
+// Mixxx's system controllers directory: { dir } or { skip: "<why>" }.
+export function controllersDir(env = process.env) {
+  let dir = env.RANE_MIXXX_CONTROLLERS;
+  if (!dir) {
+    if (flatpakDir === undefined) {
+      const r = spawnSync("flatpak", ["info", "--show-location", "org.mixxx.Mixxx"], { encoding: "utf8", timeout: 5000 });
+      flatpakDir = r.status === 0 && r.stdout.trim() ? join(r.stdout.trim(), "files/share/mixxx/controllers") : null;
+    }
+    if (!flatpakDir) return { skip: "Mixxx's controller scripts not found: the org.mixxx.Mixxx Flatpak is not installed (set RANE_MIXXX_CONTROLLERS to its controllers/ directory)" };
+    dir = flatpakDir;
+  }
+  const missing = REQUIRED.filter((f) => !existsSync(join(dir, f)));
+  if (missing.length) return { skip: `Mixxx's controller scripts not found: ${missing.join(", ")} missing in ${dir}` };
+  return { dir };
+}
+
+const int = (s) => { const t = s.trim(); return /^0x/i.test(t) ? parseInt(t, 16) : Number(t); };
+
+// The parts of a mapping XML the harness uses: the script files in order and the <control> entries.
+export function readMapping(xmlPath) {
+  const root = parseXml(readFileSync(xmlPath, "utf8"));
+  const scriptFiles = all(root, "file").map((f) => ({ filename: f.attrs.filename, prefix: f.attrs.functionprefix ?? "" }));
+  const controls = all(root, "control").map((c) => {
+    const field = (n) => child(c, n)?.text.trim();
+    const options = child(c, "options")?.children.map((o) => o.name) ?? [];
+    return { group: field("group"), key: field("key"), status: int(field("status")), midino: int(field("midino")), options };
+  });
+  return { scriptFiles, controls };
+}
+
+// Loads a mapping. Options: xml (default mapping/Rane-One.midi.xml), env (for controllersDir), controllerName.
+// Returns the harness, or { skip } when Mixxx's scripts are missing.
+export function loadMapping({ xml = MAPPING_XML, env = process.env, controllerName = "Midi Through Port-0" } = {}) {
+  const found = controllersDir(env);
+  if (found.skip) return { skip: found.skip };
+  const mapping = readMapping(xml);
+  const h = {
+    loaded: [], sets: [], params: [], takeovers: [], ignoreNext: [], calls: [], logs: [], timers: new Map(),
+    connections: [], unhandled: [], thrown: [], midiReads: 0, now: 0, controls: mapping.controls,
+  };
+  // Values and parameters are separate stores: the fake knows no control's range or taper (Mixxx maps `rate`
+  // parameter 0.5 to value 0, `volume` through a taper), so a test reads back what was written, as it was written.
+  const values = new Map(), parameters = new Map();
+  for (const g of ["[Channel1]", "[Channel2]", "[Channel3]", "[Channel4]"]) {
+    values.set(`${g},rateRange`, 0.5);
+    values.set(`${g},rate_dir`, 1);
+  }
+  const failing = new Set();
+  let failAll = false, nextTimer = 1;
+  // Connection callbacks are queued and run after the handler (or timer, or init) returns, not inside setValue:
+  // a callback that sets its own control can't recurse here. h.flush() runs them by hand.
+  const queued = [];
+  const fire = (group, key, value) => {
+    for (const c of h.connections) if (c.isConnected && c.group === group && c.key === key) queued.push([c, value]);
+  };
+  // Mixxx's engine takes a double: true/false arrive as 1/0, and a NaN is refused with a warning.
+  const set = (record, name, g, k, raw) => {
+    const v = Number(raw);
+    if (Number.isNaN(v)) { h.logs.push(["warn", `fake engine: ${name}(${g}, ${k}) refused NaN`]); return; }
+    record.push([g, k, v]);
+    (record === h.sets ? values : parameters).set(`${g},${k}`, v);
+    if (record === h.sets) fire(g, k, v);
+  };
+  const methods = {
+    getValue: (g, k) => values.get(`${g},${k}`) ?? 0,
+    setValue: (g, k, v) => set(h.sets, "setValue", g, k, v),
+    getParameter: (g, k) => parameters.get(`${g},${k}`) ?? 0,
+    setParameter: (g, k, v) => set(h.params, "setParameter", g, k, v),
+    softTakeover: (g, k, enable) => { h.takeovers.push([g, k, enable]); },
+    softTakeoverIgnoreNextValue: (g, k) => { h.ignoreNext.push([g, k]); },
+    makeConnection: (group, key, callback) => {
+      const c = {
+        group, key, callback, isConnected: true,
+        disconnect() { c.isConnected = false; return true; },
+        trigger() { if (c.isConnected) callback(methods.getValue(group, key), group, key); },
+      };
+      h.connections.push(c);
+      return c;
+    },
+    // Intervals under 20 ms run at 20 ms with a warning (the reviewer's recollection of Mixxx 2.5: UNVERIFIED
+    // against its source), so a mapping test can't rely on a timer faster than Mixxx's. A string callback is
+    // compiled once, at beginTimer.
+    beginTimer: (ms, callback, oneShot = false) => {
+      const id = nextTimer++;
+      const fn = typeof callback === "function" ? callback : vm.runInContext(`(function () { ${callback} })`, ctx);
+      if (!(ms >= 20)) h.logs.push(["warn", `fake engine: beginTimer(${ms}) runs at 20 ms`]);
+      const every = Math.max(20, Number(ms) || 0);
+      h.timers.set(id, { at: h.now + every, ms: every, fn, oneShot });
+      return id;
+    },
+    stopTimer: (id) => h.timers.delete(id),
+    getSetting: () => undefined,
+    isScratching: () => false,
+  };
+  // Every engine call is recorded in h.calls; failNext(name) makes the next call of that method throw; a method
+  // the fake lacks throws with its name, so a mapping that needs more of Mixxx fails loudly.
+  const engine = new Proxy({}, {
+    get(_, name) {
+      if (typeof name !== "string") return undefined;
+      return (...args) => {
+        h.calls.push([name, ...args]);
+        if (failAll || failing.delete(name)) throw new Error(`fake engine: ${name} failed (failNext)`);
+        if (!Object.hasOwn(methods, name)) throw new Error(`fake engine has no ${name}`);
+        return methods[name](...args);
+      };
+    },
+  });
+  const refuse = (name) => () => { throw new Error(`fake midi: ${name} refused (D9: the mapping sends nothing)`); };
+  const midiObject = { sendShortMsg: refuse("sendShortMsg"), sendSysexMsg: refuse("sendSysexMsg") };
+  const midi = new Proxy(midiObject, { get(t, k) { h.midiReads++; return t[k]; } });
+  const logAt = (level) => (...a) => { h.logs.push([level, a.join(" ")]); };
+  const console = { log: logAt("log"), info: logAt("info"), debug: logAt("debug"), warn: logAt("warn"), error: logAt("error") };
+  const ctx = vm.createContext({ engine, midi, console });
+  h.ctx = ctx;
+
+  // Mixxx loads common-controller-scripts.js first, then each <file> in order: from the mapping's directory when
+  // it is there, else from the system controllers directory (where midi-components-0.0.js lives).
+  const files = [join(found.dir, "common-controller-scripts.js"), ...mapping.scriptFiles.map(({ filename }) =>
+    existsSync(join(dirname(xml), filename)) ? join(dirname(xml), filename) : join(found.dir, filename))];
+  for (const f of files) {
+    vm.runInContext(readFileSync(f, "utf8"), ctx, { filename: f });
+    h.loaded.push(f);
+  }
+
+  // Mixxx wraps each <key> once as `(function (channel, control, value, status, group) { (KEY)(...); })`, so the
+  // object before the key's last dot is `this` and the key is resolved at each call.
+  const wrappers = new Map();
+  const wrapper = (key) => {
+    if (!wrappers.has(key)) {
+      wrappers.set(key, vm.runInContext(`(function (channel, control, value, status, group) { (${key})(channel, control, value, status, group); })`, ctx));
+    }
+    return wrappers.get(key);
+  };
+  // A pitch bend (0xEn) is keyed by its status alone: its first data byte is the value's LSB, and Mixxx's own
+  // mappings bind 14-bit pitch bend faders with one entry and no <midino> (Icon-iControls.midi.xml,
+  // MVave-SMC-Mixer.midi.xml in 2.5.6). Mixxx's exact rule in C++ is UNVERIFIED (M7 needs it for the platter).
+  const tableKey = (status, d1) => (status & 0xf0) === 0xe0 ? `${status},pitch bend` : `${status},${d1}`;
+  const table = new Map();
+  for (const c of mapping.controls) {
+    if (!c.options.includes("script-binding")) throw new Error(`fake-mixxx handles <script-binding/> controls only: ${c.key}`);
+    const k = tableKey(c.status, c.midino);
+    table.set(k, [...(table.get(k) ?? []), c]);
+  }
+  const call = (what, fn) => {
+    try { fn(); } catch (e) { h.thrown.push({ what, error: String(e) }); }
+    h.flush();
+  };
+  h.flush = () => {
+    while (queued.length) {
+      const [c, value] = queued.shift();
+      if (!c.isConnected) continue;
+      try { c.callback(value, c.group, c.key); } catch (e) { h.thrown.push({ what: `connection ${c.group},${c.key}`, error: String(e) }); }
+    }
+  };
+  const prefixes = mapping.scriptFiles.map((f) => f.prefix).filter(Boolean);
+
+  h.failNext = (name) => { failing.add(name); };
+  h.failAll = (on = true) => { failAll = on; }; // every engine call throws while on
+  h.getValue = (group, key) => methods.getValue(group, key);
+  h.getParameter = (group, key) => methods.getParameter(group, key);
+  h.setValue = (group, key, value) => values.set(`${group},${key}`, value); // set state without recording a set
+  h.wrapper = wrapper;
+  // Runs the timers due in the next `ms` milliseconds, in time order.
+  h.tick = (ms) => {
+    const end = h.now + ms;
+    for (;;) {
+      let due;
+      for (const [id, t] of h.timers) if (t.at <= end && (!due || t.at < due[1].at)) due = [id, t];
+      if (!due) break;
+      const [id, t] = due;
+      h.now = t.at;
+      if (t.oneShot) h.timers.delete(id); else t.at += t.ms;
+      call(`timer ${id}`, t.fn);
+    }
+    h.now = end;
+  };
+  // Dispatches one message: [status, d1, d2] or a capture record ({ bytes: "90017F", ... }). Returns the number of
+  // <control> entries it reached (0: recorded in h.unhandled).
+  h.dispatch = (msg) => {
+    const [status, d1 = 0, d2 = 0] = Array.isArray(msg) ? msg : msg.bytes.match(/../g).map((b) => parseInt(b, 16));
+    const entries = table.get(tableKey(status, d1)) ?? [];
+    if (!entries.length) h.unhandled.push({ status, ch: (status & 0x0f) + 1, number: d1, value: d2 });
+    for (const c of entries) call(c.key, () => wrapper(c.key)(status & 0x0f, d1, d2, status, c.group));
+    return entries.length;
+  };
+  // Dispatches every channel message of a capture (JSONL) in order, advancing timers by the take's t_us gaps.
+  h.replay = (file) => {
+    const start = { sets: h.sets.length, unhandled: h.unhandled.length, thrown: h.thrown.length };
+    let sent = 0, last;
+    for (const line of readFileSync(file, "utf8").split("\n")) {
+      if (!line.trim()) continue;
+      const rec = JSON.parse(line);
+      if (typeof rec.bytes !== "string" || parseInt(rec.bytes.slice(0, 2), 16) >= 0xf0) continue;
+      if (last !== undefined && rec.t_us > last) h.tick((rec.t_us - last) / 1000);
+      last = rec.t_us;
+      h.dispatch(rec);
+      sent++;
+    }
+    return { sent, unhandled: h.unhandled.slice(start.unhandled), thrown: h.thrown.slice(start.thrown), sets: h.sets.slice(start.sets) };
+  };
+  h.shutdown = () => {
+    for (const p of prefixes) call(`${p}.shutdown`, () => vm.runInContext(`if (typeof ${p}.shutdown === "function") ${p}.shutdown();`, ctx));
+  };
+
+  // Mixxx 2.5 calls <prefix>.init(controllerName, debugging) for each file with a function prefix.
+  ctx.__controllerName = controllerName;
+  for (const p of prefixes) call(`${p}.init`, () => vm.runInContext(`if (typeof ${p}.init === "function") ${p}.init(__controllerName, false);`, ctx));
+  delete ctx.__controllerName;
+  return h;
+}
diff --git a/tests/helpers/temp.mjs b/tests/helpers/temp.mjs
new file mode 100644
index 0000000..caaafe5
--- /dev/null
+++ b/tests/helpers/temp.mjs
@@ -0,0 +1,14 @@
+// Temp dirs for tests: each one is removed when the test file ends, pass or fail.
+import { after } from "node:test";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+const dirs = [];
+after(() => dirs.forEach((d) => rmSync(d, { recursive: true, force: true })));
+
+export function tempDir(prefix) {
+  const d = mkdtempSync(join(tmpdir(), prefix));
+  dirs.push(d);
+  return d;
+}
diff --git a/tests/helpers/xml.mjs b/tests/helpers/xml.mjs
new file mode 100644
index 0000000..7e0a741
--- /dev/null
+++ b/tests/helpers/xml.mjs
@@ -0,0 +1,67 @@
+// A small well-formedness parser for the mapping XML (zero dependencies, D5), enough for its subset: declaration,
+// comments, elements, attributes, text. No DTD, CDATA or processing instructions. Moved here from
+// tests/mapping-xml.test.mjs (M6-02) so tests/helpers/fake-mixxx.mjs reads the same XML the same way.
+
+const ENTITIES = { amp: "&", lt: "<", gt: ">", quot: '"', apos: "'" };
+const decode = (s) => s.replace(/&(amp|lt|gt|quot|apos|#\d+|#x[\da-fA-F]+);/g, (_, e) =>
+  e[0] !== "#" ? ENTITIES[e] : String.fromCodePoint(e[1] === "x" ? parseInt(e.slice(2), 16) : Number(e.slice(1))));
+
+// Returns the root element as { name, attrs, children, text } (text: the element's own text, decoded, children's
+// left out); throws on anything not well-formed.
+export function parseXml(src) {
+  let i = 0;
+  const fail = (why) => { throw new Error(`${why} at offset ${i}`); };
+  const NAME = /[A-Za-z_][\w.-]*/y;
+  const name = () => { NAME.lastIndex = i; const m = NAME.exec(src) ?? fail("expected a name"); i = NAME.lastIndex; return m[0]; };
+  const ws = () => { while (/\s/.test(src[i] ?? "")) i++; };
+  const skipMisc = () => {
+    for (;;) {
+      ws();
+      if (src.startsWith("<!--", i)) {
+        const end = src.indexOf("-->", i + 4);
+        if (end < 0 || src.slice(i + 4, end).includes("--")) fail("bad comment");
+        i = end + 3;
+      } else return;
+    }
+  };
+  const text = (s) => { if (/[<&]/.test(s.replace(/&(amp|lt|gt|quot|apos|#\d+|#x[\da-fA-F]+);/g, ""))) fail("bad text"); return decode(s); };
+  const element = () => {
+    if (src[i++] !== "<") fail("expected <");
+    const el = { name: name(), attrs: {}, children: [], text: "" };
+    for (;;) {
+      const before = i;
+      ws();
+      if (src.startsWith("/>", i)) { i += 2; return el; }
+      if (src[i] === ">") { i++; break; }
+      if (i === before) fail("expected whitespace before an attribute");
+      const key = name();
+      ws(); if (src[i++] !== "=") fail("expected =");
+      ws(); const q = src[i++]; if (q !== '"' && q !== "'") fail("expected a quote");
+      const end = src.indexOf(q, i); if (end < 0) fail("unterminated attribute");
+      const value = text(src.slice(i, end));
+      if (Object.hasOwn(el.attrs, key)) fail(`duplicate attribute ${key}`);
+      el.attrs[key] = value; i = end + 1;
+    }
+    for (;;) {
+      const lt = src.indexOf("<", i); if (lt < 0) fail(`unclosed <${el.name}>`);
+      el.text += text(src.slice(i, lt)); i = lt;
+      if (src.startsWith("<!--", i)) { skipMisc(); continue; }
+      if (src.startsWith("</", i)) {
+        i += 2; if (name() !== el.name) fail(`mismatched </…> for <${el.name}>`);
+        ws(); if (src[i++] !== ">") fail("expected >");
+        return el;
+      }
+      el.children.push(element());
+    }
+  };
+  if (src.startsWith("﻿")) i = 1;
+  if (src.startsWith("<?xml", i)) { const end = src.indexOf("?>", i); if (end < 0) fail("bad declaration"); i = end + 2; }
+  skipMisc();
+  const root = element();
+  skipMisc();
+  if (i !== src.length) fail("content after the root element");
+  return root;
+}
+
+export const all = (el, name) => [...(el.name === name ? [el] : []), ...el.children.flatMap((c) => all(c, name))];
+export const child = (el, name) => el.children.find((c) => c.name === name);
