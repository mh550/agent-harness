+    RaneOne.Fx.prototype.constructor = RaneOne.Fx;
+});
+
+RaneOne.containers = ["deck1", "deck2", "mixer", "fx"];
+
+// Builds one container and guards its inputs at once, in its own guard: one that fails to build leaves the others
+// built and guarded.
+RaneOne.build = RaneOne.guard("build", function(name) {
+    RaneOne[name] = null;
+    const made = name === "mixer" ? new RaneOne.Mixer() : name === "fx" ? new RaneOne.Fx() : new RaneOne.Deck(Number(name.slice(4)));
+    RaneOne.guardInputs(made, name);
+    RaneOne[name] = made;
+});
+
 RaneOne.init = RaneOne.guard("init", function(id) {
     console.log("RaneOne: init " + id);
+    RaneOne.defineComponents();
+    RaneOne.containers.forEach(RaneOne.build);
+    RaneOne.setStart();
