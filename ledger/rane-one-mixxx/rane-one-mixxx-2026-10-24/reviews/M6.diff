+        const layered = function(note, shiftNote, unshifted, shifted) {
+            return new RaneOne.Layered({note: note, shiftNote: shiftNote, unshifted: unshifted, shifted: shifted});
+        };
+        this.motorOff = false;
+
+        // Channel n. Play is a plain toggle: Shift+Play = Play (D31; Components' PlayButton would make it reverse).
+        this.sameNote = new components.ComponentContainer({
+            play: toggle("play"),
+            bendUp: new RaneOne.BendButton({group: group, inKey: "rate_temp_up"}),
+            bendDown: new RaneOne.BendButton({group: group, inKey: "rate_temp_down"}),
+        });
+        this.cue = layered(1, 5, new components.CueButton({group: group, outConnect: false}), push("start"));
+        this.sync = layered(2, 3, new components.SyncButton({group: group, outConnect: false}),
+            new RaneOne.SetButton({group: group, inKey: "sync_enabled", value: 0}));
+        // For the debug log: Components' SyncButton has no inKey; it sets beatsync (tap) and sync_enabled (hold).
+        this.sync.debugKeys = function() {
+            return [[group, "beatsync"], [group, "sync_enabled"]];
+        };
+        this.load = layered(6, 8, push("LoadSelectedTrack"), push("LoadSelectedTrack"));
+        this.back = layered(7, 18, push("MoveFocusBackward", "[Library]"), toggle("show_maximized_library", "[Skin]"));
+        // Range changes nothing on the motor and must not touch rateRange (D27); Shift+Range is key lock.
+        this.range = layered(43, 13, new RaneOne.Counted({}), toggle("keylock"));
+        // Note 16 as the reverse pad is UNVERIFIED (round 2 step 4).
+        this.reverse = layered(16, 17, toggle("reverse"), new RaneOne.ReverseRoll({group: group, inKey: "reverseroll"}));
+        // Library encoder (D33): CC 0, CC 1 with Shift (seen on deck 2 only; deck 1's is UNVERIFIED). Which way
+        // 65 scrolls is UNVERIFIED.
+        this.browse = new RaneOne.Encoder({targets: [["[Library]", "MoveVertical"]], step: 1, shiftNumber: 1, shiftStep: 10});
+        this.pitch = new RaneOne.PitchFader({group: group});
+        this.strip = new RaneOne.Strip({group: group});
+        this.platter = new RaneOne.Platter({});
+        // Stop Time (CC 72): the One's spin-down setting, for M7.
+        this.stopTime = null;
+        this.stopTimeKnob = new RaneOne.Store({owner: this, name: "stopTime"});
+
+        // Channel n + 4.
+        this.slip = layered(9, 10, toggle("slip_enabled"), new RaneOne.MotorOffButton({deck: this}));
+        this.padParamLeft = layered(40, 42, push("beatjump_backward"), new RaneOne.BeatjumpSize({group: group, factor: 0.5}));
+        this.padParamRight = layered(41, 43, push("beatjump_forward"), new RaneOne.BeatjumpSize({group: group, factor: 2}));
+        this.loopHalve = layered(52, 54, push("loop_halve"), push("loop_in"));
+        this.loopDouble = layered(53, 55, push("loop_double"), push("loop_out"));
+        this.autoLoop = layered(63, 65, new RaneOne.AutoLoop({group: group}), push("reloop_toggle"));
+        // Pads and pad modes (D30, table at RaneOne.Pad): mode notes 0, 7, 11, 12, 13; pad i on notes 19 + i, 27 + i.
+        this.padMode = new RaneOne.PadMode({});
+        this.pads = new components.ComponentContainer({});
+        for (let i = 1; i <= 8; i++) {
+            this.pads["pad" + i] = new RaneOne.Pad({group: group, number: i, deck: this});
+        }
+    };
+    RaneOne.Deck.prototype = Object.create(components.Deck.prototype);
+    RaneOne.Deck.prototype.constructor = RaneOne.Deck;
+
+    // The mixer (the M6 plan's control table): per channel trim, EQ, filter, headphone cue and fader, on the deck
+    // channels but not a deck; the crossfader; the front-panel knobs (which of CC 35/36 is the cue mix and which
+    // the level is UNVERIFIED, round 2 step 9); the torque switch stored for M7. Every knob and fader is a Pot with
+    // soft takeover. The EQ bands (high/mid/low from the sweep order) and trim are UNVERIFIED (`unknown` rows).
+    RaneOne.Mixer = function() {
+        const pot = function(group, key) {
+            return new components.Pot({group: group, inKey: key});
+        };
+        const channel = function(n) {
+            const group = "[Channel" + n + "]";
+            const eq = "[EqualizerRack1_" + group + "_Effect1]";
+            return new components.ComponentContainer({
+                trim: pot(group, "pregain"),
+                eqHigh: pot(eq, "parameter3"),
+                eqMid: pot(eq, "parameter2"),
+                eqLow: pot(eq, "parameter1"),
+                filter: pot("[QuickEffectRack1_" + group + "]", "super1"),
+                pfl: new RaneOne.StateButton({group: group, inKey: "pfl"}),
+                volume: pot(group, "volume"),
+            });
+        };
+        this.channel1 = channel(1);
+        this.channel2 = channel(2);
+        this.crossfader = pot("[Master]", "crossfader");
+        this.headMix = pot("[Master]", "headMix");
+        this.headGain = pot("[Master]", "headGain");
+        this.torque = null;
+        this.torqueSwitch = new RaneOne.Store({owner: this, name: "torque"});
+    };
+    RaneOne.Mixer.prototype = Object.create(components.ComponentContainer.prototype);
+    RaneOne.Mixer.prototype.constructor = RaneOne.Mixer;
+
+    // An FX paddle (note 16 on ch 9 for deck 1, ch 10 for deck 2: D32). It reports its state, 127 pulled or locked
+    // up and 0 down (02 at 38.47–51.29 s), so it sets the unit's enable for its deck to that state, never toggles;
+    // `on` is read by Tap.
+    RaneOne.Paddle = subclass(RaneOne.StateButton, {
+        on: false,
+        input: function(channel, control, value, status) {
+            this.on = RaneOne.isPress(status, value);
+            engine.setValue(this.group, this.inKey, this.on ? 1 : 0);
+        },
+    });
+
+    // FX Tap (note 4 ch 16, D32): bpm_tap on the deck whose paddle is on, deck 1 if both; a counted no-op if none.
+    // 1 on the press and 0 on the release, to the deck the press picked.
+    RaneOne.FxTap = subclass(Component, {
+        held: null,
+        input: function(channel, control, value, status) {
+            if (this.held) {
+                engine.setValue(this.held, "bpm_tap", 0);
+                this.held = null;
+            }
+            if (RaneOne.isPress(status, value)) {
+                const group = this.fx.paddle1.on ? "[Channel1]" : this.fx.paddle2.on ? "[Channel2]" : null;
+                if (group) {
+                    this.held = group;
+                    engine.setValue(group, "bpm_tap", 1);
+                } else {
+                    RaneOne.count(status, control);
+                }
+            }
+        },
+        debugKeys: function() {
+            return [["[Channel1]", "bpm_tap"], ["[Channel2]", "bpm_tap"]];
+        },
+    });
+
+    // The FX depth knob (CC 4 ch 16): `mix` of both units, soft takeover (D32). The One also sends CC 4 = 0 with
+    // each paddle-on, at the same t_us and just before the FX state burst (02 at 38.47, 41.01, 43.31 s). So a 0
+    // after a value above 8, or before any value (02's paddles come before its depth sweep), is held: the burst's
+    // first message (note 0 ch 9) drops it; any other message applies it first (RaneOne.heard), and so does a
+    // 50 ms timer. Platter messages (CC 6 and the pitch bend on ch 1/2, every 1 ms per deck with the motors on,
+    // take 25) neither drop nor apply it: whether one can fall between the zero and the burst is UNVERIFIED (no
+    // paddle-on is captured with a motor running), so only the timer settles a zero they keep coming after.
+    // Shutdown drops a held zero (RaneOne.shutdown). `zero`, not `held`, so RaneOne.releaseAll leaves it alone.
+    RaneOne.FxDepth = subclass(RaneOne.Pots, {
+        last: null,
+        zero: null,
+        timer: 0,
+        input: function(channel, control, value, status, group) {
+            if (value === 0 && (this.last === null || this.last > 8)) {
+                const that = this;
+                this.zero = [channel, control, status, group];
+                this.timer = engine.beginTimer(50, RaneOne.guard("fx.depth.timer", function() {
+                    that.timer = 0;
+                    that.settle(true);
+                }), true);
+                return;
+            }
+            this.last = value;
+            RaneOne.Pots.prototype.input.call(this, channel, control, value, status, group);
+        },
+        heard: function(status, control) {
+            const kind = status & 0xf0;
+            const platter = (status & 0x0f) <= 1 && (kind === 0xe0 || (kind === 0xb0 && control === 6));
+            if (this.zero && !platter) {
+                this.settle(!(status === 0x98 && control === 0));
+            }
+        },
+        settle: function(apply) {
+            const zero = this.zero;
+            this.zero = null;
+            if (this.timer) {
+                engine.stopTimer(this.timer);
+                this.timer = 0;
+            }
+            if (apply && zero) {
+                this.last = 0;
+                RaneOne.Pots.prototype.input.call(this, zero[0], zero[1], 0, zero[2], zero[3]);
+            }
+        },
+    });
+
+    // The FX section (D32), shared by both decks: the paddles, the FX1–6 state report (ch 9 notes 0–2, ch 10 notes
+    // 3–5: only value 0, all six with each paddle change, so a counted no-op), Tap, the depth knob and the beat knob
+    // (CC 3 ch 16, `super1` of both units ±1/32 per tick). With Shift: not captured (round 2 step 1).
+    RaneOne.Fx = function() {
+        const units = ["[EffectRack1_EffectUnit1]", "[EffectRack1_EffectUnit2]"];
+        this.paddle1 = new RaneOne.Paddle({group: units[0], inKey: "group_[Channel1]_enable"});
+        this.paddle2 = new RaneOne.Paddle({group: units[1], inKey: "group_[Channel2]_enable"});
+        this.fxState = new RaneOne.Counted({});
+        this.tap = new RaneOne.FxTap({fx: this});
+        this.depth = new RaneOne.FxDepth({pots: units.map(function(unit) {
+            return new components.Pot({group: unit, inKey: "mix"});
