diff --git a/tests/temp-cleanup.test.mjs b/tests/temp-cleanup.test.mjs
new file mode 100644
index 0000000..3d404a6
--- /dev/null
+++ b/tests/temp-cleanup.test.mjs
@@ -0,0 +1,34 @@
+// Every test file removes the temp dirs it makes, including those of the tools it runs. The suite runs once more in
+// a child with its own TMPDIR, which must be empty afterwards. The child skips this file, so it doesn't recurse.
+import { test, after } from "node:test";
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { mkdtempSync, readdirSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), "..");
+const INNER = "RANE_TEMP_CLEANUP_INNER";
+// Node's own module compile cache, not a test's.
+const IGNORED = new Set(["node-compile-cache"]);
+
+const dir = mkdtempSync(join(tmpdir(), "temp-cleanup-"));
+after(() => rmSync(dir, { recursive: true, force: true }));
+
+test("the suite leaves nothing in TMPDIR", { skip: process.env[INNER] ? "inner run" : false }, () => {
+  // NODE_TEST_CONTEXT would make the child report to this runner instead of running the suite.
+  const { NODE_TEST_CONTEXT, ...env } = process.env;
+  const r = spawnSync(process.execPath, ["--test", "--test-reporter=spec", "tests/**/*.test.mjs"], {
+    cwd: ROOT, env: { ...env, TMPDIR: dir, [INNER]: "1" }, encoding: "utf8", timeout: 300_000,
+  });
+  assert.equal(r.error, undefined, String(r.error));
+  assert.ok(Number(/ℹ tests (\d+)/.exec(r.stdout)?.[1]) > 0, `the inner run ran no tests:\n${r.stdout.slice(-2000)}`);
+  const left = readdirSync(dir).filter((n) => !IGNORED.has(n));
+  const byPrefix = {};
+  for (const n of left) {
+    const p = n.replace(/-[^-]*$/, "");
+    byPrefix[p] = (byPrefix[p] ?? 0) + 1;
+  }
+  assert.deepEqual(byPrefix, {}, `temp dirs left behind (make them with tempDir() from tests/helpers/temp.mjs), by prefix: ${JSON.stringify(byPrefix)}`);
+});
