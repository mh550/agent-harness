+// The debug log (RaneOne.DEBUG): one engine.makeConnection per (group, key) the containers can change, which logs
+// "RaneOne: <group>,<key> = <value>" on each change, Mixxx's own report of what moved (the M6 plan's replay check
+// greps it). The keys are each component's [group, inKey] plus its debugKeys() for the ones it picks at the press.
+// Not playposition (the strip's): Mixxx moves it all the time a deck plays, which would flood the log. Each key is
+// connected in its own guard, so one Mixxx refuses doesn't stop the rest.
+RaneOne.debugConnections = [];
+RaneOne.debugDisconnect = RaneOne.guard("debugDisconnect", function() {
+    RaneOne.debugConnections.forEach(function(connection) {
+        connection.disconnect();
+    });
+    RaneOne.debugConnections = [];
+});
+RaneOne.debugConnect = RaneOne.guard("debugConnect", function() {
+    RaneOne.debugDisconnect();
+    const seen = {};
+    RaneOne.containers.forEach(function(name) {
+        RaneOne.forEachObject(RaneOne[name], name, function(obj) {
+            const keys = typeof obj.debugKeys === "function" ? obj.debugKeys() : [];
+            if (typeof obj.group === "string" && typeof obj.inKey === "string") {
+                keys.push([obj.group, obj.inKey]);
+            }
+            keys.forEach(function(key) {
+                const id = key[0] + "," + key[1];
+                if (seen[id]) {
+                    return;
+                }
+                seen[id] = true;
+                RaneOne.guard("debugConnect " + id, function() {
+                    const connection = engine.makeConnection(key[0], key[1], function(value) {
+                        console.log("RaneOne: " + id + " = " + value);
+                    });
+                    if (connection) {
+                        RaneOne.debugConnections.push(connection);
+                    }
+                })();
+            });
+        });
+    });
+});
+
+// Mixxx's state at init, in its own guard (an engine that refuses it must not stop init):
+// - D27: the rate range matches the motor's 1 ± 0.5×, so the pitch fader's ends reach the motor's speeds.
+// - D35: the One reports its faders only at power-on (01: both channel faders at 0), not when a port opens, so the
+//   channel faders start at 0 (silence) until the first CC 28 sets them; the Pot applies its first value at once.
+RaneOne.setStart = RaneOne.guard("setStart", function() {
+    ["[Channel1]", "[Channel2]"].forEach(function(group) {
+        engine.setValue(group, "rateRange", 0.5);
+        engine.setValue(group, "volume", 0);
+    });
 });
 
 RaneOne.shutdown = RaneOne.guard("shutdown", function() {
     console.log("RaneOne: shutdown");
+    if (RaneOne.fx && RaneOne.fx.depth) {
+        RaneOne.fx.depth.settle(false);
+    }
+    RaneOne.containers.forEach(function(name) {
+        if (RaneOne[name]) {
+            RaneOne.releaseAll(RaneOne[name], name);
+        }
+    });
+    RaneOne.debugDisconnect();
 });
