 #!/usr/bin/env bash
 # Copies every file in mapping/ into the dev profile's controllers/ (MIXXX_DEV_PROFILE, default
 # ~/.var/app/org.mixxx.Mixxx/dev-profile). Always copies, never symlinks: the Flatpak cannot see this checkout.
-#   tools/install-mapping
-# Exit: 0 installed · 1 nothing to install · 2 usage · 3 refused (the real Mixxx profile)
+#   tools/install-mapping [--debug]
+# --debug: the copy of Rane-One-scripts.js gets RaneOne.DEBUG = true (the mapping logs each control it changes);
+# mapping/ itself is never changed.
+# Exit: 0 installed · 1 nothing to install · 2 usage · 3 refused (the real Mixxx profile) · 4 --debug: the script
+# has no single `RaneOne.DEBUG = false;` line (nothing installed)
 set -euo pipefail
 here=$(cd "$(dirname "$0")" && pwd)
 # shellcheck source=lib/profile.sh
 source "$here/lib/profile.sh"
-(( $# == 0 )) || { sed -n "4s/^#   /usage: /p" "$0" >&2; exit 2; }
+debug=0
+if (( $# == 1 )) && [[ $1 == --debug ]]; then debug=1; elif (( $# )); then sed -n "4s/^#   /usage: /p" "$0" >&2; exit 2; fi
 profile_guard
 src=$here/../mapping
 files=()
@@ -15,6 +19,14 @@ for f in "$src"/*; do
   if [[ -f $f && ! -L $f ]]; then files+=("$f"); elif [[ -e $f ]]; then echo "skipped (not a file): $f" >&2; fi
 done
 (( ${#files[@]} )) || { echo "nothing to install: no files in $(realpath -m "$src")" >&2; exit 1; }
+flag='RaneOne.DEBUG = false;'
+if (( debug )); then
+  n=0
+  if [[ -f $src/Rane-One-scripts.js && ! -L $src/Rane-One-scripts.js ]]; then
+    n=$(grep -cxF -- "$flag" "$src/Rane-One-scripts.js" || true)
+  fi
+  (( n == 1 )) || { echo "refused --debug: $src/Rane-One-scripts.js needs exactly one line '$flag' (found ${n:-none})" >&2; exit 4; }
+fi
 dest=$PROFILE/controllers
 [[ ! -L $dest ]] || { echo "refused: $dest is a symlink" >&2; exit 3; }
 mkdir -p "$dest"
@@ -26,9 +38,15 @@ for f in "${files[@]}"; do
   # A fresh temp file plus rename in the same directory, so a running Mixxx's file watcher never reads half a
   # script and a stale symlink in controllers/ is replaced, never written through.
   tmp=$(mktemp -- "$dest/.$name.XXXXXX")
-  cp -- "$f" "$tmp"
+  note=
+  if (( debug )) && [[ $name == Rane-One-scripts.js ]]; then
+    sed "s/^RaneOne\.DEBUG = false;\$/RaneOne.DEBUG = true;/" -- "$f" > "$tmp"
+    note=" (RaneOne.DEBUG = true)"
+  else
+    cp -- "$f" "$tmp"
+  fi
   chmod 644 -- "$tmp"
   mv -f -T -- "$tmp" "$dest/$name"
   tmp=
-  echo "installed $dest/$name"
+  echo "installed $dest/$name$note"
 done
