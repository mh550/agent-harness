+// A synthetic mapping script for tests/mapping-harness.test.mjs (with Probe.midi.xml): a Components Button and
+// Pot, a plain handler that records its `this`, and an unguarded handler that tries to send MIDI.
+var Probe = {};
+
+Probe.init = function(id, debugging) {
+    Probe.initArgs = [id, debugging];
+    Probe.cue = new components.Button({group: "[Channel1]", key: "cue_default"});
+    Probe.volume = new components.Pot({group: "[Channel1]", inKey: "volume"});
+    Probe.plain = {
+        input: function(channel, control, value, status, group) {
+            this.seen = [channel, control, value, status, group];
+            this.self = this;
+            engine.setValue(group, "probe", value);
+        },
+    };
+    Probe.sender = {
+        input: function(channel, control, value) {
+            midi.sendShortMsg(0x91, control, value);
+        },
+    };
+};
+
+Probe.shutdown = function() {
+    Probe.shutDown = true;
+};
