diff --git a/tests/mapping-deck.test.mjs b/tests/mapping-deck.test.mjs
new file mode 100644
index 0000000..0ebe49b
--- /dev/null
+++ b/tests/mapping-deck.test.mjs
@@ -0,0 +1,277 @@
+// Deck buttons (M6-03): transport, library, pitch bend, Range, Reverse, Slip, pad parameter and loop buttons on
+// channels 1/2 and 5/6, with their Shift layers, as the M6 plan's control table and D31/D33 give them. Every
+// expectation is on the fake Mixxx (tests/helpers/fake-mixxx.mjs), dispatching through mapping/Rane-One.midi.xml.
+//
+// These tests need Mixxx 2.5.6's controller scripts from the org.mixxx.Mixxx Flatpak (or RANE_MIXXX_CONTROLLERS);
+// when they are missing, each test is skipped with the reason.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import vm from "node:vm";
+import { controllersDir, loadMapping } from "./helpers/fake-mixxx.mjs";
+import { parseCsv } from "../tools/lib/census.mjs";
+
+const { skip } = controllersDir();
+const ROOT = new URL("..", import.meta.url).pathname;
+const CENSUS = join(ROOT, "captures/2026-10-23-census");
+const SHIFT = 0x8f; // note 50 on channel 16: 0x9f press, 0x8f release
+
+// The deck-button rows of the controls CSV: notes on channels 1/2 and 5/6 named "Deck N …", except the pads and the
+// pad-mode buttons (M6-05).
+const csv = parseCsv(readFileSync(join(ROOT, "reference/rane-one-mk1-controls.csv"), "utf8").split("\n").filter((l) => !l.startsWith("#")).join("\n"));
+const ROWS = csv.slice(1).map(([status, channel, number, name, , confidence]) => ({ status, ch: +channel, note: +number, name, confidence }))
+  .filter((r) => r.status === "90" && [1, 2, 5, 6].includes(r.ch) && /^Deck \d /.test(r.name) && !/pad mode|pad \d/.test(r.name))
+  .map((r) => ({ ...r, deck: r.ch > 4 ? r.ch - 4 : r.ch, id: `${r.ch > 4 ? "p" : "d"}${r.note}` }));
+
+// What a press and release of each row records, by the plan's table (D31, D33). `shift`: the row is a Shift layer,
+// so the test holds Shift (the One sends that note only then). `shifted`: a same-note row's record with Shift held.
+// `keys`: what a replay must touch for the row (default: the keys of `sets`). `counted`: no Mixxx control, counted.
+const pulse = (g, k) => [[g, k, 1], [g, k, 0]];
+const EXPECT = {
+  d0: { sets: (g) => [[g, "play", 1]], shifted: (g) => [[g, "play", 1]] }, // Shift+Play = Play (D31)
+  d1: { sets: (g) => pulse(g, "cue_default") },
+  d2: { sets: (g) => [[g, "beatsync", 1]], keys: ["beatsync", "sync_enabled"] }, // tap; hold: below
+  d3: { shift: true, sets: (g) => [[g, "sync_enabled", 0]] },
+  d5: { shift: true, sets: (g) => pulse(g, "start") },
+  d6: { sets: (g) => pulse(g, "LoadSelectedTrack") },
+  d7: { sets: () => pulse("[Library]", "MoveFocusBackward") },
+  d8: { shift: true, sets: (g) => pulse(g, "LoadSelectedTrack") },
+  d11: { sets: (g) => pulse(g, "rate_temp_up"), shifted: (g) => pulse(g, "rate_temp_up_small"), keys: ["rate_temp_up", "rate_temp_up_small"] },
+  d12: { sets: (g) => pulse(g, "rate_temp_down"), shifted: (g) => pulse(g, "rate_temp_down_small"), keys: ["rate_temp_down", "rate_temp_down_small"] },
+  d13: { shift: true, sets: (g) => [[g, "keylock", 1]] },
+  d16: { sets: (g) => [[g, "reverse", 1]] },
+  d17: { shift: true, sets: (g) => [...pulse(g, "reverseroll"), [g, "reverse", 0], [g, "slip_enabled", 0]] }, // censor
+  d18: { shift: true, sets: () => [["[Skin]", "show_maximized_library", 1]] },
+  d43: { sets: () => [], counted: true }, // Range: nothing on the motor, must not touch rateRange (D27)
+  p9: { sets: (g) => [[g, "slip_enabled", 1]] },
+  p10: { shift: true, sets: () => [], counted: true }, // motor-off mode: stored for M7
+  p40: { sets: (g) => pulse(g, "beatjump_backward") },
+  p41: { sets: (g) => pulse(g, "beatjump_forward") },
+  p42: { shift: true, sets: (g) => [[g, "beatjump_size", 2]] }, // from 4
+  p43: { shift: true, sets: (g) => [[g, "beatjump_size", 8]] },
+  p52: { sets: (g) => pulse(g, "loop_halve") },
+  p53: { sets: (g) => pulse(g, "loop_double") },
+  p54: { shift: true, sets: (g) => pulse(g, "loop_in") },
+  p55: { shift: true, sets: (g) => pulse(g, "loop_out") },
+  p63: { sets: (g) => pulse(g, "beatloop_activate"), keys: ["beatloop_activate", "reloop_toggle"] }, // no loop yet
+  p65: { shift: true, sets: (g) => pulse(g, "reloop_toggle") },
+};
+
+const group = (deck) => `[Channel${deck}]`;
+const fresh = () => {
+  const h = loadMapping();
+  for (const d of [1, 2]) h.setValue(group(d), "beatjump_size", 4);
+  h.sets.length = 0; // init's rateRange (D27) and volume (D35) writes are tested in mapping-mixer.test.mjs
+  return h;
+};
+// Presses and releases one note, Shift held around it when asked; returns the sets it recorded.
+const press = (h, ch, note, { shift = false } = {}) => {
+  if (shift) h.dispatch([0x90 | (SHIFT & 0x0f), 50, 127]);
+  const from = h.sets.length;
+  h.dispatch([0x90 | (ch - 1), note, 127]);
+  h.dispatch([0x80 | (ch - 1), note, 0]);
+  const sets = h.sets.slice(from);
+  if (shift) h.dispatch([SHIFT, 50, 0]);
+  return sets;
+};
+const fmt = (sets) => JSON.stringify(sets);
+const counts = (h) => vm.runInContext("RaneOne.counts", h.ctx);
+
+test("the controls CSV's deck buttons on channels 1/2 and 5/6 are the rows this test expects, on both decks", () => {
+  assert.ok(ROWS.length >= 50, String(ROWS.length));
+  const ids = new Set(ROWS.map((r) => r.id));
+  assert.deepEqual([...ids].filter((id) => !EXPECT[id]), [], "a CSV row with no expectation here");
+  assert.deepEqual(Object.keys(EXPECT).filter((id) => !ids.has(id)), [], "an expectation with no CSV row");
+  for (const id of ids) assert.deepEqual(ROWS.filter((r) => r.id === id).map((r) => r.deck).sort(), [1, 2], id);
+  // A Shift layer's own row says "with Shift"; the same-note rows say "(same note with Shift)".
+  for (const r of ROWS) assert.equal(!!EXPECT[r.id].shift, /with Shift/.test(r.name) && !/same note/.test(r.name), `${r.name}: Shift layer`);
+});
+
+for (const r of ROWS) {
+  const e = EXPECT[r.id];
+  const g = group(r.deck);
+  test(`ch ${r.ch} note ${r.note} (${r.name}) ${e.shift ? "with Shift held " : ""}records ${fmt(e.sets(g)) || "nothing"}`, { skip }, () => {
+    const h = fresh();
+    assert.equal(fmt(press(h, r.ch, r.note, { shift: e.shift })), fmt(e.sets(g)));
+    assert.equal(h.thrown.length, 0, JSON.stringify(h.thrown[0]));
+    assert.deepEqual(h.unhandled, []);
+    if (e.counted) {
+      const c = counts(h);
+      assert.equal(c[`90 ch ${r.ch} ${r.note}`], 1, JSON.stringify(c));
+      assert.equal(c[`80 ch ${r.ch} ${r.note}`], 1, JSON.stringify(c));
+    }
+  });
+  if (e.shifted) {
+    test(`ch ${r.ch} note ${r.note} (${r.name}) with Shift held records ${fmt(e.shifted(g))}`, { skip }, () => {
+      const h = fresh();
+      assert.equal(fmt(press(h, r.ch, r.note, { shift: true })), fmt(e.shifted(g)));
+      assert.equal(h.thrown.length, 0);
+    });
+  }
+}
+
+test("every deck-button note has a <control> for its note-on (0x9n) and note-off (0x8n), and Shift has both", { skip }, () => {
+  const h = loadMapping();
+  const have = new Set(h.controls.map((c) => `${c.status},${c.midino}`));
+  const want = [...ROWS.flatMap((r) => [0x90, 0x80].map((s) => [s | (r.ch - 1), r.note])), [0x9f, 50], [0x8f, 50]];
+  const missing = want.filter(([s, n]) => !have.has(`${s},${n}`)).map(([s, n]) => `0x${s.toString(16)} ${n}`);
+  assert.deepEqual(missing, []);
+});
+
+test("Shift alone records nothing and sets RaneOne.shifted while held", { skip }, () => {
+  const h = fresh();
+  h.dispatch([0x9f, 50, 127]);
+  assert.equal(vm.runInContext("RaneOne.shifted", h.ctx), true);
+  h.dispatch([0x8f, 50, 0]);
+  assert.equal(vm.runInContext("RaneOne.shifted", h.ctx), false);
+  assert.deepEqual(h.sets, []);
+  assert.deepEqual(h.thrown, []);
+});
+
+test("a Shift-layer press released on the unshifted note ends that press, not the other layer (take 03 at 117.8 s)", { skip }, () => {
+  const h = fresh();
+  h.dispatch([0x9f, 50, 127]);
+  h.dispatch([0x90, 18, 127]); // Shift+Back
+  h.dispatch([0x8f, 50, 0]);
+  h.dispatch([0x80, 7, 0]); // released as Back
+  h.dispatch([0x80, 7, 0]); // a release with no press is ignored
+  assert.equal(fmt(h.sets), fmt([["[Skin]", "show_maximized_library", 1]]));
+  h.sets.length = 0;
+  h.dispatch([0x9f, 50, 127]);
+  h.dispatch([0x91, 17, 127]); // Shift+Reverse on deck 2: reverseroll while held
+  h.dispatch([0x8f, 50, 0]);
+  h.dispatch([0x81, 16, 0]); // take 05 releases it on note 16
+  assert.equal(fmt(h.sets), fmt([...pulse("[Channel2]", "reverseroll"), ["[Channel2]", "reverse", 0], ["[Channel2]", "slip_enabled", 0]]));
+});
+
+test("a release with no press records nothing", { skip }, () => {
+  const h = fresh();
+  for (const n of [1, 2, 6, 11, 16]) h.dispatch([0x80, n, 0]);
+  assert.deepEqual(h.sets, []);
+});
+
+test("a pitch bend held while Shift goes down is released on the key it pressed", { skip }, () => {
+  const h = fresh();
+  h.dispatch([0x90, 11, 127]);
+  h.dispatch([0x9f, 50, 127]);
+  h.dispatch([0x80, 11, 0]);
+  h.dispatch([0x8f, 50, 0]);
+  assert.equal(fmt(h.sets), fmt(pulse("[Channel1]", "rate_temp_up")));
+});
+
+test("Sync held past Components' long-press time turns sync_enabled on; pressed while on, turns it off", { skip }, () => {
+  const h = fresh();
+  h.dispatch([0x90, 2, 127]);
+  h.tick(300);
+  h.dispatch([0x80, 2, 0]);
+  assert.equal(fmt(h.sets), fmt([["[Channel1]", "beatsync", 1], ["[Channel1]", "sync_enabled", 1]]));
+  h.sets.length = 0;
+  assert.equal(fmt(press(h, 1, 2)), fmt([["[Channel1]", "sync_enabled", 0]]));
+});
+
+test("auto loop reloops when a loop is set; beat jump size halves to 1/32 at least and doubles to 512 at most", { skip }, () => {
+  const h = fresh();
+  h.setValue("[Channel1]", "loop_enabled", 1);
+  assert.equal(fmt(press(h, 5, 63)), fmt(pulse("[Channel1]", "reloop_toggle")));
+  h.setValue("[Channel2]", "beatjump_size", 1 / 32);
+  assert.equal(fmt(press(h, 6, 42, { shift: true })), fmt([["[Channel2]", "beatjump_size", 1 / 32]]));
+  h.setValue("[Channel2]", "beatjump_size", 512);
+  assert.equal(fmt(press(h, 6, 43, { shift: true })), fmt([["[Channel2]", "beatjump_size", 512]]));
+});
+
+test("Shift+Slip flips the deck's stored motor-off mode (take 25) and changes no Mixxx control", { skip }, () => {
+  const h = fresh();
+  const motorOff = (d) => vm.runInContext(`RaneOne.deck${d}.motorOff`, h.ctx);
+  assert.equal(motorOff(1), false);
+  press(h, 5, 10, { shift: true });
+  assert.equal(motorOff(1), true);
+  assert.equal(motorOff(2), false);
+  press(h, 5, 10, { shift: true });
+  assert.equal(motorOff(1), false);
+  assert.deepEqual(h.sets, []);
+});
+
+test("an engine that throws inside a deck handler doesn't reach Mixxx: the guard logs one warning, the next press works", { skip }, () => {
+  const h = fresh();
+  h.failNext("setValue");
+  h.dispatch([0x90, 1, 127]);
+  assert.deepEqual(h.thrown, []);
+  // Named by the innermost guarded input: the Cue layer of deck 1's layered Cue button.
+  assert.deepEqual(h.logs.filter(([l]) => l === "warn").map(([, t]) => t.replace(/ failed: .*/, "")), ["RaneOne: deck1.cue.unshifted.input"]);
+  h.dispatch([0x80, 1, 0]);
+  h.dispatch([0x90, 1, 127]);
+  assert.equal(fmt(h.sets.slice(-2)), fmt([["[Channel1]", "cue_default", 0], ["[Channel1]", "cue_default", 1]]));
+});
+
+// Takes 03 and 05 (the deck-control censuses): every deck button the take presses records its control, nothing
+// throws, and nothing is unhandled (the pitch fader and deck knobs are M6-04's, the pads and pad modes M6-05's).
+for (const take of ["03-census-d1-controls", "05-census-d2-controls"]) {
+  test(`replaying ${take} touches every deck button it presses and leaves nothing unhandled`, { skip }, () => {
+    const h = fresh();
+    const file = join(CENSUS, `${take}.jsonl`);
+    const r = h.replay(file);
+    assert.ok(r.sent > 1000, String(r.sent));
+    assert.equal(r.thrown.length, 0, JSON.stringify(r.thrown[0]));
+    assert.equal(r.unhandled.length, 0, `unhandled: ${JSON.stringify(r.unhandled.slice(0, 5))}`);
+    const pressed = new Set(readFileSync(file, "utf8").split("\n").filter(Boolean).map((l) => JSON.parse(l))
+      .filter((m) => m.type === "on").map((m) => `${m.ch},${m.d1}`));
+    const touched = new Set(r.sets.map(([g, k]) => `${g},${k}`));
+    const c = counts(h);
+    let checked = 0;
+    for (const row of ROWS.filter((x) => pressed.has(`${x.ch},${x.note}`))) {
+      const e = EXPECT[row.id];
+      checked++;
+      if (e.counted) { assert.ok(c[`90 ch ${row.ch} ${row.note}`] >= 1, `${row.name}: not counted`); continue; }
+      const [g, first] = e.sets(group(row.deck))[0];
+      const keys = e.keys ?? [first];
+      assert.ok(keys.some((k) => touched.has(`${g},${k}`)), `${row.name}: no set of ${keys.join(" or ")} on ${g}`);
+    }
+    assert.ok(checked >= 20, `only ${checked} deck rows pressed in ${take}`);
+  });
+}
+
+// Review (M6-03): Mixxx 2.5.6's RateControl::slotReverseRollActivate sets reverse and slip_enabled to 1 on press
+// and to 0 on release, whatever they were, inside the setValue (a direct connection); so after writing reverseroll 0
+// the mapping writes back what the deck had before the censor. The fake has no RateControl: the test checks the
+// writes and their order.
+test("Shift+Reverse (censor) gives back the Slip and Reverse the deck had before it", { skip }, () => {
+  const h = fresh();
+  h.setValue("[Channel1]", "slip_enabled", 1);
+  h.setValue("[Channel1]", "reverse", 1);
+  assert.equal(fmt(press(h, 1, 17, { shift: true })), fmt([...pulse("[Channel1]", "reverseroll"),
+    ["[Channel1]", "reverse", 1], ["[Channel1]", "slip_enabled", 1]]));
+  assert.deepEqual(h.thrown, []);
+});
+
+test("shutdown releases what is held, so a hot reload can't leave a pitch bend or censor on", { skip }, () => {
+  const h = fresh();
+  h.dispatch([0x90, 11, 127]);
+  h.dispatch([0x9f, 50, 127]);
+  h.dispatch([0x91, 17, 127]);
+  h.sets.length = 0;
+  h.shutdown();
+  const keys = h.sets.map(([g, k, v]) => `${g},${k},${v}`);
+  assert.ok(keys.includes("[Channel1],rate_temp_up,0"), keys.join(" "));
+  assert.ok(keys.includes("[Channel2],reverseroll,0"), keys.join(" "));
+});
+
+test("a Sync tap leaves no timer behind, and a Sync press released on its Shift note (3) ends it", { skip }, () => {
+  const h = fresh();
+  press(h, 1, 2);
+  h.tick(300);
+  assert.equal(fmt(h.sets), fmt([["[Channel1]", "beatsync", 1]]));
+  assert.equal(h.timers.size, 0);
+  h.dispatch([0x90, 2, 127]);
+  h.dispatch([0x80, 3, 0]);
+  h.tick(300);
+  assert.equal(h.timers.size, 0);
+  assert.equal(fmt(h.sets.filter(([, k]) => k === "sync_enabled")), "[]");
+});
+
+test("a note-off with a non-zero value is a release, for Play too", { skip }, () => {
+  const h = fresh();
+  h.dispatch([0x90, 0, 127]);
+  h.dispatch([0x80, 0, 64]);
+  assert.equal(fmt(h.sets), fmt([["[Channel1]", "play", 1]]));
+});
diff --git a/tests/mapping-fx.test.mjs b/tests/mapping-fx.test.mjs
new file mode 100644
index 0000000..f267ec0
--- /dev/null
+++ b/tests/mapping-fx.test.mjs
@@ -0,0 +1,333 @@
+// The FX section (D32: paddles, FX1–6 state, depth with its paddle-zero rule, Tap), the platter placeholders M7
+// replaces, the debug log (RaneOne.DEBUG) and the census replay that leaves nothing unhandled (M6-06). Every
+// expectation is on the fake Mixxx (tests/helpers/fake-mixxx.mjs), dispatching through mapping/Rane-One.midi.xml.
+//
+// These tests need Mixxx 2.5.6's controller scripts from the org.mixxx.Mixxx Flatpak (or RANE_MIXXX_CONTROLLERS);
+// when they are missing, each test is skipped with the reason. The XML-only tests run either way.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import vm from "node:vm";
+import { controllersDir, loadMapping, MAPPING_XML, MAPPING_DIR } from "./helpers/fake-mixxx.mjs";
+import { parseCsv } from "../tools/lib/census.mjs";
+
+const { skip } = controllersDir();
+const ROOT = new URL("..", import.meta.url).pathname;
+const CENSUS = join(ROOT, "captures/2026-10-23-census");
+const fmt = (x) => JSON.stringify(x);
+const on = (ch, n, v = 127) => [0x90 | (ch - 1), n, v];
+const off = (ch, n) => [0x80 | (ch - 1), n, 0];
+const cc = (ch, n, v) => [0xb0 | (ch - 1), n, v];
+const UNIT = (n) => `[EffectRack1_EffectUnit${n}]`;
+const ENABLE = (n) => [UNIT(n), `group_[Channel${n}]_enable`];
+const setsOf = (h, [g, k]) => h.sets.filter(([sg, sk]) => sg === g && sk === k).map(([, , v]) => v);
+const mixOf = (h, n) => h.params.filter(([g, k]) => g === UNIT(n) && k === "mix").map(([, , v]) => v);
+const counts = (h) => vm.runInContext("RaneOne.counts", h.ctx);
+// What Components' Pot sets for a 7-bit value (its inValueScale, centre rule included).
+const pot = (h, v) => vm.runInContext(`components.Pot.prototype.inValueScale(${v})`, h.ctx);
+// The FX state burst the One sends with each paddle change (02 at 38.47 s): ch 9 notes 0–2, ch 10 notes 3–5, value 0.
+const BURST = [on(9, 0, 0), on(9, 1, 0), on(9, 2, 0), on(10, 3, 0), on(10, 4, 0), on(10, 5, 0)];
+
+const csv = parseCsv(readFileSync(join(ROOT, "reference/rane-one-mk1-controls.csv"), "utf8").split("\n").filter((l) => !l.startsWith("#")).join("\n"));
+const ROWS = csv.slice(1).map(([status, channel, number, name, , confidence]) => ({ status, ch: +channel, number: number === "" ? null : +number, name, confidence }));
+
+// Paddles (D32): note 16 on ch 9 (deck 1) and ch 10 (deck 2) report the paddle's state, so the unit's enable for
+// that deck is set to it, never toggled; the controls CSV names them, and the FX1–6 rows are notes 0–2 and 3–5.
+test("the controls CSV has the paddles on note 16 of ch 9/10 and the FX1–6 state rows on notes 0–2 and 3–5", () => {
+  const fx = ROWS.filter((r) => r.ch === 9 || r.ch === 10).map((r) => `${r.ch}:${r.number}:${/^FX paddle/.test(r.name) ? "paddle" : "state"}`);
+  assert.equal(fx.join(" "), "9:0:state 9:1:state 9:2:state 9:16:paddle 10:3:state 10:4:state 10:5:state 10:16:paddle");
+});
+
+for (const n of [1, 2]) {
+  const ch = 8 + n;
+  test(`deck ${n}'s paddle (note 16 ch ${ch}) sets ${ENABLE(n).join(",")} to its state, on and off, and nothing else`, { skip }, () => {
+    const h = loadMapping();
+    h.sets.length = 0;
+    for (const m of [on(ch, 16), on(ch, 16, 0), on(ch, 16), off(ch, 16)]) h.dispatch(m);
+    assert.equal(fmt(setsOf(h, ENABLE(n))), fmt([1, 0, 1, 0]));
+    assert.equal(h.sets.length, 4, fmt(h.sets.slice(0, 6)));
+    assert.deepEqual(h.unhandled, []);
+    assert.deepEqual(h.thrown, []);
+  });
+
+  test(`deck ${n}'s paddle locked up stays enabled: the FX burst and time change nothing`, { skip }, () => {
+    const h = loadMapping();
+    h.dispatch(on(ch, 16));
+    for (const m of BURST) h.dispatch(m);
+    h.tick(2000);
+    h.dispatch(on(ch, 16)); // the state reported again (a power-on dump)
+    assert.equal(fmt(setsOf(h, ENABLE(n))), fmt([1, 1]));
+    assert.equal(h.getValue(...ENABLE(n)), 1);
+    assert.equal(fmt(setsOf(h, ENABLE(3 - n))), fmt([]), "the other deck's unit");
+  });
+}
+
+test("the FX1–6 state rows (ch 9 notes 0–2, ch 10 notes 3–5) are counted no-ops, note-on and note-off", { skip }, () => {
+  const h = loadMapping();
+  h.sets.length = 0;
+  h.params.length = 0;
+  for (const m of BURST) h.dispatch(m);
+  for (const [ch, n] of [[9, 0], [9, 1], [9, 2], [10, 3], [10, 4], [10, 5]]) h.dispatch(off(ch, n));
+  assert.equal(fmt([h.sets, h.params, h.unhandled, h.thrown]), fmt([[], [], [], []]));
+  const c = counts(h);
+  assert.equal(fmt(["90 ch 9 0", "90 ch 10 5", "80 ch 9 1", "80 ch 10 3"].map((k) => c[k])), fmt([1, 1, 1, 1]));
+});
+
+// Depth and beat (D32, built in M6-04; tests/mapping-mixer.test.mjs has the sweeps): the depth knob is a
+// soft-takeover Pot on `mix` of both units, the beat knob steps `super1` of both by ±1/32 per tick.
+test("the depth knob is a soft-takeover Pot on both units' mix; the beat knob steps both units' super1", { skip }, () => {
+  const h = loadMapping();
+  h.dispatch(cc(16, 4, 64));
+  for (const n of [1, 2]) {
+    assert.equal(fmt(mixOf(h, n)), fmt([0.5]));
+    assert.ok(h.takeovers.some((t) => fmt(t) === fmt([UNIT(n), "mix", true])), `unit ${n}: no soft takeover`);
+  }
+  h.setValue(UNIT(1), "super1", 0.5);
+  h.setValue(UNIT(2), "super1", 0.5);
+  h.dispatch(cc(16, 3, 65));
+  h.dispatch(cc(16, 3, 63));
+  h.dispatch(cc(16, 3, 63));
+  for (const n of [1, 2]) assert.equal(fmt(setsOf(h, [UNIT(n), "super1"])), fmt([0.5 + 1 / 32, 0.5, 0.5 - 1 / 32]));
+});
+
+// D32's paddle-zero rule: the One sends CC 4 = 0 just before the FX burst with each paddle-on (02 at 38.47, 41.01,
+// 43.31 s). A depth 0 after a value above 8, or before any depth value (02's paddles come before its depth sweep),
+// is held: dropped if the burst (ch 9 note 0) comes next, else applied with the next message or after 50 ms.
+test("a depth 0 followed by the FX burst is dropped: mix keeps the knob's last value", { skip }, () => {
+  const h = loadMapping();
+  h.dispatch(cc(16, 4, 100));
+  h.dispatch(cc(16, 4, 0));
+  for (const m of [...BURST, on(9, 16)]) h.dispatch(m);
+  h.tick(200);
+  for (const n of [1, 2]) assert.equal(fmt(mixOf(h, n)), fmt([pot(h, 100)]), `unit ${n}`);
+});
+
+test("a depth 0 before any depth value, then the FX burst, is dropped too (take 02's first paddle-on)", { skip }, () => {
+  const h = loadMapping();
+  h.dispatch(cc(16, 4, 0));
+  for (const m of BURST) h.dispatch(m);
+  h.tick(200);
+  assert.equal(fmt([mixOf(h, 1), mixOf(h, 2)]), fmt([[], []]));
+});
+
+test("a held depth 0 with no burst is applied after 50 ms", { skip }, () => {
+  const h = loadMapping();
+  h.dispatch(cc(16, 4, 100));
+  h.dispatch(cc(16, 4, 0));
+  h.tick(40);
+  assert.equal(fmt(mixOf(h, 1)), fmt([pot(h, 100)]), "still held at 40 ms");
+  h.tick(20);
+  assert.equal(fmt([mixOf(h, 1), mixOf(h, 2)]), fmt([[pot(h, 100), 0], [pot(h, 100), 0]]));
+  h.tick(200);
+  assert.equal(mixOf(h, 1).length, 2, "applied once");
+});
+
+test("a held depth 0 is applied before the next message that is not the burst (another knob, or the depth knob)", { skip }, () => {
+  const h = loadMapping();
+  h.dispatch(cc(16, 4, 100));
+  h.dispatch(cc(16, 4, 0));
+  h.dispatch(cc(16, 8, 64)); // the crossfader
+  const order = h.params.map(([g, k, v]) => `${k}=${v}`);
+  assert.equal(fmt(order.slice(-3)), fmt(["mix=0", "mix=0", "crossfader=0.5"]));
+  h.dispatch(cc(16, 4, 100));
+  h.dispatch(cc(16, 4, 0));
+  h.dispatch(cc(16, 4, 3));
+  assert.equal(fmt(mixOf(h, 1).slice(-3)), fmt([pot(h, 100), 0, pot(h, 3)]));
+  h.tick(200);
+  assert.equal(mixOf(h, 1).length, 5, "the timer of an applied zero doesn't apply it again");
+});
+
+test("platter messages between a held depth 0 and the burst neither apply nor drop it; the timer still applies one", { skip }, () => {
+  const h = loadMapping();
+  h.dispatch(cc(16, 4, 100));
+  h.dispatch(cc(16, 4, 0));
+  for (const m of [cc(1, 6, 3), [0xe0, 17, 64], cc(2, 6, 125), [0xe1, 0, 0]]) h.dispatch(m);
+  for (const m of [...BURST, on(9, 16)]) h.dispatch(m);
+  h.tick(200);
+  assert.equal(fmt(mixOf(h, 1)), fmt([pot(h, 100)]), "dropped by the burst");
+  h.dispatch(cc(16, 4, 0));
+  h.dispatch(cc(1, 6, 3));
+  h.tick(60);
+  assert.equal(fmt(mixOf(h, 1)), fmt([pot(h, 100), 0]), "applied by the timer");
+});
+
+test("a held depth 0 at shutdown is dropped, not applied, and its timer stopped", { skip }, () => {
+  const h = loadMapping();
+  h.dispatch(cc(16, 4, 100));
+  h.dispatch(on(5, 40)); // a held pad parameter button, which shutdown releases
+  h.dispatch(cc(16, 4, 0));
+  vm.runInContext("RaneOne.shutdown()", h.ctx);
+  h.tick(200);
+  assert.equal(fmt(mixOf(h, 1)), fmt([pot(h, 100)]));
+  assert.equal(h.timers.size, 0);
+  assert.deepEqual(h.thrown, []);
+});
+
+test("a failure while settling the held zero is logged as RaneOne.heard's and doesn't drop the message", { skip }, () => {
+  const h = loadMapping();
+  h.dispatch(cc(16, 4, 100));
+  h.dispatch(cc(16, 4, 0));
+  h.failNext("stopTimer");
+  h.dispatch(on(1, 0));
+  assert.equal(h.getValue("[Channel1]", "play"), 1);
+  assert.ok(h.logs.some(([level, l]) => level === "warn" && l.startsWith("RaneOne: heard failed")), fmt(h.logs));
+});
+
+test("a depth 0 after a value of 8 or less is a real turn to 0: applied at once", { skip }, () => {
+  const h = loadMapping();
+  for (const v of [20, 8, 0]) h.dispatch(cc(16, 4, v));
+  assert.equal(fmt(mixOf(h, 1)), fmt([pot(h, 20), pot(h, 8), 0]));
+});
+
+// Tap (D32): bpm_tap on the deck whose paddle is on, deck 1 if both, a counted no-op if none; 1 on the press and 0
+// on the release, to the deck the press picked.
+test("Tap (note 4 ch 16) is bpm_tap on the paddled deck, deck 1 if both, counted if none", { skip }, () => {
+  const h = loadMapping();
+  const taps = (g) => setsOf(h, [g, "bpm_tap"]);
+  h.dispatch(on(16, 4)); h.dispatch(off(16, 4));
+  assert.equal(fmt([taps("[Channel1]"), taps("[Channel2]")]), fmt([[], []]));
+  assert.equal(counts(h)["90 ch 16 4"], 1);
+  h.dispatch(on(10, 16));
+  h.dispatch(on(16, 4)); h.dispatch(off(16, 4));
+  assert.equal(fmt([taps("[Channel1]"), taps("[Channel2]")]), fmt([[], [1, 0]]));
+  h.dispatch(on(9, 16));
+  h.dispatch(on(16, 4)); h.dispatch(off(16, 4));
+  assert.equal(fmt([taps("[Channel1]"), taps("[Channel2]")]), fmt([[1, 0], [1, 0]]));
+  // The paddle goes down while Tap is held: the release still ends deck 1's tap.
+  h.dispatch(on(16, 4)); h.dispatch(on(9, 16, 0)); h.dispatch(on(16, 4, 0));
+  assert.equal(fmt([taps("[Channel1]"), taps("[Channel2]")]), fmt([[1, 0, 1, 0], [1, 0]]));
+  assert.deepEqual(h.unhandled, []);
+  assert.deepEqual(h.thrown, []);
+});
+
+// Platter (M7's): CC 6 and the pitch bend on channels 1 and 2 go to RaneOne.deckN.platter.input, which only counts.
+for (const n of [1, 2]) {
+  test(`deck ${n}'s platter messages (CC 6 and pitch bend on ch ${n}) only count in RaneOne.deck${n}.platter`, { skip }, () => {
+    const h = loadMapping();
+    h.sets.length = 0;
+    h.params.length = 0;
+    for (const m of [cc(n, 6, 3), [0xe0 | (n - 1), 17, 64], cc(n, 6, 125), [0xe0 | (n - 1), 0, 0]]) h.dispatch(m);
+    assert.equal(vm.runInContext(`RaneOne.deck${n}.platter.messages`, h.ctx), 4);
+    assert.equal(vm.runInContext(`RaneOne.deck${3 - n}.platter.messages`, h.ctx), 0);
+    assert.equal(fmt([h.sets, h.params, h.unhandled, h.thrown]), fmt([[], [], [], []]));
+  });
+}
+
+// The XML's own comments: each <control> is preceded by one naming its row.
+const RAW = readFileSync(MAPPING_XML, "utf8");
+const ENTRIES = [...RAW.matchAll(/<!--((?:(?!-->)[^])*)-->\s*<control>((?:(?!<\/control>)[^])*)<\/control>/g)].map(([, comment, body]) => ({
+  comment, key: body.match(/<key>([^<]*)<\/key>/)[1], status: parseInt(body.match(/<status>([^<]*)<\/status>/)[1], 16),
+  midino: parseInt(body.match(/<midino>([^<]*)<\/midino>/)[1], 16),
+}));
+
+test("every <control> entry directly follows a comment", () => {
+  assert.equal(ENTRIES.length, (RAW.match(/<control>/g) ?? []).length);
+});
+
+test("the platter entries are CC 6 and pitch bend on ch 1/2 to deckN.platter.input, under a comment saying M7 replaces them", () => {
+  const platter = ENTRIES.filter((e) => /\.platter\.input$/.test(e.key));
+  assert.equal(fmt(platter.map((e) => `${e.status.toString(16)} ${e.midino} ${e.key}`).sort()), fmt([
+    "b0 6 RaneOne.deck1.platter.input", "b1 6 RaneOne.deck2.platter.input", "e0 0 RaneOne.deck1.platter.input", "e1 0 RaneOne.deck2.platter.input"]));
+  assert.match(RAW, /<!--[^>]*M7 replaces[^>]*-->\s*<!--[^>]*-->\s*<control>\s*<group>\[Channel1\]<\/group>\s*<key>RaneOne\.deck1\.platter\.input/);
+});
+
+// Every entry of a control the controls CSV marks mk2 or unknown says UNVERIFIED (M6 plan, Control table).
+test("every XML entry for a controls-CSV row marked mk2 or unknown carries UNVERIFIED in its comment", () => {
+  const unsure = new Set(ROWS.filter((r) => r.confidence !== "capture").map((r) => `${parseInt(r.status, 16) & 0xf0},${r.ch},${r.number}`));
+  assert.ok(unsure.size > 50, String(unsure.size));
+  const rowOf = (e) => `${(e.status & 0xf0) === 0x80 ? 0x90 : e.status & 0xf0},${(e.status & 0x0f) + 1},${e.midino}`;
+  const bare = ENTRIES.filter((e) => unsure.has(rowOf(e)) && !e.comment.includes("UNVERIFIED"));
+  assert.equal(bare.length, 0, `${bare.length} without UNVERIFIED, first: ${fmt(bare.slice(0, 3).map((e) => [rowOf(e), e.comment]))}`);
+  const hit = new Set(ENTRIES.map(rowOf));
+  assert.equal([...unsure].filter((u) => !hit.has(u)).length, 0, "an unsure row with no entry");
+});
+
+// The census replay (M6 plan, Features): the seven census takes plus 25 (motor toggle) and 26 (strip), nothing
+// unhandled and nothing thrown. The table goes to the test's diagnostics.
+const TAKES = ["02-census-mixer", "03-census-d1-controls", "04-census-d1-pads", "05-census-d2-controls", "06-census-d2-pads",
+  "27-census-d1-pads-shift", "28-census-d2-pads-shift", "25-motor-toggle", "26-strip"];
+
+test("replaying the census takes plus 25 and 26 leaves zero unhandled messages and zero handler exceptions", { skip }, (t) => {
+  const rows = [];
+  for (const take of TAKES) {
+    const h = loadMapping();
+    const r = h.replay(join(CENSUS, `${take}.jsonl`));
+    const changed = new Set([...r.sets, ...h.params].map(([g, k]) => `${g},${k}`));
+    const warned = h.logs.filter(([level]) => level === "warn").length;
+    rows.push({ take, sent: r.sent, unhandled: r.unhandled.length, thrown: r.thrown.length, warned, changed: changed.size,
+      platter: vm.runInContext("RaneOne.deck1.platter.messages + RaneOne.deck2.platter.messages", h.ctx),
+      first: r.unhandled[0] ?? r.thrown[0] ?? null });
+  }
+  t.diagnostic("take | sent | unhandled | thrown | warnings | controls changed | platter messages");
+  for (const r of rows) t.diagnostic(`${r.take} | ${r.sent} | ${r.unhandled} | ${r.thrown} | ${r.warned} | ${r.changed} | ${r.platter}`);
+  const bad = rows.filter((r) => r.unhandled || r.thrown || r.warned);
+  assert.equal(bad.length, 0, fmt(bad));
+  assert.ok(rows.every((r) => r.sent > 50), fmt(rows.map((r) => r.sent)));
+});
+
+// The debug log (M6 plan, Script structure): RaneOne.DEBUG is false in the repo; when true, init connects every
+// (group, key) the mapping can change and logs `RaneOne: <group>,<key> = <value>` on each change.
+test("RaneOne.DEBUG = false; is in the script exactly once (tools/install-mapping --debug rewrites that line)", () => {
+  const src = readFileSync(join(MAPPING_DIR, "Rane-One-scripts.js"), "utf8");
+  assert.equal((src.match(/^RaneOne\.DEBUG = false;$/gm) ?? []).length, 1);
+});
+
+const debugMapping = () => {
+  const h = loadMapping();
+  vm.runInContext("RaneOne.DEBUG = true; RaneOne.init('debug')", h.ctx);
+  h.sets.length = 0;
+  h.params.length = 0;
+  h.logs.length = 0;
+  return h;
+};
+
+test("with RaneOne.DEBUG off, init makes no connection; on, a change logs 'RaneOne: <group>,<key> = <value>'", { skip }, () => {
+  assert.equal(loadMapping().connections.length, 0);
+  const h = debugMapping();
+  h.dispatch(on(1, 0));
+  h.dispatch(on(9, 16));
+  const lines = h.logs.filter(([, l]) => l.startsWith("RaneOne: [")).map(([, l]) => l);
+  assert.ok(lines.includes("RaneOne: [Channel1],play = 1"), fmt(lines));
+  assert.ok(lines.includes("RaneOne: [EffectRack1_EffectUnit1],group_[Channel1]_enable = 1"), fmt(lines));
+  const keys = h.connections.map((c) => `${c.group},${c.key}`);
+  assert.equal(new Set(keys).size, keys.length, "one connection per (group, key)");
+  assert.equal(keys.filter((k) => k.endsWith(",playposition")).length, 0, "playposition would flood the log");
+  assert.ok(keys.includes("[Channel1],sync_enabled") && keys.includes("[Channel1],beatsync"));
+});
+
+// M6-07's dev-Mixxx check reads D27's rate_ratio = 1 + rate × rateRange × rate_dir off the log, so the pitch fader
+// connects rate_ratio too (Mixxx computes it; the mapping never sets it).
+test("with RaneOne.DEBUG on, the pitch fader's rate_ratio is connected on both decks", { skip }, () => {
+  const keys = debugMapping().connections.map((c) => `${c.group},${c.key}`);
+  assert.ok(keys.includes("[Channel1],rate_ratio") && keys.includes("[Channel2],rate_ratio"), fmt(keys.filter((k) => k.includes("rate"))));
+});
+
+test("with RaneOne.DEBUG on, every control the census replay changes has a debug connection", { skip }, () => {
+  const missing = new Set();
+  for (const take of TAKES) {
+    const h = debugMapping();
+    const keys = new Set(h.connections.filter((c) => c.isConnected).map((c) => `${c.group},${c.key}`));
+    const r = h.replay(join(CENSUS, `${take}.jsonl`));
+    // playposition is left out on purpose: Mixxx moves it all the time a deck plays.
+    for (const [g, k] of [...r.sets, ...h.params]) if (k !== "playposition" && !keys.has(`${g},${k}`)) missing.add(`${take}: ${g},${k}`);
+    assert.equal(r.thrown.length, 0, fmt(r.thrown[0]));
+  }
+  assert.equal(missing.size, 0, fmt([...missing].slice(0, 5)));
+});
+
+test("a debug connection that fails leaves the others connected", { skip }, () => {
+  const h = loadMapping();
+  h.failNext("makeConnection");
+  vm.runInContext("RaneOne.DEBUG = true; RaneOne.init('debug')", h.ctx);
+  assert.ok(h.connections.length > 100, String(h.connections.length));
+  assert.equal(h.logs.filter(([level, l]) => level === "warn" && l.includes("debugConnect")).length, 1);
+});
+
+test("debug connections skip samplers past [App],num_samplers (Mixxx warns on an unknown control)", { skip }, () => {
+  const h = loadMapping();
+  h.setValue("[App]", "num_samplers", 4);
+  vm.runInContext("RaneOne.DEBUG = true; RaneOne.init('debug')", h.ctx);
+  const samplers = new Set(h.connections.filter((c) => c.group.startsWith("[Sampler")).map((c) => c.group));
+  assert.equal(fmt([...samplers].sort()), fmt(["[Sampler1]", "[Sampler2]", "[Sampler3]", "[Sampler4]"]));
+});
diff --git a/tests/mapping-harness.test.mjs b/tests/mapping-harness.test.mjs
new file mode 100644
index 0000000..06d4447
--- /dev/null
+++ b/tests/mapping-harness.test.mjs
@@ -0,0 +1,168 @@
+// The fake Mixxx itself (tests/helpers/fake-mixxx.mjs, M6 plan § Test harness): loading a mapping in Mixxx's
+// order, dispatching through the XML's <control> table, recording engine calls, refusing MIDI output, and running
+// Mixxx's own Components inside it. The dispatch tests use a synthetic mapping (tests/fixtures/mapping-harness/).
+//
+// These tests need Mixxx 2.5.6's controller scripts (midi-components-0.0.js, common-controller-scripts.js) from the
+// org.mixxx.Mixxx Flatpak, or RANE_MIXXX_CONTROLLERS. When they are missing, every test that needs them is skipped
+// with the reason (node --test prints it); the skip test at the end runs everywhere.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { basename, join } from "node:path";
+import vm from "node:vm";
+import { controllersDir, loadMapping, readMapping, MAPPING_DIR, MAPPING_XML } from "./helpers/fake-mixxx.mjs";
+import { tempDir } from "./helpers/temp.mjs";
+
+const FIXTURES = new URL("./fixtures/mapping-harness/", import.meta.url).pathname;
+const PROBE = join(FIXTURES, "Probe.midi.xml");
+const { skip, dir: MIXXX_DIR } = controllersDir();
+const probe = () => loadMapping({ xml: PROBE });
+
+test("loads Rane-One.midi.xml's scripts in Mixxx's order and calls RaneOne.init", { skip }, () => {
+  const h = loadMapping();
+  const { scriptFiles } = readMapping(MAPPING_XML);
+  assert.deepEqual(h.loaded.map((f) => basename(f)), ["common-controller-scripts.js", ...scriptFiles.map((f) => f.filename)]);
+  for (const f of h.loaded) {
+    const own = scriptFiles.some((s) => s.filename === basename(f) && s.filename !== "midi-components-0.0.js");
+    assert.equal(f, join(own ? MAPPING_DIR : MIXXX_DIR, basename(f)), "mapping files from mapping/, the rest from Mixxx");
+  }
+  assert.equal(typeof h.ctx.components?.Button, "function", "Components is loaded");
+  assert.ok(h.logs.some(([l, t]) => l === "log" && t === "RaneOne: init Midi Through Port-0"), JSON.stringify(h.logs.slice(0, 3)));
+  assert.deepEqual(h.thrown, []);
+  assert.equal(h.midiReads, 0);
+});
+
+test("dispatches the three-message fixture through the <control> table and records setValue as [group, control, value]", { skip }, () => {
+  const h = probe();
+  assert.deepEqual([...h.ctx.Probe.initArgs], ["Midi Through Port-0", false]);
+  const r = h.replay(join(FIXTURES, "three-messages.jsonl"));
+  assert.equal(r.sent, 3);
+  assert.deepEqual(r.unhandled, []);
+  assert.deepEqual(r.thrown, []);
+  // The note-on and its note-off (0x80, its own <control> entry) reach the Button; CC 22 reaches the Pot.
+  assert.deepEqual(r.sets, [["[Channel1]", "cue_default", 1], ["[Channel1]", "cue_default", 0]]);
+  assert.equal(h.params.length, 1);
+  assert.deepEqual(h.params[0].slice(0, 2), ["[Channel1]", "volume"]);
+  assert.ok(Math.abs(h.params[0][2] - 99 / 126) < 1e-12, String(h.params[0][2]));
+  assert.equal(h.getParameter("[Channel1]", "volume"), h.params[0][2]);
+  assert.equal(h.getValue("[Channel1]", "volume"), 0, "values and parameters are separate stores");
+});
+
+test("dispatch calls the key like Mixxx: channel from the status, `this` is the key's owner, group from the XML", { skip }, () => {
+  const h = probe();
+  assert.equal(h.dispatch([0xb1, 0x17, 42]), 1);
+  const { plain } = h.ctx.Probe;
+  assert.equal(plain.self, plain);
+  assert.deepEqual([...plain.seen], [1, 0x17, 42, 0xb1, "[Channel2]"]);
+  assert.deepEqual(h.sets, [["[Channel2]", "probe", 42]]);
+});
+
+test("a message with no <control> entry goes to unhandled, exactly by status byte", { skip }, () => {
+  const h = probe();
+  assert.equal(h.dispatch([0xb0, 63, 1]), 0);
+  assert.equal(h.dispatch([0x81, 0x01, 0]), 0, "a note-off on another channel has no entry");
+  assert.deepEqual(h.unhandled, [{ status: 0xb0, ch: 1, number: 63, value: 1 }, { status: 0x81, ch: 2, number: 1, value: 0 }]);
+  assert.deepEqual(h.sets, []);
+});
+
+test("midi.sendShortMsg and midi.sendSysexMsg throw in the fake, and reads of midi are counted", { skip }, () => {
+  const h = probe();
+  assert.throws(() => vm.runInContext("midi.sendShortMsg(0x90, 1, 127)", h.ctx), /sendShortMsg refused/);
+  assert.throws(() => vm.runInContext("midi.sendSysexMsg([0xf0, 0xf7], 2)", h.ctx), /sendSysexMsg refused/);
+  assert.equal(h.midiReads, 2);
+  // An unguarded handler that sends: the exception escapes it and the harness records it.
+  h.dispatch([0x91, 0x07, 127]);
+  assert.equal(h.thrown.length, 1);
+  assert.equal(h.thrown[0].what, "Probe.sender.input");
+  assert.match(h.thrown[0].error, /sendShortMsg refused/);
+});
+
+test("components.Button and components.Pot work in the fake: the Pot sets [Channel1],volume with soft takeover", { skip }, () => {
+  const h = probe();
+  // The Button connected its output at construction (Components' outConnect) and its trigger sent nothing.
+  assert.ok(h.connections.some((c) => c.group === "[Channel1]" && c.key === "cue_default" && c.isConnected));
+  assert.equal(h.midiReads, 0);
+  // Components' Pot turns soft takeover on at its first input (Pot.input -> connect), not at construction.
+  assert.deepEqual(h.takeovers, []);
+  h.dispatch([0xb0, 22, 0]);
+  h.dispatch([0xb0, 22, 127]);
+  assert.deepEqual(h.params, [["[Channel1]", "volume", 0], ["[Channel1]", "volume", 1]]);
+  assert.deepEqual(h.takeovers, [["[Channel1]", "volume", true]]);
+  h.dispatch([0x90, 1, 127]);
+  assert.deepEqual(h.sets, [["[Channel1]", "cue_default", 1]]);
+  assert.deepEqual(h.thrown, []);
+  assert.deepEqual(h.logs.filter(([l]) => l === "warn"), []);
+});
+
+test("failNext makes the next engine call throw once; a method the fake lacks throws with its name", { skip }, () => {
+  const h = probe();
+  h.failNext("setValue");
+  h.dispatch([0xb1, 0x17, 1]);
+  h.dispatch([0xb1, 0x17, 2]);
+  assert.equal(h.thrown.length, 1);
+  assert.match(h.thrown[0].error, /setValue failed \(failNext\)/);
+  assert.deepEqual(h.sets, [["[Channel2]", "probe", 2]]);
+  assert.throws(() => vm.runInContext("engine.brake(1, true)", h.ctx), /fake engine has no brake/);
+  assert.deepEqual(h.calls.at(-1), ["brake", 1, true]);
+});
+
+test("engine values are numbers, NaN is refused with a warning, and connections fire after the handler", { skip }, () => {
+  const h = probe();
+  const fired = [];
+  vm.runInContext("engine.makeConnection('[Channel1]', 'play', function (v, g, k) { __fired.push([v, g, k]); })", Object.assign(h.ctx, { __fired: fired }));
+  vm.runInContext("engine.setValue('[Channel1]', 'play', true); engine.setValue('[Channel1]', 'play', NaN)", h.ctx);
+  assert.deepEqual(h.sets, [["[Channel1]", "play", 1]]);
+  assert.deepEqual(fired, [], "queued, not run inside setValue");
+  h.flush();
+  assert.deepEqual(fired.map((f) => [...f]), [[1, "[Channel1]", "play"]]);
+  assert.match(h.logs.at(-1)[1], /refused NaN/);
+  assert.equal(h.getValue("[Channel1]", "rateRange"), 0.5);
+  assert.equal(h.getValue("[Channel2]", "rate_dir"), 1);
+});
+
+test("timers run when the harness ticks, one-shot once and repeating until stopped", { skip }, () => {
+  const h = probe();
+  const runs = [];
+  Object.assign(h.ctx, { __runs: runs });
+  const once = vm.runInContext("engine.beginTimer(100, \"__runs.push('once');\", true)", h.ctx);
+  const every = vm.runInContext("engine.beginTimer(30, function () { __runs.push('every'); })", h.ctx);
+  assert.ok(once > 0 && every > 0 && once !== every);
+  h.tick(99);
+  assert.deepEqual(runs, ["every", "every", "every"]);
+  h.tick(1);
+  assert.deepEqual(runs.slice(3), ["once"]);
+  vm.runInContext(`engine.stopTimer(${every})`, h.ctx);
+  h.tick(1000);
+  assert.equal(runs.length, 4);
+  vm.runInContext("engine.beginTimer(5, function () { __runs.push('fast'); }, true)", h.ctx);
+  assert.match(h.logs.at(-1)[1], /beginTimer\(5\) runs at 20 ms/);
+  h.tick(19);
+  assert.equal(runs.length, 4);
+  h.tick(1);
+  assert.equal(runs.at(-1), "fast");
+});
+
+test("failAll makes every engine call throw until turned off", { skip }, () => {
+  const h = probe();
+  h.failAll();
+  h.dispatch([0xb0, 22, 64]);
+  h.dispatch([0x90, 1, 127]);
+  assert.equal(h.thrown.length, 2);
+  h.failAll(false);
+  h.dispatch([0xb0, 22, 64]);
+  assert.equal(h.thrown.length, 2);
+  assert.equal(h.params.length, 1);
+});
+
+test("shutdown calls each prefix's shutdown", { skip }, () => {
+  const h = probe();
+  h.shutdown();
+  assert.equal(h.ctx.Probe.shutDown, true);
+});
+
+test("without Mixxx's controller scripts the harness returns an explicit skip, not a failure", () => {
+  const empty = tempDir("fake-mixxx-");
+  const r = loadMapping({ env: { RANE_MIXXX_CONTROLLERS: empty } });
+  assert.deepEqual(Object.keys(r), ["skip"]);
+  assert.match(r.skip, /Mixxx's controller scripts not found: common-controller-scripts\.js, midi-components-0\.0\.js missing in /);
+  assert.match(controllersDir({ RANE_MIXXX_CONTROLLERS: join(empty, "nope") }).skip, /missing in .*nope$/);
+});
diff --git a/tests/mapping-mixer.test.mjs b/tests/mapping-mixer.test.mjs
new file mode 100644
index 0000000..fdbb107
--- /dev/null
+++ b/tests/mapping-mixer.test.mjs
@@ -0,0 +1,297 @@
+// Pitch fader, mixer, front-panel knobs, library encoders, FX depth and beat knobs, strip search and the Stop Time
+// and torque stores (M6-04), as the M6 plan's control table and D27/D32/D33/D34 give them. Every expectation is on
+// the fake Mixxx (tests/helpers/fake-mixxx.mjs), dispatching through mapping/Rane-One.midi.xml.
+//
+// These tests need Mixxx 2.5.6's controller scripts from the org.mixxx.Mixxx Flatpak (or RANE_MIXXX_CONTROLLERS);
+// when they are missing, each test is skipped with the reason.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import vm from "node:vm";
+import { controllersDir, loadMapping, readMapping, MAPPING_XML } from "./helpers/fake-mixxx.mjs";
+import { parseCsv } from "../tools/lib/census.mjs";
+
+const { skip } = controllersDir();
+const ROOT = new URL("..", import.meta.url).pathname;
+const CENSUS = join(ROOT, "captures/2026-10-23-census");
+const fmt = (x) => JSON.stringify(x);
+const cc = (ch, number, value) => [0xb0 | (ch - 1), number, value];
+
+const csv = parseCsv(readFileSync(join(ROOT, "reference/rane-one-mk1-controls.csv"), "utf8").split("\n").filter((l) => !l.startsWith("#")).join("\n"));
+const ROWS = csv.slice(1).map(([status, channel, number, name, , confidence]) => ({ status, ch: +channel, number: +number, name, confidence }));
+
+// The plan's Pots: every CC row the controls CSV names a mixer knob or fader, a front-panel knob, the crossfader or
+// the FX depth knob, by (channel, CC). The FX depth knob drives `mix` on both effect units (D32).
+const POTS = {
+  "1,22": [["[Channel1]", "pregain"]],
+  "1,23": [["[EqualizerRack1_[Channel1]_Effect1]", "parameter3"]],
+  "1,24": [["[EqualizerRack1_[Channel1]_Effect1]", "parameter2"]],
+  "1,25": [["[EqualizerRack1_[Channel1]_Effect1]", "parameter1"]],
+  "1,26": [["[QuickEffectRack1_[Channel1]]", "super1"]],
+  "1,28": [["[Channel1]", "volume"]],
+  "2,22": [["[Channel2]", "pregain"]],
+  "2,23": [["[EqualizerRack1_[Channel2]_Effect1]", "parameter3"]],
+  "2,24": [["[EqualizerRack1_[Channel2]_Effect1]", "parameter2"]],
+  "2,25": [["[EqualizerRack1_[Channel2]_Effect1]", "parameter1"]],
+  "2,26": [["[QuickEffectRack1_[Channel2]]", "super1"]],
+  "2,28": [["[Channel2]", "volume"]],
+  "15,35": [["[Master]", "headMix"]],
+  "15,36": [["[Master]", "headGain"]],
+  "16,4": [["[EffectRack1_EffectUnit1]", "mix"], ["[EffectRack1_EffectUnit2]", "mix"]],
+  "16,8": [["[Master]", "crossfader"]],
+};
+const POT_ROWS = ROWS.filter((r) => r.status === "B0" && /Mixer channel|Front panel knob|Crossfader|FX depth/.test(r.name));
+
+test("the controls CSV's mixer, front-panel, crossfader and FX depth CCs are the Pots this test expects", () => {
+  assert.deepEqual(POT_ROWS.map((r) => `${r.ch},${r.number}`).sort(), Object.keys(POTS).sort());
+});
+
+for (const r of POT_ROWS) {
+  const targets = POTS[`${r.ch},${r.number}`];
+  test(`ch ${r.ch} CC ${r.number} (${r.name}) is a soft-takeover Pot on ${targets.map((t) => t.join(",")).join(" and ")}`, { skip }, () => {
+    const h = loadMapping();
+    assert.deepEqual(h.takeovers.filter(([g, k]) => targets.some((t) => t[0] === g && t[1] === k)), [], "takeover before the first value");
+    for (const v of [0, 127, 64]) h.dispatch(cc(r.ch, r.number, v));
+    for (const [g, k] of targets) {
+      // Components' Pot maps 64 to exactly 0.5 (Component.inValueScale's centre rule).
+      assert.equal(fmt(h.params.filter(([pg, pk]) => pg === g && pk === k)), fmt([[g, k, 0], [g, k, 1], [g, k, 0.5]]));
+      assert.ok(h.takeovers.some((t) => fmt(t) === fmt([g, k, true])), `no engine.softTakeover(${g}, ${k}, true)`);
+    }
+    assert.deepEqual(h.unhandled, []);
+    assert.deepEqual(h.thrown, []);
+  });
+}
+
+// Pitch fader (D27): CC 9 is the MSB and CC 41 the LSB of one 14-bit value, CC 9 first (take 23). Direction: with
+// Mixxx's rate_dir 1, value 16383 (the motor's 1.5×, the fast end) is rate +1, 8192 (1×) is 0 and 0 (0.5×) is −1,
+// at the rateRange 0.5 init sets; rate = rate_dir × (motorRatioFromFader(v) − 1) / rateRange.
+const rates = (h, g = "[Channel1]") => h.sets.filter(([sg, k]) => sg === g && k === "rate").map(([, , v]) => v);
+const pair = (h, ch, v) => { h.dispatch(cc(ch, 9, v >> 7)); h.dispatch(cc(ch, 41, v & 127)); };
+
+test("take 23 reaches the pitch fader's bottom (0), centre (8192) and top (16383) as CC 9 then CC 41 pairs", () => {
+  const msgs = readFileSync(join(CENSUS, "23-pitch-d1.jsonl"), "utf8").split("\n").filter(Boolean).map((l) => JSON.parse(l)).filter((m) => m.type === "cc");
+  const seen = new Set();
+  for (let i = 1; i < msgs.length; i++) if (msgs[i].d1 === 41 && msgs[i - 1].d1 === 9) seen.add(msgs[i - 1].d2 * 128 + msgs[i].d2);
+  for (const v of [0, 8192, 16383]) assert.ok(seen.has(v), String(v));
+});
+
+// The One reports its faders only in the power-on dump (01: CC 28 = 0 on both channels), not when a port opens
+// (D27), so Mixxx's channel faders start at 0 (D35) and the first CC 28 applies at once (no takeover yet).
+test("init sets both channel faders' volume to 0 (D35), and the first CC 28 applies", { skip }, () => {
+  const h = loadMapping();
+  for (const [ch, g] of [[1, "[Channel1]"], [2, "[Channel2]"]]) {
+    assert.ok(h.sets.some((s) => fmt(s) === fmt([g, "volume", 0])), g);
+    h.dispatch(cc(ch, 28, 127));
+    assert.equal(fmt(h.params.filter(([pg, k]) => pg === g && k === "volume")), fmt([[g, "volume", 1]]));
+  }
+});
+
+test("a mixer or FX container that fails to build leaves the decks built and every deck input guarded", { skip }, () => {
+  const h = loadMapping();
+  vm.runInContext("RaneOne.Mixer = function() { throw new Error('mixer broken'); }; RaneOne.init('again', false);", h.ctx);
+  assert.equal(vm.runInContext("RaneOne.deck1.cue.unshifted.input.guarded === true && RaneOne.deck2.pitch.inputMSB.guarded === true", h.ctx), true);
+  assert.equal(vm.runInContext("typeof RaneOne.fx.beat.input.guarded", h.ctx), "boolean", "fx still built after the mixer failed");
+});
+
+test("init sets rateRange 0.5 on both decks and leaves rate alone until the fader moves (D27)", { skip }, () => {
+  const h = loadMapping();
+  for (const g of ["[Channel1]", "[Channel2]"]) {
+    assert.ok(h.sets.some((s) => fmt(s) === fmt([g, "rateRange", 0.5])), g);
+    assert.deepEqual(rates(h, g), []);
+  }
+});
+
+for (const [v, want] of [[0, -1], [8192, 0], [16383, 1]]) {
+  test(`pitch fader at ${v} sets [Channel1],rate ${want} and [Channel2],rate ${want} (rate_dir 1), ${-want} with rate_dir −1`, { skip }, () => {
+    const h = loadMapping();
+    pair(h, 1, v);
+    pair(h, 2, v);
+    assert.equal(rates(h, "[Channel1]").at(-1), want);
+    assert.equal(rates(h, "[Channel2]").at(-1), want);
+    h.setValue("[Channel1]", "rate_dir", -1);
+    pair(h, 1, v);
+    assert.equal(rates(h).at(-1), -want || 0);
+    assert.equal(h.takeovers.filter(([, k]) => k === "rate").length, 0, "the pitch fader has no soft takeover (D27)");
+    assert.deepEqual(h.thrown, []);
+  });
+}
+
+// The rate the fader's motor ratio gives at value v, rateRange 0.5 and rate_dir 1.
+const rateAt = (h, v) => (vm.runInContext(`RaneOnePlatter.motorRatioFromFader(${v})`, h.ctx) - 1) / 0.5;
+
+test("a lone CC 9 applies exactly (MSB << 7) + 64, within 64 steps (1/256 of the travel) of any LSB; its CC 41 then makes it exact", { skip }, () => {
+  const h = loadMapping();
+  for (const v of [0, 5000, 8192, 12345, 16383]) {
+    h.dispatch(cc(1, 9, v >> 7));
+    assert.ok(Math.abs(rates(h).at(-1) - rateAt(h, ((v >> 7) << 7) + 64)) < 1e-12, `${v}: lone ${rates(h).at(-1)}`);
+    h.dispatch(cc(1, 41, v & 127));
+    assert.ok(Math.abs(rates(h).at(-1) - rateAt(h, v)) < 1e-12, `${v}: full ${rates(h).at(-1)}`);
+  }
+});
+
+// In an MSB-first stream a CC 41 with no CC 9 seen yet is the tail of a pair whose MSB came before the port opened:
+// paired with the next MSB it would apply a value up to 127 steps off, so it is dropped (review M6-04).
+test("a CC 41 before any CC 9 is ignored; the next pair applies exactly", { skip }, () => {
+  const h = loadMapping();
+  h.dispatch(cc(1, 41, 0));
+  assert.deepEqual(rates(h), []);
+  h.dispatch(cc(1, 9, 127));
+  h.dispatch(cc(1, 41, 127));
+  assert.equal(fmt(rates(h)), fmt([rateAt(h, 16320), 1]));
+});
+
+test("the pitch fader follows the live rateRange, clamps to ±1, and logs once when rateRange is under 0.5", { skip }, () => {
+  const h = loadMapping();
+  h.setValue("[Channel1]", "rateRange", 1);
+  pair(h, 1, 16383);
+  assert.equal(rates(h).at(-1), 0.5);
+  h.setValue("[Channel1]", "rateRange", 0.25);
+  pair(h, 1, 16383);
+  assert.equal(rates(h).at(-1), 1);
+  pair(h, 1, 0);
+  assert.equal(rates(h).at(-1), -1);
+  assert.equal(h.logs.filter(([l, t]) => l === "warn" && /rateRange/.test(t)).length, 1, fmt(h.logs));
+  h.setValue("[Channel1]", "rateRange", 0);
+  const n = rates(h).length;
+  pair(h, 1, 16383);
+  assert.equal(rates(h).length, n, "no rate from a rateRange of 0");
+  assert.deepEqual(h.thrown, []);
+});
+
+test("replaying take 23 sweeps [Channel1],rate to −1 and +1 and ends on the take's last fader value", { skip }, () => {
+  const h = loadMapping();
+  const r = h.replay(join(CENSUS, "23-pitch-d1.jsonl"));
+  const rs = rates(h);
+  assert.equal(Math.min(...rs), -1);
+  assert.equal(Math.max(...rs), 1);
+  const msgs = readFileSync(join(CENSUS, "23-pitch-d1.jsonl"), "utf8").split("\n").filter(Boolean).map((l) => JSON.parse(l));
+  const msb = msgs.findLast((m) => m.type === "cc" && m.ch === 1 && m.d1 === 9).d2;
+  const lsb = msgs.findLast((m) => m.type === "cc" && m.ch === 1 && m.d1 === 41).d2;
+  const ratio = vm.runInContext(`RaneOnePlatter.motorRatioFromFader(${msb * 128 + lsb})`, h.ctx);
+  assert.ok(Math.abs(rs.at(-1) - (ratio - 1) / 0.5) < 1e-12);
+  assert.equal(r.thrown.length, 0, fmt(r.thrown[0]));
+  // The platter (CC 6 and the pitch bend) goes to its M7 placeholder (M6-06): nothing is unhandled.
+  assert.equal(r.unhandled.length, 0, fmt(r.unhandled.slice(0, 3)));
+});
+
+// Library encoders (D33): CC 0 on ch 1/2 moves [Library],MoveVertical by value − 64; with Shift (CC 1) by 10×.
+test("the library encoders move [Library],MoveVertical by ±1 per tick, ±10 with Shift (CC 1), on both decks", { skip }, () => {
+  const h = loadMapping();
+  for (const ch of [1, 2]) for (const n of [0, 1]) for (const v of [65, 63]) h.dispatch(cc(ch, n, v));
+  const moves = h.sets.filter(([g, k]) => g === "[Library]" && k === "MoveVertical").map(([, , v]) => v);
+  assert.equal(fmt(moves), fmt([1, -1, 10, -10, 1, -1, 10, -10]));
+  assert.deepEqual(h.unhandled, []);
+});
+
+// FX beat knob (D32): CC 3 ch 16 steps super1 of both units by ±1/32 per message, clamped to 0–1.
+test("the FX beat knob steps super1 of both effect units by ±1/32 per tick, clamped to 0..1", { skip }, () => {
+  const h = loadMapping();
+  const units = ["[EffectRack1_EffectUnit1]", "[EffectRack1_EffectUnit2]"];
+  for (const u of units) h.setValue(u, "super1", 0.5);
+  h.dispatch(cc(16, 3, 65));
+  for (const u of units) assert.equal(h.getValue(u, "super1"), 0.5 + 1 / 32);
+  h.dispatch(cc(16, 3, 63));
+  h.dispatch(cc(16, 3, 63));
+  for (const u of units) assert.equal(h.getValue(u, "super1"), 0.5 - 1 / 32);
+  for (let i = 0; i < 40; i++) h.dispatch(cc(16, 3, 65));
+  for (const u of units) assert.equal(h.getValue(u, "super1"), 1);
+  for (let i = 0; i < 40; i++) h.dispatch(cc(16, 3, 63));
+  for (const u of units) assert.equal(h.getValue(u, "super1"), 0);
+  assert.deepEqual(h.thrown, []);
+});
+
+// Headphone cue buttons (note 27 ch 1/2) report the One's state (census analysis § Census): set, not toggled.
+test("the headphone cue buttons set [ChannelN],pfl to the reported state (127 → 1, 0 or a note-off → 0)", { skip }, () => {
+  const h = loadMapping();
+  h.dispatch([0x90, 27, 127]);
+  h.dispatch([0x90, 27, 127]);
+  h.dispatch([0x81, 27, 0]);
+  h.dispatch([0x80, 27, 0]);
+  h.dispatch([0x91, 27, 127]);
+  h.dispatch([0x91, 27, 0]);
+  assert.equal(fmt(h.sets.filter(([, k]) => k === "pfl")), fmt([["[Channel1]", "pfl", 1], ["[Channel1]", "pfl", 1],
+    ["[Channel2]", "pfl", 0], ["[Channel1]", "pfl", 0], ["[Channel2]", "pfl", 1], ["[Channel2]", "pfl", 0]]));
+});
+
+// Strip search (D34): CC 43 MSB, CC 75 LSB (take 26), by the pitch fader's MSB-first rule, into playposition =
+// v / 16383, only while the deck is stopped or Shift is held.
+test("the strip sets playposition v / 16383 while the deck is stopped or Shift is held, and not while it plays", { skip }, () => {
+  const h = loadMapping();
+  const pos = (g) => h.sets.filter(([sg, k]) => sg === g && k === "playposition").map(([, , v]) => v);
+  h.dispatch(cc(1, 43, 64));
+  h.dispatch(cc(1, 75, 0));
+  assert.equal(pos("[Channel1]").at(-1), 8192 / 16383);
+  h.setValue("[Channel2]", "play", 1);
+  h.dispatch(cc(2, 43, 127));
+  h.dispatch(cc(2, 75, 127));
+  assert.deepEqual(pos("[Channel2]"), []);
+  h.dispatch([0x9f, 50, 127]);
+  h.dispatch(cc(2, 43, 0));
+  h.dispatch(cc(2, 75, 0));
+  h.dispatch([0x8f, 50, 0]);
+  assert.equal(pos("[Channel2]").at(-1), 0);
+  assert.deepEqual(h.thrown, []);
+});
+
+test("replaying take 26 moves both decks' playposition from near the start to near the end", { skip }, () => {
+  const h = loadMapping();
+  const r = h.replay(join(CENSUS, "26-strip.jsonl"));
+  for (const g of ["[Channel1]", "[Channel2]"]) {
+    const p = h.sets.filter(([sg, k]) => sg === g && k === "playposition").map(([, , v]) => v);
+    assert.ok(p.length > 1000, `${g}: ${p.length}`);
+    assert.ok(Math.min(...p) < 0.05 && Math.max(...p) > 0.95, `${g}: ${Math.min(...p)}..${Math.max(...p)}`);
+  }
+  assert.equal(r.thrown.length, 0);
+});
+
+// Stores (M7's inputs; no Mixxx control): Stop Time (CC 72 ch 1/2) and the torque switch (CC 96 ch 15).
+test("Stop Time and the torque switch are stored for M7 and counted, and change no Mixxx control", { skip }, () => {
+  const h = loadMapping();
+  const before = h.sets.length;
+  h.dispatch(cc(1, 72, 10));
+  h.dispatch(cc(2, 72, 99));
+  h.dispatch(cc(15, 96, 127));
+  assert.equal(h.sets.length, before);
+  assert.deepEqual(h.params, []);
+  assert.equal(vm.runInContext("RaneOne.deck1.stopTime", h.ctx), 10);
+  assert.equal(vm.runInContext("RaneOne.deck2.stopTime", h.ctx), 99);
+  assert.equal(vm.runInContext("RaneOne.mixer.torque", h.ctx), 127);
+  const c = vm.runInContext("RaneOne.counts", h.ctx);
+  assert.equal(fmt([c["B0 ch 1 72"], c["B0 ch 2 72"], c["B0 ch 15 96"]]), fmt([1, 1, 1]), "counted once each");
+});
+
+// Take 02 (the mixer census): every mixer row it moves records, each Pot sweeps its parameter from 0 to 1, and
+// nothing is unhandled (the FX paddles, FX1–6 state and Tap are M6-06's, tests/mapping-fx.test.mjs).
+test("replaying take 02 touches every mixer row and sweeps each Pot to 0 and to 1", { skip }, () => {
+  const h = loadMapping();
+  const r = h.replay(join(CENSUS, "02-census-mixer.jsonl"));
+  assert.ok(r.sent > 4000, String(r.sent));
+  assert.equal(r.thrown.length, 0, fmt(r.thrown[0]));
+  assert.equal(r.unhandled.length, 0, fmt(r.unhandled.slice(0, 3)));
+  for (const targets of Object.values(POTS)) {
+    for (const [g, k] of targets) {
+      const v = h.params.filter(([pg, pk]) => pg === g && pk === k).map(([, , x]) => x);
+      assert.ok(v.length > 10, `${g},${k}: ${v.length} sets`);
+      assert.equal(fmt([Math.min(...v), Math.max(...v)]), fmt([0, 1]), `${g},${k}`);
+      assert.ok(h.takeovers.some((t) => fmt(t) === fmt([g, k, true])), `${g},${k}: no soft takeover`);
+    }
+  }
+  for (const g of ["[Channel1]", "[Channel2]"]) assert.ok(h.sets.some(([sg, k]) => sg === g && k === "pfl"), `${g},pfl`);
+  for (const u of ["[EffectRack1_EffectUnit1]", "[EffectRack1_EffectUnit2]"]) assert.ok(h.sets.some(([g, k]) => g === u && k === "super1"), `${u},super1`);
+});
+
+test("the XML binds both bytes of each 14-bit pair, every Pot and every encoder, and has no duplicate (status, channel, number)", () => {
+  const { controls } = readMapping(MAPPING_XML);
+  const keys = new Map();
+  for (const c of controls) keys.set(`${c.status},${c.midino}`, [...(keys.get(`${c.status},${c.midino}`) ?? []), c.key]);
+  const dup = [...keys].filter(([, k]) => k.length > 1);
+  assert.equal(dup.length, 0, fmt(dup.slice(0, 3)));
+  const need = [...Object.keys(POTS).map((k) => k.split(",").map(Number)), ...[1, 2].flatMap((ch) => [0, 1, 9, 41, 43, 72, 75].map((n) => [ch, n])), [16, 3], [15, 96]];
+  const missing = need.filter(([ch, n]) => !keys.has(`${0xb0 | (ch - 1)},${n}`));
+  assert.deepEqual(missing, []);
+  for (const ch of [1, 2]) {
+    assert.equal(keys.get(`${0xb0 | (ch - 1)},9`)[0], `RaneOne.deck${ch}.pitch.inputMSB`);
+    assert.equal(keys.get(`${0xb0 | (ch - 1)},41`)[0], `RaneOne.deck${ch}.pitch.inputLSB`);
+  }
+});
diff --git a/tests/mapping-pads.test.mjs b/tests/mapping-pads.test.mjs
new file mode 100644
index 0000000..4afdf12
--- /dev/null
+++ b/tests/mapping-pads.test.mjs
@@ -0,0 +1,200 @@
+// Pads and pad modes (M6-05): the five mode notes on channels 5/6 (0, 13, 7, 11, 12; the same note with Shift) pick
+// what the eight pads do, per deck, Hot Cue at init (D30 *default*, the M6 plan's § Control table). Pad i is note
+// 19 + i, and 27 + i with Shift held (the One applies Shift itself: takes 27 and 28). Every expectation is on the
+// fake Mixxx (tests/helpers/fake-mixxx.mjs), dispatching through mapping/Rane-One.midi.xml.
+//
+// These tests need Mixxx 2.5.6's controller scripts from the org.mixxx.Mixxx Flatpak (or RANE_MIXXX_CONTROLLERS);
+// when they are missing, each test is skipped with the reason.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import vm from "node:vm";
+import { controllersDir, loadMapping } from "./helpers/fake-mixxx.mjs";
+
+const { skip } = controllersDir();
+const ROOT = new URL("..", import.meta.url).pathname;
+const CENSUS = join(ROOT, "captures/2026-10-23-census");
+const SHIFT_ON = [0x9f, 50, 127];
+const SHIFT_OFF = [0x8f, 50, 0];
+
+// D30, written out by hand so the test doesn't share the mapping's arithmetic: [group, key] for pad i (1–8).
+const ROLL = ["0.0625", "0.125", "0.25", "0.5", "1", "2", "4", "8"];
+const JUMP = [1, 2, 4, 8, 1, 2, 4, 8];
+const way = (i) => (i <= 4 ? "backward" : "forward");
+const MODES = {
+  0: { name: "Hot Cue", pad: (g, i) => [g, `hotcue_${i}_activate`], shift: (g, i) => [g, `hotcue_${i}_clear`] },
+  13: { name: "Saved Loop", pad: (g, i) => [g, `hotcue_${i + 8}_activate`], shift: (g, i) => [g, `hotcue_${i + 8}_clear`] },
+  7: { name: "Roll", pad: (g, i) => [g, `beatlooproll_${ROLL[i - 1]}_activate`], shift: (g, i) => [g, `beatloop_${ROLL[i - 1]}_toggle`] },
+  11: { name: "Sampler", pad: (g, i) => [`[Sampler${i}]`, "cue_gotoandplay"], shift: (g, i) => [`[Sampler${i}]`, "cue_gotoandstop"] },
+  12: { name: "Beat Jump", pad: (g, i) => [g, `beatjump_${JUMP[i - 1]}_${way(i)}`], shift: (g, i) => [g, `beatjump_${JUMP[i - 1] * 4}_${way(i)}`] },
+};
+
+const fmt = (sets) => JSON.stringify(sets);
+const pulse = ([g, k]) => [[g, k, 1], [g, k, 0]];
+const fresh = () => {
+  const h = loadMapping();
+  h.setValue("[App]", "num_samplers", 16);
+  h.sets.length = 0; // init's rateRange (D27) and volume (D35) writes are tested in mapping-mixer.test.mjs
+  return h;
+};
+// Presses and releases one note on channel ch, Shift held around it when asked; returns the sets it recorded.
+const press = (h, ch, note, { shift = false } = {}) => {
+  if (shift) h.dispatch(SHIFT_ON);
+  const from = h.sets.length;
+  h.dispatch([0x90 | (ch - 1), note, 127]);
+  h.dispatch([0x80 | (ch - 1), note, 0]);
+  const sets = h.sets.slice(from);
+  if (shift) h.dispatch(SHIFT_OFF);
+  return sets;
+};
+const counts = (h) => vm.runInContext("RaneOne.counts", h.ctx);
+
+for (const deck of [1, 2]) {
+  const ch = deck + 4;
+  const g = `[Channel${deck}]`;
+  for (const [mode, m] of Object.entries(MODES)) {
+    test(`deck ${deck}: mode note ${mode} (${m.name}), then pads 1–8 (notes 20–27) and with Shift (notes 28–35)`, { skip }, () => {
+      const h = fresh();
+      assert.equal(fmt(press(h, ch, +mode)), "[]", "a mode note sets no Mixxx control");
+      for (let i = 1; i <= 8; i++) {
+        const slip = +mode === 7 ? [[g, "slip_enabled", 0]] : []; // a roll gives back the Slip before it (review, below)
+        assert.equal(fmt(press(h, ch, 19 + i)), fmt([...pulse(m.pad(g, i)), ...slip]), `pad ${i}`);
+        assert.equal(fmt(press(h, ch, 27 + i, { shift: true })), fmt(pulse(m.shift(g, i))), `Shift+pad ${i}`);
+      }
+      assert.deepEqual(h.thrown, []);
+      assert.deepEqual(h.unhandled, []);
+    });
+  }
+}
+
+test("Hot Cue is the mode at init, on both decks", { skip }, () => {
+  const h = fresh();
+  assert.equal(fmt(press(h, 5, 22)), fmt(pulse(["[Channel1]", "hotcue_3_activate"])));
+  assert.equal(fmt(press(h, 6, 35, { shift: true })), fmt(pulse(["[Channel2]", "hotcue_8_clear"])));
+});
+
+test("pad mode is per deck: Roll on deck 1 leaves deck 2 in Hot Cue", { skip }, () => {
+  const h = fresh();
+  press(h, 5, 7);
+  assert.equal(fmt(press(h, 5, 20)), fmt([...pulse(["[Channel1]", "beatlooproll_0.0625_activate"]), ["[Channel1]", "slip_enabled", 0]]));
+  assert.equal(fmt(press(h, 6, 20)), fmt(pulse(["[Channel2]", "hotcue_1_activate"])));
+});
+
+test("a mode note pressed with Shift held selects the same mode (take 04 presses them so)", { skip }, () => {
+  const h = fresh();
+  press(h, 6, 12, { shift: true });
+  assert.equal(fmt(press(h, 6, 25)), fmt(pulse(["[Channel2]", "beatjump_2_forward"])));
+  press(h, 6, 0, { shift: true });
+  assert.equal(fmt(press(h, 6, 25)), fmt(pulse(["[Channel2]", "hotcue_6_activate"])));
+});
+
+test("a held pad is released on what it pressed, even after a mode change", { skip }, () => {
+  const h = fresh();
+  press(h, 5, 7);
+  h.dispatch([0x94, 24, 127]); // roll 1 beat, held
+  press(h, 5, 0);
+  h.dispatch([0x84, 24, 0]);
+  assert.equal(fmt(h.sets), fmt([...pulse(["[Channel1]", "beatlooproll_1_activate"]), ["[Channel1]", "slip_enabled", 0]]));
+});
+
+test("a Shift+pad press released on the plain note (Shift let go first) ends that press; a lone release does nothing", { skip }, () => {
+  const h = fresh();
+  press(h, 5, 7);
+  h.dispatch(SHIFT_ON);
+  h.dispatch([0x94, 29, 127]); // Shift+pad 2: beatloop_0.125_toggle
+  h.dispatch(SHIFT_OFF);
+  h.dispatch([0x84, 21, 0]);
+  h.dispatch([0x84, 21, 0]);
+  h.dispatch([0x84, 30, 0]);
+  assert.equal(fmt(h.sets), fmt(pulse(["[Channel1]", "beatloop_0.125_toggle"])));
+});
+
+test("a second pad note while one is held releases the first before pressing the second", { skip }, () => {
+  const h = fresh();
+  h.dispatch([0x95, 21, 127]);
+  h.dispatch([0x95, 29, 127]); // the same pad's Shift note before any release (not seen in a take)
+  h.dispatch([0x85, 29, 0]);
+  assert.equal(fmt(h.sets), fmt([...pulse(["[Channel2]", "hotcue_2_activate"]), ...pulse(["[Channel2]", "hotcue_2_clear"])]));
+});
+
+test("a sampler pad past [App],num_samplers is a counted no-op, not a set", { skip }, () => {
+  const h = fresh();
+  h.setValue("[App]", "num_samplers", 4);
+  press(h, 5, 11);
+  assert.equal(fmt(press(h, 5, 23)), fmt(pulse(["[Sampler4]", "cue_gotoandplay"])));
+  assert.equal(fmt(press(h, 5, 24)), "[]");
+  assert.equal(fmt(press(h, 5, 32, { shift: true })), "[]");
+  const c = counts(h);
+  assert.equal(c["90 ch 5 24"], 1, JSON.stringify(c));
+  assert.equal(c["90 ch 5 32"], 1, JSON.stringify(c));
+  assert.deepEqual(h.thrown, []);
+});
+
+test("shutdown releases a held pad, so a hot reload can't leave a roll on", { skip }, () => {
+  const h = fresh();
+  press(h, 6, 7);
+  h.dispatch([0x95, 27, 127]);
+  h.sets.length = 0;
+  h.shutdown();
+  assert.equal(fmt(h.sets), fmt([["[Channel2]", "beatlooproll_8_activate", 0], ["[Channel2]", "slip_enabled", 0]]));
+});
+
+test("an engine that throws inside a pad handler doesn't reach Mixxx, and the next press works", { skip }, () => {
+  const h = fresh();
+  h.failNext("setValue");
+  h.dispatch([0x94, 20, 127]);
+  assert.deepEqual(h.thrown, []);
+  assert.deepEqual(h.logs.filter(([l]) => l === "warn").map(([, t]) => t.replace(/ failed: .*/, "")), ["RaneOne: deck1.pads.pad1.input"]);
+  h.dispatch([0x84, 20, 0]);
+  assert.equal(fmt(press(h, 5, 20)), fmt(pulse(["[Channel1]", "hotcue_1_activate"])));
+});
+
+test("every pad and mode note has a <control> for its note-on and note-off, keyed by pad (one input per pad)", { skip }, () => {
+  const h = loadMapping();
+  const byNote = new Map(h.controls.map((c) => [`${c.status},${c.midino}`, c.key]));
+  const missing = [];
+  for (const deck of [1, 2]) {
+    for (const s of [0x90, 0x80].map((x) => x | (deck + 3))) {
+      for (const n of [0, 7, 11, 12, 13]) if (byNote.get(`${s},${n}`) !== `RaneOne.deck${deck}.padMode.input`) missing.push(`0x${s.toString(16)} ${n}`);
+      for (let i = 1; i <= 8; i++) {
+        for (const n of [19 + i, 27 + i]) if (byNote.get(`${s},${n}`) !== `RaneOne.deck${deck}.pads.pad${i}.input`) missing.push(`0x${s.toString(16)} ${n}`);
+      }
+    }
+  }
+  assert.deepEqual(missing, []);
+});
+
+// Takes 04/06 (pads in each mode, mode notes with and without Shift) and 27/28 (Shift+pads in each mode): nothing
+// throws, nothing on channels 5/6 is unhandled, and every pad press records a set (Sampler included: 16 samplers).
+for (const take of ["04-census-d1-pads", "06-census-d2-pads", "27-census-d1-pads-shift", "28-census-d2-pads-shift"]) {
+  test(`replaying ${take} handles every pad and mode note without a thrown handler`, { skip }, () => {
+    const h = fresh();
+    const file = join(CENSUS, `${take}.jsonl`);
+    const r = h.replay(file);
+    assert.ok(r.sent >= 80, String(r.sent));
+    const padPresses = readFileSync(file, "utf8").split("\n").filter(Boolean).map((l) => JSON.parse(l))
+      .filter((m) => m.type === "on" && (m.ch === 5 || m.ch === 6) && m.d1 >= 20 && m.d1 <= 35).length;
+    assert.equal(r.thrown.length, 0, JSON.stringify(r.thrown[0]));
+    assert.deepEqual(r.unhandled.filter((u) => u.ch === 5 || u.ch === 6).slice(0, 5), []);
+    const pads = r.sets.filter(([, k]) => k !== "slip_enabled"); // a roll's Slip write-back
+    const presses = pads.filter(([, , v]) => v === 1).length;
+    const releases = pads.filter(([, , v]) => v === 0).length;
+    assert.equal(presses, releases, "every press released");
+    assert.ok(padPresses >= 32, String(padPresses));
+    assert.equal(presses, padPresses, "one set per pad press");
+  });
+}
+
+// Review (M6-05): Mixxx 2.5.6's LoopingControl sets slip_enabled 1 when a roll starts and 0 when the last roll ends,
+// whatever it was, so after the roll's 0 the pad writes back the Slip the deck had before (as Shift+Reverse does).
+// The fake has no LoopingControl: the test checks the writes and their order.
+test("a Roll pad gives back the Slip the deck had before it", { skip }, () => {
+  const h = fresh();
+  press(h, 5, 7);
+  h.setValue("[Channel1]", "slip_enabled", 1);
+  assert.equal(fmt(press(h, 5, 21)), fmt([...pulse(["[Channel1]", "beatlooproll_0.125_activate"]), ["[Channel1]", "slip_enabled", 1]]));
+  h.setValue("[Channel1]", "slip_enabled", 0);
+  assert.equal(fmt(press(h, 5, 21)), fmt([...pulse(["[Channel1]", "beatlooproll_0.125_activate"]), ["[Channel1]", "slip_enabled", 0]]));
+  assert.equal(fmt(press(h, 5, 29, { shift: true })), fmt(pulse(["[Channel1]", "beatloop_0.125_toggle"])), "a beatloop doesn't touch Slip");
+});
