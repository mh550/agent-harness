+// Feeds the same inputs to two machines, the second mirrored (ratio, expectedRatio, playRatio and ticks negated):
+// the motor turning backwards, as with deck 1's reverse pad on in census 15 and 17. Returns both result lists.
+function mirrorPair(config, inputs) {
+  const fwd = P.createStateMachine(config);
+  const rev = P.createStateMachine(config);
+  const neg = (x) => (x === undefined ? undefined : x === 0 ? 0 : -x);
+  const a = [], b = [];
+  for (const u of inputs) {
+    a.push(plain(fwd.update(u)));
+    b.push(plain(rev.update({ ...u, ratio: neg(u.ratio), expectedRatio: neg(u.expectedRatio),
+      playRatio: neg(u.playRatio), ticks: neg(u.ticks) })));
+  }
+  assert.equal(rev.stats().malformed, fwd.stats().malformed, "malformed counts");
+  return { a, b, fwd, rev };
+}
