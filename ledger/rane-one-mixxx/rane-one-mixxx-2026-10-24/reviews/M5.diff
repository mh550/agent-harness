--- /dev/null
+++ b/tools/lib/fader-sweeps.mjs
@@ -0,0 +1,261 @@
+// One deck's pitch fader against its platter (M5-06, docs/plans/2026-10-24-M5-truth.md, question B6): tools/fader-sweeps
+// is its CLI. The fader is a 14-bit pair on the deck's channel, CC 9 (MSB) then CC 41 (LSB), adjacent and almost
+// always in the same µs (captures/2026-10-23-census/23-pitch-d1.jsonl and 24-pitch-d2.jsonl: 4,476 and 4,150 pairs, CC 9
+// always first; 9 and 11 of them have the LSB 20-190 µs later), so a value is taken on each CC 41 with the last CC 9. From that and the deck's CC 6/pitch bend pairs:
+//   holds         every stretch where the fader stood still for minHoldMs or more: its value, the core's
+//                 motorRatioFromFader there (`expected`), the platter's device-timed ratio from settleMs after the
+//                 fader stopped to the next fader message (`device`; the timed deltas of tools/lib/platter-format.mjs),
+//                 and the 1-Euro estimator over the same stretch (`est`: the mean of every update, and the lowest and
+//                 highest mean of its windowMs windows); `sweep` counts the Range presses before it, from 1
+//   rangePresses  note 43 on the deck's channel (census M5-03), with how long each was held
+//   others        every message that is not a platter pair on channel 1 or 2 or the deck's CC 9/41
+//   lag           the motor behind the fader: the delay d (0-200 ms in 5 ms steps) for which centre ×
+//                 motorRatioFromFader(fader at t - d) best fits the device ratio of 10 ms windows (least squares;
+//                 centre = the device ratio over the centre holds; the windows are scored whether Play is on or
+//                 not, which suits takes with the motor on throughout, as 23 and 24 are), the same fit on every
+//                 estimator update (`estBestMs`: what the state machine compares), how far the windows are off that fit at that
+//                 delay by eighths of the fader (`bins`: the mean of window / fit - 1), and the take's steepest 100 ms fader sections
+//                 (up to 6, at least 3 s apart): how long the fader's ratio and the platter's (10 ms device windows,
+//                 2 ms steps) took to cover 90 % of the section's change, and the difference
+// Pure: nothing here opens a port.
+import { runCore } from "./platter-run.mjs";
+import { platterSamples, BACKLOG_US, GAP_MAX_US, TIMER_HZ, MINUS_2 } from "./platter-format.mjs";
+import { deckChannels, PLAY_NOTE } from "./deck.mjs";
+
+export const FADER_MSB = 9;
+export const FADER_LSB = 41;
+export const RANGE_NOTE = 43;
+const CENTRE = 8192;
+const NOMINAL = (3600 * 100) / (3 * 60); // ticks/s at ratio 1: the core's TICKS_PER_REV at 33 1/3 rpm
+
+// The deck's 14-bit fader values: [{ t_us, value }], one per CC 41 that has a CC 9 before it.
+export function faderValues(recs, { ch }) {
+  const out = [];
+  let msb = null;
+  for (const r of recs) {
+    if (r.ch !== ch || r.type !== "cc") continue;
+    if (r.d1 === FADER_MSB) msb = r.d2;
+    else if (r.d1 === FADER_LSB && msb !== null) out.push({ t_us: r.t_us, value: (msb << 7) | r.d2 });
+  }
+  return out;
+}
+
+// values: faderValues(). → [{ fromUs (the message that set it), toUs (the next one, or endUs), value }] for each
+// value that stood for minHoldUs or more.
+export function faderHolds(values, { minHoldUs, endUs }) {
+  const out = [];
+  values.forEach((v, i) => {
+    const toUs = i + 1 < values.length ? values[i + 1].t_us : endUs;
+    if (toUs - v.t_us >= minHoldUs) out.push({ fromUs: v.t_us, toUs, value: v.value });
+  });
+  return out;
+}
+
+// A timed delta as in platter-format.mjs, but a delta that moved no tick still counts: its time passed.
+const timed = (s) => s.u !== null && s.u > 0 && s.u < MINUS_2 && s.gapUs <= GAP_MAX_US && s.t_us >= BACKLOG_US;
+
+// The device-timed ratio of samples (platterSamples(), time order) with fromUs <= t_us < toUs, or null if none is
+// timed. `start` is an index to search from (the caller's cursor for rising windows).
+function deviceRatio(samples, fromUs, toUs, start = 0) {
+  let i = start;
+  while (i < samples.length && samples[i].t_us < fromUs) i++;
+  const first = i;
+  let ticks = 0, u = 0;
+  for (; i < samples.length && samples[i].t_us < toUs; i++) {
+    if (timed(samples[i])) {
+      ticks += samples[i].dTicks;
+      u += samples[i].u;
+    }
+  }
+  return { ratio: u > 0 ? ticks / (u / TIMER_HZ) / NOMINAL : null, first };
+}
+
+// The last fader value set at or before t (CENTRE before the first message: every take starts at the centre, the
+// power-on dump reports 8192 on both decks, census 01).
+function valueAt(values) {
+  let i = 0;
+  return (t) => {
+    if (i > 0 && values[i - 1].t_us > t) i = 0;
+    while (i < values.length && values[i].t_us <= t) i++;
+    return i === 0 ? CENTRE : values[i - 1].value;
+  };
+}
+
+// The expectedRatio an untouched platter should turn at, for tools/platter-run --expected fader[:<ms>] and runCore's
+// opts.expected: off (0) at the start, toggled by each press of the deck's note 0 (Play, census 15-34), and while on,
+// the core's motorRatioFromFader of the fader value delayMs ago (the centre before the first fader message). →
+// [{ t_us, e }] with strictly rising t_us, the first at 0.
+export function faderExpected(P, recs, { deck = 1, delayMs = 0, config } = {}) {
+  const { ch } = deckChannels(deck);
+  const events = [];
+  for (const r of recs) {
+    if (r.ch === ch && r.type === "on" && r.d1 === PLAY_NOTE && r.d2 > 0) events.push({ t_us: r.t_us, press: true });
+  }
+  for (const v of faderValues(recs, { ch })) events.push({ t_us: v.t_us + 1000 * delayMs, value: v.value });
+  events.sort((a, b) => a.t_us - b.t_us); // stable: at one time a press comes before a fader value
+  const out = [{ t_us: 0, e: 0 }];
+  let on = false, value = CENTRE;
+  for (const ev of events) {
+    if (ev.press) on = !on;
+    else value = ev.value;
+    const e = on ? P.motorRatioFromFader(value, config) : 0;
+    const last = out[out.length - 1];
+    if (ev.t_us === last.t_us) last.e = e;
+    else if (e !== last.e) out.push({ t_us: ev.t_us, e });
+  }
+  return out;
+}
+
+// recs: M2 records, t_us non-decreasing. opts: { deck (1|2, default 1), minHoldMs (400), settleMs (300), windowMs
+// (200), config (passed to the core: estimator, state machine, motorRatioFromFader) }.
+export function faderSweeps(P, recs, opts = {}) {
+  const deck = opts.deck ?? 1;
+  const { ch } = deckChannels(deck);
+  const minHoldUs = 1000 * (opts.minHoldMs ?? 400);
+  const settleUs = 1000 * (opts.settleMs ?? 300);
+  const windowUs = 1000 * (opts.windowMs ?? 200);
+  const config = opts.config;
+  const ratioOf = (v) => P.motorRatioFromFader(v, config);
+  const endUs = recs.length > 0 ? recs[recs.length - 1].t_us : 0;
+  const values = faderValues(recs, { ch });
+  const samples = platterSamples(recs, { ch });
+  const run = runCore(P, recs, { deck, estimator: config, stateMachine: config });
+
+  const isPlatter = (r) => (r.ch === 1 || r.ch === 2) && (r.type === "pb" || (r.type === "cc" && r.d1 === 6));
+  const isFader = (r) => r.ch === ch && r.type === "cc" && (r.d1 === FADER_MSB || r.d1 === FADER_LSB);
+  const others = recs.filter((r) => !isPlatter(r) && !isFader(r))
+    .map((r) => ({ t_us: r.t_us, type: r.type, ch: r.ch, d1: r.d1, d2: r.d2 }));
+  const rangePresses = [];
+  for (const r of recs) {
+    if (r.ch !== ch || r.d1 !== RANGE_NOTE) continue;
+    if (r.type === "on" && r.d2 > 0) rangePresses.push({ t_us: r.t_us, ms: null });
+    else if ((r.type === "off" || r.type === "on") && rangePresses.length > 0 && rangePresses.at(-1).ms === null) {
+      rangePresses.at(-1).ms = (r.t_us - rangePresses.at(-1).t_us) / 1000;
+    }
+  }
+
+  let ui = 0;
+  const holds = faderHolds(values, { minHoldUs, endUs }).map((h) => {
+    const a = h.fromUs + settleUs;
+    const updates = [];
+    while (ui < run.updates.length && run.updates[ui].t < a) ui++;
+    for (let j = ui; j < run.updates.length && run.updates[j].t < h.toUs; j++) updates.push(run.updates[j]);
+    let windowMin = null, windowMax = null;
+    for (let w = a; w + windowUs <= h.toUs; w += windowUs) {
+      const inW = updates.filter((x) => x.t >= w && x.t < w + windowUs);
+      if (inW.length === 0) continue;
+      const m = inW.reduce((s, x) => s + x.ratio, 0) / inW.length;
+      windowMin = windowMin === null ? m : Math.min(windowMin, m);
+      windowMax = windowMax === null ? m : Math.max(windowMax, m);
+    }
+    return {
+      sweep: 1 + rangePresses.filter((p) => p.t_us < h.fromUs).length,
+      value: h.value, fromUs: h.fromUs, toUs: h.toUs, expected: ratioOf(h.value),
+      device: a < h.toUs ? deviceRatio(samples, a, h.toUs).ratio : null,
+      est: updates.length === 0 ? null : {
+        mean: updates.reduce((s, x) => s + x.ratio, 0) / updates.length, windowMin, windowMax,
+      },
+    };
+  });
+
+  return { deck, ch, faderMessages: values.length, holds, rangePresses, others,
+    lag: lag(samples, values, holds, ratioOf, run.updates) };
+}
+
+function lag(samples, values, holds, ratioOf, updates) {
+  const centreHolds = holds.filter((h) => h.value === CENTRE && h.device !== null);
+  if (values.length === 0 || centreHolds.length === 0) {
+    return { centre: null, bestMs: null, rmsAtBest: null, grid: [], bins: [], estBestMs: null, estRmsAtBest: null, steep: [] };
+  }
+  // The centre speed: the centre holds' device ratios weighted by their length.
+  const span = (h) => h.toUs - h.fromUs;
+  const centre = centreHolds.reduce((s, h) => s + h.device * span(h), 0) / centreHolds.reduce((s, h) => s + span(h), 0);
+  const want = (v) => centre * ratioOf(v);
+
+  const STEP = 10000;
+  const wins = [];
+  let cursor = 0;
+  for (let a = values[0].t_us - 1e6; a < values[values.length - 1].t_us + 1e6; a += STEP) {
+    const d = deviceRatio(samples, a, a + STEP, cursor);
+    cursor = d.first;
+    if (d.ratio !== null) wins.push({ t: a + STEP / 2, r: d.ratio });
+  }
+  const grid = [];
+  for (let ms = 0; ms <= 200; ms += 5) {
+    const at = valueAt(values);
+    let e = 0;
+    for (const w of wins) e += (w.r - want(at(w.t - 1000 * ms))) ** 2;
+    grid.push({ ms, rms: wins.length > 0 ? Math.sqrt(e / wins.length) : null });
+  }
+  const best = grid.reduce((b, g) => (g.rms !== null && (b === null || g.rms < b.rms) ? g : b), null);
+  // The same fit on what the state machine sees: every estimator update (heartbeats included) over the same span.
+  const ests = updates.filter((x) => x.t >= values[0].t_us - 1e6 && x.t < values[values.length - 1].t_us + 1e6);
+  let estBest = null;
+  for (let ms = 0; ms <= 200; ms += 5) {
+    const at = valueAt(values);
+    let e = 0;
+    for (const x of ests) e += (x.ratio - want(at(x.t - 1000 * ms))) ** 2;
+    const rms = ests.length > 0 ? Math.sqrt(e / ests.length) : null;
+    if (rms !== null && (estBest === null || rms < estBest.rms)) estBest = { ms, rms };
+  }
+  // At the best delay, how far the windows are off the fit, by the fader's eighth: 0-2047, 2048-4095, … 14336-16383.
+  const bins = Array.from({ length: 8 }, (_, i) => ({ from: 2048 * i, to: 2048 * i + 2047, windows: 0, off: null }));
+  if (best !== null) {
+    const at = valueAt(values);
+    const sums = new Array(8).fill(0);
+    for (const w of wins) {
+      const v = at(w.t - 1000 * best.ms);
+      const i = Math.min(7, Math.floor(v / 2048));
+      bins[i].windows++;
+      sums[i] += w.r / want(v) - 1;
+    }
+    bins.forEach((b, i) => {
+      if (b.windows > 0) b.off = sums[i] / b.windows;
+    });
+  }
+
+  // Steepest sections: from the instant of message k (the value before it) to the last message within 100 ms.
+  const sections = [];
+  for (let k = 0; k < values.length; k++) {
+    let j = k;
+    while (j + 1 < values.length && values[j + 1].t_us - values[k].t_us <= 100000) j++;
+    const from = k > 0 ? values[k - 1].value : CENTRE;
+    sections.push({ fromUs: values[k].t_us, toUs: values[j].t_us, from, to: values[j].value, k, j,
+      change: want(values[j].value) - want(from) });
+  }
+  sections.sort((x, y) => Math.abs(y.change) - Math.abs(x.change));
+  const picked = [];
+  for (const s of sections) {
+    if (s.change === 0) break;
+    if (picked.every((p) => Math.abs(p.fromUs - s.fromUs) > 3e6)) picked.push(s);
+    if (picked.length === 6) break;
+  }
+  const steep = picked.sort((x, y) => x.fromUs - y.fromUs).map((s) => {
+    const r0 = want(s.from), target = r0 + 0.9 * s.change;
+    const past = (r) => (r - target) * Math.sign(s.change) >= 0;
+    let faderUs = null;
+    for (let i = s.k; i <= s.j; i++) {
+      if (past(want(values[i].value))) {
+        faderUs = values[i].t_us;
+        break;
+      }
+    }
+    let platterUs = null, c = 0;
+    for (let t = s.fromUs; t < s.fromUs + 600000; t += 2000) {
+      const d = deviceRatio(samples, t - STEP / 2, t + STEP / 2, c);
+      c = d.first;
+      if (d.ratio !== null && past(d.ratio)) {
+        platterUs = t;
+        break;
+      }
+    }
+    return {
+      fromUs: s.fromUs, toUs: s.toUs, from: s.from, to: s.to, ratioFrom: r0, ratioTo: want(s.to),
+      faderMs: (faderUs - s.fromUs) / 1000,
+      platterMs: platterUs === null ? null : (platterUs - s.fromUs) / 1000,
