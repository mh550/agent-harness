+
+// M5-04: the census hand takes (captures/2026-10-23-census/, docs/research/2026-10-24-census-analysis.md § Platter
+// format). Deck N's platter is CC 6 + pitch bend on channel N. The net ticks are tools/analyze-platter's over the
+// whole take (09: +36,008; 13 --deck 2: +35,987), so the decoder agrees with the tool the document quotes.
+const CENSUS = new URL("../captures/2026-10-23-census/", import.meta.url).pathname;
+function decodeTake(name, deck) {
+  const records = readJsonl(CENSUS + name);
+  const dec = P.createDecoder({ ccStatus: 0xb0 | (deck - 1), pbStatus: 0xe0 | (deck - 1) });
+  let last = null;
+  for (const r of records) {
+    const b = Buffer.from(r.bytes, "hex");
+    last = dec.feed(b[0], b[1], b[2], r.t_us) ?? last;
+  }
+  last = dec.flush(records.at(-1).t_us + 1_000_000) ?? last;
+  return { ticks: last?.ticks ?? 0, stats: plain(dec.stats()) };
+}
+
+test("census take 09 (deck 1, ten turns) decodes with 0 timer unwrap errors and net ticks +36,008, the tool's", () => {
+  const { ticks, stats } = decodeTake("09-hand-d1-ten.jsonl", 1);
+  assert.equal(stats.timerErrors, 0);
+  assert.equal(ticks, 36008, "the feature allows ±8; the decoder matches exactly, start backlog (+14) included");
+  assert.equal(stats.samples, 12783);
+});
+
+test("census take 13 (deck 2 on channel 2, ten turns) decodes with 0 timer unwrap errors and net ticks +35,987, the tool's", () => {
+  const { ticks, stats } = decodeTake("13-hand-d2-ten.jsonl", 2);
+  assert.equal(stats.timerErrors, 0);
+  assert.equal(ticks, 35987);
+  assert.equal(stats.samples, 13160);
+  assert.equal(decodeTake("13-hand-d2-ten.jsonl", 1).stats.samples, 0, "deck 1's channel holds none of it");
+});
+
+test("census take 12 (deck 2, slow turns) decodes with 0 timer unwrap errors", () => {
+  const { ticks, stats } = decodeTake("12-hand-d2-slow.jsonl", 2);
+  assert.equal(stats.timerErrors, 0);
+  assert.equal(stats.samples, 6631);
+  assert.equal(ticks, -4, "one turn forward and back to the mark: tools/analyze-platter --deck 2 nets -4");
+});
+
+// M5-07 (§ Platter format, "Exception"): a -1 on a backward pass through CC 0 at speed, ~1 ms after the message
+// before it, whose timed neighbour puts it far under the limit, is a mis-timed message, not saturation: census 08 at
+// 4.284 s, 15 at 5.207 and 37.989 s. The decoder tells it by the previous timed delta alone (causal): its per-tick
+// interval × this message's ticks under MARKER_GLITCH_FRACTION (0.25) of TIMER_MARKER_MIN, within half the
+// timestamp's span (2.9 ms) of host time. Its sample is `untrusted`, so the estimator keeps the timed ratio.
+function backwardRun(dec, { n = 6, perMsg = 2823, gapUs = 1000 } = {}) {
+  // n pairs 2 ticks apart going backward through CC 0, perMsg counts and gapUs of host time apart, from t = 0.
+  let cc = 2 * n, pb = 1000, t = 0, s = null;
+  for (let i = 0; i < n; i++, cc -= 2, pb += perMsg, t += gapUs) s = pair(dec, cc & 0x7f, pb & 0x3fff, t);
+  return { cc: cc + 2, pb: pb - perMsg, t: t - gapUs, last: s };
+}
+
+test("M5-07: a -1 ~1 ms after a fast timed delta is a mis-timed message: untrusted, counted apart, not a marker", () => {
+  const dec = P.createDecoder();
+  const r = backwardRun(dec);
+  assert.equal(r.last.untrusted, undefined, "the run itself is timed");
+  const glitch = pair(dec, (r.cc - 2) & 0x7f, (r.pb - 1) & 0x3fff, r.t + 1000);
+  assert.equal(glitch.untrusted, true, "untrusted, so the estimator holds the timed ratio");
+  assert.equal(typeof glitch.timer, "number", "a timer is still given");
+  const s = dec.stats();
+  assert.equal(s.glitchMarkers, 1);
+  assert.equal(s.markers, 0);
+  assert.equal(s.untrustedTimers, 0, "untrustedTimers stays the host-gap and wrap count");
+  const after = pair(dec, (r.cc - 4) & 0x7f, (r.pb - 1 + 2824) & 0x3fff, r.t + 2000);
+  assert.equal(after.untrusted, undefined, "the next delta is timed again");
+  assert.equal(after.timer - glitch.timer, 2824);
+});
+
+test("M5-07: a -1 stays a saturation marker after a host gap of 2.9 ms or more, a slow delta, or a marker", () => {
+  const cases = [
+    ["host gap 3 ms", (dec, r) => pair(dec, (r.cc - 2) & 0x7f, (r.pb - 1) & 0x3fff, r.t + 3000)],
+    ["2 ticks after 2,100 counts per tick (0.26 of the limit)", (dec) => {
+      const r = backwardRun(dec, { perMsg: 4200 });
+      return pair(dec, (r.cc - 2) & 0x7f, (r.pb - 1) & 0x3fff, r.t + 1000);
+    }],
+    ["after another -1", (dec, r) => {
+      pair(dec, (r.cc - 2) & 0x7f, (r.pb - 1) & 0x3fff, r.t + 6000);
+      return pair(dec, (r.cc - 4) & 0x7f, (r.pb - 2) & 0x3fff, r.t + 7000);
+    }],
+  ];
+  for (const [name, step] of cases) {
+    const dec = P.createDecoder();
+    const r = backwardRun(dec);
+    const s = step(dec, r);
+    assert.equal(s.untrusted, undefined, name);
+    assert.equal(dec.stats().glitchMarkers, 0, name);
+    assert.ok(dec.stats().markers >= 1, name);
+  }
+});
+
+test("M5-07: MARKER_GLITCH_FRACTION 0 turns the rule off; an invalid value falls back to 0.25", () => {
+  assert.equal(P.DEFAULTS.MARKER_GLITCH_FRACTION, 0.25);
+  for (const [config, glitches] of [[{ MARKER_GLITCH_FRACTION: 0 }, 0], [{ MARKER_GLITCH_FRACTION: -1 }, 1],
+    [{ MARKER_GLITCH_FRACTION: "x" }, 1], [{ MARKER_GLITCH_FRACTION: 1.5 }, 1]]) {
+    const dec = P.createDecoder(config);
+    const r = backwardRun(dec);
+    pair(dec, (r.cc - 2) & 0x7f, (r.pb - 1) & 0x3fff, r.t + 1000);
+    assert.equal(dec.stats().glitchMarkers, glitches, JSON.stringify(config));
+  }
+});
+
+test("M5-07: census 08 has 1 mis-timed -1 and 15 has 2 (the three of § Platter format); every other platter take 0", () => {
+  const counts = {};
+  for (const [take, deck] of [
+    ["07-hand-d1-slow", 1], ["08-hand-d1-fast", 1], ["09-hand-d1-ten", 1], ["10-hand-d1-touch", 1], ["11-hand-d1-alt", 1],
+    ["15-motor-d1-33", 1], ["17-motor-d1-hold", 1], ["18-motor-d1-backspin", 1], ["19-motor-d1-stop-min", 1],
+    ["20-motor-d1-stop-max", 1], ["23-pitch-d1", 1], ["25-motor-toggle", 1], ["12-hand-d2-slow", 2],
+    ["13-hand-d2-ten", 2], ["14-hand-d2-touch", 2], ["21-motor-d2-33", 2], ["24-pitch-d2", 2], ["29-hand-d2-fast", 2],
+    ["30-hand-d2-alt", 2], ["31-motor-d2-hold", 2], ["32-motor-d2-backspin", 2], ["33-motor-d2-stop-min", 2],
+    ["34-motor-d2-stop-max", 2],
+  ]) {
+    const n = decodeTake(`${take}.jsonl`, deck).stats.glitchMarkers;
+    if (n !== 0) counts[take] = n;
+  }
+  assert.deepEqual(counts, { "08-hand-d1-fast": 1, "15-motor-d1-33": 2 });
+});
+
+// M5-08: WRAP_JUMP (M4-08 review #1) on the census. The decoder keeps the largest shrink of the per-tick device
+// interval from one timed delta to the next (maxShrink) and the largest after a host gap of 2.9 ms or more, the
+// only ones the wrap check judges (maxGapShrink), each with its host time.
+const PLATTER_TAKES = [
+  ["07-hand-d1-slow", 1], ["08-hand-d1-fast", 1], ["09-hand-d1-ten", 1], ["10-hand-d1-touch", 1], ["11-hand-d1-alt", 1],
+  ["15-motor-d1-33", 1], ["17-motor-d1-hold", 1], ["18-motor-d1-backspin", 1], ["19-motor-d1-stop-min", 1],
+  ["20-motor-d1-stop-max", 1], ["23-pitch-d1", 1], ["25-motor-toggle", 1], ["26-strip", 1], ["12-hand-d2-slow", 2],
+  ["13-hand-d2-ten", 2], ["14-hand-d2-touch", 2], ["21-motor-d2-33", 2], ["24-pitch-d2", 2], ["29-hand-d2-fast", 2],
+  ["30-hand-d2-alt", 2], ["31-motor-d2-hold", 2], ["32-motor-d2-backspin", 2], ["33-motor-d2-stop-min", 2],
+  ["34-motor-d2-stop-max", 2],
+];
+const shrinkOf = (take, deck, fromUs = 0) => {
+  const records = readJsonl(`${CENSUS}${take}.jsonl`).filter((r) => r.t_us >= fromUs);
+  const dec = P.createDecoder({ ccStatus: 0xb0 | (deck - 1), pbStatus: 0xe0 | (deck - 1) });
+  for (const r of records) {
+    const b = Buffer.from(r.bytes, "hex");
+    dec.feed(b[0], b[1], b[2], r.t_us);
+  }
+  const stats = plain(dec.stats());
+  return { ...stats, at: stats.maxShrinkUs / 1e6, gapAt: stats.maxGapShrinkUs / 1e6 };
+};
+
+test("M5-08: the fast takes 08 and 29 shrink the per-tick interval under WRAP_JUMP after every gap, with 0 unwrap errors", () => {
+  const W = P.DEFAULTS.WRAP_JUMP;
+  for (const [take, deck] of [["08-hand-d1-fast", 1], ["29-hand-d2-fast", 2]]) {
+    const s = shrinkOf(take, deck);
+    assert.equal(s.timerErrors, 0, take);
+    assert.equal(s.untrustedTimers, 0, `${take}: the wrap check never fired`);
+    assert.ok(s.maxGapShrink > 1 && s.maxGapShrink < W, `${take}: ${s.maxGapShrink} after a gap`);
+  }
+  // Under 2.9 ms apart a fast scratch shrinks it further: 29's 2.63x at 1.359 s is the census's largest.
+  const s29 = shrinkOf("29-hand-d2-fast", 2);
+  assert.equal(s29.maxShrink.toFixed(2), "2.63");
+  assert.equal(s29.at.toFixed(3), "1.359");
+});
+
+test("M5-08: over every platter take the largest shrink after a gap is 1.48x (32 at 3.387 s), under WRAP_JUMP 1.8", () => {
+  let best = null, backlog = null;
+  for (const [take, deck] of PLATTER_TAKES) {
+    const s = shrinkOf(take, deck);
+    if (best === null || s.maxGapShrink > best.s.maxGapShrink) best = { take, s };
+    // Outside the start backlog (the first ms, messages sent before the port opened: 17 reads 21.44x there),
+    // 29's fast scratch is the largest shrink of all, and 31's release from the hold (2.44x at 9.235 s) the next.
+    const out = shrinkOf(take, deck, 1000);
+    if (take !== "29-hand-d2-fast") assert.ok(out.maxShrink < 2.45, `${take}: ${out.maxShrink} at ${out.at} s`);
+    if (s.maxShrink > out.maxShrink) assert.ok(s.at < 0.0015, `${take}: the larger shrink is in the backlog`);
+    if (backlog === null || s.maxShrink > backlog.s.maxShrink) backlog = { take, s };
+  }
+  assert.equal(best.take, "32-motor-d2-backspin");
+  assert.equal(best.s.maxGapShrink.toFixed(2), "1.48");
+  assert.equal(best.s.gapAt.toFixed(3), "3.387");
+  assert.equal(backlog.take, "17-motor-d1-hold");
+  assert.equal(backlog.s.maxShrink.toFixed(2), "21.44");
+  assert.equal(shrinkOf("29-hand-d2-fast", 2, 1000).maxShrink.toFixed(2), "2.63");
+});
