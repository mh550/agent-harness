@@ -0,0 +1,142 @@
+// One deck of a capture cut into fixed host-time windows: tools/platter-windows is its CLI (M5-05,
+// docs/plans/2026-10-24-M5-truth.md, Tool changes). The capture goes through the whole core the way tools/platter-run
+// runs it (tools/lib/platter-run.mjs: decoder, speed estimator, state machine, a heartbeat every 20 ms), and the raw
+// CC 6/pitch bend pairs are read beside it (tools/lib/platter-format.mjs). Per window:
+//   samples      CC 6/pitch bend pairs whose pitch bend falls in the window
+//   netTicks     the platter's position at the window's end minus at its start (the last pair before each)
+//   hostRatio    netTicks over the window's host seconds, as a ratio of the nominal ticks/s (what the estimator's
+//                HOST_WINDOW_MS path reads over a window of the same length)
+//   deviceRatio  the ticks of the window's timed deltas over their device time (sum of unsigned timer deltas /
+//                TIMER_HZ), as a ratio; a timed delta is one under the -2 marker, after a host gap of at most 20 ms
+//                (TIMER_GAP_MAX_US), outside the start backlog. Markers' unknown time is left out, so with markers
+//                in a window it reads high: they are counted beside it
+//   raw          min and max of the per-message device ratio (dTicks over that one delta's device time) of the
+//                window's timed deltas that moved
+//   est          min, mean and max of the estimator's ratio over every update in the window (heartbeats included:
+//                what the state machine sees)
+//   timedShare   the share of the window's samples (not heartbeats) the estimator timed by the device
+//   markers      samples whose timer delta is -1 or -2 (16383/16382)
+//   state        the state machine's state at the window's last update
+// Ratios are signed: a platter turning backward reads negative. Pure: nothing here opens a port.
+import { runCore } from "./platter-run.mjs";
+import { platterSamples, BACKLOG_US, GAP_MAX_US, TIMER_HZ, MINUS_2 } from "./platter-format.mjs";
+import { deckChannels } from "./deck.mjs";
+
+// The core's DEFAULTS.TICKS_PER_REV (census 09, 13, 15, 21) at 33 1/3 rpm.
+const NOMINAL = (3600 * 100) / (3 * 60);
+
+// "0.1,-0.5,.99" → [0.1, -0.5, 0.99], or null if any part is not a plain signed decimal.
+export function parseThresholds(s) {
+  const out = [];
+  for (const part of s.split(",")) {
+    if (!/^-?(\d+(\.\d*)?|\.\d+)$/.test(part)) return null;
+    out.push(Number(part));
+  }
+  return out;
+}
+
+// updates: [{ t, ratio }] in time order (t in µs). For each threshold, the first update in [fromUs, toUs) whose
+// ratio is on the other side of the threshold than the first update at or after fromUs (at or above vs below), so
+// the same call times a rise through it and a fall through it: [{ threshold, t_us, ms (after fromUs) }], t_us and
+// ms null if it never crosses.
+export function crossings(updates, thresholds, fromUs, toUs = Infinity) {
+  const after = updates.filter((u) => u.t >= fromUs && u.t < toUs);
+  return thresholds.map((threshold) => {
+    if (after.length === 0) return { threshold, t_us: null, ms: null };
+    const above = after[0].ratio >= threshold;
+    const hit = after.find((u) => (u.ratio >= threshold) !== above);
+    return hit === undefined ? { threshold, t_us: null, ms: null }
+      : { threshold, t_us: hit.t, ms: (hit.t - fromUs) / 1000 };
+  });
+}
+
+const timedDelta = (s, markerMin) => s.u !== null && s.u > 0 && s.u < markerMin && s.gapUs <= GAP_MAX_US &&
+  s.t_us >= BACKLOG_US;
+
+function summarize(samples, updates, fromUs, toUs, posBefore, nominal) {
+  const seconds = (toUs - fromUs) / 1e6;
+  let n = 0, ticks = 0, u = 0, markers = 0, rawMin = Infinity, rawMax = -Infinity, pos = posBefore;
+  for (const s of samples) {
+    n++;
+    pos = s.pos;
+    if (s.u !== null && s.u >= MINUS_2) markers++;
+    if (!timedDelta(s, MINUS_2)) continue;
+    ticks += s.dTicks;
+    u += s.u;
+    if (s.dTicks !== 0) {
+      const r = s.dTicks / (s.u / TIMER_HZ) / nominal;
+      rawMin = Math.min(rawMin, r);
+      rawMax = Math.max(rawMax, r);
+    }
+  }
+  const netTicks = posBefore === null ? 0 : pos - posBefore;
+  let est = null, real = 0, timed = 0;
+  if (updates.length > 0) {
+    let min = Infinity, max = -Infinity, sum = 0;
+    for (const x of updates) {
+      min = Math.min(min, x.ratio);
+      max = Math.max(max, x.ratio);
+      sum += x.ratio;
+      if (!x.heartbeat) {
+        real++;
+        if (x.timed) timed++;
+      }
+    }
+    est = { min, mean: sum / updates.length, max };
+  }
+  return {
+    fromUs, toUs, samples: n, netTicks,
+    hostRatio: seconds > 0 ? netTicks / seconds / nominal : null,
+    deviceRatio: u > 0 ? ticks / (u / TIMER_HZ) / nominal : null,
+    raw: rawMin <= rawMax ? { min: rawMin, max: rawMax } : null,
+    est, timedShare: real > 0 ? timed / real : null, markers,
+    state: updates.length > 0 ? updates[updates.length - 1].state : null,
+  };
+}
+
+// recs: M2 records, t_us non-decreasing. opts: { deck (1|2, default 1), windowMs (default 200), fromUs, toUs (the
+// span [fromUs, toUs); default the capture's first message to its last), cross: thresholds for crossings() in the span,
+// config: passed to the estimator and state machine }.
+// → { deck, nominal (ticks/s at ratio 1), windowMs, span (one summary over the whole span), windows, crossings,
+//   presses (the deck's note 0 presses, from runCore), decoderStats }.
+export function platterWindows(P, recs, opts = {}) {
+  const deck = opts.deck ?? 1;
+  const windowUs = 1000 * (opts.windowMs ?? 200);
+  const { ch } = deckChannels(deck);
+  const run = runCore(P, recs, { deck, estimator: opts.config, stateMachine: opts.config });
+  const samples = platterSamples(recs, { ch });
+  const first = recs.length > 0 ? recs[0].t_us : 0;
+  const last = recs.length > 0 ? recs[recs.length - 1].t_us : 0;
+  const fromUs = opts.fromUs ?? first;
+  const toUs = Math.max(fromUs, Math.min(opts.toUs ?? last, last));
+
+  // samples[i] / updates[j] in [a, b), and the position of the last sample before a (null if none)
+  let si = 0, ui = 0;
+  const take = (a, b) => {
+    while (si < samples.length && samples[si].t_us < a) si++;
+    while (ui < run.updates.length && run.updates[ui].t < a) ui++;
+    const before = si > 0 ? samples[si - 1].pos : null;
+    const s0 = si, u0 = ui;
+    let s1 = s0, u1 = u0;
+    while (s1 < samples.length && samples[s1].t_us < b) s1++;
+    while (u1 < run.updates.length && run.updates[u1].t < b) u1++;
+    const ss = samples.slice(s0, s1);
+    return { ss, us: run.updates.slice(u0, u1), before: before ?? (ss.length > 0 ? ss[0].pos : null) };
+  };
+  const windows = [];
+  for (let a = fromUs; a < toUs; a += windowUs) {
+    const b = Math.min(a + windowUs, toUs);
+    const { ss, us, before } = take(a, b);
+    windows.push(summarize(ss, us, a, b, before, NOMINAL));
+  }
+  si = 0;
+  ui = 0;
+  const all = take(fromUs, toUs);
+  const span = summarize(all.ss, all.us, fromUs, toUs, all.before, NOMINAL);
+  return {
+    deck, nominal: NOMINAL, windowMs: windowUs / 1000, span, windows,
+    crossings: crossings(run.updates, opts.cross ?? [], fromUs, toUs),
+    presses: run.presses.map((p) => ({ t_us: p.t_us, ms: p.ms, ch: p.ch })),
+    decoderStats: run.decoderStats,
+  };
+}
