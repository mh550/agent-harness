+// A motor whose per-tick device interval carries a once-per-revolution pattern of `period` ticks (an eccentric
+// encoder disc would do this), 2 ticks per message, ~1 ms per message, `revs` revolutions. `noise` adds per-tick
+// jitter of that fraction (a pseudo-random sequence from `seed`, so runs repeat); `ramp` slows it by that fraction over
+// the take (speed drift, which the detrend must take out).
+function motor(period, revs, { dir = 1, perTick = 1411, noise = 0, ramp = 0, seed = 12345 } = {}) {
+  const steps = [];
+  const ticks = Math.round(period * revs);
+  let frac = 0;
+  const rand = () => { // mulberry32: 32-bit integer steps, so the sequence is exact and has no short cycles
+    seed = (seed + 0x6d2b79f5) | 0;
+    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296 - 0.5;
+  };
+  for (let k = 0; k < ticks; k += 2) {
+    let u = 0;
+    for (const j of [k, k + 1]) {
+      const ph = (2 * Math.PI * j) / period;
+      u += perTick * (1 + (ramp * j) / ticks) * (1 + 0.004 * Math.sin(ph) + 0.002 * Math.sin(3 * ph + 1) + noise * rand());
+    }
+    frac += u;
+    const whole = Math.round(frac);
+    frac -= whole;
+    steps.push([Math.round(whole / 2.8224), 2 * dir, whole]);
+  }
+  return platterSamples(take(steps), { ch: 1 });
+}
+
+test("revolutionPeriod finds a 3600-tick pattern at 3600 and a 3598-tick one at 3598, from a trial of 3600", () => {
+  const a = revolutionPeriod(motor(3600, 30), { trial: 3600 });
+  assert.ok(Math.abs(a.period - 3600) < 0.2, JSON.stringify(a));
+  assert.ok(a.corr > 0.9, JSON.stringify(a));
+  assert.ok(Math.abs(a.revs - 15) < 0.5, JSON.stringify(a));
+  const b = revolutionPeriod(motor(3598, 30), { trial: 3600 });
+  assert.ok(Math.abs(b.period - 3598) < 0.2, JSON.stringify(b));
+  const c = revolutionPeriod(motor(3600, 30), { trial: 3598 });
+  assert.ok(Math.abs(c.period - 3600) < 0.2, JSON.stringify(c));
+});
+
+// Jitter makes a random error, not a pull toward the trial: one noise sequence gives the same error from any trial
+// (so trial independence on a real take says nothing about precision; sub-windows do, see the analysis document).
+test("revolutionPeriod under jitter and a 3 % speed ramp: unbiased over 8 noise sequences, from either trial", () => {
+  for (const [truth, trial] of [[3600, 3598], [3598, 3600]]) {
+    const errs = [1, 2, 3, 4, 5, 6, 7, 8].map((seed) =>
+      revolutionPeriod(motor(truth, 30, { noise: 0.03, ramp: 0.03, seed }), { trial }).period - truth);
+    const mean = errs.reduce((a, b) => a + b) / errs.length;
+    assert.ok(Math.abs(mean) < 0.5, `${truth} from ${trial}: mean error ${mean}, ${errs}`);
+    assert.ok(errs.every((e) => Math.abs(e) < 2.5), `${truth} from ${trial}: ${errs}`);
+  }
+  const ramp = revolutionPeriod(motor(3600, 30, { ramp: 0.03 }), { trial: 3598 });
+  assert.ok(Math.abs(ramp.period - 3600) < 0.3, JSON.stringify(ramp));
+});
+
+test("revolutionPeriod reads a backward motor too (take 15 runs backward)", () => {
+  const r = revolutionPeriod(motor(3600, 30, { dir: -1 }), { trial: 3600 });
+  assert.ok(Math.abs(r.period - 3600) < 0.2, JSON.stringify(r));
+});
+
+test("revolutionPeriod says why it found nothing: under 4 revolutions of timed ticks, or a shift past the search", () => {
+  assert.deepEqual(revolutionPeriod(motor(3600, 3), { trial: 3600 }), { period: null, reason: "short" });
+  assert.deepEqual(revolutionPeriod([], { trial: 3600 }), { period: null, reason: "short" });
+  assert.deepEqual(revolutionPeriod(motor(3600, 30), { trial: 3560 }), { period: null, reason: "shift" },
+    "40 ticks/rev off: 600 ticks over 15 revs");
+});
