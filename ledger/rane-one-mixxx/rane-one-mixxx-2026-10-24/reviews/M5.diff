+// docs/research/2026-10-24-census-analysis.md § Pitch fader and Range).
+// Exit: 0 run · 1 unreadable file or a line that breaks the M2 format · 2 usage
+// Spec: docs/plans/2026-10-24-M5-truth.md, question B6; the analysis is tools/lib/fader-sweeps.mjs.
+import { readJsonl } from "./lib/jsonl.mjs";
+import { loadPlatter } from "./lib/load-platter.mjs";
+import { faderSweeps, FADER_MSB, FADER_LSB, RANGE_NOTE } from "./lib/fader-sweeps.mjs";
+import { parseDeck, deckHelp } from "./lib/deck.mjs";
+
+const USAGE = "usage: tools/fader-sweeps <capture.jsonl> [--deck 1|2] [--json]";
+const HELP = `${USAGE}
+Reads the deck's 14-bit pitch fader (CC ${FADER_MSB} MSB, CC ${FADER_LSB} LSB on the deck's channel; a value on each CC ${FADER_LSB}) beside its
+platter (CC 6 + pitch bend) and prints:
+  holds   each stretch of 400 ms or more where the fader stood still: sweep (1 + the Range presses before it), the
+          value, the core's motorRatioFromFader there, the platter's device-timed ratio from 300 ms after the fader
+          stopped (and how far it is off), and the 1-Euro estimator's mean and its lowest and highest 200 ms window
+  range   note ${RANGE_NOTE} presses on the deck's channel and every other message that is not a platter pair or the fader
+  lag     the delay (0-200 ms, 5 ms steps) at which the centre speed × motorRatioFromFader(the fader then) best fits
+          the platter's 10 ms device-timed windows (and the estimator's updates), how far the windows are off that fit by eighth of the fader, and
+          the steepest 100 ms fader sections: how long the fader's ratio
+          and the platter took to cover 90 % of the change
+${deckHelp(10)}
+  --json  print one JSON object
+Ratios are over 33 1/3 rpm at 3600 ticks/rev (2000 ticks/s). Nothing is sent anywhere.
+Exit: 0 run · 1 unreadable file or a line that breaks the M2 format · 2 usage
+`;
+
+function usage(why) {
+  if (why) process.stderr.write(`fader-sweeps: ${why}\n`);
+  process.stderr.write(USAGE + "\n");
+  process.exit(2);
+}
+
+const args = process.argv.slice(2);
+if (args.length === 1 && args[0] === "--help") {
+  process.stdout.write(HELP);
+  process.exit(0);
+}
+let file = null, deck = 1, json = false;
+const seen = new Set();
+for (let i = 0; i < args.length; i++) {
+  const a = args[i];
+  if (!a.startsWith("-") || a === "-") {
+    if (a === "-") usage("reading stdin is not supported");
+    if (file !== null) usage(`unexpected argument ${a}`);
+    file = a;
+    continue;
+  }
+  if (seen.has(a)) usage(`${a} given twice`);
+  seen.add(a);
+  if (a === "--json") {
+    json = true;
+    continue;
+  }
+  const v = args[++i];
+  if (v === undefined) usage(`${a} needs a value`);
+  if (a === "--deck") {
+    deck = parseDeck(v);
+    if (deck === null) usage(`bad --deck ${v}`);
+  } else usage(`unknown option ${a}`);
+}
+if (file === null) usage();
+
+let recs;
+try {
+  recs = readJsonl(file);
+} catch (err) {
+  process.stderr.write(`fader-sweeps: ${err.code ? `${file}: ${err.message}` : err.message}\n`);
+  process.exit(1);
+}
+const r = faderSweeps(loadPlatter(), recs, { deck });
+
+// No process.exit after a write: a pipe would get only the first 64 KiB.
+if (json) process.stdout.write(JSON.stringify({ file, ...r }) + "\n");
+else process.stdout.write(text(r).join("\n") + "\n");
+
+function text(r) {
+  const sec = (t) => (t / 1e6).toFixed(3);
+  const num = (x, d) => (x === null || x === undefined ? "-" : x.toFixed(d));
+  const pct = (x) => (x === null ? "-" : `${x >= 0 ? "+" : "-"}${Math.abs(100 * x).toFixed(2)} %`);
+  const out = [`${file}: deck ${r.deck}, fader CC ${FADER_MSB}/${FADER_LSB} on ch ${r.ch}: ${r.faderMessages} values, ` +
+    `${r.holds.length} holds of 400 ms or more`];
+  out.push("sweep    from s      to s  value  function   device       off   est mean  200 ms min     max");
+  for (const h of r.holds) {
+    out.push([String(h.sweep).padStart(5), sec(h.fromUs).padStart(9), sec(h.toUs).padStart(9), String(h.value).padStart(6),
+      num(h.expected, 5).padStart(9), num(h.device, 5).padStart(8),
+      pct(h.device === null ? null : h.device / h.expected - 1).padStart(9),
+      num(h.est?.mean, 5).padStart(10), num(h.est?.windowMin, 5).padStart(11), num(h.est?.windowMax, 5).padStart(8)].join(" "));
+  }
+  for (const p of r.rangePresses) {
+    out.push(`range: note ${RANGE_NOTE} ch ${r.ch} at ${sec(p.t_us)} s (${p.ms === null ? "no release" : `${p.ms.toFixed(1)} ms`})`);
+  }
+  const kinds = new Map();
+  for (const m of r.others) {
+    const k = `${m.type} ch ${m.ch} ${m.d1}`;
+    kinds.set(k, [...(kinds.get(k) ?? []), sec(m.t_us)]);
+  }
+  out.push(`other messages: ${r.others.length}${kinds.size === 0 ? "" : ":"}`);
+  for (const [k, ts] of kinds) out.push(`  ${k} ×${ts.length}: ${ts.slice(0, 8).join(", ")}${ts.length > 8 ? ", …" : ""} s`);
+  const l = r.lag;
+  if (l.bestMs === null) {
+    out.push("lag: no centre hold to scale by");
+  } else {
+    out.push(`lag: centre speed ${num(l.centre, 5)}; best fit ${l.bestMs} ms behind the fader (rms ${num(l.rmsAtBest, 5)}; ` +
+      `0 ms ${num(l.grid[0].rms, 5)}, 50 ms ${num(l.grid[10].rms, 5)}, 100 ms ${num(l.grid[20].rms, 5)}); ` +
+      `on the estimator's updates ${l.estBestMs} ms (rms ${num(l.estRmsAtBest, 5)})`);
+    out.push(`  off the fit at ${l.bestMs} ms, by fader eighth (10 ms windows): ` + l.bins.map((b) =>
+      `${b.from}-${b.to} ${pct(b.off)} (${b.windows})`).join(", "));
+    for (const s of l.steep) {
+      out.push(`  steep ${sec(s.fromUs)}-${sec(s.toUs)} s: fader ${s.from} -> ${s.to} (ratio ${num(s.ratioFrom, 4)} -> ` +
+        `${num(s.ratioTo, 4)}): 90 % after ${num(s.faderMs, 0)} ms by the fader, ` +
+        `${s.platterMs === null ? "not within 600 ms" : `${num(s.platterMs, 0)} ms`} by the platter (lag ${num(s.lagMs, 0)} ms)`);
+    }
+  }
+  return out;
+}
