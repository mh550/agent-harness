diff --git a/tools/lib/platter-format.mjs b/tools/lib/platter-format.mjs
new file mode 100644
index 0000000..4382f0f
--- /dev/null
+++ b/tools/lib/platter-format.mjs
@@ -0,0 +1,167 @@
+// The platter-format checks of M5-04 (docs/research/2026-10-24-census-analysis.md § Platter format), used by
+// tools/analyze-platter --markers and --period:
+// - the start backlog: what the One held while no one read its port, delivered within the take's first ms
+//   (captures/2026-10-23-census/09-hand-d1-ten.jsonl: 182 messages at t < 1 ms, then nothing until 3.73 s);
+// - the saturation check (spec §5 M5 check 2): is an unsigned timestamp delta of 16383 (-1) "16,383 counts (5.8 ms)
+//   or more since the last message"? Counted: -1 and -2, the deltas in 16,304-16,381, every -1 whose two timed
+//   neighbours' per-tick intervals put it under 5.8 ms, and every -1 after a host gap under 5.8 ms;
+// - the revolution period: the per-tick device interval carries a pattern that repeats once per revolution, so
+//   the shift of that pattern between a take's two halves gives the ticks per revolution without a mark.
+// Pure functions over M2 records; nothing here opens a port.
+import { TIMER_MOD } from "./platter-analysis.mjs";
+
+export const BACKLOG_US = 1000;
+export const TIMER_HZ = 2822400; // the core's DEFAULTS.TIMER_HZ (captures/2026-10-19-quick/platter.jsonl)
+export const MINUS_1 = TIMER_MOD - 1;
+export const MINUS_2 = TIMER_MOD - 2;
+export const BAND_LO = TIMER_MOD - 80; // 16,304: the quick capture's largest real delta
+export const LIMIT_US = (MINUS_1 / TIMER_HZ) * 1e6; // 5,804.6 µs
+export const GAP_MAX_US = 20000; // the core's TIMER_GAP_MAX_US: a delta after a longer host gap isn't timed
+// Between two consecutive timed deltas the per-tick device interval changed at most 3.53x in the census (take 29 at
+// 1.362 s; 1.40x in the quick capture, the core's WRAP_JUMP note), so a -1 whose neighbours read under 1/4 of the
+// limit can't be 5.8 ms or more. Between 1/4 and 1 a -1 is consistent with saturation without proving it.
+export const SHRINK = 4;
+
+const tickDelta = (a, b) => ((((b - a + 64) % 128) + 128) % 128) - 64;
+
+// recs: M2 records. Deck `ch`'s CC `cc` paired with the pitch bend after it, one sample per pair:
+// {t_us (the pitch bend's), cc (the CC value), pos (ticks since the first pair), dTicks, u (unsigned timer delta),
+// gapUs (host time since the previous pair)}; dTicks, u and gapUs are null on the first.
+export function platterSamples(recs, { ch, cc = 6 }) {
+  const out = [];
+  let pending = null, lastCc = null, lastPb = null, lastT = null, pos = 0;
+  for (const r of recs) {
+    if (r.ch !== ch) continue;
+    if (r.type === "cc" && r.d1 === cc) {
+      pending = r.value;
+    } else if (r.type === "pb" && pending !== null) {
+      const first = lastCc === null;
+      const dTicks = first ? null : tickDelta(lastCc, pending);
+      if (!first) pos += dTicks;
+      out.push({
+        t_us: r.t_us, cc: pending, pos, dTicks,
+        u: first ? null : (((r.value - lastPb) % TIMER_MOD) + TIMER_MOD) % TIMER_MOD,
+        gapUs: first ? null : r.t_us - lastT,
+      });
+      lastCc = pending;
+      lastPb = r.value;
+      lastT = r.t_us;
+      pending = null;
+    }
+  }
+  return out;
+}
+
+// The messages of the take's first BACKLOG_US (any type) and deck `ch`'s net CC `cc` ticks among them.
+export function startBacklog(recs, { ch, cc = 6 }) {
+  let messages = 0, netTicks = 0, lastCc = null;
+  for (const r of recs) {
+    if (r.t_us >= BACKLOG_US) break;
+    messages++;
+    if (r.ch === ch && r.type === "cc" && r.d1 === cc) {
+      if (lastCc !== null) netTicks += tickDelta(lastCc, r.value);
+      lastCc = r.value;
+    }
+  }
+  return { messages, netTicks };
+}
+
+const timed = (s) => s !== undefined && s.u !== null && s.u > 0 && s.u < MINUS_2 && s.dTicks !== 0 &&
+  s.gapUs <= GAP_MAX_US && s.t_us >= BACKLOG_US;
+
+// samples: platterSamples(); only those with fromUs <= t_us < toUs are checked (their neighbours may lie outside).
+// → {minus1, minus2, backlogMarkers (-1s in the start backlog), band: [{t_us, u, before, after}],
+//    timedNeighbours (-1s with a timed sample on each side), under: [{t_us, estimate, before, after, dTicks, wrap}]
+//    (estimate = the neighbours' mean per-tick interval × the -1's ticks, over 16,383; listed below 1/SHRINK;
+//    wrap: "backward" or "forward" if the -1's ticks passed through CC 0, else null), estimates: every timed-neighbour
+//    -1's estimate, passes: {backward, forward, backwardMinus1, forwardMinus1} (samples whose ticks pass through CC 0
+//    with a timed sample on each side, and how many of them are -1),
+//    hostShort: [{t_us, gapUs}] (-1s outside the backlog whose host gap is under LIMIT_US)}.
+export function markerCheck(samples, { fromUs = -Infinity, toUs = Infinity } = {}) {
+  const r = { minus1: 0, minus2: 0, backlogMarkers: 0, band: [], timedNeighbours: 0, estimates: [], under: [], hostShort: [],
+    passes: { backward: 0, forward: 0, backwardMinus1: 0, forwardMinus1: 0 } };
+  samples.forEach((s, i) => {
+    if (s.u === null || s.t_us < fromUs || s.t_us >= toUs) return;
+    const prev = samples[i - 1], next = samples[i + 1];
+    const wrap = s.dTicks < 0 && s.cc > prev.cc ? "backward" : s.dTicks > 0 && s.cc < prev.cc ? "forward" : null;
+    if (wrap && s.t_us >= BACKLOG_US && timed(prev) && timed(next)) {
+      r.passes[wrap]++;
+      if (s.u === MINUS_1) r.passes[`${wrap}Minus1`]++;
+    }
+    if (s.u >= BAND_LO && s.u < MINUS_2) {
+      r.band.push({ t_us: s.t_us, u: s.u, before: prev?.u ?? null, after: next?.u ?? null });
+    }
+    if (s.u === MINUS_2) r.minus2++;
+    if (s.u !== MINUS_1) return;
+    r.minus1++;
+    if (s.t_us < BACKLOG_US) {
+      r.backlogMarkers++;
+      return;
+    }
+    if (s.gapUs < LIMIT_US) r.hostShort.push({ t_us: s.t_us, gapUs: s.gapUs });
+    if (!timed(prev) || !timed(next)) return;
+    r.timedNeighbours++;
+    const perTick = (prev.u / Math.abs(prev.dTicks) + next.u / Math.abs(next.dTicks)) / 2;
+    const estimate = (perTick * Math.max(1, Math.abs(s.dTicks))) / MINUS_1;
+    r.estimates.push(estimate);
+    if (estimate < 1 / SHRINK) {
+      r.under.push({ t_us: s.t_us, estimate, before: prev.u, after: next.u, dTicks: s.dTicks, wrap });
+    }
+  });
+  return r;
+}
+
+// samples: platterSamples() of a steady spin (a motor take). trial: ticks per revolution to fold at. The per-tick
+// interval of every timed sample, divided by its running mean over ±detrend samples (speed drift out), is averaged
+// per tick position mod trial for each half of the samples, smoothed over ±smooth ticks; the shift (in ticks)
+// that best lines the second half's profile up with the first's, over the revolutions between the halves' centres,
+// is how far `trial` is from the true period. → {period, shift, revs, corr (normalised, at the best shift),
+// points}, or {period: null, reason: "short"} with under 4 revolutions of timed samples, or {period: null, reason:
+// "shift"} if the best shift is at ±maxShift (outside the search).
+export function revolutionPeriod(samples, { trial = 3600, smooth = 30, maxShift = 60, detrend = 200 } = {}) {
+  const pts = [];
+  for (const s of samples) {
+    if (!timed(s)) continue;
+    pts.push({ tick: Math.min(s.pos - s.dTicks, s.pos), iv: s.u / Math.abs(s.dTicks) });
+  }
+  const n = pts.length;
+  if (n < 2 || Math.abs(pts[n - 1].tick - pts[0].tick) < 4 * trial) return { period: null, reason: "short" };
+  const pre = [0];
+  for (const p of pts) pre.push(pre[pre.length - 1] + p.iv);
+  const det = pts.map((p, i) => {
+    const a = Math.max(0, i - detrend), b = Math.min(n, i + detrend);
+    return p.iv / ((pre[b] - pre[a]) / (b - a)) - 1;
+  });
+  const B = Math.round(trial);
+  const profile = (lo, hi) => {
+    const sum = new Float64Array(B), cnt = new Float64Array(B);
+    for (let i = lo; i < hi; i++) {
+      const b = Math.min(B - 1, Math.floor(((((pts[i].tick % trial) + trial) % trial) / trial) * B));
+      sum[b] += det[i];
+      cnt[b]++;
+    }
+    const raw = Array.from(sum, (v, b) => (cnt[b] ? v / cnt[b] : 0));
+    return raw.map((_, b) => {
+      let t = 0;
+      for (let k = -smooth; k <= smooth; k++) t += raw[(((b + k) % B) + B) % B];
+      return t / (2 * smooth + 1);
+    });
+  };
+  const h = n >> 1;
+  const p1 = profile(0, h), p2 = profile(h, n);
+  const centre = (lo, hi) => (pts[lo].tick + pts[hi - 1].tick) / 2;
+  const revs = (centre(h, n) - centre(0, h)) / trial;
+  const xc = (s) => p1.reduce((t, v, b) => t + v * p2[(((b + s) % B) + B) % B], 0);
+  const ys = new Map();
+  let best = -maxShift;
+  for (let s = -maxShift; s <= maxShift; s++) {
+    ys.set(s, xc(s));
+    if (ys.get(s) > ys.get(best)) best = s;
+  }
+  if (Math.abs(best) === maxShift) return { period: null, reason: "shift" };
+  const [ym, y0, yp] = [ys.get(best - 1), ys.get(best), ys.get(best + 1)];
+  const den = ym - 2 * y0 + yp;
+  const shift = ((best + (den !== 0 ? (0.5 * (ym - yp)) / den : 0)) * trial) / B;
+  const norm = Math.sqrt(p1.reduce((t, v) => t + v * v, 0) * p2.reduce((t, v) => t + v * v, 0));
+  return { period: trial + shift / revs, shift, revs: Math.abs(revs), corr: norm > 0 ? y0 / norm : 0, points: n };
+}
diff --git a/tools/lib/platter-run-all.mjs b/tools/lib/platter-run-all.mjs
new file mode 100644
index 0000000..f422c8d
--- /dev/null
+++ b/tools/lib/platter-run-all.mjs
@@ -0,0 +1,90 @@
+// Every platter take of the 2026-10-23 census through tools/platter-run (M5-08): the deck and the expectedRatio each
+// take needs to read as what Michael played, and one summary per take (states in order, control flips under 20 ms).
+// The arguments are tools/platter-run's own (parsed by tools/lib/platter-run-cli.mjs), so each row re-runs alone as
+// `tools/platter-run captures/2026-10-23-census/<file> <args>`.
+// Why each --expected: the takes' note 0 presses (Play, docs/research/2026-10-24-census-analysis.md § Motor) toggle
+// the motor, but 17, 18, 19, 31, 32 and 33 begin with the motor already running (31's on/off at 0.000 s is a press
+// from before the port opened, § Not data); 15 and 17 ran with deck 1's reverse pad on, so the motor turns at -1
+// (D29); 23 and 24 follow the pitch fader 35 ms late (D27, FADER_LAG_MS). Press times are the note-ons'
+// (`tools/take-events <take> --no-platter`). 16 and 22 are not data (§ Not data).
+// Spec: docs/plans/2026-10-24-M5-truth.md, Questions row 6 and Tool changes.
+import { readJsonl } from "./jsonl.mjs";
+import { parseRunArgs, platterRun } from "./platter-run-cli.mjs";
+
+const CLOCK_STATES = new Set(["stopped", "motor_at_speed"]);
+
+export const CENSUS_DIR = "captures/2026-10-23-census";
+
+export const TAKES = Object.freeze([
+  ["07-hand-d1-slow.jsonl", "--deck 1"],
+  ["08-hand-d1-fast.jsonl", "--deck 1"],
+  ["09-hand-d1-ten.jsonl", "--deck 1"],
+  ["10-hand-d1-touch.jsonl", "--deck 1"],
+  ["11-hand-d1-alt.jsonl", "--deck 1"],
+  ["12-hand-d2-slow.jsonl", "--deck 2"],
+  ["13-hand-d2-ten.jsonl", "--deck 2"],
+  ["14-hand-d2-touch.jsonl", "--deck 2"],
+  ["15-motor-d1-33.jsonl", "--deck 1 --expected 0:0,1.773677:-1"],
+  ["17-motor-d1-hold.jsonl", "--deck 1 --expected 0:-1"],
+  ["18-motor-d1-backspin.jsonl", "--deck 1 --expected 0:1"],
+  ["19-motor-d1-stop-min.jsonl", "--deck 1 --expected 0:1,7.042559:0"],
+  ["20-motor-d1-stop-max.jsonl", "--deck 1"],
+  ["21-motor-d2-33.jsonl", "--deck 2"],
+  ["23-pitch-d1.jsonl", "--deck 1 --expected fader:35"],
+  ["24-pitch-d2.jsonl", "--deck 2 --expected fader:35"],
+  ["25-motor-toggle.jsonl", "--deck 1"],
+  ["26-strip.jsonl", "--deck 1"],
+  ["29-hand-d2-fast.jsonl", "--deck 2"],
+  ["30-hand-d2-alt.jsonl", "--deck 2"],
+  ["31-motor-d2-hold.jsonl", "--deck 2 --expected 0:1"],
+  ["32-motor-d2-backspin.jsonl", "--deck 2 --expected 0:1"],
+  ["33-motor-d2-stop-min.jsonl", "--deck 2 --expected 0:1,8.912328:0"],
+  ["34-motor-d2-stop-max.jsonl", "--deck 2"],
+].map(([file, args]) => Object.freeze({ file, args: Object.freeze(args.split(" ")) })));
+
+// One take's run → { file, args, end_s, states: [{ t_s, state }], presses: [t_s], toPlatter, glitches: [{ t_s,
+// ms, from, to }], decoder }: every state change with its time (the first update's included), the deck's note 0
+// presses, how many times control went from the clock to the platter, and the decoder's stats.
+export function summarize(file, args, recs, res) {
+  const r3 = (us) => Math.round(us / 1000) / 1000;
+  const states = [], presses = [];
+  let toPlatter = 0;
+  for (const c of res.changes) {
+    if (c.kind === "press") presses.push(r3(c.t_us));
+    if (c.kind !== "state") continue;
+    states.push({ t_s: r3(c.t_us), state: c.state });
+    if (CLOCK_STATES.has(c.from) && c.control === "platter") toPlatter++;
+  }
+  return {
+    file, args: [...args], end_s: recs.length > 0 ? r3(recs[recs.length - 1].t_us) : 0, states, presses, toPlatter,
+    glitches: res.glitches.map((g) => ({ t_s: r3(g.t_us), ms: g.ms, from: g.from, to: g.to })),
+    decoder: res.run.decoderStats,
+  };
+}
+
+// Runs every take of TAKES found in dir → [summary]. Throws the reader's error for an unreadable take.
+export function runAll(P, dir) {
+  return TAKES.map(({ file, args }) => {
+    const opts = parseRunArgs(args);
+    if (opts.error !== undefined) throw new Error(`${file}: ${opts.error}`);
+    const recs = readJsonl(`${dir}/${file}`);
+    return summarize(file, args, recs, platterRun(P, recs, opts));
+  });
+}
+
+// summary → one line: take, arguments, glitch count, takeovers, decoder counts, then the states in order.
+export function formatLine(s) {
+  const d = s.decoder;
+  const seq = [];
+  let k = 0;
+  for (const st of s.states) {
+    while (k < s.presses.length && s.presses[k] <= st.t_s) seq.push(`Play ${s.presses[k++].toFixed(3)}`);
+    seq.push(`${st.state} ${st.t_s.toFixed(3)}`);
+  }
+  while (k < s.presses.length) seq.push(`Play ${s.presses[k++].toFixed(3)}`);
+  const g = s.glitches.map((x) => ` [${x.t_s.toFixed(3)} s ${x.from} -> ${x.to} ${x.ms} ms]`).join("");
+  return `${s.file.slice(0, 2)} ${s.args.join(" ")} | glitches ${s.glitches.length}${g} | to platter ${s.toPlatter} | ` +
+    `${d.timerErrors} unwrap errors, ${d.untrustedTimers} untrusted, ${d.glitchMarkers} mis-timed | ` +
+    `shrink ${d.maxShrink.toFixed(2)}x, after a gap ${d.maxGapShrink.toFixed(2)}x | end ${s.end_s.toFixed(3)} s | ` +
+    seq.join(", ");
+}
diff --git a/tools/lib/platter-run-cli.mjs b/tools/lib/platter-run-cli.mjs
new file mode 100644
index 0000000..bdbf142
--- /dev/null
+++ b/tools/lib/platter-run-cli.mjs
@@ -0,0 +1,53 @@
+// tools/platter-run's options and run, shared with tools/platter-run-all (M5-08) so the arguments a take is listed
+// with there mean exactly what they mean to tools/platter-run.
+// Spec: docs/plans/2026-10-24-M5-truth.md, Tool changes (tools/platter-run-all).
+import { runCore, timeline, glitches, parseExpected } from "./platter-run.mjs";
+import { parseDeck } from "./deck.mjs";
+import { faderExpected } from "./fader-sweeps.mjs";
+
+// tools/platter-run's arguments (without --help) → { file, deck, expected, faderDelayMs, json } or { error: message }.
+// file is null if none was given.
+export function parseRunArgs(args) {
+  let file = null, deck = 1, expected = null, faderDelayMs = null, json = false;
+  const seen = new Set();
+  for (let i = 0; i < args.length; i++) {
+    const a = args[i];
+    if (!a.startsWith("-") || a === "-") {
+      if (a === "-") return { error: "reading stdin is not supported" };
+      if (file !== null) return { error: `unexpected argument ${a}` };
+      file = a;
+      continue;
+    }
+    if (seen.has(a)) return { error: `${a} given twice` };
+    seen.add(a);
+    if (a === "--json") {
+      json = true;
+      continue;
+    }
+    const v = args[++i];
+    if (v === undefined) return { error: `${a} needs a value` };
+    if (a === "--deck") {
+      deck = parseDeck(v);
+      if (deck === null) return { error: `bad --deck ${v}` };
+    } else if (a === "--expected") {
+      const m = /^fader(?::(\d{1,4}))?$/.exec(v);
+      if (m !== null) {
+        faderDelayMs = m[1] === undefined ? 0 : Number(m[1]);
+        if (faderDelayMs > 1000) return { error: `bad --expected ${v}` };
+      } else {
+        expected = parseExpected(v);
+        if (expected === null) return { error: `bad --expected ${v}` };
+      }
+    } else return { error: `unknown option ${a}` };
+  }
+  return { file, deck, expected, faderDelayMs, json };
+}
+
+// records and parseRunArgs' options → { run, changes, glitches }: runCore's result, its timeline and the control
+// flips that flip back within 20 ms, as tools/platter-run prints them.
+export function platterRun(P, recs, { deck = 1, expected = null, faderDelayMs = null } = {}) {
+  const exp = faderDelayMs !== null ? faderExpected(P, recs, { deck, delayMs: faderDelayMs }) : expected;
+  const run = runCore(P, recs, { deck, expected: exp });
+  const changes = timeline(run);
+  return { run, changes, glitches: glitches(changes) };
+}
