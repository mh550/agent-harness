+// The Rane One's two decks on MIDI, for the platter tools (M5-02): deck N sends its platter (CC 6, each followed by
+// a pitch bend) and Play on MIDI channel N. Deck 1: captures/2026-10-19-quick/platter.jsonl; deck 2:
+// captures/2026-10-23-census/12-hand-d2-slow.jsonl (hand) and 21-motor-d2-33.jsonl (motor), CC 6 and pitch bends
+// on channel 2 only. Play as note 0 on the deck's channel is assumed (UNVERIFIED, D19): note 0 has one press in
+// each motor take (15 on channel 1, 21 on channel 2); M5-03 names it.
+
+export const PLAY_NOTE = 0;
+
+// "1" or "2" → the deck number, anything else → null.
+export const parseDeck = (v) => (v === "1" || v === "2" ? Number(v) : null);
+
+// deck 1|2 → { ch: its 1-based channel, ccStatus, pbStatus, otherCh: the other deck's channel }.
+export function deckChannels(deck) {
+  return { ch: deck, ccStatus: 0xb0 | (deck - 1), pbStatus: 0xe0 | (deck - 1), otherCh: 3 - deck };
+}
+
+// The --help lines both tools share; col is the column the tool's option descriptions start at.
+export function deckHelp(col) {
+  const pad = (s) => s.padEnd(col);
+  return `${pad("  --deck <1|2>")}the deck read (default 1). deck 1: CC 6, pitch bend and Play (note ${PLAY_NOTE}) on MIDI channel 1;
+${pad("")}deck 2: the same on channel 2 (captures/2026-10-23-census/12-hand-d2-slow.jsonl and
+${pad("")}21-motor-d2-33.jsonl). Play as note ${PLAY_NOTE} is assumed (UNVERIFIED)`;
+}
