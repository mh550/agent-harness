@@ -0,0 +1,24 @@
+// Every message of an M2 capture with its time: tools/take-events is its CLI (M5-04, docs/plans/2026-10-24-M5-truth.md).
+
+// CC 6 or a pitch bend on channel 1 or 2: a deck's platter (captures/2026-10-23-census/12-hand-d2-slow.jsonl for
+// deck 2, captures/2026-10-19-quick/platter.jsonl for deck 1).
+export const isPlatter = (r) => (r.ch === 1 || r.ch === 2) && (r.type === "pb" || (r.type === "cc" && r.d1 === 6));
+
+// recs: M2 records. → {events: the records with fromUs <= t_us < toUs (minus the platter's with noPlatter),
+// hidden: how many platter records in that window noPlatter left out}.
+export function takeEvents(recs, { noPlatter = false, fromUs = -Infinity, toUs = Infinity }) {
+  const events = [];
+  let hidden = 0;
+  for (const r of recs) {
+    if (r.t_us < fromUs || r.t_us >= toUs) continue;
+    if (noPlatter && isPlatter(r)) hidden++;
+    else events.push(r);
+  }
+  return { events, hidden };
+}
+
+// "1.500000 s  on ch 16 50 127"; a pitch bend shows its 14-bit value, everything else its data bytes.
+export function formatEvent(r) {
+  const data = r.type === "pb" ? String(r.value) : [r.d1, r.d2].filter((d) => d !== undefined && d !== null).join(" ");
+  return `${(r.t_us / 1e6).toFixed(6)} s  ${r.type}${r.ch ? ` ch ${r.ch}` : ""}${data ? ` ${data}` : ""}`;
+}
