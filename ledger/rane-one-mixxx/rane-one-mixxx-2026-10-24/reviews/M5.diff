+    inputs.push({ ratio: 0.15, hostTimeUs: (t += 100), expectedRatio: 1, ticks: ticks + n, untrusted: n === 100 });
+  }
+  const a = assertMirrored("scripted D24", undefined, inputs);
+  const take = a[412].position;
+  assert.equal(a[412].state, "held");
+  assert.deepEqual(a.slice(413).map((x) => Math.round((x.position - take) * 1e6) / 1e6 + 0), [0, -50, 10, 60, 50]);
+});
+
+test("D29: the mirror holds for every stall length, 40-150 ms, where T7 fires on the burst's untrusted sample too", () => {
+  for (const stallMs of [40, 55, 60, 65, 70, 75, 80, 100, 150]) {
+    const recs = readJsonl(synth.generate({ rpm: 33.333, seed: 9, segments: [
+      { kind: "constant", ratio: 1, seconds: 1, jitterTicks: 1 },
+      { kind: "stall-burst", stallMs, ratio: 1, seconds: 1, jitterTicks: 1 },
+      { kind: "constant", ratio: 1, seconds: 1, jitterTicks: 1 },
+    ] }));
+    assertMirrored(`${stallMs} ms stall`, undefined, inputsOf(runCore(P, recs, { expected: [{ t_us: 0, e: 1 }] })));
+  }
+});
+
+test("D29: forward → stopped → reverse keeps the track position continuous, and reverse settles at speed", () => {
+  const sm = P.createStateMachine();
+  let t = 0, ticks = 0, last = null, maxStep = 0;
+  const step = (r, e) => {
+    ticks += r * 2; // 1 ms at 2000 ticks/s per unit ratio
+    const res = plain(sm.update({ ratio: r, hostTimeUs: (t += 1000), expectedRatio: e, ticks: Math.round(ticks) }));
+    if (last !== null) maxStep = Math.max(maxStep, Math.abs(res.position - last.position));
+    last = res;
+    return res;
+  };
+  for (let i = 0; i < 1500; i++) step(1, 1);
+  assert.equal(last.state, "motor_at_speed");
+  for (let i = 0; i < 1500; i++) step(Math.max(0, 1 - i / 300), 0);
+  assert.equal(last.state, "stopped");
+  for (let i = 0; i < 1500; i++) step(-Math.min(1, i / 300), -1);
+  assert.equal(last.state, "motor_at_speed");
+  assert.ok(maxStep <= 3, `largest position step ${maxStep} ticks in 1 ms`);
+  assert.equal(sm.stats().malformed, 0);
+});
+
+test("D29: with the motor reversed, a forward push past -BACKSPIN_RATIO is the backspin, a backward one is not", () => {
+  const g = rig();
+  g.run(1500, { r: -1, e: -1 });
+  assert.equal(g.last().state, "motor_at_speed");
+  g.run(30, { r: -1.8, e: -1 });
+  assert.notEqual(g.last().state, "backspin", "pushed along the motor's direction");
+  g.run(1500, { r: -1, e: -1 });
+  assert.equal(g.last().state, "motor_at_speed");
+  g.run(30, { r: 0.6, e: -1 });
+  assert.equal(g.last().state, "backspin");
+  g.run(30, { r: 0.3, e: -1 });
+  assert.equal(g.last().state, "scratching", "T3 at -BACKSPIN_EXIT_RATIO");
+});
diff --git a/tests/platter-windows.test.mjs b/tests/platter-windows.test.mjs
new file mode 100644
index 0000000..ca51959
--- /dev/null
+++ b/tests/platter-windows.test.mjs
@@ -0,0 +1,165 @@
+// tools/platter-windows (M5-05, docs/plans/2026-10-24-M5-truth.md, Tool changes): one deck of a capture through
+// the core's decoder, speed estimator and state machine (tools/lib/platter-run.mjs), cut into fixed host-time
+// windows, each with its net ticks, host-time ratio, device-timed ratio, the estimator's ratio range and the
+// saturation markers; plus the first time the estimator's ratio crosses given thresholds after --from (spin-up and
+// spin-down times in docs/research/2026-10-24-census-analysis.md § Motor). Labelled data: tools/synth-platter.
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { readFileSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { readJsonl, formatLine, toRecord } from "../tools/lib/jsonl.mjs";
+import { loadPlatter } from "./helpers/load-platter.mjs";
+import { synthDir, ROOT } from "./helpers/synth.mjs";
+import { platterWindows, crossings, parseThresholds } from "../tools/lib/platter-windows.mjs";
+
+const P = loadPlatter();
+const TOOL = join(ROOT, "tools", "platter-windows");
+const run = (...args) => spawnSync(TOOL, args, { encoding: "utf8" });
+
+let synth;
+const files = {};
+const recs = {};
+before(() => {
+  synth = synthDir("platter-windows-");
+  files.step = synth.generate("step"); // 1.0 for 2 s, then 0.5 for 2 s, jitter 1 tick
+  files.reverse = synth.generate({ rpm: 33.333, seed: 7, segments: [
+    { kind: "constant", ratio: -1, seconds: 3, jitterTicks: 1 }] });
+  files.deck2 = synth.generate({ rpm: 33.333, seed: 3, ch: 2, segments: [
+    { kind: "constant", ratio: 1, seconds: 2, jitterTicks: 1 }, { kind: "constant", ratio: 0.5, seconds: 2, jitterTicks: 1 }] });
+  files.slow = synth.generate({ rpm: 33.333, seed: 5, segments: [
+    { kind: "constant", ratio: 1, seconds: 1, jitterTicks: 0 }, { kind: "slow", ratio: 0.02, seconds: 2 }] });
+  for (const k of Object.keys(files)) recs[k] = readJsonl(files[k]);
+});
+after(() => synth.cleanup());
+
+test("step: 200 ms windows read 1.0 in the first 2 s and 0.5 after, by host time, device time and the estimator", () => {
+  const w = platterWindows(P, recs.step, { windowMs: 200 });
+  assert.equal(w.nominal, 2000, "3600 ticks/rev at 33 1/3 rpm");
+  assert.equal(w.windows.length, 20);
+  for (const x of w.windows) {
+    const want = x.fromUs < 2e6 ? 1 : 0.5;
+    if (x.fromUs === 0 || x.fromUs === 2e6) continue; // the first window starts the filter; the step's own window
+    assert.ok(Math.abs(x.hostRatio - want) <= 0.02, `host ${x.hostRatio} at ${x.fromUs}`);
+    assert.ok(Math.abs(x.deviceRatio - want) <= 0.005, `device ${x.deviceRatio} at ${x.fromUs}`);
+    assert.ok(Math.abs(x.est.mean - want) <= 0.01, `estimator mean ${x.est.mean} at ${x.fromUs}`);
+    assert.ok(x.raw.min <= x.deviceRatio && x.deviceRatio <= x.raw.max, "the per-message range holds the window's ratio");
+    assert.equal(x.markers, 0);
+    assert.equal(x.timedShare, 1);
+  }
+});
+
+test("windows tile the span: their samples and net ticks add up to the span's", () => {
+  const w = platterWindows(P, recs.step, { windowMs: 300 });
+  const sum = (k) => w.windows.reduce((a, x) => a + x[k], 0);
+  assert.equal(sum("samples"), w.span.samples);
+  assert.equal(sum("netTicks"), w.span.netTicks);
+  assert.ok(Math.abs(w.span.netTicks - 6000) <= 3, `net ${w.span.netTicks} (2 s at 2000/s + 2 s at 1000/s)`);
+  assert.ok(Math.abs(w.span.deviceRatio - 0.75) <= 0.005, `span device ${w.span.deviceRatio}`);
+  const last = w.windows[w.windows.length - 1];
+  assert.ok(last.toUs - last.fromUs < 300000, "the last window is cut at the span's end");
+});
+
+test("--from/--to clip the span; a window's seconds and the ratio follow the clip", () => {
+  const w = platterWindows(P, recs.step, { windowMs: 500, fromUs: 1e6, toUs: 3e6 });
+  assert.deepEqual(w.windows.map((x) => [x.fromUs, x.toUs]),
+    [[1e6, 1.5e6], [1.5e6, 2e6], [2e6, 2.5e6], [2.5e6, 3e6]]);
+  assert.ok(Math.abs(w.span.netTicks - 3000) <= 3, `net ${w.span.netTicks}`);
+  assert.ok(Math.abs(w.span.hostRatio - 0.75) <= 0.01, `host ${w.span.hostRatio}`);
+});
+
+test("a reversed spin reads -1 (the sign is kept), and a deck 2 capture reads only with deck 2", () => {
+  const r = platterWindows(P, recs.reverse, { windowMs: 200, fromUs: 0.4e6 });
+  for (const x of r.windows) assert.ok(Math.abs(x.est.mean + 1) <= 0.01, `estimator ${x.est.mean} at ${x.fromUs}`);
+  assert.ok(Math.abs(r.span.deviceRatio + 1) <= 0.002, `span device ${r.span.deviceRatio}`);
+  const two = platterWindows(P, recs.deck2, { deck: 2, windowMs: 200 });
+  const one = platterWindows(P, recs.step, { deck: 1, windowMs: 200 });
+  assert.equal(JSON.stringify(two.windows), JSON.stringify(one.windows), "the channel 2 twin reads as deck 1 does");
+  const wrong = platterWindows(P, recs.deck2, { deck: 1, windowMs: 200 });
+  assert.equal(wrong.span.samples, 0);
+  assert.ok(wrong.windows.every((x) => x.deviceRatio === null && x.est === null));
+});
+
+test("below the timer's limit every delta is a -1 marker: counted, left out of the device ratio, read by host time", () => {
+  const w = platterWindows(P, recs.slow, { windowMs: 500, fromUs: 1.5e6, toUs: 3e6 });
+  for (const x of w.windows) {
+    assert.ok(x.samples > 0 && x.markers === x.samples, `${x.markers} markers of ${x.samples} at ${x.fromUs}`);
+    assert.equal(x.deviceRatio, null, "no timed delta, no device ratio");
+    assert.equal(x.raw, null);
+    assert.equal(x.timedShare, 0);
+    assert.ok(Math.abs(x.hostRatio - 0.02) <= 0.01, `host ${x.hostRatio}`);
+  }
+});
+
+test("crossings: the first update after --from on the other side of each threshold, in either direction", () => {
+  const ups = [0.5, 0.05, 0.2, 0.995, 1.0, 0.3].map((ratio, i) => ({ t: 1000 * i, ratio }));
+  assert.deepEqual(crossings(ups, [0.1, 0.99], 1000),
+    [{ threshold: 0.1, t_us: 2000, ms: 1 }, { threshold: 0.99, t_us: 3000, ms: 2 }]);
+  assert.deepEqual(crossings(ups, [0.99], 4000), [{ threshold: 0.99, t_us: 5000, ms: 1 }], "down through 0.99");
+  assert.deepEqual(crossings(ups, [2], 0), [{ threshold: 2, t_us: null, ms: null }], "never crossed");
+  const down = [-0.01, -0.2, -0.995].map((ratio, i) => ({ t: i, ratio }));
+  assert.deepEqual(crossings(down, [-0.1, -0.99], 0).map((c) => c.t_us), [1, 2], "negative thresholds");
+  const step = platterWindows(P, recs.step, { windowMs: 200, fromUs: 1.5e6, cross: [0.75] });
+  const c = step.crossings[0];
+  assert.ok(c.t_us >= 2e6 && c.t_us <= 2.05e6, `0.75 crossed at ${c.t_us} (the step is at 2 s)`);
+});
+
+test("crossings stop at --to: a threshold first crossed after the span's end reads never", () => {
+  const w = platterWindows(P, recs.step, { windowMs: 200, fromUs: 1.5e6, toUs: 1.9e6, cross: [0.75] });
+  assert.deepEqual(w.crossings, [{ threshold: 0.75, t_us: null, ms: null }]);
+});
+
+test("tools/platter-windows --json through a pipe is whole however long (1 ms windows: about 1 MB)", () => {
+  const r = spawnSync("sh", ["-c", `"${TOOL}" "${files.step}" --window-ms 1 --json | cat`], { encoding: "utf8", maxBuffer: 1 << 26 });
+  assert.equal(r.status, 0, r.stderr);
+  assert.ok(r.stdout.length > 65536, `${r.stdout.length} bytes`);
+  assert.equal(JSON.parse(r.stdout).windows.length, 4000);
+});
+
+test("parseThresholds reads a comma list of signed decimals and refuses anything else", () => {
+  assert.deepEqual(parseThresholds("0.1,0.99"), [0.1, 0.99]);
+  assert.deepEqual(parseThresholds("-0.5,-.4,1"), [-0.5, -0.4, 1]);
+  for (const bad of ["", "x", "0.1,", "1e3", "--1", "0.1,,2"]) assert.equal(parseThresholds(bad), null, bad);
+});
+
+test("tools/platter-windows prints one row per window, the span and the crossings; --json the same numbers", () => {
+  const t = run(files.step, "--window-ms", "1000", "--from", "1", "--cross", "0.75");
+  assert.equal(t.status, 0, t.stderr);
+  const lines = t.stdout.trim().split("\n");
+  assert.match(lines[0], /deck 1 .*ch 1/);
+  assert.equal(lines.filter((l) => /^\s+\d+\.\d{3}\s/.test(l)).length, 3, t.stdout);
+  assert.match(t.stdout, /^span 1\.000-4\.000 s: \d+ samples, net \+\d+ ticks/m);
+  assert.match(t.stdout, /^cross \+0\.75: 2\.0\d\d s/m);
+  const j = run(files.step, "--window-ms", "1000", "--from", "1", "--cross", "0.75", "--json");
+  assert.equal(j.status, 0, j.stderr);
+  const o = JSON.parse(j.stdout);
+  const lib = platterWindows(P, recs.step, { windowMs: 1000, fromUs: 1e6, cross: [0.75] });
+  assert.equal(JSON.stringify(o.windows), JSON.stringify(lib.windows));
+  assert.equal(JSON.stringify(o.crossings), JSON.stringify(lib.crossings));
+  assert.equal(o.deck, 1);
+});
+
+test("tools/platter-windows --deck 2 reads channel 2; presses of the deck's note 0 are listed", () => {
+  const f = join(synth.dir, "press.jsonl");
+  const lines = readFileSync(files.deck2, "utf8").split("\n").filter(Boolean);
+  // a note 0 press on ch 2 at 1 s (on, off 50 ms later), placed in time order
+  const t = (l) => JSON.parse(l).t_us;
+  const on = formatLine(toRecord({ status: 0x91, data: [0, 127] }, 1000000)).trim();
+  const off = formatLine(toRecord({ status: 0x81, data: [0, 0] }, 1050000)).trim();
+  const all = [...lines, on, off].map((l, i) => [t(l), i, l]).sort((a, b) => a[0] - b[0] || a[1] - b[1]).map((x) => x[2]);
+  writeFileSync(f, all.join("\n") + "\n");
+  const r = run(f, "--deck", "2");
+  assert.equal(r.status, 0, r.stderr);
+  assert.match(r.stdout, /deck 2 .*ch 2/);
+  assert.match(r.stdout, /^press note 0 ch 2 at 1\.000 s \(50 ms\)$/m);
+  assert.doesNotMatch(r.stdout, / 0 samples/);
+});
+
+test("tools/platter-windows exits 1 on an unreadable file; --help names its options", () => {
+  const r = run(join(synth.dir, "missing.jsonl"));
+  assert.equal(r.status, 1);
+  assert.match(r.stderr, /^platter-windows: /);
+  const h = run("--help");
+  assert.equal(h.status, 0);
+  for (const o of ["--deck", "--window-ms", "--from", "--to", "--cross", "--json"]) assert.match(h.stdout, new RegExp(o));
+});
diff --git a/tests/take-events.test.mjs b/tests/take-events.test.mjs
new file mode 100644
index 0000000..d7b5706
--- /dev/null
+++ b/tests/take-events.test.mjs
@@ -0,0 +1,109 @@
+// tools/take-events (M5-04): every message of a capture with its time, `type ch d1 d2`, so the analysis document's
+// message lists (docs/research/2026-10-24-census-analysis.md) can be re-run. --no-platter hides CC 6 and pitch bends
+// on channels 1 and 2 (the decks' platters, captures/2026-10-23-census/12-hand-d2-slow.jsonl and the quick capture).
+import { test, after } from "node:test";
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+import { formatLine, toRecord } from "../tools/lib/jsonl.mjs";
+import { takeEvents, isPlatter } from "../tools/lib/take-events.mjs";
+
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), "..");
+const TOOL = join(ROOT, "tools", "take-events");
+const dir = mkdtempSync(join(tmpdir(), "take-events-"));
+after(() => rmSync(dir, { recursive: true, force: true }));
+
+const line = (status, d1, d2, t_us) => formatLine(toRecord({ status, data: [d1, d2] }, t_us));
+// 8 messages: deck 1's platter pair, deck 2's, Shift (note 50 ch 16) on and off, a CC 72 on ch 1, a CC 6 on ch 5
+const FIXTURE = join(dir, "f.jsonl");
+writeFileSync(FIXTURE, [
+  line(0xb0, 6, 71, 1_000), line(0xe0, 0x12, 0x3b, 1_000), line(0xb1, 6, 19, 250_000), line(0xe1, 0, 0x40, 250_100),
+  line(0x9f, 50, 127, 1_500_000), line(0x8f, 50, 0, 1_750_000), line(0xb0, 72, 58, 2_000_000), line(0xb4, 6, 1, 3_000_000),
+].join(""));
+const run = (...args) => spawnSync(TOOL, args, { encoding: "utf8" });
+
+test("isPlatter is CC 6 or a pitch bend on channel 1 or 2 only", () => {
+  assert.equal(isPlatter({ type: "cc", ch: 1, d1: 6 }), true);
+  assert.equal(isPlatter({ type: "pb", ch: 2, d1: 0 }), true);
+  assert.equal(isPlatter({ type: "cc", ch: 5, d1: 6 }), false);
+  assert.equal(isPlatter({ type: "cc", ch: 1, d1: 72 }), false);
+  assert.equal(isPlatter({ type: "on", ch: 1, d1: 6 }), false);
+});
+
+test("takeEvents keeps [from, to) and, with noPlatter, drops the platter messages and counts them", () => {
+  const recs = [{ t_us: 0, type: "cc", ch: 1, d1: 6 }, { t_us: 5, type: "on", ch: 16, d1: 50 },
+    { t_us: 10, type: "pb", ch: 2, d1: 0 }, { t_us: 20, type: "off", ch: 16, d1: 50 }];
+  assert.deepEqual(takeEvents(recs, {}).events.map((r) => r.t_us), [0, 5, 10, 20]);
+  assert.deepEqual(takeEvents(recs, { fromUs: 5, toUs: 20 }), { events: [recs[1], recs[2]], hidden: 0 });
+  assert.deepEqual(takeEvents(recs, { noPlatter: true }), { events: [recs[1], recs[3]], hidden: 2 });
+});
+
+test("the tool prints every message with its time, type, channel and data bytes", () => {
+  const r = run(FIXTURE);
+  assert.equal(r.status, 0, r.stderr);
+  assert.equal(r.stdout, [
+    `${FIXTURE}: 8 messages, 8 shown`,
+    "0.001000 s  cc ch 1 6 71",
+    "0.001000 s  pb ch 1 7570",
+    "0.250000 s  cc ch 2 6 19",
+    "0.250100 s  pb ch 2 8192",
+    "1.500000 s  on ch 16 50 127",
+    "1.750000 s  off ch 16 50 0",
+    "2.000000 s  cc ch 1 72 58",
+    "3.000000 s  cc ch 5 6 1",
+    "",
+  ].join("\n"));
+});
+
+test("--no-platter, --from and --to narrow it; the header says how many platter messages were left out", () => {
+  const r = run(FIXTURE, "--no-platter", "--from", "0.2", "--to", "2.5");
+  assert.equal(r.status, 0, r.stderr);
+  assert.equal(r.stdout, [
+    `${FIXTURE}: 8 messages, 3 shown (0.2-2.5 s), 2 CC 6/pitch bend on ch 1-2 left out`,
+    "1.500000 s  on ch 16 50 127", "1.750000 s  off ch 16 50 0", "2.000000 s  cc ch 1 72 58", "",
+  ].join("\n"));
+});
+
+test("--json prints one object with the messages as records", () => {
+  const o = JSON.parse(run(FIXTURE, "--no-platter", "--json").stdout);
+  assert.equal(o.messages, 8);
+  assert.equal(o.hidden, 4);
+  assert.deepEqual(o.events.map((e) => [e.t_us, e.type, e.ch, e.d1]), [[1_500_000, "on", 16, 50], [1_750_000, "off", 16, 50],
+    [2_000_000, "cc", 1, 72], [3_000_000, "cc", 5, 6]]);
+});
+
+test("an unreadable or malformed file exits 1 naming it; --help exits 0 and names the options", () => {
+  const bad = join(dir, "bad.jsonl");
+  writeFileSync(bad, "{}\n");
+  assert.equal(run(bad).status, 1);
+  assert.match(run(bad).stderr, /bad\.jsonl:1/);
+  assert.equal(run(join(dir, "missing.jsonl")).status, 1);
+  const h = run("--help");
+  assert.equal(h.status, 0);
+  assert.match(h.stdout, /--no-platter/);
+  assert.match(h.stdout, /--from <s>/);
+});
+
+for (const [take, n, ch] of [["10-hand-d1-touch.jsonl", 12, 1], ["14-hand-d2-touch.jsonl", 6, 2]]) {
+  test(`take ${take.slice(0, 2)} (five taps on the vinyl top) holds ${n} messages, all CC 6 + pitch bend pairs on ch ${ch}`, () => {
+    const file = join(ROOT, "captures", "2026-10-23-census", take);
+    const r = run(file, "--no-platter");
+    assert.equal(r.status, 0, r.stderr);
+    assert.match(r.stdout, new RegExp(`: ${n} messages, 0 shown, ${n} CC 6/pitch bend on ch 1-2 left out\n$`));
+    const o = JSON.parse(run(file, "--json").stdout);
+    assert.equal(o.events.length, n);
+    assert.ok(o.events.every((e) => e.ch === ch && (e.type === "pb" || (e.type === "cc" && e.d1 === 6))));
+    assert.deepEqual(o.events.map((e) => e.type), Array.from({ length: n }, (_, i) => (i % 2 ? "pb" : "cc")));
+  });
+}
+
+test("--json through a pipe is whole: census 15's 126,224 messages, not the first 64 KiB (M5-08)", () => {
+  const take = join(ROOT, "captures", "2026-10-23-census", "15-motor-d1-33.jsonl");
+  const r = spawnSync(TOOL, [take, "--json"], { encoding: "utf8", maxBuffer: 1 << 26 });
+  assert.equal(r.status, 0, r.stderr);
+  assert.ok(r.stdout.length > 1 << 20, `${r.stdout.length} bytes`);
+  assert.equal(JSON.parse(r.stdout).events.length, 126224);
+});
