+// ---------------------------------------------------------------------------- D25: configurable switch-over
+
+// D25 (Michael, 2026-10-24): the thresholds between Mixxx's clock and the platter are his to tune, so they are config
+// overrides of DEFAULTS. One step script, run with the defaults and with D25_CONFIG; each step is placed so the two
+// predict different timing. Returns the first-update index of every state change as [index, state].
+const D25_CONFIG = Object.freeze({ TAKEOVER_TOL: 0.06, HANDBACK_TOL: 0.02, TAKEOVER_MS: 40, SETTLE_MS: 400 });
+function d25Script(config) {
+  const g = rig(config);
+  g.run(500, { r: 1, e: 1 }); //       0-499: motor on at speed
+  g.run(200, { r: 1.045, e: 1 }); // 500-699: 4.5 % fast (between the two TAKEOVER_TOLs)
+  g.run(100, { r: 1, e: 1 }); //     700-799: back on speed
+  g.run(200, { r: 1.08, e: 1 }); //  800-999: 8 % fast (past both)
+  g.run(1000, { r: 1.015, e: 1 }); // 1000-1999: 1.5 % fast (between the two HANDBACK_TOLs)
+  const changes = [];
+  g.out.forEach((o, i) => {
+    if (i === 0 || o.state !== g.out[i - 1].state) changes.push([i, o.state]);
+  });
+  return changes;
+}
+
+test("D25 configurable switch-over: TAKEOVER_TOL 0.06, HANDBACK_TOL 0.02, TAKEOVER_MS 40, SETTLE_MS 400 move takeover and handback as predicted", () => {
+  // Defaults: at speed after SETTLE_MS 150 (update 150); 4.5 % is past TAKEOVER_TOL 0.03, so the platter takes over
+  // TAKEOVER_MS 10 after it starts (510) and, back on speed, settles at once (700); the 8 % step comes before the
+  // 150 ms handback (850), and from settling T14 leaves at once (800). 1.5 % is outside HANDBACK_TOL 0.01: the
+  // platter keeps control to the end.
+  assert.deepEqual(d25Script(), [
+    [0, "stopped"], [150, "motor_at_speed"], [510, "scratching"], [700, "settling"], [800, "scratching"],
+  ]);
+  // D25_CONFIG: at speed after 400 ms (400); 4.5 % is inside 0.06, nothing happens; 8 % takes over 40 ms after it
+  // starts (840); 1.5 % is inside HANDBACK_TOL 0.02, so it settles at once (1000) and hands back 400 ms later (1400).
+  assert.deepEqual(d25Script(D25_CONFIG), [
+    [0, "stopped"], [400, "motor_at_speed"], [840, "scratching"], [1000, "settling"], [1400, "motor_at_speed"],
+  ]);
+});
