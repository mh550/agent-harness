+++ b/tests/platter-fader.test.mjs
@@ -0,0 +1,185 @@
+// The pitch fader → motor speed function of the core (M5-06): RaneOnePlatter.motorRatioFromFader(value14, config),
+// the speed ratio an untouched platter turns at for a 14-bit pitch fader value (CC 9 MSB, CC 41 LSB). Pinned on
+// captures/2026-10-23-census/23-pitch-d1.jsonl and 24-pitch-d2.jsonl through tools/lib/fader-sweeps.mjs (every
+// stretch where the fader stood still for 400 ms or more: its value, and the platter's device-timed ratio from
+// 300 ms after the fader stopped). docs/research/2026-10-24-census-analysis.md § Pitch fader and Range.
+import { test, before } from "node:test";
+import assert from "node:assert/strict";
+import { join } from "node:path";
+import { readJsonl } from "../tools/lib/jsonl.mjs";
+import { loadPlatter } from "./helpers/load-platter.mjs";
+import { ROOT } from "./helpers/synth.mjs";
+import { faderSweeps, faderExpected } from "../tools/lib/fader-sweeps.mjs";
+import { runCore, timeline } from "../tools/lib/platter-run.mjs";
+
+const P = loadPlatter();
+const CENSUS = join(ROOT, "captures", "2026-10-23-census");
+const f = (v, config) => P.motorRatioFromFader(v, config);
+
+test("DEFAULTS: MOTOR_RANGE 0.5 (the fader's ends are 0.5x and 1.5x) and FADER_DIRECTION +1 (16383 is fast)", () => {
+  assert.equal(P.DEFAULTS.MOTOR_RANGE, 0.5);
+  assert.equal(P.DEFAULTS.FADER_DIRECTION, 1);
+});
+
+test("centre 8192 is 1, the ends are exactly 1 -/+ MOTOR_RANGE, and it is linear on each side", () => {
+  assert.equal(f(8192), 1);
+  assert.equal(f(0), 0.5);
+  assert.equal(f(16383), 1.5);
+  assert.equal(f(4096), 0.75);
+  assert.ok(Math.abs(f(12287) - (1 + 0.5 * 4095 / 8191)) < 1e-12);
+  let last = -Infinity;
+  for (let v = 0; v <= 16383; v++) {
+    const r = f(v);
+    assert.ok(r > last, `rises at ${v}`);
+    last = r;
+  }
+});
+
+test("config: MOTOR_RANGE and FADER_DIRECTION override; -1 mirrors the fader; bad values fall back", () => {
+  assert.equal(f(16383, { MOTOR_RANGE: 0.08 }), 1.08);
+  assert.equal(f(0, { MOTOR_RANGE: 0.08 }), 0.92);
+  assert.equal(f(0, { FADER_DIRECTION: -1 }), 1.5);
+  assert.equal(f(16383, { FADER_DIRECTION: -1 }), 0.5);
+  for (const bad of [0, -0.1, 1, 1.5, NaN, "0.5", null]) {
+    assert.equal(f(16383, { MOTOR_RANGE: bad }), 1.5, `MOTOR_RANGE ${bad}`);
+  }
+  for (const bad of [0, 2, 0.5, "1", null]) assert.equal(f(0, { FADER_DIRECTION: bad }), 0.5, `FADER_DIRECTION ${bad}`);
+  for (const bad of [null, 7, "x", []]) assert.equal(f(0, bad), 0.5);
+});
+
+test("a value that is not an integer in 0-16383 gives null, and nothing throws", () => {
+  for (const bad of [-1, 16384, 8192.5, NaN, Infinity, "8192", null, undefined, {}]) {
+    assert.equal(f(bad), null, String(bad));
+  }
+  const hostile = { get MOTOR_RANGE() { throw new Error("boom"); } };
+  assert.equal(f(16383, hostile), 1.5);
+});
+
+// The takes: deck 1 (23) and deck 2 (24), three sweeps each with Range pressed between them.
+const takes = {};
+const recs = {};
+before(() => {
+  recs[1] = readJsonl(join(CENSUS, "23-pitch-d1.jsonl"));
+  recs[2] = readJsonl(join(CENSUS, "24-pitch-d2.jsonl"));
+  takes[1] = faderSweeps(P, recs[1], { deck: 1 });
+  takes[2] = faderSweeps(P, recs[2], { deck: 2 });
+});
+const off = (h) => h.device / h.expected - 1;
+
+test("23 and 24: the fader stands at 0, 8192 and 16383 only, in three sweeps split by two Range presses", () => {
+  for (const deck of [1, 2]) {
+    const t = takes[deck];
+    assert.equal(t.rangePresses.length, 2, `deck ${deck}`);
+    assert.deepEqual([...new Set(t.holds.map((h) => h.value))].sort((a, b) => a - b), [0, 8192, 16383]);
+    for (const sweep of [1, 2, 3]) {
+      const values = t.holds.filter((h) => h.sweep === sweep).map((h) => h.value);
+      assert.ok(values.includes(0) && values.includes(16383), `deck ${deck} sweep ${sweep}: ${values}`);
+    }
+  }
+  assert.equal(takes[1].holds.length, 12);
+  assert.equal(takes[2].holds.length, 10);
+});
+
+test("23, deck 1: every hold at the top, centre and bottom is within 0.5 % of the function, in every sweep", () => {
+  for (const h of takes[1].holds) {
+    assert.ok(Math.abs(off(h)) <= 0.005, `${h.value} at ${h.fromUs / 1e6} s: ${h.device} vs ${h.expected}`);
+  }
+});
+
+test("24, deck 2: the top and centre holds are within 0.5 %; the bottom ones sag 0.8-7.3 % under 0.5x", () => {
+  for (const h of takes[2].holds) {
+    if (h.value === 0) {
+      assert.ok(off(h) < -0.005 && off(h) > -0.075, `0 at ${h.fromUs / 1e6} s: ${h.device}`);
+    } else {
+      assert.ok(Math.abs(off(h)) <= 0.005, `${h.value} at ${h.fromUs / 1e6} s: ${h.device} vs ${h.expected}`);
+    }
+  }
+  // The sag, not the target: before it sags, deck 2 turns at 0.5x within 0.5 % for a 200 ms window in the last sweep.
+  const last = takes[2].holds.find((h) => h.value === 0 && h.sweep === 3);
+  assert.ok(last.est.windowMax >= 0.4975 && last.est.windowMax <= 0.5025, String(last.est.windowMax));
+});
+
+test("Range changes nothing: each end reads the same speed in all three sweeps (within 0.0005 on deck 1, 0.0015 at deck 2's top)", () => {
+  for (const value of [0, 16383]) {
+    const d = takes[1].holds.filter((h) => h.value === value).map((h) => h.device);
+    assert.ok(Math.max(...d) - Math.min(...d) <= 0.0005, `deck 1 ${value}: ${d}`);
+  }
+  const top = takes[2].holds.filter((h) => h.value === 16383).map((h) => h.device);
+  assert.ok(Math.max(...top) - Math.min(...top) <= 0.0015, `deck 2 top: ${top}`);
+});
+
+test("the One sends nothing for Range but note 43 on the deck's channel, and nothing else between the sweeps", () => {
+  for (const deck of [1, 2]) {
+    const kinds = takes[deck].others.map((m) => `${m.type} ${m.ch} ${m.d1}`);
+    assert.deepEqual([...new Set(kinds)].sort(), [`off ${deck} 0`, `off ${deck} 43`, `on ${deck} 0`, `on ${deck} 43`]);
+  }
+});
+
+test("off the fit by fader eighth: deck 1 within 0.2 % everywhere; deck 2 2-4 % slow in the bottom quarter", () => {
+  for (const b of takes[1].lag.bins) assert.ok(Math.abs(b.off) <= 0.002, JSON.stringify(b));
+  const d2 = takes[2].lag.bins;
+  for (const b of d2.slice(0, 2)) assert.ok(b.off < -0.02 && b.off > -0.04, JSON.stringify(b));
+  for (const b of d2.slice(4)) assert.ok(Math.abs(b.off) <= 0.005, JSON.stringify(b));
+});
+
+test("the motor follows the fader with a lag: best fit 25 / 45 ms by device time, 35 / 55 ms by the estimator", () => {
+  assert.deepEqual([takes[1].lag.bestMs, takes[2].lag.bestMs, takes[1].lag.estBestMs, takes[2].lag.estBestMs],
+    [25, 45, 35, 55]);
+  for (const s of takes[1].lag.steep) assert.ok(s.lagMs >= 0 && s.lagMs <= 60, JSON.stringify(s));
+});
+
+// The state machine with expectedRatio following the fader (tools/platter-run <take> --expected fader[:<ms>]):
+// the takeovers (entries to scratching) and the expectedRatio each was made at.
+const takeovers = (deck, delayMs, config) => {
+  const run = runCore(P, recs[deck], { deck, expected: faderExpected(P, recs[deck], { deck, delayMs }),
+    stateMachine: config });
+  return timeline(run).filter((c) => c.kind === "state" && c.state === "scratching")
+    .map((c) => ({ t: c.t_us / 1e6,
+      e: run.updates.find((u) => u.t === c.t_us && u.state === "scratching").expectedRatio }));
+};
+// The largest |ratio / expectedRatio - 1| that every update of some 10 ms (TAKEOVER_MS) after 5 s keeps.
+const sustained = (deck, delayMs) => {
+  const run = runCore(P, recs[deck], { deck, expected: faderExpected(P, recs[deck], { deck, delayMs }) });
+  const u = run.updates.filter((x) => x.t > 5e6 && x.expectedRatio > 0);
+  let best = 0;
+  for (let i = 0; i < u.length; i++) {
+    let m = Infinity, j = i;
+    for (; j < u.length && u[j].t <= u[i].t + 10000; j++) m = Math.min(m, Math.abs(u[j].ratio / u[j].expectedRatio - 1));
+    if (j - 1 > i) best = Math.max(best, m);
+  }
+  return best;
+};
+
+test("FADER_LAG_MS 35: on 23 no takeover, and no 10 ms off by more than 2 % (3.79 % read now, 2.28 % at 25 ms)", () => {
+  assert.equal(P.DEFAULTS.FADER_LAG_MS, 35);
+  assert.deepEqual(takeovers(1, P.DEFAULTS.FADER_LAG_MS), []);
+  const at = (ms) => Math.round(10000 * sustained(1, ms)) / 100;
+  assert.deepEqual([at(0), at(25), at(35)], [3.79, 2.28, 1.65]);
+  // Deck 2: its slow-end sag takes over whatever the delay; each takeover is below the centre.
+  const d2 = takeovers(2, P.DEFAULTS.FADER_LAG_MS);
+  assert.equal(d2.length, 6, JSON.stringify(d2));
+  for (const x of d2) assert.ok(x.e < 0.95, JSON.stringify(x));
+});
+
+test("23 with the fader as expectedRatio: one takeover (77.67 s, a fast move at 0.52x) with no delay, none at 25 ms", () => {
+  const now = takeovers(1, 0);
+  assert.equal(now.length, 1, JSON.stringify(now));
+  assert.ok(Math.abs(now[0].t - 77.668) < 0.01 && now[0].e < 0.55, JSON.stringify(now));
+  assert.deepEqual(takeovers(1, 25), []);
+  assert.deepEqual(takeovers(1, 50), []);
+});
+
+test("24 with the fader as expectedRatio: 6 takeovers at 25 ms, all below the centre (deck 2's sag)", () => {
+  const late = takeovers(2, 25);
+  assert.equal(late.length, 6, JSON.stringify(late));
+  for (const x of late) assert.ok(x.e < 0.95, JSON.stringify(x));
+});
+
+// RETARGET_MS keeps only the expectedRatio before the last change, and a moving fader changes it every 6-8 ms, so
+// 50 ms already covers what it can: 100 and 300 give what 50 does.
+test("RETARGET_MS on 23 and 24: it removes a takeover only at one delay (deck 2, 25 ms: 6 -> 5)", () => {
+  const n = (deck, delayMs, ms) => takeovers(deck, delayMs, { RETARGET_MS: ms }).length;
+  assert.deepEqual([n(1, 0, 0), n(1, 0, 100), n(1, 0, 300), n(1, 25, 50)], [1, 1, 1, 0]);
+  assert.deepEqual([n(2, 0, 0), n(2, 0, 300), n(2, 25, 0), n(2, 25, 50), n(2, 25, 300)], [7, 7, 6, 5, 5]);
+  assert.deepEqual([n(2, 35, 0), n(2, 35, 50), n(2, 50, 0), n(2, 50, 50)], [6, 6, 7, 7]);
+});
diff --git a/tests/platter-format.test.mjs b/tests/platter-format.test.mjs
new file mode 100644
index 0000000..a9918ea
--- /dev/null
+++ b/tests/platter-format.test.mjs
@@ -0,0 +1,192 @@
+// tools/lib/platter-format.mjs (M5-04): the checks behind docs/research/2026-10-24-census-analysis.md § Platter
+// format. The start backlog (messages the One held while the port was closed, delivered in the take's first ms),
+// the saturation-marker check (spec §5 M5 check 2) and the once-per-revolution period of the per-tick interval
+// (ticks per revolution without a mark). Every input here is synthetic, so each expected number is known exactly.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { formatLine, toRecord } from "../tools/lib/jsonl.mjs";
+import {
+  BACKLOG_US, LIMIT_US, SHRINK, platterSamples, startBacklog, markerCheck, revolutionPeriod,
+} from "../tools/lib/platter-format.mjs";
+
+const rec = (status, d1, d2, t_us) => JSON.parse(formatLine(toRecord({ status, data: [d1, d2] }, t_us)));
+
+// [t_us, cc value, pitch-bend value] rows → M2 records of one deck (CC 6 then its pitch bend at the same time).
+function records(rows, ch = 1) {
+  const out = [];
+  for (const [t, cc, pb] of rows) {
+    out.push(rec(0xb0 | (ch - 1), 6, cc & 0x7f, t));
+    out.push(rec(0xe0 | (ch - 1), pb & 0x7f, (pb >> 7) & 0x7f, t));
+  }
+  return out;
+}
+
+// A take built from per-message steps: [host gap µs, ticks, unsigned timer delta]; starts at t0 with CC 10, PB 0.
+function take(steps, { t0 = 100_000, ch = 1 } = {}) {
+  let t = t0, cc = 10, pb = 0;
+  const rows = [[t, cc, pb]];
+  for (const [gap, dTicks, u] of steps) {
+    t += gap;
+    cc = (((cc + dTicks) % 128) + 128) % 128;
+    pb = (pb + u) % 16384;
+    rows.push([t, cc, pb]);
+  }
+  return records(rows, ch);
+}
+
+test("the limit is 16,383 counts at 2,822,400 Hz (5.805 ms) and the backlog window is the take's first ms", () => {
+  assert.equal(BACKLOG_US, 1000);
+  assert.ok(Math.abs(LIMIT_US - 5804.6) < 0.1, String(LIMIT_US));
+});
+
+test("platterSamples pairs each CC 6 with the pitch bend after it, on the deck's channel only", () => {
+  const recs = [...take([[1000, 2, 2800], [1000, -1, 16383]]), ...take([[1000, 5, 100]], { ch: 2 })];
+  const s = platterSamples(recs, { ch: 1 });
+  assert.deepEqual(s.map((x) => [x.t_us, x.cc, x.pos, x.dTicks, x.u, x.gapUs]), [
+    [100_000, 10, 0, null, null, null], [101_000, 12, 2, 2, 2800, 1000], [102_000, 11, 1, -1, 16383, 1000],
+  ]);
+  assert.equal(platterSamples(recs, { ch: 2 }).length, 2);
+});
+
+test("startBacklog counts the messages of the take's first ms and the deck's net ticks among them", () => {
+  const recs = [...take([[10, 1, 16383], [10, 1, 16383], [10, -1, 16383]], { t0: 0 }),
+    ...take([[1000, 3, 3000]], { t0: 2_000_000 })];
+  assert.deepEqual(startBacklog(recs, { ch: 1 }), { messages: 8, netTicks: 1 });
+  assert.deepEqual(startBacklog(take([[1000, 1, 3000]]), { ch: 1 }), { messages: 0, netTicks: 0 });
+});
+
+test("markerCheck counts -1 and -2, lists deltas in 16,304-16,381 with their neighbours", () => {
+  const recs = take([[3000, 1, 9000], [5900, 1, 16359], [6000, 1, 16383], [6000, 1, 16382], [3000, 1, 9000]]);
+  const r = markerCheck(platterSamples(recs, { ch: 1 }));
+  assert.equal(r.minus1, 1);
+  assert.equal(r.minus2, 1);
+  assert.deepEqual(r.band, [{ t_us: 108_900, u: 16359, before: 9000, after: 16383 }]);
+  assert.equal(r.timedNeighbours, 0, "the -1's neighbours are a band delta (timed) and a -2 (not)");
+  assert.deepEqual(r.under, []);
+  assert.deepEqual(r.hostShort, []);
+});
+
+test("a -1 between timed neighbours ~1 ms per tick is put under 5.8 ms by them; one beside 5.7 ms ticks is not", () => {
+  // the take 08 pattern: 2931 and 3011 per tick around a -1 (estimate 0.18 of the limit)
+  const fast = markerCheck(platterSamples(take([[1000, -1, 2931], [1000, -1, 16383], [1000, -1, 3011]]), { ch: 1 }));
+  assert.equal(fast.timedNeighbours, 1);
+  assert.equal(fast.under.length, 1);
+  assert.equal(fast.under[0].t_us, 102_000);
+  assert.ok(Math.abs(fast.under[0].estimate - (2931 + 3011) / 2 / 16383) < 1e-9);
+  assert.deepEqual([fast.under[0].before, fast.under[0].after, fast.under[0].dTicks, fast.under[0].wrap], [2931, 3011, -1, null]);
