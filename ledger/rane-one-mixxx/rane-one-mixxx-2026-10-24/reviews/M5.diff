@@ -0,0 +1,152 @@
+// tools/fader-sweeps (M5-06, docs/plans/2026-10-24-M5-truth.md, question B6): one deck's 14-bit pitch fader (CC 9
+// MSB, CC 41 LSB) against its platter: the holds with the core's motorRatioFromFader beside the platter's speed, the
+// Range presses (note 43) and every other message, and the motor's lag behind the fader. Labelled data: a
+// tools/synth-platter capture whose platter steps 40 ms after fader messages added here.
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { readJsonl, formatLine, toRecord } from "../tools/lib/jsonl.mjs";
+import { loadPlatter } from "./helpers/load-platter.mjs";
+import { synthDir, ROOT } from "./helpers/synth.mjs";
+import { faderSweeps, faderValues, faderHolds, faderExpected } from "../tools/lib/fader-sweeps.mjs";
+
+const P = loadPlatter();
+const TOOL = join(ROOT, "tools", "fader-sweeps");
+const run = (...args) => spawnSync(TOOL, args, { encoding: "utf8" });
+
+const LAG_US = 40000;
+const fader = (ch, value, t_us) => [
+  toRecord({ status: 0xb0 | (ch - 1), data: [9, value >> 7] }, t_us),
+  toRecord({ status: 0xb0 | (ch - 1), data: [41, value & 127] }, t_us),
+];
+const note = (status, ch, n, v, t_us) => toRecord({ status: status | (ch - 1), data: [n, v] }, t_us);
+
+let synth, file, recs;
+before(() => {
+  synth = synthDir("fader-sweeps-");
+  const platter = readJsonl(synth.generate({ rpm: 33.333, seed: 11, ch: 2, segments: [
+    { kind: "constant", ratio: 1, seconds: 3.5, jitterTicks: 1 },
+    { kind: "constant", ratio: 1.5, seconds: 3.5, jitterTicks: 1 },
+    { kind: "constant", ratio: 0.5, seconds: 3.5, jitterTicks: 1 },
+    { kind: "constant", ratio: 1, seconds: 3.5, jitterTicks: 1 }] }));
+  const added = [
+    ...fader(2, 8192, 200000),
+    ...fader(2, 16383, 3500000 - LAG_US),
+    note(0x90, 2, 43, 127, 5000000), note(0x80, 2, 43, 0, 5150000),
+    ...fader(2, 0, 7000000 - LAG_US),
+    note(0x90, 2, 43, 127, 8500000), note(0x80, 2, 43, 0, 8600000),
+    note(0x90, 16, 50, 127, 9000000),
+    ...fader(2, 8192, 10500000 - LAG_US),
+    ...fader(1, 0, 12000000), // the other deck's fader: not this deck's
+  ];
+  recs = [...platter, ...added].map((r, i) => ({ r, i }))
+    .sort((a, b) => a.r.t_us - b.r.t_us || a.i - b.i).map((x) => x.r);
+  file = join(synth.dir, "fader.jsonl");
+  writeFileSync(file, recs.map(formatLine).join(""));
+});
+after(() => synth.cleanup());
+
+test("faderValues: a value per CC 41 with the last CC 9 of that channel; a CC 41 before any CC 9 is skipped", () => {
+  const r = [toRecord({ status: 0xb0, data: [41, 5] }, 1), ...fader(1, 12345, 2), ...fader(2, 7, 3),
+    toRecord({ status: 0xb0, data: [41, 0] }, 4)];
+  assert.deepEqual(faderValues(r, { ch: 1 }), [{ t_us: 2, value: 12345 }, { t_us: 4, value: (12345 >> 7) << 7 }]);
+  assert.deepEqual(faderValues(r, { ch: 2 }), [{ t_us: 3, value: 7 }]);
+});
+
+test("faderHolds: values that stood minHoldUs or more, the last one up to endUs", () => {
+  const v = [{ t_us: 0, value: 1 }, { t_us: 100, value: 2 }, { t_us: 600, value: 3 }];
+  assert.deepEqual(faderHolds(v, { minHoldUs: 400, endUs: 1000 }), [
+    { fromUs: 100, toUs: 600, value: 2 }, { fromUs: 600, toUs: 1000, value: 3 }]);
+  assert.deepEqual(faderHolds(v, { minHoldUs: 501, endUs: 1000 }), []);
+});
+
+test("holds: each fader value with motorRatioFromFader and the platter's speed, sweeps counted by Range", () => {
+  const r = faderSweeps(P, recs, { deck: 2 });
+  assert.equal(r.faderMessages, 4);
+  assert.deepEqual(r.holds.map((h) => [h.sweep, h.value, h.expected]),
+    [[1, 8192, 1], [1, 16383, 1.5], [2, 0, 0.5], [3, 8192, 1]]);
+  for (const h of r.holds) {
+    assert.ok(Math.abs(h.device / h.expected - 1) < 0.005, `${h.value}: device ${h.device}`);
+    assert.ok(Math.abs(h.est.mean / h.expected - 1) < 0.01, `${h.value}: estimator ${h.est.mean}`);
+    assert.ok(h.est.windowMin <= h.est.mean && h.est.mean <= h.est.windowMax);
+  }
+  assert.deepEqual(r.rangePresses, [{ t_us: 5000000, ms: 150 }, { t_us: 8500000, ms: 100 }]);
+});
+
+test("others: every message that is not a platter pair or this deck's fader", () => {
+  const r = faderSweeps(P, recs, { deck: 2 });
+  assert.deepEqual(r.others.map((m) => `${m.type} ${m.ch} ${m.d1}`),
+    ["on 2 43", "off 2 43", "on 2 43", "off 2 43", "on 16 50", "cc 1 9", "cc 1 41"]);
+});
+
+test("lag: the best fit and the steepest sections find the platter 40 ms behind the fader", () => {
+  const { lag } = faderSweeps(P, recs, { deck: 2 });
+  assert.ok(Math.abs(lag.centre - 1) < 0.005, String(lag.centre));
+  assert.ok(Math.abs(lag.bestMs - 40) <= 5, String(lag.bestMs));
+  assert.ok(lag.estBestMs >= lag.bestMs, "the estimator lags the device time");
+  assert.equal(lag.bins.length, 8);
+  for (const b of lag.bins.filter((x) => x.windows > 0)) assert.ok(Math.abs(b.off) < 0.005, JSON.stringify(b));
+  assert.deepEqual(lag.bins.map((b) => b.windows > 0), [true, false, false, false, true, false, false, true]);
+  assert.equal(lag.steep.length, 3);
+  for (const s of lag.steep) {
+    assert.equal(s.faderMs, 0, "a one-message step");
+    assert.ok(Math.abs(s.lagMs - 40) <= 6, JSON.stringify(s));
+  }
+  assert.deepEqual(lag.steep.map((s) => [s.from, s.to]), [[8192, 16383], [16383, 0], [0, 8192]]);
+});
+
+test("no centre hold: no lag, and nothing throws", () => {
+  const r = faderSweeps(P, recs.filter((x) => !(x.t_us === 200000 || x.t_us === 10500000 - LAG_US)), { deck: 2 });
+  assert.equal(r.lag.bestMs, null);
+  assert.deepEqual(faderSweeps(P, [], { deck: 1 }).holds, []);
+});
+
+test("the CLI prints the holds, Range presses, other messages and lag; --json carries the same", () => {
+  const t = run(file, "--deck", "2");
+  assert.equal(t.status, 0, t.stderr);
+  assert.match(t.stdout, /deck 2, fader CC 9\/41 on ch 2: 4 values, 4 holds/);
+  assert.match(t.stdout, /^ {4}2 +6\.960 +10\.460 +0 +0\.50000 +0\.5000\d /m);
+  assert.match(t.stdout, /^range: note 43 ch 2 at 5\.000 s \(150\.0 ms\)$/m);
+  assert.match(t.stdout, /^ {2}on ch 16 50 ×1: 9\.000 s$/m);
+  assert.match(t.stdout, /^lag: centre speed (0\.99|1\.00)\d+; best fit (35|40|45) ms behind the fader/m);
+  const j = run(file, "--deck", "2", "--json");
+  assert.equal(j.status, 0, j.stderr);
+  const o = JSON.parse(j.stdout);
+  assert.equal(o.file, file);
+  assert.equal(o.holds.length, 4);
+  assert.match(run(file).stdout, /deck 1, fader CC 9\/41 on ch 1: 1 values, 1 holds/, "deck 1: the one ch 1 pair");
+});
+
+test("faderExpected: off until Play, then motorRatioFromFader of the fader delayMs ago, off again on the next press", () => {
+  const r = [note(0x90, 1, 0, 127, 1000), note(0x80, 1, 0, 0, 1500), ...fader(1, 16383, 2000), ...fader(1, 0, 3000),
+    note(0x90, 1, 0, 127, 4000), ...fader(1, 8192, 5000), note(0x90, 1, 0, 127, 6000)];
+  assert.deepEqual(faderExpected(P, r, { deck: 1 }),
+    [{ t_us: 0, e: 0 }, { t_us: 1000, e: 1 }, { t_us: 2000, e: 1.5 }, { t_us: 3000, e: 0.5 }, { t_us: 4000, e: 0 },
+      { t_us: 6000, e: 1 }]);
+  const late = faderExpected(P, r, { deck: 1, delayMs: 1 });
+  assert.deepEqual(late, [{ t_us: 0, e: 0 }, { t_us: 1000, e: 1 }, { t_us: 3000, e: 1.5 }, { t_us: 4000, e: 0 },
+    { t_us: 6000, e: 1 }], "the 0 arrives with the press at 4000: off wins");
+  assert.deepEqual(faderExpected(P, r, { deck: 2 }), [{ t_us: 0, e: 0 }]);
+});
+
+test("platter-run --expected fader[:<ms>]: the fader sets expectedRatio while the motor is on", () => {
+  const withPlay = [...recs, note(0x90, 2, 0, 127, 100000), note(0x80, 2, 0, 0, 160000)].map((r, i) => ({ r, i }))
+    .sort((a, b) => a.r.t_us - b.r.t_us || a.i - b.i).map((x) => x.r);
+  const f = join(synth.dir, "fader-play.jsonl");
+  writeFileSync(f, withPlay.map(formatLine).join(""));
+  const pr = (...a) => spawnSync(join(ROOT, "tools", "platter-run"), [f, "--deck", "2", ...a], { encoding: "utf8" });
+  const t = pr("--expected", "fader:40");
+  assert.equal(t.status, 0, t.stderr);
+  assert.match(t.stdout, /the pitch fader 40 ms ago sets it \(--expected fader\); 4 changes/);
+  assert.doesNotMatch(t.stdout, /expectedRatio 1\.5/, "fader changes are counted, not listed");
+  // The synthetic platter spins before Play (scratching until the press); after it, no takeover: the platter
+  // follows the fader 40 ms late, as the expectedRatio does.
+  assert.equal(t.stdout.match(/scratching/g).length, 1, t.stdout);
+  assert.ok(t.stdout.indexOf("scratching") < t.stdout.indexOf("press note 0"), "the one takeover is before Play");
+  assert.ok(pr("--expected", "fader").stdout.match(/scratching/g).length > 1, "with no delay the 0.5x steps take over");
+  const j = pr("--expected", "fader", "--json");
+  const kinds = j.stdout.trim().split("\n").map((l) => JSON.parse(l)).filter((c) => c.kind === "expected");
+  assert.deepEqual(kinds.map((c) => c.expectedRatio), [1, 1.5, 0.5, 1]);
+});
