@@ -0,0 +1,157 @@
+// The committed MK1 control map (M5-03): reference/rane-one-mk1-midi-map.csv and reference/rane-one-mk1-vs-mk2.csv
+// reproduce from captures/2026-10-23-census/ byte for byte (the date in the first comment line aside), and
+// reference/rane-one-mk1-controls.csv names every map row once, with evidence that holds in the takes.
+// Spec: docs/plans/2026-10-24-M5-truth.md (B8); the analysis is docs/research/2026-10-24-census-analysis.md § Census.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { mkdtempSync, readFileSync, existsSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+import { readJsonl } from "../tools/lib/jsonl.mjs";
+import { parseCsv, readCensusCsv } from "../tools/lib/census.mjs";
+
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), "..");
+const TOOL = join(ROOT, "tools", "census");
+const DIR = "captures/2026-10-23-census";
+const MAP = "reference/rane-one-mk1-midi-map.csv";
+const DIFF = "reference/rane-one-mk1-vs-mk2.csv";
+const CONTROLS = "reference/rane-one-mk1-controls.csv";
+const MK2 = "reference/rane-one-mk2-djay-midi-map.csv";
+const TAKES = ["02-census-mixer", "03-census-d1-controls", "04-census-d1-pads", "05-census-d2-controls",
+  "06-census-d2-pads", "27-census-d1-pads-shift", "28-census-d2-pads-shift"].map((t) => `${DIR}/${t}.jsonl`);
+const MAP_ARGS = [...TAKES, "--shift", "16:50", "--out", MAP, "--force"];
+const DIFF_ARGS = ["--diff", MK2, "--out", DIFF, "--force"];
+
+const read = (rel) => readFileSync(join(ROOT, rel), "utf8");
+const run = (args) => spawnSync(TOOL, args, { encoding: "utf8", cwd: ROOT });
+const DATE = /\d{4}-\d{2}-\d{2}$/;
+
+// Runs the committed command with --out pointed at a temp file; returns [committed lines, rerun lines] with the
+// first line's date and --out path made equal, so the comparison is byte for byte on everything else.
+function rerun(rel, args) {
+  const out = join(mkdtempSync(join(tmpdir(), "census-map-")), "out.csv");
+  const r = run(args.map((a) => (a === rel ? out : a)));
+  assert.equal(r.status, 0, r.stderr);
+  const again = readFileSync(out, "utf8").split("\n");
+  const committed = read(rel).split("\n");
+  assert.match(committed[0], DATE, "the first comment line ends with the date");
+  again[0] = again[0].replace(out, rel).replace(DATE, committed[0].match(DATE)[0]);
+  return [committed, again];
+}
+
+test(`${MAP} is what its first comment line's command writes: 134 rows, Shift column filled`, () => {
+  const text = read(MAP);
+  assert.equal(text.split("\n")[0].replace(DATE, "D"), `# rane-one-mk1-midi-map · tools/census ${MAP_ARGS.join(" ")} · D`);
+  const [committed, again] = rerun(MAP, MAP_ARGS);
+  assert.deepEqual(again, committed);
+  const rows = readCensusCsv(text);
+  assert.equal(rows.length, 134);
+  assert.ok(rows.every((r) => ["true", "false", "both"].includes(r.shift)), "every row has a shift value");
+  assert.ok(rows.every((r) => r.source_file.split(";").every((f) => TAKES.includes(f))));
+});
+
+test(`${DIFF} is what its first comment line's command writes (the MK2 diff of the committed map)`, () => {
+  assert.equal(read(DIFF).split("\n")[0].replace(DATE, "D"), `# rane-one-mk1-vs-mk2 · tools/census ${DIFF_ARGS.join(" ")} · D`);
+  const [committed, again] = rerun(DIFF, DIFF_ARGS);
+  assert.deepEqual(again, committed);
+  // The same diff lines as the census of the takes, without the file in between.
+  const direct = run(["--diff", MK2, ...TAKES]);
+  assert.equal(direct.status, 0, direct.stderr);
+  assert.equal(committed.filter((l) => !l.startsWith("#")).join("\n"), direct.stdout);
+});
+
+// ---- reference/rane-one-mk1-controls.csv ----
+
+const CONTROL_HEADER = ["status", "channel", "number", "name", "evidence", "confidence"];
+const table = parseCsv(read(CONTROLS).split("\n").filter((l) => !l.startsWith("#")).join("\n"));
+const controls = table.slice(1).map((r) => Object.fromEntries(CONTROL_HEADER.map((h, i) => [h, r[i]])));
+const key = (r) => `${r.status}/${r.channel}/${r.number}`;
+const mk2Keypaths = new Set(parseCsv(read(MK2)).slice(1).map((r) => r[1]).filter(Boolean));
+
+// One evidence item: "<take>.jsonl@<from>-<to>" (seconds into the take) or "mk2:<djay keyPath>".
+const TAKE_ITEM = /^(\d\d-[a-z0-9-]+\.jsonl)@(\d+(?:\.\d+)?)-(\d+(?:\.\d+)?)$/;
+const items = (r) => r.evidence.split(";").map((s) => s.trim());
+
+test(`${CONTROLS} has the columns ${CONTROL_HEADER.join(",")}, one row per control, confidence capture|mk2|unknown`, () => {
+  assert.deepEqual(table[0], CONTROL_HEADER);
+  for (const r of table.slice(1)) assert.equal(r.length, CONTROL_HEADER.length, r.join(","));
+  const seen = new Set();
+  for (const r of controls) {
+    assert.ok(!seen.has(key(r)), `${key(r)} named twice`);
+    seen.add(key(r));
+    assert.ok(["capture", "mk2", "unknown"].includes(r.confidence), `${key(r)}: confidence ${r.confidence}`);
+    assert.ok(r.name.trim().length > 0, `${key(r)} has no name`);
+    assert.match(r.status, /^(90|B0|E0)$/);
+    assert.ok(+r.channel >= 1 && +r.channel <= 16);
+  }
+});
+
+test(`every data row of ${MAP} has exactly one row in ${CONTROLS}`, () => {
+  const rows = readCensusCsv(read(MAP));
+  for (const m of rows) {
+    const hits = controls.filter((c) => c.status === m.status && +c.channel === m.channel && c.number === String(m.number ?? ""));
+    assert.equal(hits.length, 1, `${m.control}: ${hits.length} rows in ${CONTROLS}`);
+  }
+});
+
+test(`every evidence item holds: the take has that control's message in the time range, or the MK2 map has the keyPath`, () => {
+  const takes = new Map();
+  const take = (file) => {
+    if (!takes.has(file)) {
+      assert.ok(existsSync(join(ROOT, DIR, file)), `${file} is not in ${DIR}`);
+      takes.set(file, readJsonl(join(ROOT, DIR, file)));
+    }
+    return takes.get(file);
+  };
+  const STATUS = { on: "90", off: "90", cc: "B0", pb: "E0" };
+  for (const r of controls) {
+    const ev = items(r);
+    assert.ok(ev.length > 0 && ev.every((e) => e !== ""), `${key(r)}: empty evidence`);
+    for (const e of ev) {
+      if (e.startsWith("mk2:")) {
+        assert.ok(mk2Keypaths.has(e.slice(4)), `${key(r)}: ${e} is not a keyPath of the MK2 map`);
+        continue;
+      }
+      const m = TAKE_ITEM.exec(e);
+      assert.ok(m, `${key(r)}: evidence item ${JSON.stringify(e)} is neither take@from-to nor mk2:keyPath`);
+      const [from, to] = [+m[2] * 1e6, +m[3] * 1e6];
+      assert.ok(from <= to, `${key(r)}: ${e}`);
+      // Ranges are written to 0.01 s: a message counts if it falls within 5 ms of either end.
+      const hit = take(m[1]).some((x) => STATUS[x.type] === r.status && x.ch === +r.channel &&
+        (r.number === "" ? x.d1 !== undefined : x.d1 === +r.number) && x.t_us >= from - 5000 && x.t_us <= to + 5000);
+      assert.ok(hit, `${key(r)}: no such message in ${e}`);
+    }
+    if (r.confidence === "capture") assert.ok(ev.some((e) => TAKE_ITEM.test(e)), `${key(r)}: capture needs a take`);
+    if (r.confidence === "mk2") assert.ok(ev.some((e) => e.startsWith("mk2:")), `${key(r)}: mk2 needs a keyPath`);
+  }
+});
+
+test("Shift is note 50 on channel 16 (capture); pads 20-27 and their Shift layer 28-35, and the five pad-mode buttons, on both decks", () => {
+  const at = (status, ch, n) => controls.find((c) => c.status === status && +c.channel === ch && c.number === String(n));
+  assert.equal(at("90", 16, 50).name, "Shift");
+  assert.equal(at("90", 16, 50).confidence, "capture");
+  for (const [deck, ch] of [[1, 5], [2, 6]]) {
+    for (let p = 1; p <= 8; p++) {
+      assert.deepEqual([at("90", ch, 19 + p).name, at("90", ch, 19 + p).confidence], [`Deck ${deck} pad ${p}`, "capture"]);
+      assert.deepEqual([at("90", ch, 27 + p).name, at("90", ch, 27 + p).confidence], [`Deck ${deck} pad ${p} with Shift`, "capture"]);
+    }
+    for (const n of [0, 7, 11, 12, 13]) assert.match(at("90", ch, n).name, new RegExp(`^Deck ${deck} pad mode `));
+  }
+});
+
+test("Play is note 0 on the deck's channel (capture), cited at every motor start and stop press of the motor takes (M5-05)", () => {
+  const at = (ch) => controls.find((c) => c.status === "90" && +c.channel === ch && c.number === "0");
+  const want = {
+    1: ["15-motor-d1-33", "19-motor-d1-stop-min", "20-motor-d1-stop-max", "23-pitch-d1", "25-motor-toggle"],
+    2: ["21-motor-d2-33", "24-pitch-d2", "33-motor-d2-stop-min", "34-motor-d2-stop-max"],
+  };
+  for (const ch of [1, 2]) {
+    const r = at(ch);
+    assert.equal(r.name, `Deck ${ch} Play`);
+    assert.equal(r.confidence, "capture");
+    const cited = items(r).map((e) => TAKE_ITEM.exec(e)?.[1]).filter(Boolean);
+    assert.deepEqual(cited, want[ch].map((t) => `${t}.jsonl`));
+  }
+});
