+  const recs = take([[1000, -10, 29310], [1000, -1, 16383], [1000, -1, 3011], [1000, 3, 9000], [1000, 1, 3000],
+    [1000, -2, 6000], [1000, -1, 3000], [25_000, -1, 3000]]);
