+#!/usr/bin/env node
+// Runs every platter take of the 2026-10-23 census through tools/platter-run's core run, with the deck and
+// --expected each take needs, and prints one summary line per take: the arguments, the glitch count (control flips
+// that flip back within 20 ms), takeovers, decoder counts and the states in order (M5-08).
+// Exit: 0 run · 1 a take missing or unreadable · 2 usage
+// Spec: docs/plans/2026-10-24-M5-truth.md, Tool changes; the table is tools/lib/platter-run-all.mjs.
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { loadPlatter } from "./lib/load-platter.mjs";
+import { runAll, formatLine, TAKES, CENSUS_DIR } from "./lib/platter-run-all.mjs";
+
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), "..");
+const USAGE = "usage: tools/platter-run-all [--dir <captures dir>] [--json]";
+const HELP = `${USAGE}
+Runs the ${TAKES.length} platter takes of ${CENSUS_DIR}/ (07-15, 17-21, 23-26, 29-34; 16 and 22 are not data)
+through the platter core exactly as tools/platter-run <take> <args> does, with the arguments
+tools/lib/platter-run-all.mjs lists for each take, and prints one line per take:
+  <nn> <args> | glitches <n> | to platter <n> | <decoder counts> | shrink … | end <s> | <state> <s>, Play <s>, …
+glitches: control flips that flip back within 20 ms (each listed with its time); to platter: changes of control
+from the clock to the platter; shrink: the decoder's largest per-tick interval shrink, overall and after a host gap
+of 2.9 ms or more (WRAP_JUMP judges those). A last line totals the glitches.
+  --dir <dir>  where the takes are (default ${CENSUS_DIR} in this checkout)
+  --json       one JSON object per take instead
+Exit: 0 run · 1 a take missing or unreadable · 2 usage
+`;
+
+function usage(why) {
+  if (why) process.stderr.write(`platter-run-all: ${why}\n`);
+  process.stderr.write(USAGE + "\n");
+  process.exit(2);
+}
+
+const args = process.argv.slice(2);
+if (args.length === 1 && args[0] === "--help") {
+  process.stdout.write(HELP);
+  process.exit(0);
+}
+let dir = join(ROOT, CENSUS_DIR), json = false;
+const seen = new Set();
+for (let i = 0; i < args.length; i++) {
+  const a = args[i];
+  if (seen.has(a)) usage(`${a} given twice`);
+  seen.add(a);
+  if (a === "--json") json = true;
+  else if (a === "--dir") {
+    dir = args[++i];
+    if (dir === undefined) usage("--dir needs a value");
+  } else usage(a.startsWith("-") ? `unknown option ${a}` : `unexpected argument ${a}`);
+}
+
+let sums;
+try {
+  sums = runAll(loadPlatter(), dir);
+} catch (err) {
+  process.stderr.write(`platter-run-all: ${err.message}\n`);
+  process.exit(1);
+}
+// No process.exit after a write: a pipe would get only the first 64 KiB.
+const bad = sums.filter((s) => s.glitches.length > 0);
+const total = sums.reduce((n, s) => n + s.glitches.length, 0);
+if (json) process.stdout.write(sums.map((s) => JSON.stringify(s) + "\n").join(""));
+else {
+  process.stdout.write(sums.map(formatLine).join("\n") + "\n" +
+    `${sums.length} takes: ${total} control flips under 20 ms` +
+    (bad.length > 0 ? ` (${bad.map((s) => s.file.slice(0, 2)).join(", ")})` : "") + "\n");
+}
diff --git a/tools/platter-windows b/tools/platter-windows
new file mode 100755
index 0000000..00e0e98
--- /dev/null
+++ b/tools/platter-windows
@@ -0,0 +1,125 @@
+#!/usr/bin/env node
+// One deck of a platter capture (M2 JSONL) through the pure platter core, cut into fixed host-time windows: per
+// window the net ticks, the host-time and device-timed speed ratio, the estimator's ratio range, the saturation
+// markers and the state; then the whole span, and the first time the estimator's ratio crosses each --cross
+// threshold after --from (M5-05: spin-up, spin-down, hold, dither and backspin numbers of
+// docs/research/2026-10-24-census-analysis.md § Motor).
+// Exit: 0 run · 1 unreadable file or a line that breaks the M2 format · 2 usage
+// Spec: docs/plans/2026-10-24-M5-truth.md, Tool changes; the windows are tools/lib/platter-windows.mjs.
+import { readJsonl } from "./lib/jsonl.mjs";
+import { loadPlatter } from "./lib/load-platter.mjs";
+import { platterWindows, parseThresholds } from "./lib/platter-windows.mjs";
+import { parseDeck, deckHelp, PLAY_NOTE } from "./lib/deck.mjs";
+import { DECIMAL } from "./lib/numbers.mjs";
+
+const USAGE = "usage: tools/platter-windows <capture.jsonl> [--deck 1|2] [--window-ms 200] [--from <s>] [--to <s>] [--cross <ratio>,…] [--json]";
+const HELP = `${USAGE}
+Runs one deck of a capture through the platter core in mapping/rane-one-platter.js (as tools/platter-run does) and
+prints one row per window of host time from --from to --to. Ratios are signed speeds over 33 1/3 rpm at 3600
+ticks/rev (2000 ticks/s); a platter turning backward reads negative.
+${deckHelp(19)}
+  --window-ms <n>  the window length in ms, 1-600000 (default 200: the core's HOST_WINDOW_MS)
+  --from <s>       the span's start in seconds of t_us (default: the first message); also where --cross starts
+  --to <s>         the span's end, exclusive (default and limit: the last message's time)
+  --cross <list>   thresholds, e.g. 0.1,0.99 or -0.5: for each, the first estimator update in the span on the
+                   other side of the first one's (a rise or a fall), with its time and the ms after --from
+  --json           print one JSON object
+Columns: window start (s), samples (CC 6/pitch bend pairs), net ticks, host ratio (net ticks over the window's
+seconds), device ratio (ticks of the timed deltas over their device time; -1/-2 markers are left out, so it reads
+high beside them), the estimator's min/mean/max ratio (heartbeats included), the per-message device ratio's min and
+max, the share of samples the estimator timed by the device, markers, and the state at the window's end. The deck's
+note ${PLAY_NOTE} presses are listed first; as in tools/platter-run they toggle the expectedRatio the state column is
+made with (off at the start), so a take that begins with the motor running needs tools/platter-run --expected for its
+states. Net ticks and the host ratio include the start backlog (messages in the first ms); --from 0.001 leaves it out.
+Exit: 0 run · 1 unreadable file or a line that breaks the M2 format · 2 usage
+`;
+
+function usage(why) {
+  if (why) process.stderr.write(`platter-windows: ${why}\n`);
+  process.stderr.write(USAGE + "\n");
+  process.exit(2);
+}
+
+const args = process.argv.slice(2);
+if (args.length === 1 && args[0] === "--help") {
+  process.stdout.write(HELP);
+  process.exit(0);
+}
+let file = null, deck = 1, windowMs = 200, from = null, to = null, cross = [], json = false;
+const seen = new Set();
+for (let i = 0; i < args.length; i++) {
+  const a = args[i];
+  if (!a.startsWith("-") || a === "-") {
+    if (a === "-") usage("reading stdin is not supported");
+    if (file !== null) usage(`unexpected argument ${a}`);
+    file = a;
+    continue;
+  }
+  if (seen.has(a)) usage(`${a} given twice`);
+  seen.add(a);
+  if (a === "--json") {
+    json = true;
+    continue;
+  }
+  const v = args[++i];
+  if (v === undefined) usage(`${a} needs a value`);
+  if (a === "--deck") {
+    deck = parseDeck(v);
+    if (deck === null) usage(`bad --deck ${v}`);
+  } else if (a === "--window-ms") {
+    if (!DECIMAL.test(v) || !(Number(v) >= 1 && Number(v) <= 600000)) usage(`bad --window-ms ${v}`);
+    windowMs = Number(v);
+  } else if (a === "--from" || a === "--to") {
+    if (!DECIMAL.test(v)) usage(`bad ${a} ${v}`);
+    if (a === "--from") from = Number(v);
+    else to = Number(v);
+  } else if (a === "--cross") {
+    cross = parseThresholds(v);
+    if (cross === null) usage(`bad --cross ${v}`);
+  } else usage(`unknown option ${a}`);
+}
+if (file === null) usage();
+if (from !== null && to !== null && !(from < to)) usage("--from must be before --to");
+
+let recs;
+try {
+  recs = readJsonl(file);
+} catch (err) {
+  process.stderr.write(`platter-windows: ${err.code ? `${file}: ${err.message}` : err.message}\n`);
+  process.exit(1);
+}
+const us = (s) => (s === null ? undefined : Math.round(s * 1e6));
+const w = platterWindows(loadPlatter(), recs, { deck, windowMs, fromUs: us(from), toUs: us(to), cross });
+
+// No process.exit after a write: a pipe would get only the first 64 KiB.
+if (json) process.stdout.write(JSON.stringify({ file, ...w }) + "\n");
+else process.stdout.write(text(w).join("\n") + "\n");
+
+function text(w) {
+const sec = (t) => (t / 1e6).toFixed(3);
+const sgn = (x, d) => (x === null ? "-" : `${x >= 0 ? "+" : "-"}${Math.abs(x).toFixed(d)}`);
+const fmt = (x) => String(Number(x.toFixed(6)));
+const out = [`${file}: deck ${deck} (CC 6 + pitch bend on ch ${deck}), ${w.decoderStats.samples} samples; windows of ` +
+  `${fmt(w.windowMs)} ms; ratio 1 = 33 1/3 rpm at 3600 ticks/rev (${w.nominal} ticks/s)`];
+for (const p of w.presses) {
+  out.push(`press note ${PLAY_NOTE} ch ${p.ch} at ${sec(p.t_us)} s (${p.ms === null ? "no release" : `${fmt(p.ms)} ms`})`);
+}
+out.push("   from s  pairs    net     host   device   est min     mean      max   raw min      max  timed  mark  state");
+for (const x of w.windows) {
+  out.push([sec(x.fromUs).padStart(9), String(x.samples).padStart(6), sgn(x.netTicks, 0).padStart(6),
+    sgn(x.hostRatio, 4).padStart(8), sgn(x.deviceRatio, 4).padStart(8),
+    sgn(x.est?.min ?? null, 4).padStart(9), sgn(x.est?.mean ?? null, 4).padStart(8), sgn(x.est?.max ?? null, 4).padStart(8),
+    sgn(x.raw?.min ?? null, 4).padStart(9), sgn(x.raw?.max ?? null, 4).padStart(8),
+    (x.timedShare === null ? "-" : `${Math.round(100 * x.timedShare)}%`).padStart(6), String(x.markers).padStart(5),
+    ` ${x.state ?? "-"}`].join(" "));
+}
+const s = w.span;
+out.push(`span ${sec(s.fromUs)}-${sec(s.toUs)} s: ${s.samples} samples, net ${sgn(s.netTicks, 0)} ticks, host ratio ` +
+  `${sgn(s.hostRatio, 5)}, device ratio ${sgn(s.deviceRatio, 5)}, estimator ${sgn(s.est?.min ?? null, 4)} to ` +
+  `${sgn(s.est?.max ?? null, 4)} (mean ${sgn(s.est?.mean ?? null, 5)}), per message ${sgn(s.raw?.min ?? null, 4)} to ` +
+  `${sgn(s.raw?.max ?? null, 4)}, ${s.markers} markers`);
+for (const c of w.crossings) {
+  out.push(`cross ${sgn(c.threshold, 2)}: ${c.t_us === null ? "never" : `${sec(c.t_us)} s (${fmt(c.ms)} ms after ${sec(s.fromUs)} s)`}`);
+}
+return out;
+}
diff --git a/tools/take-events b/tools/take-events
new file mode 100755
index 0000000..eb2a76e
--- /dev/null
+++ b/tools/take-events
@@ -0,0 +1,71 @@
+#!/usr/bin/env node
+// Lists every message of a capture (M2 JSONL) with its time in seconds, `type ch d1 d2` (a pitch bend: its 14-bit
+// value), so the message lists in docs/research/2026-10-24-census-analysis.md can be re-run (M5-04).
+// Exit: 0 listed · 1 unreadable file or a line that breaks the M2 format · 2 usage
+import { readJsonl } from "./lib/jsonl.mjs";
+import { DECIMAL } from "./lib/numbers.mjs";
+import { takeEvents, formatEvent } from "./lib/take-events.mjs";
+
+const USAGE = "usage: tools/take-events <capture.jsonl> [--no-platter] [--from <s>] [--to <s>] [--json]";
+const HELP = `${USAGE}
+Every message of an M2 capture, one per line: time in seconds of t_us, type, channel, data bytes (a pitch bend
+shows its 14-bit value).
+  --no-platter  leave out CC 6 and pitch bends on channels 1 and 2 (the decks' platters); the header counts them
+  --from <s>    first second shown (default: the start)
+  --to <s>      shown up to, not including, this second (default: the end)
+  --json        print one JSON object: {file, messages, hidden, events: [M2 records]}
+Exit: 0 listed · 1 unreadable file or a line that breaks the M2 format · 2 usage
+`;
+
+function usage(why) {
+  if (why) process.stderr.write(`take-events: ${why}\n`);
+  process.stderr.write(USAGE + "\n");
+  process.exit(2);
+}
+
+const args = process.argv.slice(2);
+if (args.length === 1 && args[0] === "--help") {
+  process.stdout.write(HELP);
+  process.exit(0);
+}
+let file = null, noPlatter = false, json = false, from = null, to = null;
+const seen = new Set();
+for (let i = 0; i < args.length; i++) {
+  const a = args[i];
+  if (!a.startsWith("-") || a === "-") {
+    if (a === "-") usage("reading stdin is not supported");
+    if (file !== null) usage(`unexpected argument ${a}`);
+    file = a;
+    continue;
+  }
+  if (seen.has(a)) usage(`${a} given twice`);
+  seen.add(a);
+  if (a === "--no-platter") noPlatter = true;
+  else if (a === "--json") json = true;
+  else if (a === "--from" || a === "--to") {
+    const v = args[++i];
+    if (v === undefined || !DECIMAL.test(v)) usage(`bad ${a} ${v ?? "(none)"}`);
+    if (a === "--from") from = Number(v);
+    else to = Number(v);
+  } else usage(`unknown option ${a}`);
+}
+if (file === null) usage();
+if (to !== null && !(to > (from ?? 0))) usage("--to must be after --from (and after 0)");
+
+let recs;
+try {
+  recs = readJsonl(file);
+} catch (err) {
+  process.stderr.write(`take-events: ${err.code ? `${file}: ${err.message}` : err.message}\n`);
+  process.exit(1);
+}
+const { events, hidden } = takeEvents(recs, { noPlatter, fromUs: (from ?? -Infinity) * 1e6, toUs: (to ?? Infinity) * 1e6 });
+// No process.exit after a write: a pipe would get only the first 64 KiB.
+if (json) {
+  process.stdout.write(JSON.stringify({ file, messages: recs.length, hidden, events }) + "\n");
+} else {
+  const span = from !== null || to !== null ? ` (${from ?? 0}-${to ?? "end"} s)` : "";
+  const left = noPlatter ? `, ${hidden} CC 6/pitch bend on ch 1-2 left out` : "";
+  const out = [`${file}: ${recs.length} messages, ${events.length} shown${span}${left}`, ...events.map(formatEvent)];
+  process.stdout.write(out.join("\n") + "\n");
+}
