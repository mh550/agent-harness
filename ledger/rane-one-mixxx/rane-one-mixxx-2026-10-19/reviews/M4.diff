+// Pushes `ticks` as markers every `everyMs` (timer -1 each) with heartbeats every 20 ms between them, from `fromUs`
+// for `ms`; returns the results with their times.
+function creep(est, { ticks, timer, fromUs, everyMs, ms, step = 1 }) {
+  const out = [];
+  let nextReal = fromUs + everyMs * 1000;
+  for (let t = fromUs + 20000; t <= fromUs + ms * 1000; t += 20000) {
+    while (nextReal <= t) {
+      ticks += step;
+      timer -= 1;
+      out.push({ t: nextReal, real: true, ...plain(est.push({ ticks, timer, hostTimeUs: nextReal })) });
+      nextReal += everyMs * 1000;
+    }
+    if (t !== nextReal - everyMs * 1000) out.push({ t, ...plain(est.push({ ticks, timer: null, hostTimeUs: t })) });
+  }
+  return out;
+}
+
+for (const everyMs of [25, 33, 40, 60]) {
+  test(`after timed motion, a creep of 1 tick per ${everyMs} ms (markers, heartbeats between) reads it within 60 ms`, () => {
+    const est = P.createSpeedEstimator();
+    for (let i = 0; i <= 300; i++) est.push(at1(2 * i, 1000 * i));
+    const truth = 1 / (everyMs / 1000) / 2000;
+    const out = creep(est, { ticks: 600, timer: Math.round(600 * TPT), fromUs: 300000, everyMs, ms: 1000 });
+    const late = out.filter((r) => r.t >= 360000);
+    const bad = late.filter((r) => r.timed || Math.abs(r.ratio - truth) > 0.03);
+    assert.deepEqual(bad.slice(0, 3), [], `truth ${truth.toFixed(4)}`);
+  });
+}
