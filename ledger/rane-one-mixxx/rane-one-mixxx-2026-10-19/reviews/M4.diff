+  const t0 = Math.round(600 * TPT);
+  const held = plain(est.push({ ticks: 602, timer: t0 - 1, hostTimeUs: 340000, untrusted: true }));
+  assert.ok(Math.abs(held.ratio - 1) < 0.002 && held.timed, `the burst's first sample: ${JSON.stringify(held)}`);
+  const next = plain(est.push({ ticks: 604, timer: t0 - 1 + 2822, hostTimeUs: 340000 }));
+  assert.ok(Math.abs(next.ratio - 1) < 0.002 && next.timed, `the next one: ${JSON.stringify(next)}`);
+  // STALL_MS after the last timed sample it is no longer held.
+  const late = P.createSpeedEstimator();
+  for (let i = 0; i <= 300; i++) late.push(at1(2 * i, 1000 * i));
