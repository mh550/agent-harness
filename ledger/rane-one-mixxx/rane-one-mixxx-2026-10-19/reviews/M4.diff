+// A stall-made takeover at speed, as in the test above: atSpeed, 100 ms at 1.0, then 70 ms of silence.
+function silentTakeover() {
+  const g = atSpeed();
+  g.run(100, { r: 1, e: 1 });
+  let t = g.now();
+  const ticks = g.last().ticks;
+  for (let k = 1; k <= 3; k++) g.sm.update({ ratio: k < 3 ? 1 : 0.008, hostTimeUs: (t += 20000), expectedRatio: 1, ticks });
+  let take;
+  for (let k = 0; k < 10; k++) take = plain(g.sm.update({ ratio: 0.008, hostTimeUs: (t += 1000), expectedRatio: 1, ticks }));
+  assert.equal(take.state, "held");
+  const next = (n, untrusted) =>
+    plain(g.sm.update({ ratio: 0.15, hostTimeUs: (t += 1000), expectedRatio: 1, ticks: ticks + n, untrusted })).position;
+  return { take, next };
+}
