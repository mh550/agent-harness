+test("D24: a host stall over STALL_MS at speed takes over, but the burst's ticks don't skip the track", () => {
+  // 80 ms with no MIDI at ratio 1.0, then the burst. The estimator reads ~0 after STALL_MS, so T7 takes over
+  // as held (plan, Speed estimator: a stall-made held). The clock already played the stall at 1.0, so the
+  // burst's ticks, which report that same motion, must not move the track a second time. The burst's first
+  // sample is the decoder's `untrusted` one (a host gap with the device still timing ticks), which confirms it.
+  const { out } = runEstimator(P, files.stall80);
+  const sm = P.createStateMachine();
+  let prev = null;
+  let first = null;
+  let worstStep = 0;
+  for (const o of out) {
+    const r = plain(sm.update({ ratio: o.ratio, hostTimeUs: o.t, expectedRatio: 1, ticks: o.ticks,
+      untrusted: o.untrusted }));
+    if (first === null && r.state === "motor_at_speed") first = { t: o.t, position: r.position };
+    if (prev !== null) {
+      const step = r.position - prev.position - (NOMINAL * (o.t - prev.t)) / 1e6;
+      worstStep = Math.max(worstStep, Math.abs(step));
+    }
+    prev = { t: o.t, position: r.position, state: r.state };
+  }
+  const tr = sm.stats().transitions;
+  assert.equal(tr["motor_at_speed>held"], 1, `the stall takes over: ${JSON.stringify(tr)}`);
+  assert.equal(prev.state, "motor_at_speed");
+  const untouched = first.position + ((prev.t - first.t) / 1e6) * NOMINAL;
+  assert.ok(Math.abs(prev.position - untouched) <= 3, `ends at ${prev.position}, untouched clock ${untouched}`);
+  assert.ok(worstStep <= 8, `largest jump against the clock between two updates: ${worstStep} ticks`);
+});
