+  assert.deepEqual(Object.keys(plain(est.stats())).sort(),
+    ["clampedTimes", "heldOverStall", "malformed", "pushed", "repeats", "reseeds", "ringSize", "timed", "untimed"]);
+});
+
+test("the first valid timer delta seeds the filter with its instantaneous ratio", () => {
+  const est = P.createSpeedEstimator();
+  est.push(at1(0, 0));
+  const r = plain(est.push({ ticks: 2, timer: 2822, hostTimeUs: 1000 }));
+  assert.equal(r.timed, true);
+  assert.ok(Math.abs(r.ratio - (2 * TPT) / 2822) < 1e-9, `ratio ${r.ratio}`);
