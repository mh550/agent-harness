+                const advance = Math.max(0, clockPosition - tickClock); // the clock's play since the last tick
+                const silent = from === "motor_at_speed" && t - tickUs >= stallUs;
+                if (ticks !== lastTicks) {
+                    tickUs = t;
+                    tickClock = clockPosition;
+                }
+                position = clockPosition;
+                if (!isClock) {
+                    takeoverPosition = position;
+                    takeoverTicks = ticks;
+                    peak = 0;
+                    absorb = 0;
+                    armed = 0;
+                    if (silent && ticks === lastTicks) {
+                        armed = advance;
+                    } else if (silent && untrusted) {
+                        absorb = Math.max(0, advance - (ticks - lastTicks));
+                        burstEndUs = t + burstUs;
+                    }
+                }
+            } else {
+                if (armed > 0 && ticks !== lastTicks) {
+                    absorb = untrusted ? armed : 0;
+                    burstEndUs = t + burstUs;
+                    armed = 0;
+                }
+                const moved = ticks - takeoverTicks;
+                if (absorb > 0 && t > burstEndUs) {
+                    absorb = Math.min(absorb, Math.max(0, peak));
+                }
+                peak = Math.max(peak, moved);
+                position = takeoverPosition + moved - Math.min(absorb, peak);
+                if (isClock) {
+                    clockPosition = position;
+                    tickUs = t;
+                    tickClock = position;
+                }
+            }
+            lastTicks = ticks;
+            lastUs = t;
+            lastE = e;
+            lastPlay = play;
+            result = {state: state, control: isClock ? "clock" : "platter", position: position};
+            return result;
+        };
+
+        const previous = function() {
+            stats.malformed++;
+            return Object.assign({}, result);
+        };
+
+        return {
+            update: function(input) {
+                try {
+                    const r = updateUnguarded(input);
+                    return r === null ? previous() : Object.assign({}, r);
+                } catch (ignored) {
+                    return previous();
+                }
+            },
+            stats: function() {
+                return {
+                    updates: stats.updates,
+                    transitions: Object.assign({}, stats.transitions),
+                    malformed: stats.malformed,
+                };
+            },
+        };
+    };
+
+    return Object.freeze({
+        DEFAULTS: DEFAULTS,
+        createDecoder: createDecoder,
+        createSpeedEstimator: createSpeedEstimator,
+        createStateMachine: createStateMachine,
+    });
+})();
diff --git a/tests/analyze-platter.test.mjs b/tests/analyze-platter.test.mjs
new file mode 100644
index 0000000..522e9fb
--- /dev/null
+++ b/tests/analyze-platter.test.mjs
@@ -0,0 +1,211 @@
+// tools/analyze-platter turns a platter capture (M2 JSONL) into per-phase numbers: message rate, CC-6 delta and
+// timestamp delta histograms, net ticks and the ticks per revolution they imply at an assumed rpm (M4-01). The
+// fixture is a 200-line synthetic capture written by this test, so every expected number below is known exactly.
+// Spec: docs/research/2026-10-19-quick-capture-analysis.md (how the real capture was analysed with this tool).
+import { test, after } from "node:test";
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { mkdtempSync, rmSync, writeFileSync, readFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+import { formatLine, toRecord } from "../tools/lib/jsonl.mjs";
+import { wrap, parsePhases, analyzePlatter } from "../tools/lib/platter-analysis.mjs";
+
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), "..");
+const TOOL = join(ROOT, "tools", "analyze-platter");
+const dir = mkdtempSync(join(tmpdir(), "analyze-platter-"));
+after(() => rmSync(dir, { recursive: true, force: true }));
+
+// 98 CC-6 + pitch-bend pairs and two note-0 presses on channel 1 = 200 lines:
+//   0.5 s     one anchor pair (CC 120, PB 16000), in no phase
+//   1-2 s     60 pairs 1 ms apart: CC +2 (wraps 127 → 1), PB alternately +2821 / +2823 (wraps 16383 → 0)
+//   3-4 s     20 pairs 50 ms apart: CC -1, PB -1 (the hold-phase pattern); the first pair's PB is 1 ms late
+//   5 s       note 0 on, off 95 ms later
+//   6-7 s     17 pairs 10 ms apart: CC +1, -1, +1, … (net +1), PB +3000
+//   8 s       note 0 on, off 110 ms later
+function fixture() {
+  const lines = [];
+  let cc = 120, pb = 16000;
+  const pair = (t_us, dcc, dpb, pbLate = 0) => {
+    cc = (cc + dcc + 128) % 128;
+    pb = (pb + dpb + 16384) % 16384;
+    lines.push(formatLine(toRecord({ status: 0xb0, data: [6, cc] }, t_us)));
+    lines.push(formatLine(toRecord({ status: 0xe0, data: [pb & 0x7f, pb >> 7] }, t_us + pbLate)));
+  };
+  const note = (t_us, ms) => {
+    lines.push(formatLine(toRecord({ status: 0x90, data: [0, 127] }, t_us)));
+    lines.push(formatLine(toRecord({ status: 0x80, data: [0, 0] }, t_us + ms * 1000)));
+  };
+  pair(500_000, 0, 0);
+  for (let k = 0; k < 60; k++) pair(1_000_000 + k * 1000, 2, k % 2 ? 2823 : 2821);
+  for (let k = 0; k < 20; k++) pair(3_000_000 + k * 50_000, -1, -1, k === 0 ? 1000 : 0);
+  note(5_000_000, 95);
+  for (let k = 0; k < 17; k++) pair(6_000_000 + k * 10_000, k % 2 ? -1 : 1, 3000);
+  note(8_000_000, 110);
+  return lines.join("");
+}
+const FIXTURE = join(dir, "synthetic.jsonl");
+writeFileSync(FIXTURE, fixture());
+const run = (...args) => spawnSync(TOOL, args, { encoding: "utf8" });
+
+test("the fixture is 200 lines", () => {
+  assert.equal(readFileSync(FIXTURE, "utf8").split("\n").length - 1, 200);
+});
+
+test("wrap gives the signed difference modulo m, in [-m/2, m/2)", () => {
+  assert.equal(wrap(1 - 127, 128), 2);
+  assert.equal(wrap(127 - 1, 128), -2);
+  assert.equal(wrap(64, 128), -64);
+  assert.equal(wrap(63, 128), 63);
+  assert.equal(wrap(0 - 16383, 16384), 1);
+  assert.equal(wrap(2822 - 16384, 16384), 2822);
+  assert.equal(wrap(-1, 16384), -1);
+});
+
+test("parsePhases reads from-to lists in seconds and refuses anything else", () => {
+  assert.deepEqual(parsePhases("2-8,9-15,20.5-36"), [{ from: 2, to: 8 }, { from: 9, to: 15 }, { from: 20.5, to: 36 }]);
+  for (const bad of ["", "2", "8-2", "2-2", "2-8,", "a-b", "-2-8", "2-8;9-15", "1e1-20", "2 -8"]) {
+    assert.equal(parsePhases(bad), null, bad);
+  }
+});
+
+test("analyzePlatter counts each phase's messages, histograms, net ticks and ticks per revolution", () => {
+  const recs = readFileSync(FIXTURE, "utf8").trim().split("\n").map((l) => JSON.parse(l));
+  const r = analyzePlatter(recs, parsePhases("1-2,3-4,6-7"), { rpm: 100 / 3 });
+  const [a, b, c] = r.phases;
+  assert.equal(a.messages, 60);
+  assert.equal(a.rate, 60);
+  assert.deepEqual(a.ccHist, { 2: 60 });
+  assert.deepEqual(a.tsHist, { 2821: 30, 2823: 30 });
+  assert.equal(a.netTicks, 120);
+  assert.equal(a.netTimer, 60 * 2822);
+  assert.equal(a.markers, 0);
+  assert.equal(a.timerPerTick, 1411);
+  // 1 s at 33⅓ rpm is 5/9 of a revolution: 120 ticks / (5/9) = 216 ticks per revolution
+  assert.ok(Math.abs(a.ticksPerRev - 216) < 1e-9, String(a.ticksPerRev));
+  assert.deepEqual(a.perSecond, [60]);
+  assert.equal(b.messages, 20);
+  assert.deepEqual(b.ccHist, { "-1": 20 });
+  assert.deepEqual(b.tsHist, { "-1": 20 });
+  assert.equal(b.netTicks, -20);
+  // -1 is read as 16383 unsigned, the "≥ 5.8 ms" marker: counted apart, not added to the timer
+  assert.equal(b.markers, 20);
+  assert.equal(b.netTimer, 0);
+  assert.ok(b.timerPerTick === 0);
+  assert.equal(c.messages, 17);
+  assert.deepEqual(c.ccHist, { "-1": 8, 1: 9 });
+  assert.equal(c.netTicks, 1);
+  assert.deepEqual(c.tsHist, { 3000: 17 });
+  assert.equal(c.netTimer, 17 * 3000);
+  assert.deepEqual(r.pairs, { cc: 98, pb: 98, adjacent: 98, sameMs: 97 });
+  assert.deepEqual(r.others.map((o) => [o.type, o.ch, o.d1, o.t_us, o.ms]),
+    [["on", 1, 0, 5_000_000, 95], ["on", 1, 0, 8_000_000, 110]]);
+});
+
+test("the tool prints every phase's numbers", () => {
+  const r = run(FIXTURE, "--phases", "1-2,3-4,6-7");
+  assert.equal(r.status, 0, r.stderr);
+  assert.match(r.stdout, /^phase 1-2 s \(1 s\): 60 messages, 60\.0\/s/m);
+  assert.match(r.stdout, /CC 6 delta \(mod 128\): \+2 ×60$/m);
+  assert.match(r.stdout, /timestamp delta \(mod 16384\): \+2821 ×30, \+2823 ×30$/m);
+  assert.match(r.stdout, /net ticks \+120, timer \+169320 unsigned \(1411\.0 per tick, 169320\/s\), 0 at -1$/m);
+  assert.match(r.stdout, /ticks per revolution at 33\.333 rpm: 216\.0$/m);
+  assert.match(r.stdout, /^phase 3-4 s .*\n.*CC 6 delta \(mod 128\): -1 ×20$/m);
+  assert.match(r.stdout, /^phase 6-7 s .*\n.*CC 6 delta \(mod 128\): -1 ×8, \+1 ×9$/m);
+  assert.match(r.stdout, /^98 CC 6, 98 followed directly by a pitch bend \(97 in the same millisecond\); 98 pitch bends$/m);
+  assert.match(r.stdout, /note 0 ch 1 at 5\.000 s for 95 ms/);
+  assert.match(r.stdout, /note 0 ch 1 at 8\.000 s for 110 ms/);
+});
+
+test("--json prints one object with the same numbers", () => {
+  const r = run(FIXTURE, "--phases", "1-2", "--json");
+  assert.equal(r.status, 0, r.stderr);
+  const o = JSON.parse(r.stdout);
+  assert.equal(o.phases[0].netTicks, 120);
+  assert.deepEqual(o.phases[0].tsHist, { 2821: 30, 2823: 30 });
+  assert.equal(o.rpm, 100 / 3);
+});
+
+test("--top limits the timestamp histogram to the most frequent values", () => {
+  const r = run(FIXTURE, "--phases", "1-2", "--top", "1");
+  assert.equal(r.status, 0, r.stderr);
+  assert.match(r.stdout, /timestamp delta \(mod 16384\): \+2821 ×30, 1 more value \(30 messages\)$/m);
+});
+
+test("--rpm 45 changes the inferred ticks per revolution", () => {
+  const r = run(FIXTURE, "--phases", "1-2", "--rpm", "45");
+  assert.equal(r.status, 0, r.stderr);
+  assert.match(r.stdout, /ticks per revolution at 45\.000 rpm: 160\.0$/m);
+});
+
+test("an unreadable or malformed file exits 1 naming it", () => {
+  const bad = join(dir, "bad.jsonl");
+  writeFileSync(bad, '{"t_us":1}\n');
+  let r = run(bad);
+  assert.equal(r.status, 1);
+  assert.match(r.stderr, /bad\.jsonl:1/);
+  r = run(join(dir, "missing.jsonl"));
+  assert.equal(r.status, 1);
+  assert.match(r.stderr, /missing\.jsonl/);
+});
+
+test("without --phases the whole capture is one phase", () => {
+  const r = run(FIXTURE);
+  assert.equal(r.status, 0, r.stderr);
+  assert.match(r.stdout, /^phase 0-9 s \(data 0\.5-8\.11 s, 7\.61 s\): 98 messages, 12\.9\/s \(whole seconds 0-60\)$/m);
+});
+
+test("a message in two overlapping phases counts in both", () => {
+  const recs = readFileSync(FIXTURE, "utf8").trim().split("\n").map((l) => JSON.parse(l));
+  const [a, b] = analyzePlatter(recs, parsePhases("1-2,1-1.03"), { rpm: 100 / 3 }).phases;
+  assert.equal(a.messages, 60);
+  assert.equal(b.messages, 30);
+  assert.equal(b.netTicks, 60);
+});
+
+test("phases are clipped to the capture's first and last message, per-second counts to whole seconds", () => {
+  const recs = readFileSync(FIXTURE, "utf8").trim().split("\n").map((l) => JSON.parse(l));
+  const [a, b, c, d] = analyzePlatter(recs, parsePhases("0-2,0.5-3.5,2.5-4.5,8.2-12"), { rpm: 100 / 3 }).phases;
+  assert.equal(a.seconds, 1.5); // data starts at 0.5 s
+  assert.equal(a.messages, 61);
+  assert.ok(Math.abs(a.rate - 61 / 1.5) < 1e-9);
+  assert.deepEqual(a.perSecond, [60]); // 1-2 s only; 0.5-1 s is not a whole second
+  assert.deepEqual(b.perSecond, [60, 0]);
+  assert.deepEqual(c.perSecond, [20]);
+  assert.equal(d.seconds, 0); // after the last message (8.11 s)
+  assert.equal(d.rate, 0);
+  assert.equal(d.ticksPerRev, 0);
+  const r = run(FIXTURE, "--phases", "0-2,8.2-12");
+  assert.match(r.stdout, /^phase 0-2 s \(data 0\.5-2 s, 1\.5 s\): 61 messages, 40\.7\/s \(whole seconds 60-60\)$/m);
+  assert.match(r.stdout, /^phase 8\.2-12 s \(no data\): 0 messages$/m);
+});
+
+test("notes pair on, velocity-0 on and off; other messages are listed once", () => {
+  const f = join(dir, "notes.jsonl");
+  const line = (status, data, t_us) => formatLine(toRecord({ status, data }, t_us));
+  writeFileSync(f, [
+    line(0x90, [1, 64], 1_000_000), line(0x90, [1, 0], 1_050_000), // velocity 0 ends it: 50 ms
+    line(0x80, [2, 0], 2_000_000), // a note-off with no note-on
+    line(0x90, [3, 100], 3_000_000), // never released
+    line(0xb0, [7, 10], 4_000_000), line(0xe1, [5, 6], 4_500_000), // CC 7; a pitch bend on channel 2
+  ].join(""));
+  const r = run(f);
+  assert.equal(r.status, 0, r.stderr);
+  assert.match(r.stdout, /^note 1 ch 1 at 1\.000 s for 50 ms$/m);
+  assert.match(r.stdout, /^note 2 ch 1 at 2\.000 s \(note-off without a note-on\)$/m);
+  assert.match(r.stdout, /^note 3 ch 1 at 3\.000 s \(no note-off\)$/m);
+  assert.match(r.stdout, /^cc 7 ch 1 at 4\.000 s$/m);
+  assert.match(r.stdout, /^pb ch 2 at 4\.500 s$/m);
+  assert.match(r.stdout, /net ticks 0, timer 0 unsigned \(no net ticks\)/);
+  assert.match(r.stdout, /^0 CC 6, 0 followed directly by a pitch bend \(0 in the same millisecond\); 0 pitch bends$/m);
+});
+
+test("an empty capture is analysed, not an error", () => {
+  const f = join(dir, "empty.jsonl");
+  writeFileSync(f, "");
+  const r = run(f);
+  assert.equal(r.status, 0, r.stderr);
+  assert.match(r.stdout, /: 0 messages/);
+  assert.match(r.stdout, /\(no data\): 0 messages$/m);
+});
