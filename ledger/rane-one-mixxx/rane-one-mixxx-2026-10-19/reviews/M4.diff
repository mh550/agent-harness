+// tools/synth-platter turns a motion script into capture-format JSONL (M2 lines, CC 6 then pitch bend per message,
+// one message per ms at most) so the platter core is tested on labelled data (M4-04). Every expected tick count
+// below is computed here from the script's own numbers, not by the tool. The fixtures' JSONL is generated by the
+// setup step into a temp dir, never committed. Spec: docs/plans/2026-10-19-M4-platter-core.md, synth-platter.
+// Device model: captures/2026-10-19-quick/platter.jsonl (D19).
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { existsSync, mkdirSync, readFileSync, readdirSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { readJsonl } from "../tools/lib/jsonl.mjs";
+import { parseScript, createMotion } from "../tools/lib/synth-platter.mjs";
+import { loadPlatter } from "./helpers/load-platter.mjs";
+import { synthDir, readMotion, MOTION_DIR, MOTION_NAMES, SYNTH } from "./helpers/synth.mjs";
+
+const P = loadPlatter();
+const TICKS_PER_REV = 3600;
+const nominal = (rpm) => (TICKS_PER_REV * rpm) / 60;
+
+// The net ticks a script moves, from its numbers alone: ∫ ratio · nominal dt per segment, rounded.
+function scriptedNetTicks(script) {
+  const rpm = script.rpm === 33.333 || script.rpm === undefined ? 100 / 3 : script.rpm;
+  const n = nominal(rpm);
+  let x = 0;
+  for (const s of script.segments) {
+    if (s.kind === "scratch") x += (s.ratio ?? 0) * n * s.seconds + s.amplitudeTicks * Math.sin((2 * Math.PI * s.seconds) / s.periodSeconds);
+    else if (s.kind === "backspin") x += s.fromRatio * n * s.decaySeconds * (1 - Math.exp(-s.seconds / s.decaySeconds));
+    else x += (s.ratio ?? (s.kind === "slow" ? 0.02 : 1)) * n * s.seconds;
+  }
+  return Math.round(x);
+}
+
+const syn = synthDir("synth-platter-");
+const files = {}; // fixture name → { path, recs }
+before(() => {
+  for (const name of MOTION_NAMES) {
+    const path = syn.generate(name);
+    files[name] = { path, recs: readJsonl(path) };
+  }
+});
+after(() => syn.cleanup());
+
+// Records → messages [{t_us, cc, pb}] (each CC 6 with the pitch bend that follows it on the same t_us).
+function messages(recs) {
+  const out = [];
+  for (let i = 0; i < recs.length; i += 2) {
+    const c = recs[i], b = recs[i + 1];
+    assert.equal(c.type, "cc", `line ${i + 1} is a CC`);
+    assert.equal(c.d1, 6);
+    assert.equal(b?.type, "pb", `line ${i + 2} is a pitch bend`);
+    assert.equal(b.t_us, c.t_us, `line ${i + 2} shares the CC's t_us`);
+    out.push({ t_us: c.t_us, cc: c.value, pb: b.value });
+  }
+  return out;
+}
+const tickDelta = (a, b) => ((((b - a) % 128) + 128 + 64) % 128) - 64;
+const timerDelta = (a, b) => (((b - a) % 16384) + 16384) % 16384; // unsigned
+
+function decode(recs) {
+  const dec = P.createDecoder();
+  let last = null, samples = 0;
+  for (const r of recs) {
+    const [status, d1, d2] = Buffer.from(r.bytes, "hex");
+    const s = dec.feed(status, d1, d2, r.t_us);
+    if (s) {
+      samples++;
+      last = s;
+    }
+  }
+  const f = dec.flush(Number.MAX_SAFE_INTEGER);
+  if (f) {
+    samples++;
+    last = f;
+  }
+  return { ticks: last ? last.ticks : 0, samples, stats: JSON.parse(JSON.stringify(dec.stats())) };
+}
+
+test("tests/fixtures/motion holds the seven scripts and no generated JSONL", () => {
+  const names = readdirSync(MOTION_DIR).sort();
+  assert.deepEqual(names, MOTION_NAMES.map((n) => `${n}.json`).sort());
+  for (const name of MOTION_NAMES) parseScript(readMotion(name)); // all valid
+});
+
+test("every generated file is M2 JSONL of CC 6 + pitch bend pairs on channel 1, t_us whole ms and rising", () => {
+  for (const name of MOTION_NAMES) {
+    const { recs } = files[name];
+    assert.ok(recs.length > 0, name);
+    assert.equal(recs.length % 2, 0, name);
+    for (const r of recs) {
+      assert.equal(r.ch, 1, name);
+      assert.equal(r.t_us % 1000, 0, `${name}: t_us ${r.t_us} is rounded to 1 ms`);
+    }
+    messages(recs);
+  }
+});
+
+test("constant33, 10 s: 20000 ± 20 ticks, 998-1000 messages/s, CC 6 advancing 2 per message", () => {
+  const msgs = messages(files.constant33.recs);
+  let net = 0;
+  const deltas = [];
+  for (let i = 1; i < msgs.length; i++) {
+    const d = tickDelta(msgs[i - 1].cc, msgs[i].cc);
+    net += d;
+    deltas.push(d);
+  }
+  assert.ok(Math.abs(net - 20000) <= 20, `net ${net}`);
+  const inWindow = msgs.filter((m) => m.t_us >= 1e6 && m.t_us < 9e6).length / 8;
+  assert.ok(inWindow >= 998 && inWindow <= 1000, `rate ${inWindow}/s`);
+  const twos = deltas.filter((d) => d === 2).length;
+  assert.ok(twos / deltas.length > 0.5, `${twos} of ${deltas.length} advance 2`);
+  // The last message closes the script and can span up to two periods; every other one moves by at most one tick.
+  assert.ok(deltas.slice(0, -1).every((d) => d >= 1 && d <= 3), "jitterTicks 1 moves a message by at most one tick");
+  assert.ok(deltas.includes(1) && deltas.includes(3), "the jitter shows (the capture has +1 and +3 too)");
+});
+
+test("constant33: a 2-tick message's timestamp advances 2822.4 counts on average, with sd 4.5 ± 1 (capture fit)", () => {
+  const msgs = messages(files.constant33.recs);
+  const d2 = [];
+  for (let i = 1; i < msgs.length; i++) {
+    if (tickDelta(msgs[i - 1].cc, msgs[i].cc) === 2) d2.push(timerDelta(msgs[i - 1].pb, msgs[i].pb));
+  }
+  const mean = d2.reduce((a, b) => a + b, 0) / d2.length;
+  const sd = Math.sqrt(d2.reduce((a, b) => a + (b - mean) ** 2, 0) / d2.length);
+  // The timestamp is the last tick's, so whatever the send jitter, a 2-tick message spans exactly 2 tick periods
+  // (2 · 1411.2 counts) plus the timer noise. The capture's 20-36 s: sd 4.47 on a 2-tick delta.
+  assert.ok(Math.abs(mean - 2822.4) < 0.5, `mean ${mean}`);
+  assert.ok(sd > 3.5 && sd < 5.5, `sd ${sd}`);
+  assert.ok(Math.max(...d2) < 16382, "no marker at speed");
+});
+
+test("timerJitterCounts is the sd of the per-message timer delta, without random-walking the timer", () => {
+  const script = { rpm: 33.333, seed: 9, segments: [{ kind: "constant", ratio: 1, seconds: 5 }] };
+  const msgs = messages(readJsonl(syn.generate(script)));
+  const d = [], d2 = [];
+  for (let i = 1; i < msgs.length; i++) {
+    d.push(timerDelta(msgs[i - 1].pb, msgs[i].pb));
+    if (tickDelta(msgs[i - 1].cc, msgs[i].cc) === 2) d2.push(d[d.length - 1]);
+  }
+  assert.ok(d2.length > 4990, "all but the first and the last message carry 2 ticks");
+  const mean = d2.reduce((a, b) => a + b, 0) / d2.length;
+  const sd = Math.sqrt(d2.reduce((a, b) => a + (b - mean) ** 2, 0) / d2.length);
+  assert.ok(Math.abs(mean - 2822.4) < 0.5, `mean ${mean}`);
+  assert.ok(sd > 3.5 && sd < 5.5, `sd ${sd}`);
+  // The unwrapped timer over 5 s stays within a few counts of 5 s · 2,822,400 Hz (noise on the timestamps, not
+  // on the deltas, so it doesn't accumulate). The first message's reference is the tick before t = 0 (x starts
+  // half a tick in), so the first delta is whole ticks too.
+  const total = d.reduce((a, b) => a + b, 0);
+  assert.ok(Math.abs(total - 5 * 2822400) < 30, `total ${total}`);
+  const q = messages(readJsonl(syn.generate({ ...script, timerJitterCounts: 0 })));
+  for (let i = 1; i < q.length; i++) {
+    const want = tickDelta(q[i - 1].cc, q[i].cc) * 1411.2;
+    assert.ok(Math.abs(timerDelta(q[i - 1].pb, q[i].pb) - want) <= 1, `message ${i}: no noise at 0`);
