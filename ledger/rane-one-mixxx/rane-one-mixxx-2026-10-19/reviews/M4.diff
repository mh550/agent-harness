+  assert.ok(g.out.slice(enter, i).every((o) => o.state === "settling"));
+});
+
+test("T13: an excursion beyond HANDBACK_TOL restarts the settle timer without leaving settling", () => {
+  const g = settling();
+  g.run(100, { r: 1, e: 1 });
