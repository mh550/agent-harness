+    assert.doesNotThrow(() => { r = est.push(s); }, `push(${String(s)})`);
+    assert.deepEqual(plain(r), last, `push(${JSON.stringify(s)}) returns the previous result`);
+  }
+  assert.equal(est.stats().malformed, junk.length);
