+test("D24: a stall-made takeover absorbs only forward ticks up to the clock's advance; backward motion counts", () => {
+  const g = atSpeed();
+  g.run(100, { r: 1, e: 1 });
+  const sm = g.sm;
+  let t = g.now();
+  const ticks = g.last().ticks;
+  const before = g.last().position;
+  // 60 ms of silence: heartbeats with the same ticks and the estimator's capped ratio.
+  for (let k = 1; k <= 3; k++) sm.update({ ratio: k < 3 ? 1 : 0.008, hostTimeUs: (t += 20000), expectedRatio: 1, ticks });
+  for (let k = 0; k < 9; k++) sm.update({ ratio: 0.008, hostTimeUs: (t += 1000), expectedRatio: 1, ticks });
+  const take = plain(sm.update({ ratio: 0.008, hostTimeUs: (t += 1000), expectedRatio: 1, ticks })); // T7
+  assert.equal(take.state, "held");
+  const advance = take.position - before; // what the clock played since the last tick: 70 ms, 140 ticks
+  assert.ok(Math.abs(advance - 140) < 1e-6, `advance ${advance}`);
+  // The burst: 100 forward ticks (absorbed), 50 back (counted), forward again to +150 (the 50 retraced count,
+  // 100 -> 140 is absorbed, the last 10 count), then on.
+  const at = (n, r, untrusted) =>
+    plain(sm.update({ ratio: r, hostTimeUs: (t += 100), expectedRatio: 1, ticks: ticks + n, untrusted })).position;
+  const T = take.position;
+  for (const [n, want] of [[100, 0], [50, -50], [150, 10], [200, 60], [190, 50]]) {
+    const got = at(n, 0.15, n === 100) - T;
+    assert.ok(Math.abs(got - want) < 1e-9, `ticks +${n}: position T${got >= 0 ? "+" : ""}${got}, want ${want}`);
+  }
+});
