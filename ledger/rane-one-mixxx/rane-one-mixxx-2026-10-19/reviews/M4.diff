+++ b/tools/analyze-platter
@@ -0,0 +1,124 @@
+#!/usr/bin/env node
+// Turns a platter capture (M2 JSONL) into per-phase numbers: CC-6 message rate, CC-6 and timestamp delta
+// histograms, net ticks and the ticks per revolution they imply at an assumed rpm (M4-01).
+// Exit: 0 analysed · 1 unreadable file or a line that breaks the M2 format · 2 usage
+// Spec: docs/research/2026-10-19-quick-capture-analysis.md; the analysis is tools/lib/platter-analysis.mjs.
+import { readJsonl } from "./lib/jsonl.mjs";
+import { parsePhases, analyzePlatter, TICK_MOD, TIMER_MOD } from "./lib/platter-analysis.mjs";
+import { parseRpm } from "./lib/numbers.mjs";
+
+const USAGE = "usage: tools/analyze-platter <capture.jsonl> [--phases <from>-<to>,…] [--rpm 33.333] [--top 8] [--json]";
+const HELP = `${USAGE}
+Per-phase numbers for the CC 6 tick counter and the pitch-bend timestamp on channel 1 of an M2 capture:
+  --phases <list>  windows in seconds of t_us, [from, to), e.g. 2-8,9-15,20-36 (default: the whole capture)
+  --rpm <n>        the speed assumed for "ticks per revolution"; 33, 33.3, 33.333 and 100/3 all mean 100/3 (default)
+  --top <n>        timestamp deltas shown, most frequent first (default 8; --json has them all)
+  --json           print one JSON object
+Per phase: CC 6 messages and messages/s (and per whole second), the CC 6 delta histogram (mod ${TICK_MOD}), the
+timestamp delta histogram (mod ${TIMER_MOD}, signed), net ticks, the net timer (unsigned; a delta of -1 is a marker,
+counted apart), timer per tick and per second, and ticks per revolution = net ticks / (seconds · rpm / 60). A delta
+is taken from the previous message of its kind and counted in the phase the message falls in; a phase's seconds are
+clipped to the capture's first and last message. Also: how CC 6 and pitch bend pair up, and every other message
+(a note's length in ms).
+Exit: 0 analysed · 1 unreadable file or a line that breaks the M2 format · 2 usage
+`;
+
+function usage(why) {
+  if (why) process.stderr.write(`analyze-platter: ${why}\n`);
+  process.stderr.write(USAGE + "\n");
+  process.exit(2);
+}
+
+const args = process.argv.slice(2);
+if (args.length === 1 && args[0] === "--help") {
+  process.stdout.write(HELP);
+  process.exit(0);
+}
+let file = null, phases = null, rpm = 100 / 3, top = 8, json = false;
+const seen = new Set();
+for (let i = 0; i < args.length; i++) {
+  const a = args[i];
+  if (!a.startsWith("-") || a === "-") {
+    if (a === "-") usage("reading stdin is not supported");
+    if (file !== null) usage(`unexpected argument ${a}`);
+    file = a;
+    continue;
+  }
+  if (seen.has(a)) usage(`${a} given twice`);
+  seen.add(a);
+  if (a === "--json") {
+    json = true;
+    continue;
+  }
+  const v = args[++i];
+  if (v === undefined) usage(`${a} needs a value`);
+  if (a === "--phases") {
+    phases = parsePhases(v);
+    if (phases === null) usage(`bad --phases ${v}`);
+  } else if (a === "--rpm") {
+    rpm = parseRpm(v);
+    if (rpm === null) usage(`bad --rpm ${v}`);
+  } else if (a === "--top") {
+    if (!/^[1-9]\d{0,3}$/.test(v)) usage(`bad --top ${v}`);
+    top = Number(v);
+  } else usage(`unknown option ${a}`);
+}
+if (file === null) usage();
+
+let recs;
+try {
+  recs = readJsonl(file);
+} catch (err) {
+  process.stderr.write(`analyze-platter: ${err.code ? `${file}: ${err.message}` : err.message}\n`);
+  process.exit(1);
+}
+const last = recs.length ? recs[recs.length - 1].t_us : 0;
+phases ??= [{ from: 0, to: Math.max(1, Math.ceil((last + 1) / 1e6)) }]; // clipped to the data below
+const r = analyzePlatter(recs, phases, { rpm });
+
+if (json) {
+  process.stdout.write(JSON.stringify({ file, rpm, ...r }) + "\n");
+  process.exit(0);
+}
+const signed = (d) => (d > 0 ? `+${d}` : String(d));
+const byValue = (h) => Object.entries(h).map(([k, n]) => [Number(k), n]).sort((x, y) => x[0] - y[0]);
+const hist = (h, limit) => {
+  const all = byValue(h);
+  if (all.length === 0) return "none";
+  const shown = limit < all.length ? [...all].sort((x, y) => y[1] - x[1] || x[0] - y[0]).slice(0, limit) : all;
+  const text = shown.map(([d, n]) => `${signed(d)} ×${n}`).join(", ");
+  const rest = all.length - shown.length;
+  if (rest === 0) return text;
+  const msgs = all.reduce((s, [, n]) => s + n, 0) - shown.reduce((s, [, n]) => s + n, 0);
+  return `${text}, ${rest} more value${rest === 1 ? "" : "s"} (${msgs} message${msgs === 1 ? "" : "s"})`;
+};
+const sec = (x) => String(Number(x.toFixed(3)));
+const out = [`${file}: ${recs.length} messages, ${sec(last / 1e6)} s`];
+for (const p of r.phases) {
+  const name = `phase ${sec(p.from)}-${sec(p.to)} s`;
+  if (p.seconds === 0) {
+    out.push(`${name} (no data): 0 messages`);
+    continue;
+  }
+  const span = p.dataFrom === p.from && p.dataTo === p.to ? `${sec(p.seconds)} s`
+    : `data ${sec(p.dataFrom)}-${sec(p.dataTo)} s, ${sec(p.seconds)} s`;
+  const ps = p.perSecond.length ? ` (whole seconds ${Math.min(...p.perSecond)}-${Math.max(...p.perSecond)})` : "";
+  out.push(`${name} (${span}): ${p.messages} messages, ${p.rate.toFixed(1)}/s${ps}`);
+  out.push(`  CC 6 delta (mod ${TICK_MOD}): ${hist(p.ccHist, Infinity)}`);
+  out.push(`  timestamp delta (mod ${TIMER_MOD}): ${hist(p.tsHist, top)}`);
+  const per = p.timerPerTick === null ? "no net ticks" : `${p.timerPerTick.toFixed(1)} per tick, ${(p.netTimer / p.seconds).toFixed(0)}/s`;
+  out.push(`  net ticks ${signed(p.netTicks)}, timer ${signed(p.netTimer)} unsigned (${per}), ${p.markers} at -1`);
+  out.push(`  ticks per revolution at ${rpm.toFixed(3)} rpm: ${p.ticksPerRev.toFixed(1)}`);
+}
+const { cc, pb, adjacent, sameMs } = r.pairs;
+out.push(`${cc} CC 6, ${adjacent} followed directly by a pitch bend (${sameMs} in the same millisecond); ${pb} pitch bends`);
+const NUMBERED = new Set(["cc", "pc", "pat"]); // types whose d1 names the control, program or note
+for (const o of r.others) {
+  const note = o.type === "on" || o.type === "off";
+  const what = note ? `note ${o.d1}` : NUMBERED.has(o.type) ? `${o.type} ${o.d1}` : o.type;
+  let len = "";
+  if (o.type === "on") len = o.ms === null ? " (no note-off)" : ` for ${sec(o.ms)} ms`;
+  else if (o.type === "off") len = " (note-off without a note-on)";
+  out.push(`${what} ch ${o.ch ?? "-"} at ${(o.t_us / 1e6).toFixed(3)} s${len}`);
+}
+process.stdout.write(out.join("\n") + "\n");
