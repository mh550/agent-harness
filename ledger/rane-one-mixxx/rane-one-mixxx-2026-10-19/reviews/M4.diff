+test("a marker (timer not rising) goes through the host-time path", () => {
+  const est = P.createSpeedEstimator();
+  for (let i = 0; i <= 300; i++) est.push(at1(2 * i, 1000 * i));
+  // The platter stops dead: marker samples 30 ms apart (over TIMER_GAP_MAX_US, as in the capture's hold), each
+  // adding -1 to the timer and dithering ±1 tick. Each one alone already bounds the speed to 0.086.
+  let r, timer = Math.round(600 * TPT);
+  for (let k = 1; k <= 8; k++) {
+    timer -= 1;
+    r = plain(est.push({ ticks: 600 + (k % 2), timer, hostTimeUs: 300000 + 30000 * k }));
+    assert.equal(r.timed, false, `marker ${k}`);
+    assert.ok(Math.abs(r.ratio) <= TPT / P.DEFAULTS.TIMER_MARKER_MIN + 1e-12, `marker ${k}: ${r.ratio}`);
+  }
+  assert.ok(Math.abs(r.ratio) <= 0.01, `after 240 ms held the ratio is ${r.ratio}`);
+});
+
+// One tick per message at a given ratio, as the decoder would emit it: the timer delta is TPT / ratio.
+function slowRun(est, ratio, n, start) {
+  let { ticks, timer, t } = start;
+  let r;
+  for (let i = 0; i < n; i++) {
+    ticks += 1;
+    timer += Math.round(TPT / ratio);
+    t += Math.round(500 / ratio);
+    r = plain(est.push({ ticks, timer, hostTimeUs: t }));
+  }
+  return { r, state: { ticks, timer, t } };
+}
+
+test("every valid timer delta is timed, however slow; only samples without device time go to host time (D23)", () => {
+  const est = P.createSpeedEstimator();
+  let state = { ticks: 0, timer: 0, t: 0 };
+  est.push({ ticks: 0, timer: 0, hostTimeUs: 0 });
+  for (const ratio of [0.11, 0.09, 0.087, 0.13]) {
+    const run = slowRun(est, ratio, 60, state);
+    state = run.state;
+    assert.equal(run.r.timed, true, `${ratio} has valid deltas (${Math.round(TPT / ratio)} counts per tick)`);
+    assert.ok(Math.abs(run.r.ratio - ratio) < 0.002, `${ratio} reads ${run.r.ratio}`);
+  }
+  assert.equal(est.stats().reseeds, 1, "the filter was seeded once and never dropped");
+});
