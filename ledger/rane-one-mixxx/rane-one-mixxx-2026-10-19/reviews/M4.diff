+// The platter state machine and the hybrid switch-over decision (M4-06): which of six states the platter is in, who
+// drives the track (`control`: the clock or the platter) and the track `position` that stays continuous across every
+// change of control. Spec: docs/plans/2026-10-19-M4-platter-core.md, State machine (T1-T14, T5a) and Switch-over.
+// Most tests drive the machine with scripted ratios at one update per ms; the jitter tests run synthetic platter
+// data (tools/synth-platter) through the decoder and estimator first.
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import { readJsonl } from "../tools/lib/jsonl.mjs";
+import { loadPlatter } from "./helpers/load-platter.mjs";
+import { synthDir } from "./helpers/synth.mjs";
+import { runEstimator } from "./helpers/run-core.mjs";
+
+const P = loadPlatter();
+const D = P.DEFAULTS;
+const NOMINAL = (D.TICKS_PER_REV * D.RPM_33) / 60; // 2000 ticks/s
+const plain = (x) => JSON.parse(JSON.stringify(x));
+const CLOCK_STATES = new Set(["stopped", "motor_at_speed"]);
+
+// A scripted platter: run(ms, {r, e, play}) pushes one update per ms (stepUs) with ticks integrated from the
+// ratio, r being a number or a function of the time in ms since the run's start. Every result is checked for
+// the control rule of M4-06 step 2 and recorded in `out` as {t, ticks, r, e, state, control, position}.
+function rig(config) {
+  const sm = P.createStateMachine(config);
+  const out = [];
+  let t = -1000;
+  let ticksF = 0;
+  const run = (ms, { r, e, play, stepUs = 1000 }) => {
+    const n = Math.round((ms * 1000) / stepUs);
+    for (let i = 0; i < n; i++) {
+      t += stepUs;
+      const ratio = typeof r === "function" ? r((i * stepUs) / 1000) : r;
+      if (out.length > 0) ticksF += (ratio * NOMINAL * stepUs) / 1e6;
+      const ticks = Math.round(ticksF);
+      const input = { ratio, hostTimeUs: t, expectedRatio: e, ticks };
+      if (play !== undefined) input.playRatio = play;
+      const res = sm.update(input);
+      assert.equal(res.control, CLOCK_STATES.has(res.state) ? "clock" : "platter", `control in ${res.state}`);
+      out.push({ t, ticks, r: ratio, e, ...plain(res) });
+    }
+    return out[out.length - 1];
+  };
+  const last = () => out[out.length - 1];
+  // The first update (index into out) at or after `from` whose state is `state`.
+  const firstIn = (state, from = 0) => out.findIndex((o, i) => i >= from && o.state === state);
+  return { sm, out, run, last, firstIn, now: () => t };
+}
+
+// Brings a rig to motor_at_speed: motor on at ratio 1 until T4 has fired.
+function atSpeed(config) {
+  const g = rig(config);
+  g.run(D.SETTLE_MS + 5, { r: 1, e: 1 });
+  assert.equal(g.last().state, "motor_at_speed");
+  return g;
+}
+
+// motor_at_speed, then a hand stop: T7 to held.
+function held(config) {
+  const g = atSpeed(config);
+  g.run(D.TAKEOVER_MS + 5, { r: 0, e: 1 });
+  assert.equal(g.last().state, "held");
+  return g;
+}
+
+// motor_at_speed, then the hand drags at half speed: T7 to scratching.
+function scratching(config) {
+  const g = atSpeed(config);
+  g.run(D.TAKEOVER_MS + 5, { r: 0.5, e: 1 });
+  assert.equal(g.last().state, "scratching");
+  return g;
+}
+
+// scratching, then let go: T11 to settling.
+function settling(config) {
+  const g = scratching(config);
+  g.run(1, { r: 1, e: 1 });
+  assert.equal(g.last().state, "settling");
+  return g;
+}
+
+// motor on, then a backward spin: T1 to backspin.
+function backspin(config) {
+  const g = atSpeed(config);
+  g.run(5, { r: -2, e: 1 });
+  assert.equal(g.last().state, "backspin");
+  return g;
+}
+
+// ---------------------------------------------------------------------------------------------------- API
+
+test("createStateMachine returns update and stats; the first update starts from stopped under the clock", () => {
+  const sm = P.createStateMachine();
+  assert.equal(typeof sm.update, "function");
+  assert.equal(typeof sm.stats, "function");
+  assert.deepEqual(plain(sm.update({ ratio: 0, hostTimeUs: 0, expectedRatio: 0, ticks: 0 })),
+    { state: "stopped", control: "clock", position: 0 });
+  assert.deepEqual(plain(sm.stats()), { updates: 1, transitions: {}, malformed: 0 });
+});
+
+test("two machines don't share state", () => {
+  const a = atSpeed();
+  const b = rig();
+  b.run(5, { r: 0, e: 0 });
+  assert.equal(a.last().state, "motor_at_speed");
+  assert.equal(b.last().state, "stopped");
+  assert.equal(Object.keys(b.sm.stats().transitions).length, 0);
+});
+
+test("stats().transitions counts each transition as '<from>><to>'", () => {
+  const g = held();
+  assert.deepEqual(plain(g.sm.stats().transitions), { "stopped>motor_at_speed": 1, "motor_at_speed>held": 1 });
+  assert.equal(g.sm.stats().updates, g.out.length);
+});
+
+// ------------------------------------------------------------------------------- transitions (plan table)
+
+test("T4 stopped -> motor_at_speed: e > 0 and |dev| <= HANDBACK_TOL for SETTLE_MS, not sooner", () => {
+  const g = rig();
+  g.run(D.SETTLE_MS + 10, { r: 1.005, e: 1 });
+  const i = g.firstIn("motor_at_speed");
+  assert.ok(i > 0);
+  assert.equal(g.out[i].t - g.out[0].t, D.SETTLE_MS * 1000, "fires exactly SETTLE_MS after the band was entered");
+  assert.ok(g.out.slice(0, i).every((o) => o.state === "stopped"));
+});
+
+test("T4 waits through a spin-up: the SETTLE_MS timer starts when the ratio enters the band", () => {
+  const g = rig();
+  g.run(400, { r: (ms) => Math.min(1, ms / 400), e: 1 }); // a 400 ms ramp, as the capture's 19.236 s press
+  g.run(300, { r: 1, e: 1 });
+  const enter = g.out.findIndex((o) => Math.abs(o.r - 1) <= D.HANDBACK_TOL);
+  const i = g.firstIn("motor_at_speed");
+  assert.equal(g.out[i].t - g.out[enter].t, D.SETTLE_MS * 1000);
+  assert.ok(g.out.slice(0, i).every((o) => o.state === "stopped"), "stopped (clock) through the spin-up");
+});
+
+test("T7 motor_at_speed -> held: ratio below tolerance for TAKEOVER_MS (the hold time), a shorter dip changes nothing", () => {
+  const g = atSpeed();
+  g.run(D.TAKEOVER_MS - 2, { r: 0, e: 1 });
+  g.run(20, { r: 1, e: 1 });
+  assert.ok(g.out.every((o, i) => i < g.firstIn("motor_at_speed") || o.state === "motor_at_speed"),
+    `a ${D.TAKEOVER_MS - 2} ms dip is not a takeover`);
+  const from = g.out.length;
+  g.run(D.TAKEOVER_MS + 5, { r: 0, e: 1 });
+  const i = g.firstIn("held", from);
+  assert.equal(g.out[i].t - g.out[from].t, D.TAKEOVER_MS * 1000, "fires TAKEOVER_MS after the deviation began");
+  assert.equal(g.out[i - 1].state, "motor_at_speed");
+});
+
+test("T7 motor_at_speed -> scratching when the ratio is off by more than TAKEOVER_TOL but above HELD_RATIO", () => {
+  const g = atSpeed();
+  g.run(D.TAKEOVER_MS + 1, { r: 1.2, e: 1 });
+  assert.equal(g.last().state, "scratching");
+  const h = atSpeed();
+  h.run(D.TAKEOVER_MS + 1, { r: 0.5, e: 1 });
+  assert.equal(h.last().state, "scratching");
+});
+
+test("T9 held -> scratching: |r| > HELD_EXIT_RATIO, and the hold hysteresis keeps 0.15 held", () => {
+  const g = held();
+  g.run(50, { r: 0.15, e: 1 });
+  assert.equal(g.last().state, "held", "0.15 is between HELD_RATIO and HELD_EXIT_RATIO");
+  g.run(1, { r: -0.25, e: 1 });
+  assert.equal(g.last().state, "scratching");
+});
+
+test("held stays held under ±1 tick position dither through the decoder's markers and the estimator", () => {
+  // A held record keeps sending (capture 38-41 s): about 16 samples/s, the position dithering by a tick, every
+  // timer delta a saturation marker. Hand-built decoder samples, through the estimator with 20 ms heartbeats.
+  const est = P.createSpeedEstimator();
+  const g = held();
+  const sm = g.sm;
+  let t = g.now();
+  const baseTicks = g.last().ticks;
+  let timer = 0;
+  const states = new Set();
+  let maxAbs = 0;
+  for (let k = 0; k < 40; k++) {
+    const sampleTicks = baseTicks + (k % 2);
+    for (let beat = 0; beat < 3; beat++) {
+      t += 20000;
+      const r = est.push({ ticks: sampleTicks, timer: beat === 0 ? timer-- : null, hostTimeUs: t });
+      maxAbs = Math.max(maxAbs, Math.abs(r.ratio));
+      states.add(sm.update({ ratio: r.ratio, hostTimeUs: t, expectedRatio: 1, ticks: sampleTicks }).state);
+    }
+  }
+  assert.ok(maxAbs < D.HELD_RATIO, `|ratio| reached ${maxAbs}`);
+  assert.deepEqual([...states], ["held"]);
+});
+
+test("T11 scratching -> settling: the ratio back within HANDBACK_TOL, immediately", () => {
+  const g = scratching();
+  g.run(1, { r: 1.009, e: 1 });
+  assert.equal(g.last().state, "settling");
