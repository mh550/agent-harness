+      const msgs = messages(seed.length ? readJsonl(syn.generate(name, seed)) : files[name].recs);
+      for (let i = 1; i < msgs.length; i++) {
+        if (name === "drop-and-burst" && msgs[i].t_us === 5_520_000) continue;
+        assert.ok(msgs[i].t_us - msgs[i - 1].t_us >= 1000, `${name} ${seed}: ${msgs[i - 1].t_us} → ${msgs[i].t_us}`);
+      }
+    }
+  }
+});
+
+test("a failed write leaves no temp file and says what failed", () => {
+  const d = join(syn.dir, "isdir");
+  mkdirSync(join(d, "out"), { recursive: true });
+  writeFileSync(join(d, "out", "x"), "");
+  const r = spawnSync(SYNTH, ["--script", join(MOTION_DIR, "slow.json"), "--out", join(d, "out"), "--force"], { encoding: "utf8" });
+  assert.equal(r.status, 1, r.stderr);
+  assert.doesNotMatch(r.stderr, /exists; use --force/);
+  assert.deepEqual(readdirSync(d), ["out"], "no .tmp left behind");
+});
+
+test("an existing --out is kept unless --force", () => {
+  const out = join(syn.dir, "exists.jsonl");
+  writeFileSync(out, "keep\n");
+  const args = ["--script", join(MOTION_DIR, "slow.json"), "--out", out];
+  const r = spawnSync(SYNTH, args, { encoding: "utf8" });
+  assert.equal(r.status, 1);
+  assert.match(r.stderr, /exists/);
+  assert.equal(readFileSync(out, "utf8"), "keep\n");
+  const f = spawnSync(SYNTH, [...args, "--force"], { encoding: "utf8" });
+  assert.equal(f.status, 0, f.stderr);
+  assert.equal(readJsonl(out).length, 402);
+  assert.match(f.stderr, /201 messages/);
+  assert.equal(f.stdout, "");
+});
