+// Hand-built samples: cumulative ticks and timer as the decoder emits them. At ratio 1 and 33⅓ one tick is 1411.2
+// timer counts and 0.5 ms.
+const TPT = 1411.2;
+const at1 = (ticks, hostTimeUs) => ({ ticks, timer: Math.round(ticks * TPT), hostTimeUs });
+
+test("createSpeedEstimator returns push and stats, and the first sample reads 0 untimed", () => {
+  const est = P.createSpeedEstimator();
