index 0000000..4fbd31d
--- /dev/null
+++ b/tools/lib/synth-platter.mjs
@@ -0,0 +1,301 @@
+// A model of the Rane One's platter output (M4-04): turns a motion script into the CC 6 + pitch-bend messages the
+// One would send, as M2 JSONL lines, so the platter core can be tested on data whose true motion is known.
+// Spec: docs/plans/2026-10-19-M4-platter-core.md, synth-platter. Device facts: captures/2026-10-19-quick/platter.jsonl,
+// analysed in docs/research/2026-10-19-quick-capture-analysis.md (D19).
+//
+// The device model:
+// - The record's position x(t) in ticks comes from the script, starting half a tick in (x = 0.5), so the tick
+//   count n = floor(x) changes when x crosses a whole number.
+// - The One polls every messagePeriodUs (1000: capture 20-36 s, 998-999 messages/s). A poll whose n differs from
+//   the last message's sends one message: CC 6 = n mod 128, then a pitch bend with the timestamp of the last tick
+//   crossing, both on one host t_us rounded to 1 ms (arecordmidi's resolution). The first poll always sends.
+// - The timestamp counts at TIMER_HZ, plus Gaussian noise of sd timerJitterCounts / √2 on each timestamp, so a
+//   message's delta has sd timerJitterCounts (default 4.5: capture 20-36 s, sd 4.47 on a 2-tick delta) and the
+//   timer doesn't random-walk. In the capture most of that 4.5 is slow motor wow (50-message means range
+//   2814-2831), not per-message noise (sd of successive differences 1.63); the white noise here is an upper bound.
+// - saturate (default): the pitch bend adds the delta since the previous message's timestamp, and a delta of
+//   16382 counts or more (5.8 ms) sends previous − 1 instead, the marker the capture shows (16383 ×274; its 7 × −2
+//   aren't modelled). The next delta counts from the marker message's real time: the capture's 4 marker → real
+//   transitions read 9740-15075 counts after 4-5 ms of host time. saturate: false is the Twelve hypothesis: the
+//   pitch bend is the timestamp mod 16384 and simply wraps.
+// - A segment's jitterTicks shifts each poll by a seeded uniform ± jitterTicks · tick period / 2 (at most
+//   0.45 · messagePeriodUs), so the ticks per message vary by ± jitterTicks, as in the capture (+1/+2/+3). How often
+//   depends on the seeded poll phase: constant33 moves 568 of 8000 messages in 1-9 s (7 %), against the capture's
+//   292 of 15,971 (1.8 %). The timestamp is the last tick's, so the device-timed ratio doesn't see it.
+import { parseRpm } from "./numbers.mjs";
+import { formatLine, toRecord } from "./jsonl.mjs";
+
+export const TICKS_PER_REV = 3600; // capture 20-36 s: 3598.2 at an assumed 33⅓ (UNVERIFIED vs 3584, M5)
+export const TIMER_HZ = 2822400; // capture 20-36 s: 2,822,469 counts per host second
+export const TICK_MOD = 128;
+export const TIMER_MOD = 16384;
+export const MARKER_MIN = 16382; // a delta this large is sent as previous − 1
+export const MAX_RATIO = 10;
+export const MAX_TICKS_PER_MESSAGE = 48; // CC 6 aliases at 64; 48 leaves room for the jitter
+const GRID_US = 10; // the motion is sampled every 10 µs to find tick crossings
+
+const TOP_KEYS = {
+  rpm: 100 / 3, seed: 1, segments: null, messagePeriodUs: 1000, timerJitterCounts: 4.5, saturate: true,
+  startUs: 0, ch: 1, ticksPerRev: TICKS_PER_REV, timerHz: TIMER_HZ, comment: "",
+};
+// kind → { key: default (undefined = required) }
+const SEGMENT_KEYS = {
+  constant: { ratio: undefined, seconds: undefined, jitterTicks: 0 },
+  slow: { ratio: 0.02, seconds: undefined, jitterTicks: 0 },
+  scratch: { amplitudeTicks: undefined, periodSeconds: undefined, seconds: undefined, ratio: 0 },
+  backspin: { fromRatio: undefined, decaySeconds: undefined, seconds: undefined },
+  drop: { percent: undefined, seconds: undefined, ratio: 1, jitterTicks: 0 },
+  "stall-burst": { stallMs: undefined, seconds: undefined, ratio: 1, jitterTicks: 0, atSeconds: undefined },
+};
+
+const isObject = (v) => v !== null && typeof v === "object" && !Array.isArray(v);
+const isNum = (v) => typeof v === "number" && Number.isFinite(v);
+
+// A motion script (parsed JSON) → the same with every default filled in and rpm a number; throws Error naming the
+// first problem.
+export function parseScript(obj) {
+  if (!isObject(obj)) throw new Error("the script must be a JSON object");
+  for (const k of Object.keys(obj)) if (!Object.hasOwn(TOP_KEYS, k)) throw new Error(`unknown key ${k}`);
+  const s = { ...TOP_KEYS, ...obj };
+  const rpm = typeof s.rpm === "number" || typeof s.rpm === "string" ? parseRpm(String(s.rpm)) : null;
+  if (rpm === null) throw new Error(`rpm must be a positive number or "100/3" (got ${JSON.stringify(obj.rpm)})`);
+  s.rpm = rpm;
+  if (!Number.isInteger(s.seed) || s.seed < 0 || s.seed > 0xffffffff) throw new Error(`seed must be an integer 0..4294967295 (got ${JSON.stringify(s.seed)})`);
+  if (!Number.isInteger(s.messagePeriodUs) || s.messagePeriodUs < 100 || s.messagePeriodUs > 2000) throw new Error(`messagePeriodUs must be an integer 100..2000 (got ${JSON.stringify(s.messagePeriodUs)})`);
+  if (!isNum(s.timerJitterCounts) || s.timerJitterCounts < 0 || s.timerJitterCounts > 1000) throw new Error(`timerJitterCounts must be a number 0..1000 (got ${JSON.stringify(s.timerJitterCounts)})`);
+  if (typeof s.saturate !== "boolean") throw new Error("saturate must be true or false");
+  if (!Number.isSafeInteger(s.startUs) || s.startUs < 0 || s.startUs % 1000) throw new Error(`startUs must be whole ms, an integer multiple of 1000 ≥ 0 (got ${JSON.stringify(s.startUs)})`);
+  if (!Number.isInteger(s.ch) || s.ch < 1 || s.ch > 16) throw new Error(`ch must be an integer 1..16 (got ${JSON.stringify(s.ch)})`);
+  if (!Number.isInteger(s.ticksPerRev) || s.ticksPerRev < 1) throw new Error(`ticksPerRev must be a positive integer (got ${JSON.stringify(s.ticksPerRev)})`);
+  if (!isNum(s.timerHz) || s.timerHz <= 0) throw new Error(`timerHz must be a positive number (got ${JSON.stringify(s.timerHz)})`);
+  if (typeof s.comment !== "string") throw new Error("comment must be a string");
+  if (!Array.isArray(s.segments) || s.segments.length === 0) throw new Error("segments must be a non-empty array");
+  const nominal = (s.ticksPerRev * rpm) / 60;
+  s.segments = s.segments.map((seg, i) => parseSegment(seg, `segment ${i + 1}`, nominal, s.messagePeriodUs));
+  return s;
+}
+
+function parseSegment(seg, where, nominal, periodUs) {
+  if (!isObject(seg)) throw new Error(`${where} must be an object`);
+  const keys = SEGMENT_KEYS[seg.kind];
+  if (!keys) throw new Error(`${where}: kind must be one of ${Object.keys(SEGMENT_KEYS).join(", ")} (got ${JSON.stringify(seg.kind)})`);
+  where = `${where} (${seg.kind})`;
+  for (const k of Object.keys(seg)) if (k !== "kind" && !Object.hasOwn(keys, k)) throw new Error(`${where}: unknown key ${k}`);
+  const out = { kind: seg.kind };
+  for (const [k, def] of Object.entries(keys)) {
+    const v = seg[k] ?? def;
+    if (v === undefined) {
+      if (k === "atSeconds") continue;
+      throw new Error(`${where}: ${k} is required`);
+    }
+    if (!isNum(v)) throw new Error(`${where}: ${k} must be a number (got ${JSON.stringify(seg[k])})`);
+    out[k] = v;
+  }
+  const bad = (what) => {
+    throw new Error(`${where}: ${what}`);
+  };
+  if (!(out.seconds > 0 && out.seconds <= 3600)) bad(`seconds must be > 0 and ≤ 3600 (got ${out.seconds})`);
+  if ("ratio" in out && Math.abs(out.ratio) > MAX_RATIO) bad(`|ratio| must be ≤ ${MAX_RATIO} (got ${out.ratio})`);
+  if ("jitterTicks" in out && !(out.jitterTicks >= 0 && out.jitterTicks <= 8)) bad(`jitterTicks must be 0..8 (got ${out.jitterTicks})`);
+  if (seg.kind === "scratch") {
+    if (!(out.amplitudeTicks > 0)) bad(`amplitudeTicks must be > 0 (got ${out.amplitudeTicks})`);
+    if (!(out.periodSeconds > 0)) bad(`periodSeconds must be > 0 (got ${out.periodSeconds})`);
+    const peak = Math.abs(out.ratio) + (2 * Math.PI * out.amplitudeTicks) / out.periodSeconds / nominal;
+    if (peak > MAX_RATIO) bad(`peak |ratio| ${peak.toFixed(2)} (amplitudeTicks, periodSeconds) must be ≤ ${MAX_RATIO}`);
+  }
+  if (seg.kind === "backspin") {
+    if (!(out.fromRatio < 0 && out.fromRatio >= -MAX_RATIO)) bad(`fromRatio must be < 0 and ≥ -${MAX_RATIO} (got ${out.fromRatio})`);
+    if (!(out.decaySeconds > 0)) bad(`decaySeconds must be > 0 (got ${out.decaySeconds})`);
+  }
+  const peakRatio = seg.kind === "backspin" ? -out.fromRatio
+    : Math.abs(out.ratio) + (seg.kind === "scratch" ? (2 * Math.PI * out.amplitudeTicks) / out.periodSeconds / nominal : 0);
+  const perMessage = (peakRatio * nominal * periodUs) / 1e6;
+  if (perMessage > MAX_TICKS_PER_MESSAGE) bad(`up to ${perMessage.toFixed(1)} ticks per message (rpm, ticksPerRev, ratio, messagePeriodUs); must be ≤ ${MAX_TICKS_PER_MESSAGE}`);
+  if (seg.kind === "drop" && !(out.percent >= 0 && out.percent <= 100)) bad(`percent must be 0..100 (got ${out.percent})`);
+  if (seg.kind === "stall-burst") {
+    const stall = out.stallMs / 1000;
+    if (!(out.stallMs > 0 && stall < out.seconds)) bad(`stallMs must be > 0 and fit in the segment (got ${out.stallMs})`);
+    out.atSeconds ??= (out.seconds - stall) / 2;
+    if (!(out.atSeconds >= 0 && out.atSeconds + stall <= out.seconds)) bad(`atSeconds + stallMs must fit in the segment (got ${out.atSeconds})`);
+  }
+  return out;
+}
+
+// One segment's motion relative to its start: pos(τ) in ticks and ratio(τ), τ in seconds.
+function segmentMotion(seg, nominal) {
+  if (seg.kind === "scratch") {
+    const w = (2 * Math.PI) / seg.periodSeconds, a = seg.amplitudeTicks, r = seg.ratio;
+    return { pos: (t) => r * nominal * t + a * Math.sin(w * t), ratio: (t) => r + (a * w * Math.cos(w * t)) / nominal };
+  }
+  if (seg.kind === "backspin") {
+    const r0 = seg.fromRatio, d = seg.decaySeconds;
+    return { pos: (t) => r0 * nominal * d * (1 - Math.exp(-t / d)), ratio: (t) => r0 * Math.exp(-t / d) };
+  }
+  const r = seg.ratio;
+  return { pos: (t) => r * nominal * t, ratio: () => r };
+}
+
+// A parsed script → its true motion (the labels): posAt(s) in ticks from the start, ratioAt(s) relative to the
+// script's rpm, segmentAt(s), and segments [{kind, from, to, …}] in seconds.
+export function createMotion(script) {
+  // 100/3 itself isn't exact in binary; this way 33⅓ at 3600 ticks/rev is exactly 2000 ticks/s.
+  const nominal = script.rpm === 100 / 3 ? (script.ticksPerRev * 100) / 180 : (script.ticksPerRev * script.rpm) / 60;
+  let t = 0, x = 0;
+  const segments = [], parts = []; // parts[i]: segment i's start position and motion
+  for (const seg of script.segments) {
+    const m = segmentMotion(seg, nominal);
+    segments.push({ ...seg, from: t, to: t + seg.seconds });
+    parts.push({ x0: x, m });
+    t += seg.seconds;
+    x += m.pos(seg.seconds);
+  }
+  const seconds = t;
+  const indexAt = (s) => {
+    for (let i = 0; i < segments.length; i++) if (s < segments[i].to) return i;
+    return segments.length - 1;
+  };
+  const tau = (i, s) => Math.min(Math.max(s - segments[i].from, 0), segments[i].seconds);
+  const posAt = (s) => {
+    const i = indexAt(s);
+    return parts[i].x0 + parts[i].m.pos(tau(i, s));
+  };
+  const ratioAt = (s) => {
+    const i = indexAt(s);
+    return parts[i].m.ratio(tau(i, s));
+  };
+  return { seconds, nominalTicksPerS: nominal, posAt, ratioAt, segmentAt: (s) => segments[indexAt(s)], segments };
+}
+
+// mulberry32: a small seeded PRNG, uniform in [0, 1).
+function mulberry32(seed) {
+  let a = seed >>> 0;
+  return () => {
+    a = (a + 0x6d2b79f5) | 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+const gaussian = (rand) => Math.sqrt(-2 * Math.log(1 - rand())) * Math.cos(2 * Math.PI * rand());
+const mod = (v, m) => ((v % m) + m) % m;
+
+// A parsed script → { text (the JSONL), stats }. seed overrides the script's. Separate PRNG streams for the send
+// jitter, the timer noise and the drops, so a drop segment's percent changes nothing but which messages go.
+export function synthesize(script, { seed = script.seed } = {}) {
+  const motion = createMotion(script);
+  const nominal = motion.nominalTicksPerS;
+  const randJitter = mulberry32(seed), randNoise = mulberry32(seed ^ 0x9e3779b9), randDrop = mulberry32(seed ^ 0x85ebca6b);
+  const randPhase = mulberry32(seed ^ 0xc2b2ae35);
+  const period = script.messagePeriodUs;
+  const endUs = Math.round(motion.seconds * 1e6);
+  const sigma = script.timerJitterCounts / Math.SQRT2;
+  const xAt = (us) => 0.5 + motion.posAt(us / 1e6);
+
+  // The nominal polls: one at 0, then every period from a seeded phase (the One's poll clock has no fixed relation
+  // to where the record's ticks fall; at phase 0 every tick would sit exactly half a tick period from a poll, the
+  // one case a ± half-period shift never moves), and one at the very end.
+  // Interior polls keep a whole period from both ends, so no two polls are closer than the 1 kHz cap.
+  const polls = [0];
+  for (let p = period + Math.floor(randPhase() * period); p <= endUs - period; p += period) polls.push(p);
+  polls.push(endUs);
+
+  // Before t = 0 the record is assumed to have moved at its starting speed, so the reference timestamp is the tick
+  // half a tick back and the first delta is a whole one.
+  const v0 = Math.abs(motion.ratioAt(0) * nominal);
+  let lastCross = v0 > 0 ? -0.5e6 / v0 : 0; // µs
+  let tsPrev = Math.round((lastCross * script.timerHz) / 1e6);
+  let pb = mod(tsPrev, TIMER_MOD);
+  let nSent = 0;
+  // devUs is the nominal poll time: the send jitter picks which ticks a message carries, but the host sees the
+  // polls a whole period apart (the capture's host gaps also vary by ±1 ms in 5.4 % of 20-36 s; not modelled).
+  const msgs = [{ devUs: 0, n: 0, pb, seg: motion.segmentAt(0) }];
+  let markers = 0;
+  let t = 0, x = xAt(0);
+  for (let k = 1; k < polls.length; k++) {
+    const nominalUs = polls[k];
+    const u = randJitter(); // drawn for every poll, so the stream doesn't depend on the segments
+    let p = nominalUs;
+    const seg = motion.segmentAt(nominalUs / 1e6);
+    const r = Math.abs(motion.ratioAt(nominalUs / 1e6));
+    if (k < polls.length - 1 && seg.jitterTicks > 0 && r > 0) {
+      const max = 0.45 * period;
+      p += Math.min(max, Math.max(-max, (2 * u - 1) * seg.jitterTicks * (0.5e6 / (r * nominal))));
+    }
+    while (t < p) {
+      const b = Math.min(t + GRID_US, p);
+      const xb = xAt(b);
+      const na = Math.floor(x), nb = Math.floor(xb);
+      if (na !== nb) {
+        const level = nb > na ? nb : nb + 1; // the last whole number crossed
+        lastCross = t + ((level - x) / (xb - x)) * (b - t);
+      }
+      t = b;
+      x = xb;
+    }
+    const n = Math.floor(x);
+    if (n === nSent) continue;
+    let ts = Math.round((lastCross * script.timerHz) / 1e6 + sigma * gaussian(randNoise));
+    ts = Math.max(ts, tsPrev + 1);
+    if (script.saturate) {
+      const d = ts - tsPrev;
+      if (d >= MARKER_MIN) {
+        pb = mod(pb - 1, TIMER_MOD);
+        markers++;
+      } else pb = mod(pb + d, TIMER_MOD);
+    } else pb = mod(ts, TIMER_MOD);
+    tsPrev = ts;
+    nSent = n;
+    msgs.push({ devUs: nominalUs, n, pb, seg });
+  }
+
+  // Host-side loss: each drop segment loses round(percent %) of its messages (never the first or the last).
+  const drop = new Set();
+  for (const seg of motion.segments) {
+    if (seg.kind !== "drop" || seg.percent === 0) continue;
+    const idx = [];
+    for (let i = 1; i < msgs.length - 1; i++) if (msgs[i].devUs >= seg.from * 1e6 && msgs[i].devUs < seg.to * 1e6) idx.push(i);
+    const want = Math.round((seg.percent / 100) * idx.length);
+    for (let j = 0; j < want; j++) {
+      const pick = j + Math.floor(randDrop() * (idx.length - j));
+      [idx[j], idx[pick]] = [idx[pick], idx[j]];
+      drop.add(idx[j]);
+    }
+  }
+  // Host-side stalls: a message sent during a stall reaches the host when it ends.
+  const stalls = motion.segments.filter((s) => s.kind === "stall-burst")
+    .map((s) => ({ from: (s.from + s.atSeconds) * 1e6, to: (s.from + s.atSeconds + s.stallMs / 1000) * 1e6 }));
+
+  // A host losing 64 or more ticks in a row would see CC 6 alias (a drop at a high percent); refuse to write that.
+  let prevN = null;
+  for (let i = 0; i < msgs.length; i++) {
+    if (drop.has(i)) continue;
+    if (prevN !== null && Math.abs(msgs[i].n - prevN) > 63) {
+      throw new Error(`${Math.abs(msgs[i].n - prevN)} ticks between two messages the host gets (at ${(msgs[i].devUs / 1e6).toFixed(3)} s): CC 6 would alias at 64 ticks; lower the drop percent`);
+    }
+    prevN = msgs[i].n;
+  }
+
+  const cc = 0xb0 | (script.ch - 1), bend = 0xe0 | (script.ch - 1);
+  let text = "", stalled = 0, written = 0;
+  for (let i = 0; i < msgs.length; i++) {
+    if (drop.has(i)) continue;
+    const m = msgs[i];
+    let hostUs = m.devUs;
+    const stall = stalls.find((s) => hostUs >= s.from && hostUs < s.to);
+    if (stall) {
+      hostUs = stall.to;
+      stalled++;
+    }
+    const t_us = script.startUs + Math.round(hostUs / 1000) * 1000;
+    text += formatLine(toRecord({ status: cc, data: [6, mod(m.n, TICK_MOD)] }, t_us));
+    text += formatLine(toRecord({ status: bend, data: [m.pb & 0x7f, m.pb >> 7] }, t_us));
+    written++;
+  }
+  return {
+    text,
+    stats: {
+      seconds: motion.seconds, messages: written, markers, dropped: drop.size, stalled,
+      netTicks: msgs[msgs.length - 1].n, scriptedNetTicks: Math.floor(xAt(endUs)),
+    },
+  };
+}
diff --git a/tools/platter-run b/tools/platter-run
new file mode 100755
index 0000000..10000ec
--- /dev/null
+++ b/tools/platter-run
@@ -0,0 +1,89 @@
+#!/usr/bin/env node
+// Runs a platter capture (M2 JSONL) through the pure platter core, decoder → speed estimator → state machine with a
+// heartbeat every 20 ms of t_us, and prints the timeline of state changes (M4-07).
+// Exit: 0 run · 1 unreadable file or a line that breaks the M2 format · 2 usage
+// Spec: docs/plans/2026-10-19-M4-platter-core.md, Real-capture check; the run is tools/lib/platter-run.mjs.
+import { readJsonl } from "./lib/jsonl.mjs";
+import { loadPlatter } from "./lib/load-platter.mjs";
+import { runCore, timeline, glitches, parseExpected, HEARTBEAT_US } from "./lib/platter-run.mjs";
+
+const USAGE = "usage: tools/platter-run <capture.jsonl> [--expected <s>:<ratio>,…] [--json]";
+const HELP = `${USAGE}
+Feeds every message of a capture to the platter core in mapping/rane-one-platter.js (deck 1: CC 6 and pitch bend on
+channel 1), pushes a heartbeat every ${HEARTBEAT_US / 1000} ms of t_us, and prints each state change with its time
+in seconds, the ratio the change was made on, and whether that ratio was timed by the device or by host time.
+  --expected <list>  expectedRatio changes, e.g. 0:0,19.236:1,44.67:0 (seconds of t_us, rising). Default: 0 at
+                     the start, toggled 0 <-> 1 by each note 0 ch 1 press (assumed Play: UNVERIFIED)
+  --json             print one JSON object per change instead (kind "state", "press" or "expected")
+Note 0 ch 1 presses are marked either way. The text ends with every control flip that flips back within 20 ms.
+Exit: 0 run · 1 unreadable file or a line that breaks the M2 format · 2 usage
+`;
+
+function usage(why) {
+  if (why) process.stderr.write(`platter-run: ${why}\n`);
+  process.stderr.write(USAGE + "\n");
+  process.exit(2);
+}
+
+const args = process.argv.slice(2);
+if (args.length === 1 && args[0] === "--help") {
+  process.stdout.write(HELP);
+  process.exit(0);
+}
+let file = null, expected = null, json = false;
+const seen = new Set();
+for (let i = 0; i < args.length; i++) {
+  const a = args[i];
+  if (!a.startsWith("-") || a === "-") {
+    if (a === "-") usage("reading stdin is not supported");
+    if (file !== null) usage(`unexpected argument ${a}`);
+    file = a;
+    continue;
+  }
+  if (seen.has(a)) usage(`${a} given twice`);
+  seen.add(a);
+  if (a === "--json") {
+    json = true;
+  } else if (a === "--expected") {
+    const v = args[++i];
+    if (v === undefined) usage(`${a} needs a value`);
+    expected = parseExpected(v);
+    if (expected === null) usage(`bad --expected ${v}`);
+  } else usage(`unknown option ${a}`);
+}
+if (file === null) usage();
+
+let recs;
+try {
+  recs = readJsonl(file);
+} catch (err) {
+  process.stderr.write(`platter-run: ${err.code ? `${file}: ${err.message}` : err.message}\n`);
+  process.exit(1);
+}
+const run = runCore(loadPlatter(), recs, { expected });
+const changes = timeline(run);
+
+if (json) {
+  process.stdout.write(changes.map((c) => JSON.stringify(c) + "\n").join(""));
+  process.exit(0);
+}
+const sec = (us) => `${(us / 1e6).toFixed(3).padStart(7)} s`;
+const ratio = (r) => `${r >= 0 ? "+" : "-"}${Math.abs(r).toFixed(3)}`;
+const fmt = (e) => String(Number(e.toFixed(6)));
+const from = expected === null ? "note 0 ch 1 presses toggle it 0 <-> 1 (assumed Play: UNVERIFIED)" : "--expected";
+const out = [`${file}: ${recs.length} messages, ${run.decoderStats.samples} samples, ${run.updates.length} updates ` +
+  `(heartbeat every ${HEARTBEAT_US / 1000} ms); expectedRatio: ${from}`];
+for (const c of changes) {
+  if (c.kind === "state") {
+    out.push(`${sec(c.t_us)}  ${c.state.padEnd(14)} ${c.control.padEnd(7)} ratio ${ratio(c.ratio)} ` +
+      `(${c.timed ? "timed" : "host"})`);
+  } else if (c.kind === "press") {
+    out.push(`${sec(c.t_us)}  press note 0 ch 1 (${c.ms === null ? "no release" : `${fmt(c.ms)} ms`})`);
+  } else {
+    out.push(`${sec(c.t_us)}  expectedRatio ${fmt(c.expectedRatio)}${c.source === "press" ? " (the press)" : ""}`);
+  }
+}
+const g = glitches(changes);
+out.push(`control flips under 20 ms: ${g.length}`);
+for (const x of g) out.push(`${sec(x.t_us)}  ${x.from} -> ${x.to} for ${fmt(x.ms)} ms`);
+process.stdout.write(out.join("\n") + "\n");
diff --git a/tools/synth-platter b/tools/synth-platter
new file mode 100755
index 0000000..194f673
--- /dev/null
+++ b/tools/synth-platter
@@ -0,0 +1,94 @@
+#!/usr/bin/env node
+// Writes the platter messages a motion script would make the Rane One send, as M2 JSONL (M4-04).
+//   tools/synth-platter --script <motion.json> --out <file.jsonl> [--seed N] [--force]
+// The device model and the script format: tools/lib/synth-platter.mjs. Refuses to overwrite unless --force.
+// Exit: 0 written · 1 bad script or I/O failure · 2 usage
+// Spec: docs/plans/2026-10-19-M4-platter-core.md, section "synth-platter".
+import { readFileSync, existsSync, linkSync, renameSync, rmSync, writeFileSync } from "node:fs";
+import { dirname, basename, join } from "node:path";
+import { parseScript, synthesize } from "./lib/synth-platter.mjs";
+
+const USAGE = readFileSync(new URL(import.meta.url), "utf8").split("\n")[2].replace(/^\/\/ {3}/, "usage: ");
+const HELP = `${USAGE}
+Script: { "rpm": 33.333, "seed": 1, "segments": [ … ] }, plus optional messagePeriodUs (1000), timerJitterCounts
+(4.5), saturate (true), startUs (0), ch (1), ticksPerRev (3600), timerHz (2822400) and comment. Segments:
+  {"kind": "constant", "ratio": 1.0, "seconds": 5, "jitterTicks": 1}
+  {"kind": "scratch", "amplitudeTicks": 200, "periodSeconds": 0.5, "seconds": 2, "ratio": 0}
+  {"kind": "backspin", "fromRatio": -3, "decaySeconds": 0.4, "seconds": 4}
+  {"kind": "slow", "ratio": 0.02, "seconds": 5}
+  {"kind": "drop", "percent": 10, "seconds": 4, "ratio": 1.0, "jitterTicks": 0}
+  {"kind": "stall-burst", "stallMs": 40, "seconds": 1, "ratio": 1.0, "atSeconds": <middle>}
+--seed N overrides the script's seed. A summary goes to stderr.
+Exit: 0 written · 1 bad script or I/O failure · 2 usage
+`;
+
+function usage(why) {
+  if (why) process.stderr.write(`synth-platter: ${why}\n`);
+  process.stderr.write(USAGE + "\n");
+  process.exit(2);
+}
+
+const args = process.argv.slice(2);
+if (args.length === 1 && args[0] === "--help") {
+  process.stdout.write(HELP);
+  process.exit(0);
+}
+let scriptPath = null, out = null, seed = null, force = false;
+const seen = new Set();
+for (let i = 0; i < args.length; i++) {
+  const a = args[i];
+  if (!a.startsWith("--")) usage(`unexpected argument ${a}`);
+  if (seen.has(a)) usage(`${a} given twice`);
+  seen.add(a);
+  if (a === "--force") {
+    force = true;
+    continue;
+  }
+  const v = args[i + 1];
+  if (v === undefined || v === "" || v.startsWith("-")) usage(`${a} needs a value`);
+  i++;
+  if (a === "--script") scriptPath = v;
+  else if (a === "--out") out = v;
+  else if (a === "--seed") {
+    if (!/^\d{1,10}$/.test(v) || Number(v) > 0xffffffff) usage(`bad --seed ${v}`);
+    seed = Number(v);
+  } else usage(`unknown option ${a}`);
+}
+if (scriptPath === null || out === null) usage();
+
+const fail = (msg) => {
+  process.stderr.write(`synth-platter: ${msg}\n`);
+  process.exit(1);
+};
+let result;
+try {
+  let obj;
+  try {
+    obj = JSON.parse(readFileSync(scriptPath, "utf8"));
+  } catch (err) {
+    throw new Error(err.code ? err.message : `not JSON (${err.message})`);
+  }
+  const script = parseScript(obj);
+  result = synthesize(script, seed === null ? {} : { seed });
+} catch (err) {
+  fail(`${scriptPath}: ${err.message}`);
+}
+if (!force && existsSync(out)) fail(`${out} exists; use --force to overwrite`);
+
+// Written to a temp file next to the output, then linked (no --force: fails if the output appeared meanwhile) or
+// renamed over it (--force), so an old file survives any failure.
+const tmp = join(dirname(out), `.${basename(out)}.${process.pid}.tmp`);
+let writeError = null;
+try {
+  writeFileSync(tmp, result.text, { flag: "wx" });
+  if (force) renameSync(tmp, out);
+  else linkSync(tmp, out);
+} catch (err) {
+  writeError = err.code === "EEXIST" && err.dest === out ? `${out} exists; use --force to overwrite` : err.message;
+} finally {
+  rmSync(tmp, { force: true });
+}
+if (writeError !== null) fail(writeError);
+const s = result.stats;
+process.stderr.write(`synth-platter: wrote ${out}: ${s.messages} messages over ${s.seconds} s, net ${s.netTicks} ticks, `
+  + `${s.markers} markers, ${s.dropped} dropped, ${s.stalled} stalled\n`);
