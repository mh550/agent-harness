+// Loads the pure platter core (mapping/rane-one-platter.js) the way Mixxx does: as a plain script whose top-level
+// `var RaneOnePlatter` becomes a global. The context has no engine, midi, print, console or require, so any stray
+// call into Mixxx or Node throws a ReferenceError. Spec: docs/plans/2026-10-19-M4-platter-core.md, Loading.
+import { readFileSync } from "node:fs";
+import vm from "node:vm";
+
+export const PLATTER_JS = new URL("../../mapping/rane-one-platter.js", import.meta.url);
+
+// A fresh context per call, so two loads share no state.
+export function loadPlatter() {
+  const src = readFileSync(PLATTER_JS, "utf8");
+  const context = {};
+  vm.runInNewContext(src, context, { filename: "rane-one-platter.js" });
+  return context.RaneOnePlatter;
+}
