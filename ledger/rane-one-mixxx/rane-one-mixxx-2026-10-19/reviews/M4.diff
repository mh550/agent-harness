+  let ticks = 0, timer = 0, t = 0;
+  const step = (dTicks, us) => {
+    ticks += dTicks;
+    timer += Math.round(us * 2.8224); // device time = host time
+    t += us;
+    return plain(est.push({ ticks, timer, hostTimeUs: t }));
+  };
+  for (let i = 0; i < 300; i++) step(2, 1000); // 1.0
+  for (let i = 0; i < 150; i++) step(-3, 1000); // -1.5 for 150 ms
+  for (const us of [1000, 1000, 2000, 2000, 3000, 4000, 5000]) step(-1, us); // a quick decel
+  const stopUs = t;
+  const out = [];
+  for (let k = 1; k <= 15; k++) {
+    const hb = stopUs + 20000 * k;
+    out.push({ t: hb, ...plain(est.push({ ticks, timer: null, hostTimeUs: hb })) });
+  }
+  for (const r of out.filter((r) => r.t - stopUs >= 50000)) {
+    const bound = 1 / ((r.t - stopUs) / 1e6) / 2000;
+    assert.ok(Math.abs(r.ratio) <= bound + 1e-12, `${(r.t - stopUs) / 1000} ms after the stop: ${r.ratio}`);
+  }
+  assert.deepEqual(out.at(-1), { t: out.at(-1).t, ratio: 0, timed: false });
+});
