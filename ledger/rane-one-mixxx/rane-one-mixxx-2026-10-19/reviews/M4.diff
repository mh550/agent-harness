+test("after a null-timer sample the next timed sample takes ticks and timer from the last timed sample", () => {
+  const est = P.createSpeedEstimator();
+  for (let i = 0; i <= 20; i++) est.push(at1(2 * i, 1000 * i));
+  const nul = plain(est.push({ ticks: 42, timer: null, hostTimeUs: 21000 }));
+  assert.ok(Math.abs(nul.ratio - 1) < 0.02, `the null-timer sample reads ${nul.ratio}`);
+  const r = plain(est.push(at1(44, 22000)));
+  assert.equal(r.timed, true);
