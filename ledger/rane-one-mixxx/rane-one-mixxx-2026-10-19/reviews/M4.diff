+  // The record turns round: 8 ms without a tick, so the timestamp saturates. The 200 ms host window alone would
+  // still read 0.9 here.
+  const turn = plain(est.push({ ticks: 601, timer: Math.round(600 * TPT) - 1, hostTimeUs: 308000 }));
+  assert.equal(turn.timed, false);
+  const bound = TPT / P.DEFAULTS.TIMER_MARKER_MIN;
+  assert.ok(turn.ratio >= 0 && turn.ratio <= bound + 1e-12, `the marker sample reads ${turn.ratio}, bound ${bound}`);
+  const est2 = P.createSpeedEstimator();
+  for (let i = 0; i <= 300; i++) est2.push(at1(2 * i, 1000 * i));
+  const against = plain(est2.push({ ticks: 599, timer: Math.round(600 * TPT) - 1, hostTimeUs: 308000 }));
+  assert.equal(against.ratio, 0, "a tick back after forward motion reads 0, not the window's +0.9");
+  // Then back the other way, timed again: one tick 4 ms later is -0.125, and the filter re-seeds from it.
+  const back = plain(est.push({ ticks: 600, timer: Math.round(600 * TPT) - 1 + Math.round(8 * TPT), hostTimeUs: 312000 }));
+  assert.equal(back.timed, true);
+  assert.ok(Math.abs(back.ratio + 0.125) < 1e-3, `back: ${back.ratio}`);
+  assert.equal(est.stats().reseeds, 2);
+});
