+// The platter speed estimator (M4-05): the platter's speed ratio from the device timestamps through a filter, with a
+// host-time fallback for samples the device didn't time (below the timer's 0.086 limit, D23). Spec:
+// docs/plans/2026-10-19-M4-platter-core.md, Speed estimator and Filter choice (D22). Labelled data:
+// tools/synth-platter (tests/fixtures/motion); real data: captures/2026-10-19-quick/platter.jsonl.
+import { test, before, after } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { readJsonl } from "../tools/lib/jsonl.mjs";
+import { loadPlatter } from "./helpers/load-platter.mjs";
+import { synthDir, readMotion } from "./helpers/synth.mjs";
+import { parseScript, createMotion } from "../tools/lib/synth-platter.mjs";
+import { runEstimator } from "./helpers/run-core.mjs";
+import { benchInputs, measure, pick } from "./helpers/filter-bench.mjs";
+
+const P = loadPlatter();
+const CAPTURE = fileURLToPath(new URL("../captures/2026-10-19-quick/platter.jsonl", import.meta.url));
+const plain = (x) => JSON.parse(JSON.stringify(x));
+const S = (us) => us / 1e6;
+
+let synth;
+const files = {};
+before(() => {
+  synth = synthDir("platter-speed-");
+  for (const name of ["constant33", "constant45", "step", "slow", "backspin", "drop-and-burst", "scratch"]) {
+    files[name] = readJsonl(synth.generate(name));
+  }
+  const twin = readMotion("drop-and-burst");
+  twin.segments = twin.segments.map((s) => (s.kind === "drop" ? { ...s, percent: 0 } : s));
+  files["drop-and-burst-twin"] = readJsonl(synth.generate(twin));
+});
+after(() => synth.cleanup());
+
+// The worst |ratio - want| over results with fromUs <= t < toUs.
+function worst(out, want, fromUs, toUs = Infinity) {
+  let w = 0, at = null;
+  for (const r of out) {
+    if (r.t < fromUs || r.t >= toUs) continue;
+    const e = Math.abs(r.ratio - want);
+    if (e > w) [w, at] = [e, r.t];
+  }
+  return { w, at };
+}
+
+// Both candidate filters must meet the acceptance (plan: Speed estimator, Acceptance); the default is D22's pick.
+const FILTERS = [
+  ["default", undefined],
+  ["alpha-beta", { FILTER: "alpha-beta" }],
+  ["one-euro", { FILTER: "one-euro" }],
+];
+
+for (const [label, config] of FILTERS) {
+  test(`${label}: constant33 reads 1.000 ± 0.002 on every push after the first 50 ms`, () => {
+    const { out } = runEstimator(P, files.constant33, config);
+    const { w, at } = worst(out, 1, 50000);
+    assert.ok(w <= 0.002, `|ratio - 1| = ${w.toFixed(5)} at ${S(at)} s`);
+    assert.ok(out.filter((r) => r.t >= 50000).every((r) => r.timed), "every push after 50 ms is timed");
+  });
+
+  test(`${label}: constant45 with rpm RPM_45 reads 1.000 ± 0.002 after the first 50 ms`, () => {
+    const { out } = runEstimator(P, files.constant45, { ...config, rpm: P.DEFAULTS.RPM_45 });
+    const { w, at } = worst(out, 1, 50000);
+    assert.ok(w <= 0.002, `|ratio - 1| = ${w.toFixed(5)} at ${S(at)} s`);
+  });
+
+  test(`${label}: a step from 1.0 to 0.5 is within 0.5 ± 0.02 within 100 ms`, () => {
+    const { out } = runEstimator(P, files.step, config);
+    const before = worst(out, 1, 50000, 2000000);
+    assert.ok(before.w <= 0.002, `before the step |ratio - 1| = ${before.w.toFixed(5)} at ${S(before.at)} s`);
+    const afterStep = worst(out, 0.5, 2100000);
+    assert.ok(afterStep.w <= 0.02, `from 2.1 s |ratio - 0.5| = ${afterStep.w.toFixed(5)} at ${S(afterStep.at)} s`);
+  });
+
+  test(`${label}: slow (0.02) is untimed and the host-time ratio is within ± 20 %`, () => {
+    const { out } = runEstimator(P, files.slow, config);
+    const late = out.filter((r) => r.t >= 250000);
+    assert.ok(late.length > 100);
+    assert.ok(late.every((r) => r.timed === false), "timed is false on every push");
+    const { w, at } = worst(out, 0.02, 250000);
+    assert.ok(w <= 0.004, `|ratio - 0.02| = ${w.toFixed(5)} at ${S(at)} s`);
+  });
+
+  test(`${label}: the backspin goes negative`, () => {
+    const { out } = runEstimator(P, files.backspin, config);
+    const spin = out.filter((r) => r.t >= 1050000 && r.t < 1800000 && !r.heartbeat);
+    assert.ok(spin.length > 100);
+    assert.ok(spin.every((r) => r.ratio < 0), "every sample in 1.05-1.8 s is negative");
+    assert.ok(Math.min(...spin.map((r) => r.ratio)) < -2.5, "it reaches the script's -3");
+  });
+
+  test(`${label}: dropped messages and the 40 ms stall change the ratio by less than 0.01`, () => {
+    const dropped = runEstimator(P, files["drop-and-burst"], config);
+    const twin = runEstimator(P, files["drop-and-burst-twin"], config);
+    assert.ok(dropped.decoderStats.samples < twin.decoderStats.samples - 300, "the drop removed ~400 samples");
+    assert.equal(dropped.decoderStats.untrustedTimers, 1, "the burst's first sample is untimed (plan, synth-platter)");
+    let maxDiff = 0, at = null, j = 0;
+    for (const r of dropped.out) {
+      while (j + 1 < twin.out.length && twin.out[j + 1].t <= r.t) j++;
+      if (r.t < 50000) continue;
+      const d = Math.abs(r.ratio - twin.out[j].ratio);
+      if (d > maxDiff) [maxDiff, at] = [d, r.t];
+    }
+    assert.ok(maxDiff < 0.01, `max |Δratio| vs the undropped twin = ${maxDiff.toFixed(5)} at ${S(at)} s`);
+    const { w, at: wAt } = worst(dropped.out, 1, 50000);
+    assert.ok(w < 0.01, `|ratio - 1| = ${w.toFixed(5)} at ${S(wAt)} s`);
+    const low = dropped.out.filter((r) => r.t >= 50000 && r.ratio < 1 - P.DEFAULTS.TAKEOVER_TOL);
+    assert.deepEqual(low, [], "no ratio below 1 - TAKEOVER_TOL through the stall");
+  });
+}
+
+test("the real quick capture reads 1.00 ± 0.01 through the motor phase 20-36 s", () => {
+  const { out } = runEstimator(P, readJsonl(CAPTURE));
+  const { w, at } = worst(out, 1, 20000000, 36000000);
+  assert.ok(w <= 0.01, `|ratio - 1| = ${w.toFixed(5)} at ${S(at)} s`);
+});
