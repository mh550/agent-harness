+    { ticks: 44, timer: NaN, hostTimeUs: 22000 }, { ticks: 44, timer: null, hostTimeUs: NaN },
+    { ticks: 44, timer: null, hostTimeUs: Infinity }, { ticks: Infinity, timer: null, hostTimeUs: 22000 }];
+  for (const s of junk) {
