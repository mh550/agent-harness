index 0000000..ab6ced3
--- /dev/null
+++ b/tools/lib/platter-run.mjs
@@ -0,0 +1,141 @@
+// Runs capture-format records (a real capture or tools/synth-platter output) through the whole pure platter core
+// the way the glue will: every message is fed to the decoder with its t_us, every HEARTBEAT_US of t_us a heartbeat
+// is pushed after flush() (unless a CC is still waiting for its pitch bend), and every estimator result goes to the
+// state machine. expectedRatio comes from note 0 ch 1 presses (off at the start, toggled by each press; the button
+// is Play: UNVERIFIED, D19) unless a list of changes is given. Used by tools/platter-run (M4-07) and, through
+// tests/helpers/run-core.mjs, by the estimator tests.
+// Spec: docs/plans/2026-10-19-M4-platter-core.md, Decoder (Pairing), Speed estimator (Heartbeat), Real-capture check.
+import { DECIMAL } from "./numbers.mjs";
+
+export const HEARTBEAT_US = 20000;
+
+const isPress = (r) => r.type === "on" && r.ch === 1 && r.d1 === 0 && r.d2 > 0;
+const isRelease = (r) => (r.type === "off" || (r.type === "on" && r.d2 === 0)) && r.ch === 1 && r.d1 === 0;
+
+// "<seconds>:<ratio>,…" with strictly rising times → [{ t_us, e }], or null.
+export function parseExpected(s) {
+  const out = [];
+  for (const part of s.split(",")) {
+    const kv = part.split(":");
+    if (kv.length !== 2 || !DECIMAL.test(kv[0]) || !DECIMAL.test(kv[1])) return null;
+    const t_us = Math.round(Number(kv[0]) * 1e6);
+    if (out.length > 0 && t_us <= out[out.length - 1].t_us) return null;
+    out.push({ t_us, e: Number(kv[1]) });
+  }
+  return out;
+}
+
+// records → { updates, presses, expectedChanges, stats, decoderStats, stateStats }.
+//   updates: one per estimator push, { t, ticks, ratio, timed, heartbeat, untrusted, expectedRatio, state, control,
+//     position } (t in µs; untrusted: the decoder's flag for a sample with no device time behind it).
+//   presses: note 0 ch 1 presses, { t_us, ms, at } (ms: null without a release).
+//   expectedChanges: { t_us, e, source, at } whenever expectedRatio changes ("press" or "option").
+//   at: the index of the first update made after it, so updates in the same µs keep their order around it.
+// A change takes effect from the first message at or after its time, in file order; a heartbeat at exactly that
+// time comes before it (heartbeats run before the messages of their µs), for presses and --expected alike.
+// opts: { estimator, stateMachine } configs for the core; expected: [{ t_us, e }] instead of the presses.
+export function runCore(P, records, opts = {}) {
+  const dec = P.createDecoder();
+  const est = P.createSpeedEstimator(opts.estimator);
+  const sm = P.createStateMachine(opts.stateMachine);
+  const given = opts.expected ?? null;
+  const updates = [], presses = [], expectedChanges = [];
+  let e = 0, nextChange = 0, lastTicks = null, open = null;
+  let nextBeat = records.length > 0 ? records[0].t_us + HEARTBEAT_US : 0;
+
+  const setE = (t_us, value, source) => {
+    if (value === e) return;
+    e = value;
+    expectedChanges.push({ t_us, e, source, at: updates.length });
+  };
+  const applyGiven = (t, strict) => {
+    while (given !== null && nextChange < given.length &&
+      (strict ? given[nextChange].t_us < t : given[nextChange].t_us <= t)) {
+      setE(given[nextChange].t_us, given[nextChange].e, "option");
+      nextChange++;
+    }
+  };
+  const push = (sample, heartbeat) => {
+    const r = est.push(sample);
+    const s = sm.update({ ratio: r.ratio, hostTimeUs: sample.hostTimeUs, expectedRatio: e, ticks: sample.ticks,
+      untrusted: sample.untrusted === true });
+    updates.push({ t: sample.hostTimeUs, ticks: sample.ticks, ratio: r.ratio, timed: r.timed, heartbeat,
+      untrusted: sample.untrusted === true, expectedRatio: e, state: s.state, control: s.control,
+      position: s.position });
+  };
+  const beat = (t) => {
+    applyGiven(t, true);
+    const s = dec.flush(t);
+    if (s !== null) {
+      lastTicks = s.ticks;
+      push(s, false);
+    }
+    if (!dec.pending() && lastTicks !== null) push({ ticks: lastTicks, timer: null, hostTimeUs: t }, true);
+  };
+
+  for (const r of records) {
+    while (nextBeat <= r.t_us) {
+      beat(nextBeat);
+      nextBeat += HEARTBEAT_US;
+    }
+    applyGiven(r.t_us, false);
+    if (isPress(r)) {
+      open = { t_us: r.t_us, ms: null, at: updates.length };
+      presses.push(open);
+      if (given === null) setE(r.t_us, e > 0 ? 0 : 1, "press");
+    } else if (isRelease(r) && open !== null) {
+      open.ms = (r.t_us - open.t_us) / 1000;
+      open = null;
+    }
+    const b = Buffer.from(r.bytes, "hex");
+    if (b.length !== 3) continue;
+    const s = dec.feed(b[0], b[1], b[2], r.t_us);
+    if (s !== null) {
+      lastTicks = s.ticks;
+      push(s, false);
+    }
+  }
+  return { updates, presses, expectedChanges, stats: est.stats(), decoderStats: dec.stats(), stateStats: sm.stats() };
+}
+
+// runCore's result → the time-ordered changes: { kind: "state", t_us, t_s, from, state, control, ratio, timed } for
+// the first update and every state change, { kind: "press", t_us, t_s, note: 0, ch: 1, ms } and { kind: "expected",
+// t_us, t_s, expectedRatio, source } (t_s: t_us in seconds), in the order runCore met them: a press and the
+// expectedRatio change it makes come after the updates made before the press (even in the same µs) and before the
+// ones made after it.
+export function timeline(run) {
+  const events = [
+    ...run.presses.map((x) => ({ at: x.at, c: { kind: "press", t_us: x.t_us, t_s: x.t_us / 1e6, note: 0, ch: 1, ms: x.ms } })),
+    ...run.expectedChanges.map((x) => ({ at: x.at,
+      c: { kind: "expected", t_us: x.t_us, t_s: x.t_us / 1e6, expectedRatio: x.e, source: x.source } })),
+  ].sort((a, b) => a.at - b.at || a.c.t_us - b.c.t_us); // stable: a press before the change it makes
+  const out = [];
+  let k = 0;
+  run.updates.forEach((u, i) => {
+    while (k < events.length && events[k].at <= i) out.push(events[k++].c);
+    const prev = i === 0 ? null : run.updates[i - 1];
+    if (prev === null || u.state !== prev.state) {
+      out.push({ kind: "state", t_us: u.t, t_s: u.t / 1e6, from: prev === null ? null : prev.state, state: u.state,
+        control: u.control, ratio: u.ratio, timed: u.timed });
+    }
+  });
+  while (k < events.length) out.push(events[k++].c);
+  return out;
+}
+
+// Control flips that flip back within maxUs (default 20 ms): [{ t_us, ms, from, to }] for the first flip of each pair.
+export function glitches(changes, maxUs = 20000) {
+  const flips = [];
+  let control = null;
+  for (const c of changes) {
+    if (c.kind !== "state") continue;
+    if (control !== null && c.control !== control) flips.push({ t_us: c.t_us, from: control, to: c.control });
+    control = c.control;
+  }
+  const out = [];
+  for (let i = 0; i + 1 < flips.length; i++) {
+    const us = flips[i + 1].t_us - flips[i].t_us;
+    if (us < maxUs) out.push({ t_us: flips[i].t_us, ms: us / 1000, from: flips[i].from, to: flips[i].to });
+  }
+  return out;
+}
diff --git a/tools/lib/synth-platter.mjs b/tools/lib/synth-platter.mjs
