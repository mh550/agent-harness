+  // T1 (backspin) fires on r < -0.5 at once; allow the estimator's lag of a few ms.
+  const falseBackspin = seg.filter((r) => r.ratio < -0.5 && m.ratioAt(r.t / 1e6 - 0.01) > -0.4 && m.ratioAt(r.t / 1e6) > -0.4);
