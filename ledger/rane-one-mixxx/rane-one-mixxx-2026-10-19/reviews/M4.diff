+  g.run(1, { r: 1, e: 1 });
+  assert.equal(g.last().state, "settling");
+});
+
+test("T13 settling -> motor_at_speed after SETTLE_MS within HANDBACK_TOL; the timer starts on entering settling", () => {
+  const g = settling();
+  const enter = g.out.length - 1;
