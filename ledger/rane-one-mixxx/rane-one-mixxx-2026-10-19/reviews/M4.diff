@@ -8,3 +8,13 @@ export const median = (a) => {
   const m = s.length >> 1;
   return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2;
 };
+
+// "33", "33.", "33.0", "33.3", "33.33", "33.333", … (trailing zeros too: "33.30") and "100/3" are exactly 100/3 (a literal
+// 33.333 is 1.0e-5 low: 3 ms of fake drift over 5 min; 33.0 is 1 % low, review M3 #4); any other positive decimal
+// is taken as given. → number, or null if it isn't one.
+export function parseRpm(s) {
+  if (s === "100/3" || /^33(\.(3+0*|0*))?$/.test(s)) return 100 / 3;
+  if (!DECIMAL.test(s)) return null;
+  const v = Number(s);
+  return v > 0 ? v : null;
+}
diff --git a/tools/lib/platter-analysis.mjs b/tools/lib/platter-analysis.mjs
new file mode 100644
index 0000000..30d4119
--- /dev/null
+++ b/tools/lib/platter-analysis.mjs
@@ -0,0 +1,109 @@
+// Per-phase numbers for a platter capture in the M2 JSONL format: tools/analyze-platter is its CLI (M4-01).
+// A phase is a [from, to) window in seconds of t_us. Each CC-6 and pitch-bend message's delta is taken from the
+// previous message of its kind (wherever that was) and counted in the phase the message falls in, so phases that
+// tile a capture add up to its whole. A phase's seconds are clipped to the capture's first and last message, so a
+// rate is per second of data. The histograms are signed; the net timer is unsigned, because the timestamp is a
+// clock: a delta of -1 (16383 unsigned) is counted apart as a marker, read as "5.8 ms or more" (UNVERIFIED; see
+// the analysis document).
+// Spec: docs/research/2026-10-19-quick-capture-analysis.md.
+import { DECIMAL } from "./numbers.mjs";
+
+export const TICK_MOD = 128; // CC 6 is a 7-bit counter (captures/2026-10-19-quick/platter.jsonl)
+export const TIMER_MOD = 16384; // the pitch-bend value is a 14-bit timestamp (same capture)
+export const TIMER_MARKER = TIMER_MOD - 1; // the unsigned delta of -1, seen only after gaps of 5 ms or more
+
+// The signed difference d modulo m, in [-m/2, m/2).
+export const wrap = (d, m) => ((((d + m / 2) % m) + m) % m) - m / 2;
+
+// "2-8,9-15,20.5-36" → [{from, to}] in seconds, or null if any part is not "<from>-<to>" with from < to.
+export function parsePhases(s) {
+  const out = [];
+  for (const part of s.split(",")) {
+    const m = /^([^-]+)-([^-]+)$/.exec(part);
+    if (!m || !DECIMAL.test(m[1]) || !DECIMAL.test(m[2])) return null;
+    const from = Number(m[1]), to = Number(m[2]);
+    if (!(from < to)) return null;
+    out.push({ from, to });
+  }
+  return out;
+}
+
+const count = (hist, k) => {
+  hist[k] = (hist[k] ?? 0) + 1;
+};
+
+// recs: M2 records, t_us non-decreasing. phases: [{from, to}] in s. rpm: the speed assumed for ticks per revolution.
+// cc/ch: the counter's controller number and its 1-based channel; the pitch bends read are on the same channel.
+export function analyzePlatter(recs, phases, { rpm, cc = 6, ch = 1 }) {
+  const first = recs.length ? recs[0].t_us / 1e6 : Infinity;
+  const last = recs.length ? recs[recs.length - 1].t_us / 1e6 : -Infinity;
+  const ps = phases.map(({ from, to }) => {
+    const lo = Math.max(from, first), hi = Math.min(to, last);
+    return {
+      from, to, dataFrom: lo < hi ? lo : null, dataTo: lo < hi ? hi : null, seconds: Math.max(0, hi - lo),
+      messages: 0, rate: 0, perSecond: [], ccHist: {}, tsHist: {}, netTicks: 0, netTimer: 0, markers: 0,
+      timerPerTick: null, ticksPerRev: 0,
+    };
+  });
+  const phaseOf = (t_us) => ps.filter((p) => t_us >= p.from * 1e6 && t_us < p.to * 1e6);
+  const pairs = { cc: 0, pb: 0, adjacent: 0, sameMs: 0 };
+  const others = [];
+  const open = new Map(); // "ch:note" → the note-on record still held
+  let lastCc = null, lastPb = null;
+  recs.forEach((r, i) => {
+    if (r.type === "cc" && r.ch === ch && r.d1 === cc) {
+      pairs.cc++;
+      const next = recs[i + 1];
+      if (next?.type === "pb" && next.ch === ch) {
+        pairs.adjacent++;
+        if (Math.floor(next.t_us / 1000) === Math.floor(r.t_us / 1000)) pairs.sameMs++;
+      }
+      for (const p of phaseOf(r.t_us)) {
+        p.messages++;
+        const s = Math.floor(r.t_us / 1e6) - Math.ceil(p.dataFrom);
+        if (s >= 0) p.perSecond[s] = (p.perSecond[s] ?? 0) + 1;
+        if (lastCc !== null) {
+          const d = wrap(r.value - lastCc, TICK_MOD);
+          count(p.ccHist, d);
+          p.netTicks += d;
+        }
+      }
+      lastCc = r.value;
+    } else if (r.type === "pb" && r.ch === ch) {
+      pairs.pb++;
+      for (const p of phaseOf(r.t_us)) {
+        if (lastPb !== null) {
+          const d = wrap(r.value - lastPb, TIMER_MOD);
+          count(p.tsHist, d);
+          const u = d < 0 ? d + TIMER_MOD : d;
+          if (u === TIMER_MARKER) p.markers++;
+          else p.netTimer += u;
+        }
+      }
+      lastPb = r.value;
+    } else if (r.type === "on" && r.value > 0) {
+      const o = { type: r.type, ch: r.ch, d1: r.d1, t_us: r.t_us, ms: null };
+      others.push(o);
+      open.set(`${r.ch}:${r.d1}`, o);
+    } else if (r.type === "off" || r.type === "on") {
+      const o = open.get(`${r.ch}:${r.d1}`);
+      if (o) {
+        o.ms = (r.t_us - o.t_us) / 1000;
+        open.delete(`${r.ch}:${r.d1}`);
+      } else others.push({ type: "off", ch: r.ch, d1: r.d1, t_us: r.t_us, ms: null });
+    } else others.push({ type: r.type, ch: r.ch, d1: r.d1, t_us: r.t_us, ms: null });
+  });
+  for (const p of ps) {
+    if (p.seconds === 0) {
+      p.perSecond = [];
+      continue;
+    }
+    p.rate = p.messages / p.seconds;
+    // whole seconds of data only: [ceil(dataFrom), floor(dataTo))
+    const whole = Math.max(0, Math.floor(p.dataTo) - Math.ceil(p.dataFrom));
+    p.perSecond = Array.from({ length: whole }, (_, k) => p.perSecond[k] ?? 0);
+    p.timerPerTick = p.netTicks !== 0 ? p.netTimer / p.netTicks : null;
+    p.ticksPerRev = p.netTicks / ((p.seconds * rpm) / 60);
+  }
+  return { phases: ps, pairs, others };
+}
