+// tools/make-test-audio writes the 48 kHz WAV test signals M3 measures: a 1 kHz tone (optionally FM-modulated, for
+// wow-and-flutter) and a click track. Every file goes to a temp dir; *.wav is gitignored.
+// Spec: docs/plans/2026-10-19-M3-measurement.md, section "make-test-audio".
+import { test, after } from "node:test";
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { mkdtempSync, rmSync, readFileSync, readdirSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+import { readWav, decodeWav } from "../tools/lib/wav.mjs";
+import { tone, clicks, dbToAmplitude } from "../tools/lib/test-audio.mjs";
+
+// Every file the tests write goes under a temp dir, removed when the file's tests end.
+const dirs = [];
+const tempDir = () => {
+  const d = mkdtempSync(join(tmpdir(), "make-test-audio-"));
+  dirs.push(d);
+  return d;
+};
+after(() => dirs.forEach((d) => rmSync(d, { recursive: true, force: true })));
+
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), "..");
+const TOOL = join(ROOT, "tools", "make-test-audio");
+const MINUS_6_DB = 10 ** (-6 / 20); // 0.50119
+
+function run(args) {
+  const dir = tempDir();
+  const r = spawnSync(TOOL, args, { cwd: dir, encoding: args.includes("-") ? "buffer" : "utf8" });
+  return { ...r, dir };
+}
+
+// Rising zero crossings x[i] < 0 ≤ x[i+1], at linearly interpolated times in samples.
+function risingCrossings(x) {
+  const t = [];
+  for (let i = 0; i + 1 < x.length; i++) if (x[i] < 0 && x[i + 1] >= 0) t.push(i + x[i] / (x[i] - x[i + 1]));
+  return t;
+}
+const peak = (x) => x.reduce((m, v) => Math.max(m, Math.abs(v)), 0);
+
+test("tone --seconds 5 --out tone.wav: 1 kHz sine at -6 dBFS, 48000 Hz, pcm32, stereo, 240000 frames", () => {
+  const r = run(["tone", "--seconds", "5", "--out", "tone.wav"]);
+  assert.equal(r.status, 0, r.stderr);
+  assert.equal(r.stdout, "");
+  assert.equal(r.stderr, "wrote tone.wav: 240000 frames, 48000 Hz, pcm32, 2 ch\n");
+  assert.deepEqual(readdirSync(r.dir), ["tone.wav"]);
+  const w = readWav(join(r.dir, "tone.wav"));
+  assert.equal(w.sampleRate, 48000);
+  assert.equal(w.format, "pcm32");
+  assert.equal(w.channelCount, 2);
+  assert.equal(w.frames, 240000);
+  assert.deepEqual(w.channels[1], w.channels[0], "both channels identical");
+  const p = peak(w.channels[0]);
+  assert.ok(Math.abs(p / MINUS_6_DB - 1) < 0.01, `peak ${p} not within 1 % of ${MINUS_6_DB}`);
+  const z = risingCrossings(w.channels[0]);
+  assert.ok(Math.abs(z.length - 4999) <= 1, `${z.length} rising crossings in 5 s, expected 1 per ms`);
+  const hz = (48000 * (z.length - 1)) / (z[z.length - 1] - z[0]);
+  assert.ok(Math.abs(hz - 1000) < 0.01, `${hz} Hz`);
+});
+
+test("clicks --bpm 120 --seconds 5: one 1 ms click per beat, 10 in the file, at the peak level", () => {
+  const r = run(["clicks", "--bpm", "120", "--seconds", "5"]);
+  assert.equal(r.status, 0, r.stderr);
+  assert.equal(r.stderr, "wrote ./clicks.wav: 240000 frames, 48000 Hz, pcm32, 2 ch\n");
+  const w = readWav(join(r.dir, "clicks.wav"));
+  assert.equal(w.frames, 240000);
+  const x = w.channels[0];
+  // Rising edges with x[-1] = 0: the first click starts at sample 0.
+  const starts = [];
+  const lengths = [];
+  for (let i = 0; i < x.length; i++) {
+    if (x[i] > 0 && (i === 0 || x[i - 1] <= 0)) starts.push(i);
+    if (x[i] > 0 && (i + 1 === x.length || x[i + 1] <= 0)) lengths.push(i + 1 - starts[starts.length - 1]);
+  }
+  assert.equal(starts.length, 10);
+  assert.deepEqual(starts, [...Array(10).keys()].map((k) => k * 24000), "a beat every 0.5 s from t = 0");
+  assert.deepEqual(lengths, Array(10).fill(48), "each click is 1 ms = 48 samples");
+  assert.ok(Math.abs(peak(x) / MINUS_6_DB - 1) < 0.01);
