+// tools/record-output records the mixxx-dev null sink's monitor with pw-record (D18). `pw-record` and `pactl` are
+// stubs on PATH, so these tests never open a real stream or read the real sink list.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { mkdtempSync, mkdirSync, writeFileSync, readFileSync, readdirSync, existsSync, rmSync, chmodSync, symlinkSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+import { readWav, writeWav } from "../tools/lib/wav.mjs";
+
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), "..");
+const SCRIPT = join(ROOT, "tools", "record-output");
+const WAV_LIB = join(ROOT, "tools", "lib", "wav.mjs");
+
+// The stub logs its argv as one JSON line to $STUB/pw-record.log, then acts on $STUB_MODE:
+// ok (the frames --sample-count asks for, exit 1 like the real pw-record 1.6.8), header (a header-only WAV, as
+// when the target isn't found), short (one frame less), mono, rate44 (44.1 kHz), float (float32), hang (never exits),
+// stubborn (never exits and ignores SIGTERM).
+const PW_RECORD = `#!/usr/bin/env node
+import { appendFileSync, writeFileSync } from "node:fs";
+import { encodeWav } from ${JSON.stringify(WAV_LIB)};
+const argv = process.argv.slice(2);
+appendFileSync(process.env.STUB + "/pw-record.log", JSON.stringify(argv) + "\\n");
+writeFileSync(process.env.STUB + "/pw-record.pid", String(process.pid));
+const file = argv.at(-1);
+const n = Number(argv[argv.indexOf("--sample-count") + 1]);
+const mode = process.env.STUB_MODE ?? "ok";
+const wav = (frames, { sampleRate = 48000, format = "pcm32", count = 2 } = {}) =>
+  writeFileSync(file, encodeWav({ sampleRate, format, channels: Array.from({ length: count }, () => new Float64Array(frames)) }));
+if (mode === "stubborn") process.on("SIGTERM", () => {});
+if (mode === "hang" || mode === "stubborn") setInterval(() => {}, 1000);
+else {
+  if (mode === "ok") wav(n);
+  else if (mode === "header") wav(0);
+  else if (mode === "short") wav(n - 1);
+  else if (mode === "mono") wav(n, { count: 1 });
+  else if (mode === "rate44") wav(n, { sampleRate: 44100 });
+  else if (mode === "float") wav(n, { format: "float32" });
+  process.exit(1);
+}
+`;
+
+// \`pactl -f json list sinks\` prints $STUB/sinks.json; anything else is logged as forbidden and fails.
+const PACTL = `#!/usr/bin/env bash
+if [[ "$*" == "-f json list sinks" ]]; then echo "pactl $*" >> "$STUB/pactl.log"; cat "$STUB/sinks.json"; exit 0; fi
+echo "pactl $*" >> "$STUB/forbidden.log"; exit 99
+`;
+const sinkJson = (name, factory) => ({ index: 1, name, driver: "PipeWire", properties: { "factory.name": factory } });
+const NULL_FACTORY = "support.null-audio-sink";
+const SINKS = [
+  sinkJson("alsa_output.pci-0000_00_1f.3.analog-stereo", "api.alsa.pcm.sink"),
+  sinkJson("alsa_output.usb-Rane_Rane_ONE_A-00.analog-surround-40", "api.alsa.pcm.sink"),
+  sinkJson("mixxx-dev", NULL_FACTORY), sinkJson("other", NULL_FACTORY), sinkJson("realcard", "api.alsa.pcm.sink"),
+  { index: 2, name: "virt-eq", driver: "PipeWire", properties: { "media.class": "Audio/Sink" } },
+];
+
+function setup({ absent = false } = {}) {
+  const dir = mkdtempSync(join(tmpdir(), "record-output-"));
+  const bin = join(dir, "bin"), stub = join(dir, "stub"), out = join(dir, "out");
+  for (const d of [bin, stub, out]) mkdirSync(d);
+  writeFileSync(join(bin, "pw-record"), PW_RECORD, { mode: 0o755 });
+  writeFileSync(join(bin, "pactl"), PACTL, { mode: 0o755 });
+  writeFileSync(join(stub, "sinks.json"), JSON.stringify(absent ? SINKS.filter((x) => x.name !== "mixxx-dev") : SINKS));
+  // Anything that could play, link or change a default: logged and failed, so a regression shows.
+  for (const tool of ["pw-play", "pw-cat", "pw-link", "pw-metadata", "wpctl", "paplay", "aplay"]) {
+    writeFileSync(join(bin, tool), `#!/usr/bin/env bash\necho "${tool} $*" >> "$STUB/forbidden.log"\nexit 99\n`, { mode: 0o755 });
+  }
+  const env = Object.fromEntries(Object.entries(process.env).filter(([k]) => !/^(RECORD_OUTPUT_|STUB)/.test(k)));
+  Object.assign(env, { PATH: `${bin}:${process.env.PATH}`, STUB: stub });
+  const run = (args, extraEnv = {}) =>
+    spawnSync(SCRIPT, args, { encoding: "utf8", env: { ...env, ...extraEnv }, cwd: dir, timeout: 20000 });
+  const log = (name) => {
+    const p = join(stub, `${name}.log`);
+    return existsSync(p) ? readFileSync(p, "utf8").trim().split("\n") : [];
+  };
+  const calls = () => log("pw-record").map((l) => JSON.parse(l));
+  return { dir, out, stub, run, log, calls, done: () => rmSync(dir, { recursive: true, force: true }) };
+}
+
+// True when `want` appears in `argv` as one contiguous run.
+function hasRun(argv, want) {
+  return argv.some((_, i) => want.every((w, j) => argv[i + j] === w));
+}
+
+test("the default records mixxx-dev.monitor: the sink's monitor at 48000 Hz, s32, 2 ch, for --seconds of frames", () => {
+  const t = setup();
+  try {
+    const file = join(t.out, "out.wav");
+    const r = t.run(["--seconds", "3", file]);
+    assert.equal(r.status, 0, r.stderr);
+    const [argv] = t.calls();
+    assert.equal(t.calls().length, 1);
+    // D18: the .monitor name is Pulse-only, so the native stream targets the sink with stream.capture.sink.
+    assert.ok(hasRun(argv, ["--target", "mixxx-dev", "-P", "stream.capture.sink=true",
+      "--rate", "48000", "--format", "s32", "--channels", "2"]), JSON.stringify(argv));
+    assert.ok(hasRun(argv, ["--sample-count", "144000"]), JSON.stringify(argv));
+    assert.ok(hasRun(argv, ["-P", "node.dont-fallback=true"]), JSON.stringify(argv));
+    // A move (pavucontrol, metadata) could otherwise relink it to the Rane One's capture mid-recording.
+    assert.ok(hasRun(argv, ["-P", "node.dont-move=true"]), JSON.stringify(argv));
+    assert.equal(argv.filter((a) => a === "--target").length, 1);
+    assert.ok(!argv.some((a) => /monitor$/.test(a)), "the Pulse-only .monitor name reached pw-record");
+    // pw-record writes a temp file next to the output, renamed into place once it checks out.
+    assert.equal(dirname(argv.at(-1)), t.out);
+    assert.notEqual(argv.at(-1), file);
+    const wav = readWav(file);
+    assert.equal(wav.sampleRate, 48000);
+    assert.equal(wav.channels.length, 2);
+    assert.equal(wav.format, "pcm32");
+    assert.equal(wav.channels[0].length, 144000);
+    assert.deepEqual(readdirSync(t.out), ["out.wav"]);
+    assert.match(r.stdout, /mixxx-dev\.monitor/);
+    assert.match(r.stdout, /144000 frames/);
+    assert.match(r.stdout, /peak -inf dBFS/);
+    assert.deepEqual(t.log("pactl"), ["pactl -f json list sinks"]);
+    assert.deepEqual(t.log("forbidden"), []);
+  } finally {
+    t.done();
+  }
+});
