+test("--fm-depth 0.1 --fm-rate 4 modulates the tone frequency by ±0.1 % at 4 Hz", () => {
+  const plain = run(["tone", "--seconds", "5", "--out", "plain.wav"]);
+  const fm = run(["tone", "--seconds", "5", "--fm-depth", "0.1", "--fm-rate", "4", "--out", "fm.wav"]);
+  assert.equal(fm.status, 0, fm.stderr);
+  const zp = risingCrossings(readWav(join(plain.dir, "plain.wav")).channels[0]);
+  const w = readWav(join(fm.dir, "fm.wav"));
+  assert.equal(w.frames, 240000);
+  const x = w.channels[0];
+  const zf = risingCrossings(x);
+  const diff = Math.abs(zf.length - zp.length) / zp.length;
+  assert.ok(diff < 0.002, `FM tone has ${zf.length} crossings, plain ${zp.length}: ${(diff * 100).toFixed(3)} %`);
+  assert.ok(Math.abs(peak(x) / MINUS_6_DB - 1) < 0.01, "FM keeps the level");
+
+  // Per-cycle frequency swings ±0.1 % around 1 kHz, and its highest point recurs every 0.25 s (4 Hz).
+  const f = [];
+  for (let k = 0; k + 1 < zf.length; k++) f.push({ t: zf[k] / 48000, hz: 48000 / (zf[k + 1] - zf[k]) });
+  const dev = f.map((c) => c.hz / 1000 - 1);
+  const hi = Math.max(...dev);
+  const lo = Math.min(...dev);
+  assert.ok(hi > 0.00095 && hi < 0.00105, `max deviation ${(hi * 100).toFixed(4)} %`);
+  assert.ok(lo < -0.00095 && lo > -0.00105, `min deviation ${(lo * 100).toFixed(4)} %`);
+  const peaks = f.filter((c, k) => k > 0 && k + 1 < f.length && dev[k] > 0.00099).map((c) => c.t % 0.25);
+  assert.ok(peaks.length >= 15, `${peaks.length} cycles near the top`);
+  for (const ph of peaks) assert.ok(Math.abs(ph - 0.0625) < 0.01, `a frequency peak at phase ${ph} s of 0.25 s`);
+});
