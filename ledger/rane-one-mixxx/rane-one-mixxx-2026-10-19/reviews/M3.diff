+test("the running medians match a brute-force median on uneven spacing and repeated t_us", () => {
+  const med = (a) => {
+    const x = [...a].sort((p, q) => p - q);
+    const m = x.length >> 1;
+    return x.length % 2 ? x[m] : (x[m - 1] + x[m]) / 2;
+  };
+  for (const [seed, smoothMs] of [[11, 1000], [12, 250], [13, 100]]) {
+    const r = rng(seed);
+    const samples = [];
+    let t_us = T0_US, ticks = 0;
+    for (let i = 0; i < 400; i++) {
+      t_us += r() < 0.1 ? 0 : Math.round(1000 + 80000 * r());
+      ticks += Math.round(200 * r());
+      samples.push({ line: i + 1, t_us, ticks, playposition: 0.1 + r() * 1e-4 + ticks / 1e6, rate_ratio: 1, mode: "clock", deck: 1, backstep: false });
+    }
+    const s = analyzeDrift(samples, { trackSeconds: 100, ticksPerRev: 3600, rpm: RPM, smoothMs });
+    const t = samples.map((x) => x.t_us - samples[0].t_us);
+    const raw = samples.map((x) => 1000 * ((x.playposition - samples[0].playposition) * 100 - ((x.ticks - samples[0].ticks) / 3600) * 1.8));
+    const S = smoothMs * 1000;
+    const base = med(raw.filter((_, j) => t[j] < S || j === 0));
+    for (let i = 0; i < samples.length; i++) {
+      const want = med(raw.filter((_, j) => t[j] >= t[i] - S / 2 && t[j] <= t[i] + S / 2)) - base;
+      assert.ok(Math.abs(s.series[i].drift_ms - want) < 1e-9, `seed ${seed} i ${i}: ${s.series[i].drift_ms} vs ${want}`);
+    }
+  }
+});
