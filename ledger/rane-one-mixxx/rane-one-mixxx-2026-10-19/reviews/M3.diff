new file mode 100755
index 0000000..ffea75c
--- /dev/null
+++ b/tools/wow-flutter
@@ -0,0 +1,89 @@
+#!/usr/bin/env node
+// Reports the wow and flutter of a recorded test tone: mean frequency, peak and RMS deviation, the worst 1 s window
+// and the dropouts (D12: unweighted, passband from 0.5 Hz; the spec §3 target ≤ 0.1 % is the peak).
+// Exit: 0 measured · 1 no signal, unreadable file or --expect-hz missed · 2 usage
+// Spec: docs/plans/2026-10-19-M3-measurement.md, section "wow-flutter algorithm"; the analysis is tools/lib/wow-flutter.mjs.
+import { readWav } from "./lib/wav.mjs";
+import { analyze } from "./lib/wow-flutter.mjs";
+
+const USAGE = "usage: tools/wow-flutter <file.wav> [--channel <n>] [--json] [--expect-hz <hz>]";
+const HELP = `${USAGE}
+Measures a recorded test tone (e.g. tools/make-test-audio tone, played and recorded):
+  --channel <n>      channel to measure, 0-based (default 0)
+  --json             print the result as one JSON object instead of a line of text
+  --expect-hz <hz>   fail (exit 1) if the mean frequency is more than 5 % off (wrong file, 33/45 mix-up)
+Prints mean Hz, peak %, RMS %, the worst 1 s window (largest RMS, 0.1 s hop), dropouts and cycles measured.
+Statistics skip 1 s at each end, and dropouts (cycles 5 % off the median period or below half its level) with two
+cycles each side. Under -60 dBFS or less than 3 s of good tone: prints "no signal" and exits 1.
+Exit: 0 measured · 1 no signal, unreadable file or --expect-hz missed · 2 usage
+`;
+
+function usage(why) {
+  if (why) process.stderr.write(`wow-flutter: ${why}\n`);
+  process.stderr.write(USAGE + "\n");
+  process.exit(2);
+}
+
+const args = process.argv.slice(2);
+if (args.length === 1 && args[0] === "--help") {
+  process.stdout.write(HELP);
+  process.exit(0);
+}
+let file = null;
+let channel = 0;
+let json = false;
+let expectHz = null;
+const seen = new Set();
+for (let i = 0; i < args.length; i++) {
+  const a = args[i];
+  if (!a.startsWith("-") || a === "-") {
+    if (file !== null) usage(`unexpected argument ${a}`);
+    file = a;
+    continue;
+  }
+  if (seen.has(a)) usage(`${a} given twice`);
+  seen.add(a);
+  if (a === "--json") {
+    json = true;
+    continue;
+  }
+  const v = args[++i];
+  if (v === undefined) usage(`${a} needs a value`);
+  if (a === "--channel") {
+    if (!/^\d{1,5}$/.test(v)) usage(`bad --channel ${v}`);
+    channel = Number(v);
+  } else if (a === "--expect-hz") {
+    if (!/^(\d+(\.\d*)?|\.\d+)$/.test(v) || !(Number(v) > 0)) usage(`bad --expect-hz ${v}`);
+    expectHz = Number(v);
+  } else usage(`unknown option ${a}`);
+}
+if (file === null) usage();
+
+let wav;
+try {
+  wav = readWav(file, { channel });
+} catch (err) {
+  process.stderr.write(`wow-flutter: ${file}: ${err.message}\n`);
+  process.exit(1);
+}
+if (wav.sizeFromEof) {
+  process.stderr.write(`wow-flutter: ${file}: warning: streamed header, data size read from the end of the file\n`);
+}
+
+const r = analyze(wav.channels[0], wav.sampleRate);
+if (!r.signal) {
+  process.stdout.write(json ? JSON.stringify({ ...r, size_from_eof: wav.sizeFromEof }) + "\n" : "no signal\n");
+  process.stderr.write(`wow-flutter: ${file}: ${r.reason}\n`);
+  process.exit(1);
+}
+const pct = (v) => `${v.toFixed(4)} %`;
+const meanText = `${r.mean_hz.toFixed(3)} Hz`;
+process.stdout.write(json
+  ? JSON.stringify({ ...r, size_from_eof: wav.sizeFromEof }) + "\n"
+  : `mean ${meanText}  peak ${pct(r.peak_pct)}  rms ${pct(r.rms_pct)}  ` +
+    `worst 1 s @ ${r.worst.start_s.toFixed(2)} s: peak ${pct(r.worst.peak_pct)} rms ${pct(r.worst.rms_pct)}  ` +
+    `dropouts ${r.dropouts}  cycles ${r.cycles}\n`);
+if (expectHz !== null && Math.abs(r.mean_hz / expectHz - 1) > 0.05) {
+  process.stderr.write(`wow-flutter: mean ${meanText} is more than 5 % off --expect-hz ${expectHz}\n`);
+  process.exit(1);
+}
