diff --git a/tests/wav.test.mjs b/tests/wav.test.mjs
new file mode 100644
index 0000000..1612a54
--- /dev/null
+++ b/tests/wav.test.mjs
@@ -0,0 +1,253 @@
+// tools/lib/wav.mjs reads and writes WAV files: test signals out (make-test-audio), recordings in (wow-flutter).
+// Spec: docs/plans/2026-10-19-M3-measurement.md, section "WAV library".
+import { test, after } from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync, rmSync, readFileSync, readdirSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { FORMATS, encodeWav, decodeWav, writeWav, readWav } from "../tools/lib/wav.mjs";
+
+// Every file the tests write goes under a temp dir, removed when the file's tests end.
+const dirs = [];
+const tempDir = () => {
+  const d = mkdtempSync(join(tmpdir(), "wav-"));
+  dirs.push(d);
+  return d;
+};
+after(() => dirs.forEach((d) => rmSync(d, { recursive: true, force: true })));
+
+const BITS = { pcm16: 16, pcm24: 24, pcm32: 32, float32: 32 };
+
+// -1 … +1 in 1001 steps, so both ends and 0 are in it, plus values between the PCM steps.
+function ramp(n = 1001) {
+  const a = new Float64Array(n);
+  for (let i = 0; i < n; i++) a[i] = -1 + (2 * i) / (n - 1);
+  return a;
+}
+
+const chunk = (id, body) => {
+  const head = Buffer.alloc(8);
+  head.write(id, 0, "latin1");
+  head.writeUInt32LE(body.length, 4);
+  const pad = body.length & 1 ? Buffer.alloc(1) : Buffer.alloc(0);
+  return Buffer.concat([head, body, pad]);
+};
+const riff = (...chunks) => {
+  const body = Buffer.concat([Buffer.from("WAVE", "latin1"), ...chunks]);
+  const head = Buffer.alloc(8);
+  head.write("RIFF", 0, "latin1");
+  head.writeUInt32LE(body.length, 4);
+  return Buffer.concat([head, body]);
+};
+function fmtBody({ tag = 1, nch = 2, rate = 48000, bits = 16, byteRate, blockAlign, ext }) {
+  const b = Buffer.alloc(ext ? 40 : 16);
+  b.writeUInt16LE(tag, 0);
+  b.writeUInt16LE(nch, 2);
+  b.writeUInt32LE(rate, 4);
+  b.writeUInt32LE(byteRate ?? rate * nch * (bits / 8), 8);
+  b.writeUInt16LE(blockAlign ?? nch * (bits / 8), 12);
+  b.writeUInt16LE(bits, 14);
+  if (ext) {
+    b.writeUInt16LE(22, 16); // cbSize
+    b.writeUInt16LE(bits, 18); // valid bits
+    b.writeUInt32LE(3, 20); // channel mask FL|FR
+    Buffer.from([ext, 0, 0, 0, 0, 0, 0x10, 0, 0x80, 0, 0, 0xaa, 0, 0x38, 0x9b, 0x71]).copy(b, 24);
+  }
+  return b;
+}
+// Two stereo 16-bit frames: (0.5, -0.5), (-1, 0.25).
+const DATA16 = Buffer.alloc(8);
+[16384, -16384, -32768, 8192].forEach((v, i) => DATA16.writeInt16LE(v, i * 2));
+
+for (const format of FORMATS) {
+  for (const nch of [1, 2]) {
+    test(`${format} ${nch === 1 ? "mono" : "stereo"} at 48000 Hz round-trips through writeWav/readWav`, () => {
+      const dir = tempDir();
+      const a = ramp();
+      const channels = nch === 1 ? [a] : [a, a.slice().reverse().map((x) => x * 0.5)];
+      const file = join(dir, "x.wav");
+      writeWav(file, { sampleRate: 48000, format, channels });
+      assert.deepEqual(readdirSync(dir), ["x.wav"], "no temp file left behind");
+
+      const buf = readFileSync(file);
+      const bytes = BITS[format] / 8;
+      assert.equal(buf.readUInt32LE(24), 48000, "sample rate in the header");
+      assert.equal(buf.readUInt16LE(22), nch, "channels in the header");
+      assert.equal(buf.readUInt32LE(28), 48000 * nch * bytes, "byte rate = rate · channels · bytes per sample");
+      assert.equal(buf.readUInt16LE(32), nch * bytes, "block align = channels · bytes per sample");
+      assert.equal(buf.readUInt16LE(34), BITS[format], "bits per sample");
+      assert.equal(buf.readUInt32LE(4), buf.length - 8, "RIFF size");
+
+      const w = readWav(file);
+      assert.equal(w.sampleRate, 48000);
+      assert.equal(w.format, format);
+      assert.equal(w.frames, a.length);
+      assert.equal(w.channelCount, nch);
+      assert.equal(w.sizeFromEof, false);
+      assert.equal(w.channels.length, nch);
+      const lsb = format === "float32" ? 0 : 2 ** -(BITS[format] - 1);
+      for (let c = 0; c < nch; c++) {
+        assert.ok(w.channels[c] instanceof Float64Array);
+        // Rounding, not truncation: within half an LSB, except +1, which is clamped (checked below).
+        let worst = 0;
+        for (let i = 0; i < a.length - (c === 0 ? 1 : 0); i++) {
+          const want = format === "float32" ? Math.fround(channels[c][i]) : channels[c][i];
+          worst = Math.max(worst, Math.abs(w.channels[c][i] - want));
+        }
+        assert.ok(worst <= lsb / 2 + 1e-15, `channel ${c}: worst error ${worst} > half an LSB ${lsb / 2}`);
+      }
+      assert.equal(w.channels[0][0], -1, "full-scale negative decodes to exactly -1");
+      if (format !== "float32") assert.equal(w.channels[0][a.length - 1], 1 - lsb, "+1 is clamped to the largest code");
+      assert.equal(w.channels[0][500], 0);
+    });
+  }
+}
+
+test("pcm32 round trip is exact to the code (no float32 loss above 2^24)", () => {
+  const x = new Float64Array([(2 ** 30 + 1) / 2 ** 31, -(2 ** 31 - 3) / 2 ** 31]);
+  const w = decodeWav(encodeWav({ sampleRate: 48000, format: "pcm32", channels: [x] }));
+  assert.deepEqual([...w.channels[0]], [...x]);
+});
+
+test("float32 writes an 18-byte fmt chunk (tag 3, cbSize 0) and a fact chunk with the frame count", () => {
+  const buf = encodeWav({ sampleRate: 48000, format: "float32", channels: [ramp(7), ramp(7)] });
+  assert.equal(buf.toString("latin1", 12, 16), "fmt ");
+  assert.equal(buf.readUInt32LE(16), 18);
+  assert.equal(buf.readUInt16LE(20), 3);
+  assert.equal(buf.readUInt16LE(36), 0, "cbSize");
+  assert.equal(buf.toString("latin1", 38, 42), "fact");
+  assert.equal(buf.readUInt32LE(42), 4);
+  assert.equal(buf.readUInt32LE(46), 7);
+  assert.equal(buf.toString("latin1", 50, 54), "data");
+  assert.equal(buf.readUInt32LE(54), 7 * 2 * 4);
+  assert.equal(buf.length, 58 + 56);
+});
+
+test("PCM writes a 16-byte fmt chunk with tag 1 and the data chunk right after it", () => {
+  const buf = encodeWav({ sampleRate: 48000, format: "pcm16", channels: [ramp(4)] });
+  assert.equal(buf.readUInt32LE(16), 16);
+  assert.equal(buf.readUInt16LE(20), 1);
+  assert.equal(buf.toString("latin1", 36, 40), "data");
+  assert.equal(buf.readUInt32LE(40), 8);
+  assert.equal(buf.length, 44 + 8);
+});
+
+test("an odd-sized data chunk gets the RIFF pad byte, and reads back", () => {
+  const x = new Float64Array([0.5, -0.25, 0.125]);
+  const buf = encodeWav({ sampleRate: 48000, format: "pcm24", channels: [x] });
+  assert.equal(buf.readUInt32LE(40), 9, "data size excludes the pad");
+  assert.equal(buf.length, 44 + 10);
+  assert.equal(buf[buf.length - 1], 0);
+  assert.equal(buf.readUInt32LE(4), buf.length - 8, "RIFF size includes the pad");
+  assert.deepEqual([...decodeWav(buf).channels[0]], [...x]);
+});
+
+test("WAVE_FORMAT_EXTENSIBLE headers and unknown chunks (LIST, PEAK) are read, honouring the pad byte", () => {
+  const list = chunk("LIST", Buffer.from("INFOISFT\x05\x00\x00\x00test\x00", "latin1")); // 21 bytes: padded
+  const peak = chunk("PEAK", Buffer.alloc(16));
+  const buf = riff(chunk("fmt ", fmtBody({ tag: 0xfffe, ext: 1 })), list, peak, chunk("data", DATA16));
+  const w = decodeWav(buf);
+  assert.equal(w.format, "pcm16");
+  assert.deepEqual([...w.channels[0]], [0.5, -1]);
+  assert.deepEqual([...w.channels[1]], [-0.5, 0.25]);
+
+  const f = Buffer.alloc(8);
+  f.writeFloatLE(0.25, 0);
+  f.writeFloatLE(-0.75, 4);
+  const wf = decodeWav(riff(chunk("fmt ", fmtBody({ tag: 0xfffe, bits: 32, nch: 1, ext: 3 })), chunk("data", f)));
+  assert.equal(wf.format, "float32");
+  assert.deepEqual([...wf.channels[0]], [0.25, -0.75]);
+});
+
+test("{ channel } decodes only that channel", () => {
+  const buf = riff(chunk("fmt ", fmtBody({})), chunk("data", DATA16));
+  const w = decodeWav(buf, { channel: 1 });
+  assert.equal(w.channels.length, 1);
+  assert.equal(w.channelCount, 2);
+  assert.deepEqual([...w.channels[0]], [-0.5, 0.25]);
+  assert.throws(() => decodeWav(buf, { channel: 2 }), /channel 2/);
+  assert.throws(() => decodeWav(buf, { channel: -1 }), /channel -1/);
+});
+
+test("a streamed header (data size 0xFFFFFFFF or 0, or past EOF) is read to EOF in whole frames, sizeFromEof", () => {
+  for (const size of [0xffffffff, 0, 1000]) {
+    const data = chunk("data", DATA16);
+    data.writeUInt32LE(size, 4);
+    const buf = Buffer.concat([riff(chunk("fmt ", fmtBody({}))), data, Buffer.from([1, 2, 3])]); // 3 stray bytes
+    buf.writeUInt32LE(size === 0 ? 0 : 0xffffffff, 4); // the RIFF size is just as wrong
+    const w = decodeWav(buf);
+    assert.equal(w.sizeFromEof, true, `size ${size}`);
+    assert.equal(w.frames, 2, "the partial third frame is dropped");
+    assert.deepEqual([...w.channels[0]], [0.5, -1]);
+  }
+});
+
+test("an empty data chunk is 0 frames, not streamed; one followed by another chunk doesn't read that chunk as audio", () => {
+  const empty = decodeWav(encodeWav({ sampleRate: 48000, format: "pcm32", channels: [new Float64Array(0)] }));
+  assert.equal(empty.frames, 0);
+  assert.equal(empty.sizeFromEof, false);
+  const list = chunk("LIST", Buffer.from("INFOISFT\x00\x00\x00\x00", "latin1"));
+  const w = decodeWav(riff(chunk("fmt ", fmtBody({})), chunk("data", Buffer.alloc(0)), list));
+  assert.equal(w.frames, 0);
+  assert.equal(w.sizeFromEof, false);
+});
+
+test("bad and truncated files are rejected with the byte offset in the message", () => {
+  const good = riff(chunk("fmt ", fmtBody({})), chunk("data", DATA16));
+  const cases = [
+    [Buffer.from("RIFX"), /not a RIFF/],
+    [Buffer.concat([Buffer.from("RIFF\0\0\0\0AVI "), good.subarray(12)]), /WAVE/],
+    [good.subarray(0, 30), /fmt chunk at byte 12/], // cut inside fmt
+    [good.subarray(0, 12), /no data chunk/],
+    [riff(chunk("data", DATA16)), /data chunk at byte 12.*before fmt/],
+    [riff(chunk("fmt ", fmtBody({ tag: 2 })), chunk("data", DATA16)), /fmt chunk at byte 12: format tag 2/],
+    [riff(chunk("fmt ", fmtBody({ bits: 8 })), chunk("data", DATA16)), /8-bit/],
+    [riff(chunk("fmt ", fmtBody({ tag: 3, bits: 64 })), chunk("data", Buffer.alloc(32))), /64-bit/],
+    [riff(chunk("fmt ", fmtBody({ byteRate: 1234 })), chunk("data", DATA16)), /byte rate 1234/],
+    [riff(chunk("fmt ", fmtBody({ blockAlign: 6 })), chunk("data", DATA16)), /block align 6/],
+    [riff(chunk("fmt ", fmtBody({ nch: 0 })), chunk("data", DATA16)), /0 channels/],
+    [riff(chunk("fmt ", fmtBody({ rate: 0 })), chunk("data", DATA16)), /sample rate 0/],
+    [riff(chunk("fmt ", fmtBody({ tag: 0xfffe, ext: 2 })), chunk("data", DATA16)), /sub-format/],
+    [riff(chunk("fmt ", fmtBody({})), chunk("data", DATA16.subarray(0, 6))), /data chunk at byte 36: 6 bytes is not a whole number of 4-byte frames/],
+    [riff(chunk("fmt ", Buffer.alloc(14))), /fmt chunk at byte 12: 14 bytes/],
+  ];
+  for (const [buf, re] of cases) assert.throws(() => decodeWav(buf), (e) => /^wav: /.test(e.message) && re.test(e.message), String(re));
+  // An unknown chunk that runs past EOF before any data is a truncated file, not a streamed one.
+  const list = chunk("LIST", Buffer.alloc(4));
+  list.writeUInt32LE(100, 4);
+  assert.throws(() => decodeWav(riff(chunk("fmt ", fmtBody({})), list)), /LIST chunk at byte 36/);
+});
+
+test("encodeWav refuses bad input instead of writing a broken file", () => {
+  const ok = { sampleRate: 48000, format: "pcm16", channels: [ramp(3)] };
+  assert.throws(() => encodeWav({ ...ok, format: "pcm8" }), /format/);
+  assert.throws(() => encodeWav({ ...ok, sampleRate: 0 }), /sample rate/);
+  assert.throws(() => encodeWav({ ...ok, sampleRate: 44100.5 }), /sample rate/);
+  assert.throws(() => encodeWav({ ...ok, channels: [] }), /channel/);
+  assert.throws(() => encodeWav({ ...ok, channels: [ramp(3), ramp(4)] }), /equal length/);
+  assert.throws(() => encodeWav({ ...ok, sampleRate: 2 ** 31, channels: [ramp(3), ramp(3)] }), /^Error: wav: .*byte rate/);
+  assert.throws(() => encodeWav({ ...ok, format: "float32", channels: [new Float64Array([0, 1e39])] }), /sample 1/,
+    "a value float32 can't hold would be written as Infinity");
+  for (const bad of [NaN, Infinity, -Infinity]) {
+    for (const format of FORMATS) {
+      assert.throws(() => encodeWav({ ...ok, format, channels: [new Float64Array([0, bad])] }), /sample 1/);
+    }
+  }
+});
+
+test("PCM clamps values beyond ±1; float32 stores them as is", () => {
+  const x = new Float64Array([1.5, -1.5]);
+  assert.deepEqual([...decodeWav(encodeWav({ sampleRate: 48000, format: "pcm16", channels: [x] })).channels[0]],
+    [32767 / 32768, -1]);
+  assert.deepEqual([...decodeWav(encodeWav({ sampleRate: 48000, format: "float32", channels: [x] })).channels[0]],
+    [1.5, -1.5]);
+});
+
+test("writeWav leaves an existing file alone when encoding fails", () => {
+  const dir = tempDir();
+  const file = join(dir, "keep.wav");
+  writeFileSync(file, "old");
+  assert.throws(() => writeWav(file, { sampleRate: 48000, format: "pcm16", channels: [new Float64Array([NaN])] }));
+  assert.equal(readFileSync(file, "utf8"), "old");
+  assert.deepEqual(readdirSync(dir), ["keep.wav"]);
+});
diff --git a/tests/wow-flutter.test.mjs b/tests/wow-flutter.test.mjs
new file mode 100644
index 0000000..fa58686
--- /dev/null
+++ b/tests/wow-flutter.test.mjs
@@ -0,0 +1,313 @@
+// tools/wow-flutter measures the frequency deviation of a recorded test tone (spec §3: wow & flutter ≤ 0.1 %, D12).
+// The tolerances are M3-03's; the signals come from tools/lib/test-audio.mjs, and every file goes to a temp dir.
+// Spec: docs/plans/2026-10-19-M3-measurement.md, section "wow-flutter algorithm".
+import { test, after } from "node:test";
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+import { writeWav, encodeWav, decodeWav } from "../tools/lib/wav.mjs";
+import { tone, dbToAmplitude } from "../tools/lib/test-audio.mjs";
+import { analyze, highPass } from "../tools/lib/wow-flutter.mjs";
+
+const dirs = [];
+const tempDir = () => {
+  const d = mkdtempSync(join(tmpdir(), "wow-flutter-"));
+  dirs.push(d);
+  return d;
+};
+after(() => dirs.forEach((d) => rmSync(d, { recursive: true, force: true })));
+
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), "..");
+const TOOL = join(ROOT, "tools", "wow-flutter");
+const RATE = 48000;
+const A = dbToAmplitude(-6);
+
+const sine = (opts) => tone({ rate: RATE, frames: Math.round((opts.seconds ?? 5) * RATE), freq: 1000, amplitude: A, ...opts });
+
+// A tone whose instantaneous frequency is f(t) Hz, phase accumulated sample by sample.
+function fromFreq(seconds, f) {
+  const x = new Float64Array(Math.round(seconds * RATE));
+  let phi = 0;
+  for (let n = 0; n < x.length; n++) {
+    x[n] = A * Math.sin(phi);
+    phi += (2 * Math.PI * f(n / RATE)) / RATE;
+  }
+  return x;
+}
+
+function writeTone(x, { format = "pcm32", name = "tone.wav", channels = [x, x] } = {}) {
+  const file = join(tempDir(), name);
+  writeWav(file, { sampleRate: RATE, format, channels });
+  return file;
+}
+
+const run = (args) => spawnSync(TOOL, args, { encoding: "utf8" });
+
+const between = (v, lo, hi, what) => assert.ok(v >= lo && v <= hi, `${what} ${v} not in [${lo}, ${hi}]`);
+
+// --- The algorithm on synthetic tones (M3-03 step 1) ---
+
+test("a clean 1 kHz tone: peak and RMS deviation below 0.01 %, mean 1000 Hz", () => {
+  const r = analyze(sine({}), RATE);
+  assert.equal(r.signal, true);
+  assert.ok(r.peak_pct < 0.01, `peak ${r.peak_pct} %`);
+  assert.ok(r.rms_pct < 0.01, `rms ${r.rms_pct} %`);
+  assert.ok(Math.abs(r.mean_hz - 1000) < 0.01, `mean ${r.mean_hz} Hz`);
+  assert.equal(r.dropouts, 0);
+  // Crossings at 1 … 4999 ms, and at 0 when the DC removal leaves sample 0 just below zero: 4998 or 4999 cycles.
+  between(r.cycles, 4998, 4999, "cycles");
+});
+
+test("a clean 1 kHz tone through 16-bit PCM: still below 0.01 %", () => {
+  const w = decodeWav(encodeWav({ sampleRate: RATE, format: "pcm16", channels: [sine({})] }));
+  const r = analyze(w.channels[0], RATE);
+  assert.ok(r.peak_pct < 0.01 && r.rms_pct < 0.01, `peak ${r.peak_pct} %, rms ${r.rms_pct} %`);
+});
+
+test("0.1 % FM at 4 Hz: peak 0.085–0.115 %, RMS near 0.1/√2", () => {
+  const r = analyze(sine({ fmDepth: 0.1, fmRate: 4 }), RATE);
+  between(r.peak_pct, 0.085, 0.115, "peak %");
+  between(r.rms_pct, 0.0707 * 0.95, 0.0707 * 1.05, "rms %");
+  assert.ok(Math.abs(r.mean_hz - 1000) < 0.05, `mean ${r.mean_hz} Hz`);
+  assert.equal(r.dropouts, 0);
+});
+
+test("0.5 % FM at 0.5 Hz over 10 s (slow wow, inside the 0.5 Hz band edge): peak 0.42–0.58 %", () => {
+  const r = analyze(sine({ seconds: 10, fmDepth: 0.5, fmRate: 0.5 }), RATE);
+  between(r.peak_pct, 0.42, 0.58, "peak %");
+  assert.ok(Math.abs(r.mean_hz - 1000) < 0.5, `mean ${r.mean_hz} Hz`);
+});
+
+test("a 1010 Hz tone (constant pitch offset): deviation below 0.01 %, mean 1010 ± 0.5 Hz", () => {
+  const r = analyze(sine({ freq: 1010 }), RATE);
+  assert.ok(r.peak_pct < 0.01 && r.rms_pct < 0.01, `peak ${r.peak_pct} %, rms ${r.rms_pct} %`);
+  assert.ok(Math.abs(r.mean_hz - 1010) <= 0.5, `mean ${r.mean_hz} Hz`);
+});
+
+test("a slow drift of the pitch (0.05 Hz, below the band) is removed, a 4 Hz flutter on top is kept", () => {
+  const x = fromFreq(10, (t) => 1000 * (1 + 0.003 * Math.sin(2 * Math.PI * 0.05 * t) + 0.001 * Math.sin(2 * Math.PI * 4 * t)));
+  const r = analyze(x, RATE);
+  between(r.peak_pct, 0.085, 0.13, "peak %");
+});
+
+// Review M3-03 #1: a recording starts at any phase of the wow; the filter's edge padding must not add to the peak.
+for (const [name, ph] of [["π/2", Math.PI / 2], ["π", Math.PI], ["3π/2", (3 * Math.PI) / 2]]) {
+  test(`FM starting at phase ${name} (deviation not zero at t = 0): the same tolerances hold`, () => {
+    const fast = analyze(fromFreq(5, (t) => 1000 * (1 + 0.001 * Math.sin(2 * Math.PI * 4 * t + ph))), RATE);
+    between(fast.peak_pct, 0.085, 0.115, "0.1 % @ 4 Hz peak %");
+    const slow = analyze(fromFreq(10, (t) => 1000 * (1 + 0.005 * Math.sin(2 * Math.PI * 0.5 * t + ph))), RATE);
+    between(slow.peak_pct, 0.42, 0.58, "0.5 % @ 0.5 Hz peak %");
+  });
+}
+
+test("the high-pass passes 4 Hz, keeps ≥ 97 % at 0.5 Hz and removes DC (zero phase, net gain |H|²)", () => {
+  const fs = 1000;
+  const amp = (f) => {
+    const d = Float64Array.from({ length: 20 * fs }, (_, k) => 0.01 + Math.sin((2 * Math.PI * f * k) / fs));
+    const y = highPass(d, fs);
+    let m = 0;
+    for (let k = 5 * fs; k < 15 * fs; k++) m = Math.max(m, Math.abs(y[k]));
+    return m;
+  };
+  between(amp(4), 0.999, 1.001, "gain at 4 Hz");
+  between(amp(0.5), 0.97, 0.98, "gain at 0.5 Hz");
+  const flat = highPass(new Float64Array(5000).fill(0.02), fs);
+  assert.ok(flat.every((v) => Math.abs(v) < 1e-12), "a constant comes out as 0, edges included");
+});
+
+// --- Dropouts (M3-03 step 3) ---
+
+for (const [where, start] of [["at a zero crossing", 120000], ["in a positive half-cycle", 120007], ["in a negative half-cycle", 120030]]) {
+  test(`1 ms of zeros at 2.5 s, ${where}: dropouts 1, not flutter`, () => {
+    const x = sine({});
+    x.fill(0, start, start + 48);
+    const r = analyze(x, RATE);
+    assert.equal(r.signal, true);
+    assert.equal(r.dropouts, 1);
+    assert.ok(r.peak_pct < 0.01 && r.rms_pct < 0.01, `peak ${r.peak_pct} %, rms ${r.rms_pct} %`);
+    assert.ok(Math.abs(r.mean_hz - 1000) < 0.01, `mean ${r.mean_hz} Hz`);
+  });
+}
+
+test("a level dip to 30 % for 3 ms is one dropout; two separate 1 ms gaps are two", () => {
+  const dip = sine({});
+  for (let n = 96000; n < 96144; n++) dip[n] *= 0.3;
+  const r1 = analyze(dip, RATE);
+  assert.equal(r1.dropouts, 1);
+  assert.ok(r1.peak_pct < 0.01, `peak ${r1.peak_pct} %`);
+  const two = sine({});
+  two.fill(0, 100000, 100048);
+  two.fill(0, 150000, 150048);
+  assert.equal(analyze(two, RATE).dropouts, 2);
+});
+
+test("a dropout inside an FM tone is bridged, not flattened: 1 ms and 200 ms gaps keep the 0.1 % peak", () => {
+  for (const len of [48, 9600]) {
+    const x = sine({ fmDepth: 0.1, fmRate: 4 });
+    x.fill(0, 120000, 120000 + len);
+    const r = analyze(x, RATE);
+    assert.equal(r.dropouts, 1, `${len} samples`);
+    between(r.peak_pct, 0.085, 0.115, `peak % with a ${len}-sample gap`);
+  }
+});
+
+// Review M3-03 #2, #3: a real recording has a noise floor or silence before and after the tone.
+test("2 s of ±1 LSB 16-bit noise before the tone: trimmed, not a dropout, and not `no signal`", () => {
+  let seed = 1;
+  const lsb = () => ((seed = (seed * 1103515245 + 12345) % 2 ** 31) % 3) - 1;
+  const x = new Float64Array(7 * RATE);
+  for (let n = 0; n < 2 * RATE; n++) x[n] = lsb() / 32768;
+  x.set(sine({}), 2 * RATE);
+  const w = decodeWav(encodeWav({ sampleRate: RATE, format: "pcm16", channels: [x] }));
+  const r = analyze(w.channels[0], RATE);
+  assert.equal(r.signal, true, r.reason);
+  assert.equal(r.dropouts, 0);
+  assert.ok(r.peak_pct < 0.01, `peak ${r.peak_pct} %`);
+  between(r.cycles, 4997, 5000, "cycles of the tone only");
+});
+
+test("3 s of silence on both sides: the 1 s edge skip counts from the tone, so the peak doesn't grow", () => {
+  const fm = sine({ seconds: 10, fmDepth: 0.1, fmRate: 4 });
+  const x = new Float64Array(16 * RATE);
+  x.set(fm, 3 * RATE);
+  const alone = analyze(fm, RATE);
+  const padded = analyze(x, RATE);
+  assert.equal(padded.dropouts, 0);
+  assert.ok(Math.abs(padded.peak_pct / alone.peak_pct - 1) < 0.002, `${padded.peak_pct} vs ${alone.peak_pct} %`);
+  between(padded.worst.start_s, 4, 11, "worst window start, in file time");
+});
+
+// --- Worst window, no signal ---
+
+test("worst 1-second window: flutter only after 3 s is found there, with its own peak and RMS", () => {
+  const x = fromFreq(7, (t) => 1000 * (1 + (t < 3 ? 0 : 0.002 * Math.sin(2 * Math.PI * 4 * (t - 3)))));
+  const r = analyze(x, RATE);
+  between(r.worst.start_s, 3, 5, "worst window start s");
+  assert.equal(Math.round(r.worst.start_s * 10), r.worst.start_s * 10, "on the 0.1 s hop");
+  between(r.worst.peak_pct, 0.17, 0.23, "worst peak %");
+  between(r.worst.rms_pct, 0.1414 * 0.9, 0.1414 * 1.1, "worst rms %");
+  assert.ok(r.worst.rms_pct >= r.rms_pct);
+});
+
+test("silence, a -70 dBFS tone and a 2.5 s tone are no signal, never a crash", () => {
+  for (const [what, x] of [
+    ["silence", new Float64Array(5 * RATE)],
+    ["empty", new Float64Array(0)],
+    ["-70 dBFS", sine({}).map((v) => (v / A) * dbToAmplitude(-70))],
+    ["2.5 s", sine({ seconds: 2.5 })],
+  ]) {
+    const r = analyze(x, RATE);
+    assert.equal(r.signal, false, what);
+    assert.equal(typeof r.reason, "string", what);
+  }
+});
+
+test("the level gate ignores DC; a rate or tone too low to filter is no signal, never NaN", () => {
+  const dcTone = sine({}).map((v) => 0.01 + (v / A) * dbToAmplitude(-75));
+  const r1 = analyze(dcTone, RATE);
+  assert.equal(r1.signal, false, "a -75 dBFS tone on 0.01 DC");
+  assert.match(r1.reason, /dBFS, below -60/);
+  assert.equal(analyze(sine({}), 1).signal, false, "rate 1 Hz");
+  const low = tone({ rate: RATE, frames: 20 * RATE, freq: 10, amplitude: A });
+  const r3 = analyze(low, RATE);
+  assert.equal(r3.signal, false, "10 Hz tone");
+  assert.match(r3.reason, /below 20 Hz/);
+});
+
+test("the reason for too little tone doesn't round 2.998 s up to the 3 s it needs", () => {
+  const r = analyze(sine({ seconds: 3 }), RATE);
+  assert.equal(r.signal, false);
+  assert.match(r.reason, /^2\.99\d s of good cycles, need 3$/);
+});
+
+// --- The tool (M3-03 step 2) ---
+
+test("tools/wow-flutter tone.wav prints mean Hz, peak %, RMS %, the worst 1 s window, dropouts and cycles", () => {
+  const r = run([writeTone(sine({ fmDepth: 0.1, fmRate: 4 }))]);
+  assert.equal(r.status, 0, r.stderr);
+  assert.equal(r.stderr, "");
+  assert.match(r.stdout,
+    /^mean 1000\.\d{3} Hz {2}peak 0\.(09|10|11)\d{2} % {2}rms 0\.0\d{3} % {2}worst 1 s @ \d+\.\d{2} s: peak 0\.\d{4} % rms 0\.\d{4} % {2}dropouts 0 {2}cycles 499[89]\n$/);
+});
+
+test("--json prints the same numbers as one JSON object", () => {
+  const file = writeTone(sine({ fmDepth: 0.1, fmRate: 4 }));
+  const r = run([file, "--json"]);
+  assert.equal(r.status, 0, r.stderr);
+  assert.equal(r.stdout.trim().split("\n").length, 1, "one line");
+  const j = JSON.parse(r.stdout);
+  assert.deepEqual(Object.keys(j), ["signal", "mean_hz", "peak_pct", "rms_pct", "worst", "dropouts", "cycles", "size_from_eof"]);
+  assert.deepEqual(Object.keys(j.worst), ["start_s", "peak_pct", "rms_pct"]);
+  assert.equal(j.signal, true);
+  assert.equal(j.size_from_eof, false);
+  between(j.peak_pct, 0.085, 0.115, "peak %");
+  const text = run([file]).stdout;
+  assert.ok(text.includes(`peak ${j.peak_pct.toFixed(4)} %`), text);
+  assert.ok(text.includes(`mean ${j.mean_hz.toFixed(3)} Hz`), text);
+  assert.ok(text.includes(`@ ${j.worst.start_s.toFixed(2)} s`), text);
+});
+
+test("--channel picks the channel; the dropout file reports dropouts 1 from the tool", () => {
+  const gap = sine({});
+  gap.fill(0, 120000, 120048);
+  const file = writeTone(gap, { channels: [new Float64Array(gap.length), gap] });
+  const r0 = run([file]);
+  assert.equal(r0.status, 1);
+  assert.equal(r0.stdout, "no signal\n");
+  const r1 = JSON.parse(run([file, "--channel", "1", "--json"]).stdout);
+  assert.equal(r1.dropouts, 1);
+  assert.ok(r1.peak_pct < 0.01);
+  const bad = run([file, "--channel", "2"]);
+  assert.equal(bad.status, 1);
+  assert.match(bad.stderr, /channel 2: the file has 2/);
+});
+
+test("silence: prints `no signal` (JSON: signal false) and exits 1", () => {
+  const file = writeTone(new Float64Array(2 * RATE), { name: "silence.wav" });
+  const t = run([file]);
+  assert.equal(t.status, 1);
+  assert.equal(t.stdout, "no signal\n");
+  assert.match(t.stderr, /^wow-flutter: .*silence\.wav: /);
+  const j = run([file, "--json"]);
+  assert.equal(j.status, 1);
+  assert.equal(JSON.parse(j.stdout).signal, false);
+});
+
+test("--expect-hz fails (exit 1) when the mean is more than 5 % off, after printing the result", () => {
+  const file = writeTone(sine({ freq: 1010 }));
+  assert.equal(run([file, "--expect-hz", "1000"]).status, 0);
+  const off = run([file, "--expect-hz", "1350"]);
+  assert.equal(off.status, 1);
+  assert.match(off.stdout, /^mean 1010\.000 Hz/);
+  assert.match(off.stderr, /mean 1010\.000 Hz is more than 5 % off --expect-hz 1350/);
+});
+
+test("a streamed header (size from EOF) is measured and warned about; a missing or broken file exits 1", () => {
+  const buf = encodeWav({ sampleRate: RATE, format: "pcm16", channels: [sine({})] });
+  const data = buf.indexOf("data");
+  buf.writeUInt32LE(0xffffffff, data + 4);
+  const dir = tempDir();
+  writeFileSync(join(dir, "streamed.wav"), buf);
+  const r = run([join(dir, "streamed.wav"), "--json"]);
+  assert.equal(r.status, 0, r.stderr);
+  assert.equal(JSON.parse(r.stdout).size_from_eof, true);
+  assert.match(r.stderr, /size read from the end of the file/);
+  const missing = run([join(dir, "nope.wav")]);
+  assert.equal(missing.status, 1);
+  assert.match(missing.stderr, /^wow-flutter: /);
+  writeFileSync(join(dir, "junk.wav"), "not a wav");
+  const junk = run([join(dir, "junk.wav")]);
+  assert.equal(junk.status, 1);
+  assert.match(junk.stderr, /not a RIFF file/);
+  assert.equal(junk.stdout, "");
+});
+
+test("--help prints the options and exits 0", () => {
+  const r = run(["--help"]);
+  assert.equal(r.status, 0);
+  assert.match(r.stdout, /^usage: tools\/wow-flutter /);
+  for (const o of ["--channel", "--json", "--expect-hz"]) assert.ok(r.stdout.includes(o), o);
+});
diff --git a/tools/drift b/tools/drift
new file mode 100755
index 0000000..0df8ff1
--- /dev/null
+++ b/tools/drift
@@ -0,0 +1,129 @@
+#!/usr/bin/env node
+// Reports how far Mixxx's play position drifts from the platter over a telemetry log (D11): max, final and slope,
+// noise, jumps. Spec §3: drift with the motor on, 5 min, target < 10 ms.
+// Exit: 0 measured · 1 unreadable file, a line that breaks D11 or fewer than 2 lines for the deck · 2 usage
+// Spec: docs/plans/2026-10-19-M3-measurement.md, section "drift"; the analysis is tools/lib/drift.mjs.
+import { readFileSync } from "node:fs";
+import { parseTelemetry, parseRpm, analyzeDrift } from "./lib/drift.mjs";
+
+const USAGE = "usage: tools/drift <telemetry.jsonl> --track-seconds <n> [--ticks-per-rev 3600] [--rpm 33.333] " +
+  "[--deck 1] [--jump-ms 20] [--smooth-ms 1000] [--csv | --json]";
+const HELP = `${USAGE}
+Measures platter-versus-playposition drift from a D11 telemetry log (dev-profile/telemetry.jsonl):
+  --track-seconds <n>  the track's exact length in s (frames / rate); required
+  --ticks-per-rev <n>  encoder ticks per platter revolution (default 3600, UNVERIFIED until M4/M5)
+  --rpm <n>            nominal platter speed; 33, 33.3, 33.33, 33.333 and 100/3 all mean exactly 100/3 (default)
+  --deck <1|2>         the deck whose lines are read (a line without "deck" is deck 1; default 1)
+  --jump-ms <ms>       a change of the median over --smooth-ms larger than this is a jump (default 20)
+  --smooth-ms <ms>     running-median window against the per-buffer lag of playposition (default 1000; 0 = off)
+  --csv                print t_us,drift_ms rows (smoothed) instead of the summary
+  --json               print the summary as one JSON object
+Drift is (Mixxx's track time - the platter's) since the first line, in ms: positive means Mixxx is ahead.
+Prints max |drift|, final drift, the least-squares slope in ms/min, noise (robust spread around the smoothed
+curve), the jumps, and the sample count, span, mean rate_ratio, mode changes and backward t_us steps.
+An excursion shorter than --smooth-ms/2 is smoothed away and shows in neither max nor jumps; look for one with a
+smaller --smooth-ms (noise grows with it). Jumps need --smooth-ms/2 of log on each side.
+Exit: 0 measured · 1 unreadable file, a line that breaks D11 or fewer than 2 lines for the deck · 2 usage
+`;
+
+function usage(why) {
+  if (why) process.stderr.write(`drift: ${why}\n`);
+  process.stderr.write(USAGE + "\n");
+  process.exit(2);
+}
+const fail = (why) => {
+  process.stderr.write(`drift: ${why}\n`);
+  process.exit(1);
+};
+
+const DECIMAL = /^(\d+(\.\d*)?|\.\d+)$/;
+const args = process.argv.slice(2);
+if (args.length === 1 && args[0] === "--help") {
+  process.stdout.write(HELP);
+  process.exit(0);
+}
+let file = null;
+const opt = { trackSeconds: null, ticksPerRev: 3600, rpm: 100 / 3, smoothMs: 1000, jumpMs: 20 };
+let deck = 1;
+let output = "text";
+const seen = new Set();
+for (let i = 0; i < args.length; i++) {
+  const a = args[i];
+  if (!a.startsWith("-") || a === "-") {
+    if (a === "-") usage("reading stdin is not supported");
+    if (file !== null) usage(`unexpected argument ${a}`);
+    file = a;
+    continue;
+  }
+  if (seen.has(a)) usage(`${a} given twice`);
+  seen.add(a);
+  if (a === "--csv" || a === "--json") {
+    if (output !== "text") usage("--csv and --json can't be used together");
+    output = a.slice(2);
+    continue;
+  }
+  const v = args[++i];
+  if (v === undefined) usage(`${a} needs a value`);
+  if (a === "--track-seconds") {
+    if (!DECIMAL.test(v) || !(Number(v) > 0)) usage(`bad --track-seconds ${v}`);
+    opt.trackSeconds = Number(v);
+  } else if (a === "--ticks-per-rev") {
+    if (!/^\d{1,9}$/.test(v) || !(Number(v) > 0)) usage(`bad --ticks-per-rev ${v}`);
+    opt.ticksPerRev = Number(v);
+  } else if (a === "--rpm") {
+    const rpm = parseRpm(v);
+    if (rpm === null) usage(`bad --rpm ${v}`);
+    opt.rpm = rpm;
+  } else if (a === "--deck") {
+    if (v !== "1" && v !== "2") usage(`bad --deck ${v}`);
+    deck = Number(v);
+  } else if (a === "--jump-ms") {
+    if (!DECIMAL.test(v) || !(Number(v) > 0)) usage(`bad --jump-ms ${v}`);
+    opt.jumpMs = Number(v);
+  } else if (a === "--smooth-ms") {
+    if (!DECIMAL.test(v)) usage(`bad --smooth-ms ${v}`);
+    opt.smoothMs = Number(v);
+  } else usage(`unknown option ${a}`);
+}
+if (file === null) usage();
+if (opt.trackSeconds === null) usage("--track-seconds is required");
+
+let parsed;
+try {
+  parsed = parseTelemetry(readFileSync(file, "utf8"), file);
+} catch (err) {
+  fail(err.code ? `${file}: ${err.message}` : err.message);
+}
+const MAX_WARNINGS = 10;
+const warn = (w) => process.stderr.write(`drift: warning: ${w}\n`);
+parsed.warnings.slice(0, MAX_WARNINGS).forEach(warn);
+if (parsed.warnings.length > MAX_WARNINGS) warn(`${parsed.warnings.length - MAX_WARNINGS} more backward t_us steps`);
+
+const samples = parsed.samples.filter((s) => s.deck === deck);
+if (samples.length < 2) {
+  fail(`${file}: ${samples.length} line${samples.length === 1 ? "" : "s"} for deck ${deck}; drift needs at least 2`);
+}
+const off = samples.find((s) => s.duration !== undefined && Math.abs(s.duration - opt.trackSeconds) > 0.001);
+if (off) {
+  warn(`${file}:${off.line}: duration ${off.duration.toFixed(6)} s differs from --track-seconds ` +
+    `${opt.trackSeconds.toFixed(6)} s by ${(1000 * Math.abs(off.duration - opt.trackSeconds)).toFixed(3)} ms; using --track-seconds`);
+}
+
+const { series, ...r } = analyzeDrift(samples, opt);
+if (output === "csv") {
+  process.stdout.write("t_us,drift_ms\n" + series.map((p) => `${p.t_us},${p.drift_ms.toFixed(3)}\n`).join(""));
+} else if (output === "json") {
+  process.stdout.write(JSON.stringify({
+    ...r, deck, track_seconds: opt.trackSeconds, ticks_per_rev: opt.ticksPerRev, rpm: opt.rpm,
+    smooth_ms: opt.smoothMs, jump_ms: opt.jumpMs,
+  }) + "\n");
+} else {
+  const ms = (v) => `${v.toFixed(3)} ms`;
+  const sign = (v) => (v >= 0 ? "+" : "");
+  process.stdout.write(
+    `max ${ms(r.max_ms)}  final ${ms(r.final_ms)}  slope ${r.slope_ms_per_min.toFixed(3)} ms/min  ` +
+    `noise ${ms(r.noise_ms)}  jumps ${r.jumps.length}\n` +
+    `samples ${r.samples}  span ${r.span_s.toFixed(2)} s  mean rate_ratio ${r.mean_rate_ratio.toFixed(4)}  ` +
+    `mode changes ${r.mode_changes}  t_backsteps ${r.t_backsteps}\n` +
+    r.jumps.map((j) => `jump @ ${j.t_s.toFixed(2)} s: ${sign(j.size_ms)}${j.size_ms.toFixed(1)} ms\n`).join(""));
+}
diff --git a/tools/lib/drift.mjs b/tools/lib/drift.mjs
new file mode 100644
index 0000000..1c85ec8
--- /dev/null
+++ b/tools/lib/drift.mjs
@@ -0,0 +1,214 @@
+// Platter-versus-playposition drift from a telemetry log (D11): how far Mixxx's play position has moved away from
+// the track time the platter turned through, smoothed against the per-buffer lag of playposition, with jumps.
+// Pure: text in, numbers out; tools/drift does the file, the deck choice and the printing.
+// Spec: docs/plans/2026-10-19-M3-measurement.md, sections "Telemetry format" and "drift".
+
+const REQUIRED = ["t_us", "ticks", "timer", "playposition", "rate_ratio", "mode"];
+const isNumber = (v) => typeof v === "number" && Number.isFinite(v);
+
+// One line's object → the reason it breaks D11, or null.
+function invalid(obj) {
+  for (const k of REQUIRED) if (!(k in obj)) return `missing "${k}"`;
+  const { t_us, ticks, timer, playposition, rate_ratio, mode, deck, duration } = obj;
+  const got = (v) => ` (got ${JSON.stringify(v)})`;
+  if (!Number.isSafeInteger(t_us) || t_us < 0) return `"t_us" must be an integer ≥ 0${got(t_us)}`;
+  if (!Number.isSafeInteger(ticks)) return `"ticks" must be an integer${got(ticks)}`;
+  if (!Number.isSafeInteger(timer)) return `"timer" must be an integer${got(timer)}`;
+  if (!isNumber(playposition)) return `"playposition" must be a finite number${got(playposition)}`;
+  if (!isNumber(rate_ratio)) return `"rate_ratio" must be a finite number${got(rate_ratio)}`;
+  if (mode !== "clock" && mode !== "platter") return `"mode" must be "clock" or "platter"${got(mode)}`;
+  if (deck !== undefined && deck !== 1 && deck !== 2) return `"deck" must be 1 or 2${got(deck)}`;
+  if (duration !== undefined && !(isNumber(duration) && duration > 0)) return `"duration" must be a positive number${got(duration)}`;
+  return null;
+}
+
+// Telemetry text → { samples, warnings }. A sample is { line, t_us, ticks, playposition, rate_ratio, mode, deck,
+// duration, backstep }. Throws Error("<path>:<line>: …") on a line that breaks D11. A t_us lower than the line
+// before (the wall clock stepped back, NTP) is clamped to it with a warning, the sample gets backstep: true, and
+// the step is carried into every later line, so one clock step is one warning and the spacing after it is kept.
+// Unknown keys are ignored; a UTF-8 BOM, CRLF and a last line without its \n are accepted.
+export function parseTelemetry(text, path) {
+  const lines = text.replace(/^\ufeff/, "").split("\n");
+  if (lines[lines.length - 1] === "") lines.pop();
+  const samples = [];
+  const warnings = [];
+  let last = -Infinity;
+  let shift = 0; // µs added to every line since the clock stepped back
+  for (let i = 0; i < lines.length; i++) {
+    const where = `${path}:${i + 1}`;
+    if (lines[i].trim() === "") throw new Error(`${where}: blank line`);
+    let obj;
+    try {
+      obj = JSON.parse(lines[i]);
+    } catch {
+      throw new Error(`${where}: not JSON`);
+    }
+    if (obj === null || typeof obj !== "object" || Array.isArray(obj)) throw new Error(`${where}: not a JSON object`);
+    const why = invalid(obj);
+    if (why) throw new Error(`${where}: ${why}`);
+    let t_us = obj.t_us + shift;
+    const backstep = t_us < last;
+    if (backstep) {
+      warnings.push(`${where}: t_us goes back ${last - t_us} µs; clamped to the line before`);
+      shift += last - t_us;
+      t_us = last;
+    }
+    last = t_us;
+    samples.push({
+      line: i + 1, t_us, ticks: obj.ticks, playposition: obj.playposition, rate_ratio: obj.rate_ratio, mode: obj.mode,
+      deck: obj.deck ?? 1, duration: obj.duration, backstep,
+    });
+  }
+  return { samples, warnings };
+}
+
+// "33", "33.3", "33.33", "33.333", … (trailing zeros too: "33.30") and "100/3" are exactly 100/3 (a literal 33.333 is 1.0e-5 low: 3 ms of fake
+// drift over 5 min); any other positive decimal is taken as given. → number, or null if it isn't one.
+export function parseRpm(s) {
+  if (s === "100/3" || /^33(\.3+0*)?$/.test(s)) return 100 / 3;
+  if (!/^(\d+(\.\d+)?|\.\d+)$/.test(s)) return null;
+  const v = Number(s);
+  return v > 0 ? v : null;
+}
+
+const median = (a) => {
+  const s = Float64Array.from(a).sort();
+  const m = s.length >> 1;
+  return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2;
+};
+
+// Medians of v over the index windows [lo[i], hi[i]), both non-decreasing in i; NaN for an empty window. One sorted
+// window slides along, so a 1 kHz log costs n · window, not n · window · log(window).
+function windowMedians(v, lo, hi) {
+  const out = new Float64Array(lo.length);
+  const sorted = [];
+  const find = (x) => {
+    let a = 0, b = sorted.length;
+    while (a < b) {
+      const m = (a + b) >> 1;
+      if (sorted[m] < x) a = m + 1;
+      else b = m;
+    }
+    return a;
+  };
+  let from = 0, to = 0; // the window held in `sorted`
+  for (let i = 0; i < lo.length; i++) {
+    if (lo[i] >= to) {
+      sorted.length = 0;
+      from = to = lo[i];
+    }
+    while (to < hi[i]) sorted.splice(find(v[to]), 0, v[to++]);
+    while (from < lo[i]) sorted.splice(find(v[from++]), 1);
+    const n = sorted.length, m = n >> 1;
+    out[i] = n === 0 ? NaN : n % 2 ? sorted[m] : (sorted[m - 1] + sorted[m]) / 2;
+  }
+  return out;
+}
+
+// For each i, the first index j with t[j] ≥ t[i] + d (strict: t[j] > t[i] + d), as an Int32Array.
+function bound(t, d, strict) {
+  const out = new Int32Array(t.length);
+  let j = 0;
+  for (let i = 0; i < t.length; i++) {
+    while (j < t.length && (strict ? t[j] <= t[i] + d : t[j] < t[i] + d)) j++;
+    out[i] = j;
+  }
+  return out;
+}
+
+// samples (one deck, in time order, ≥ 2) → { max_ms, final_ms, slope_ms_per_min, noise_ms, jumps: [{ t_s, size_ms }],
+// samples, span_s, mean_rate_ratio, mode_changes, t_backsteps, series: [{ t_us, drift_ms }] }.
+// raw_ms = 1000 · (mixxx_s − platter_s): positive means Mixxx is ahead of the platter.
+export function analyzeDrift(samples, { trackSeconds, ticksPerRev = 3600, rpm = 100 / 3, smoothMs = 1000, jumpMs = 20 }) {
+  const n = samples.length;
+  if (n < 2) throw new Error(`drift needs at least 2 samples (got ${n})`);
+  const s0 = samples[0];
+  const secondsPerTick = 60 / rpm / ticksPerRev;
+  const t = new Float64Array(n); // µs since the first sample
+  const raw = new Float64Array(n);
+  for (let i = 0; i < n; i++) {
+    const s = samples[i];
+    t[i] = s.t_us - s0.t_us;
+    const platter_s = (s.ticks - s0.ticks) * secondsPerTick;
+    const mixxx_s = (s.playposition - s0.playposition) * trackSeconds;
+    raw[i] = 1000 * (mixxx_s - platter_s);
+  }
+
+  // Centred running median over smoothMs, minus the median over the first smoothMs.
+  const S = smoothMs * 1000;
+  let smooth, baseline;
+  if (S === 0) {
+    smooth = raw;
+    baseline = raw[0];
+  } else {
+    const lo = bound(t, -S / 2, false), hi = bound(t, S / 2, true);
+    smooth = windowMedians(raw, lo, hi);
+    let k = 1;
+    while (k < n && t[k] < S) k++;
+    baseline = median(raw.subarray(0, k));
+  }
+  const drift = smooth.map((v) => v - baseline);
+
+  // Jumps: the median over the smoothMs after a sample minus the median over the smoothMs before it. A run of
+  // samples over jumpMs (one sign) is one jump; a clean step gives a plateau about smoothMs wide, so the jump's time
+  // is the run's midpoint and its size the run's largest change. Only samples with at least smoothMs/2 of log on
+  // each side count, so one lagged first or last line can't be a jump on its own. Two same-sign steps closer than
+  // smoothMs merge into one jump, sized by the larger change.
+  let before, after;
+  if (S === 0) {
+    before = raw.map((_, i) => (i === 0 ? NaN : raw[i - 1]));
+    after = raw;
+  } else {
+    before = windowMedians(raw, bound(t, -S, false), Int32Array.from({ length: n }, (_, i) => i));
+    after = windowMedians(raw, Int32Array.from({ length: n }, (_, i) => i), bound(t, S, false));
+  }
+  const jumps = [];
+  let run = null;
+  const close = () => {
+    if (run) jumps.push({ t_s: (t[run.first] + t[run.last]) / 2e6, size_ms: run.size });
+    run = null;
+  };
+  const edge = S / 2;
+  for (let i = 0; i < n; i++) {
+    const d = t[i] >= edge && t[n - 1] - t[i] >= edge ? after[i] - before[i] : NaN;
+    if (!(Math.abs(d) > jumpMs)) {
+      close();
+      continue;
+    }
+    if (run && Math.sign(d) !== Math.sign(run.size)) close();
+    if (!run) run = { first: i, last: i, size: d };
+    run.last = i;
+    if (Math.abs(d) > Math.abs(run.size)) run.size = d;
+  }
+  close();
+
+  // Least-squares slope of raw_ms against t in minutes.
+  let mt = 0, mr = 0;
+  for (let i = 0; i < n; i++) {
+    mt += t[i];
+    mr += raw[i];
+  }
+  mt /= n;
+  mr /= n;
+  let sxy = 0, sxx = 0;
+  for (let i = 0; i < n; i++) {
+    sxy += (t[i] - mt) * (raw[i] - mr);
+    sxx += (t[i] - mt) ** 2;
+  }
+  const slope = sxx > 0 ? (sxy / sxx) * 60e6 : 0;
+
+  let max = 0, rate = 0, modeChanges = 0, backsteps = 0;
+  const resid = new Float64Array(n);
+  for (let i = 0; i < n; i++) {
+    max = Math.max(max, Math.abs(drift[i]));
+    resid[i] = Math.abs(raw[i] - smooth[i]); // around the smoothed curve, before the baseline is taken off
+    rate += samples[i].rate_ratio;
+    if (i > 0 && samples[i].mode !== samples[i - 1].mode) modeChanges++;
+    if (samples[i].backstep) backsteps++;
+  }
+  return {
+    max_ms: max, final_ms: drift[n - 1], slope_ms_per_min: slope, noise_ms: 1.4826 * median(resid), jumps,
+    samples: n, span_s: t[n - 1] / 1e6, mean_rate_ratio: rate / n, mode_changes: modeChanges, t_backsteps: backsteps,
+    series: samples.map((s, i) => ({ t_us: s.t_us, drift_ms: drift[i] })),
+  };
+}
diff --git a/tools/lib/test-audio.mjs b/tools/lib/test-audio.mjs
new file mode 100644
index 0000000..c02e105
--- /dev/null
+++ b/tools/lib/test-audio.mjs
@@ -0,0 +1,32 @@
+// Test signals for M3's measurements, as Float64Array samples in [-1, 1] (tools/lib/wav.mjs writes them).
+// Spec: docs/plans/2026-10-19-M3-measurement.md, section "make-test-audio".
+
+export const dbToAmplitude = (db) => 10 ** (db / 20);
+
+// A sine of `freq` Hz, optionally frequency-modulated: the instantaneous frequency is exactly
+// freq · (1 + D · sin(2π fmRate t)) with D = fmDepth / 100, so fmDepth is the peak deviation in percent.
+// The phase is the integral of that, φ(t) = 2π freq t + (freq D / fmRate)(1 − cos(2π fmRate t)), never
+// sin(2π f(t) t), whose deviation grows with t. φ(0) = 0: the tone starts at a zero crossing.
+export function tone({ rate, frames, freq, amplitude, fmDepth = 0, fmRate = 4 }) {
+  const x = new Float64Array(frames);
+  const d = fmDepth / 100;
+  const k = d ? (freq * d) / fmRate : 0;
+  for (let n = 0; n < frames; n++) {
+    const t = n / rate;
+    x[n] = amplitude * Math.sin(2 * Math.PI * freq * t + k * (1 - Math.cos(2 * Math.PI * fmRate * t)));
+  }
+  return x;
+}
+
+// A 1 ms rectangular click (round(rate / 1000) samples) at `amplitude`, starting at sample round(k · 60/bpm · rate)
+// for every beat k whose whole click fits; silence elsewhere.
+export function clicks({ rate, frames, bpm, amplitude }) {
+  const x = new Float64Array(frames);
+  const width = Math.round(rate / 1000);
+  for (let k = 0; ; k++) {
+    const start = Math.round(((k * 60) / bpm) * rate);
+    if (start + width > frames) break;
+    x.fill(amplitude, start, start + width);
+  }
+  return x;
+}
diff --git a/tools/lib/wav.mjs b/tools/lib/wav.mjs
new file mode 100644
index 0000000..6757278
--- /dev/null
+++ b/tools/lib/wav.mjs
@@ -0,0 +1,190 @@
+// WAV files: test signals out (tools/make-test-audio), recordings in (M3's wow-flutter and record-output).
+// Samples are numbers in [-1, 1], one array per channel (never interleaved). Decoded channels are Float64Array,
+// which holds every format exactly (float32 can't hold a 32-bit PCM sample).
+// Spec: docs/plans/2026-10-19-M3-measurement.md, section "WAV library".
+import { readFileSync, writeFileSync, renameSync, rmSync } from "node:fs";
+import { dirname, basename, join } from "node:path";
+
+export const FORMATS = ["pcm16", "pcm24", "pcm32", "float32"];
+const BYTES = { pcm16: 2, pcm24: 3, pcm32: 4, float32: 4 };
+const TAG_PCM = 1;
+const TAG_FLOAT = 3;
+const TAG_EXTENSIBLE = 0xfffe;
+// KSDATAFORMAT_SUBTYPE_PCM / _IEEE_FLOAT after their first two bytes (the format tag).
+const SUBFORMAT_TAIL = Buffer.from([0, 0, 0, 0, 0x10, 0, 0x80, 0, 0, 0xaa, 0, 0x38, 0x9b, 0x71]);
+
+const fail = (msg) => {
+  throw new Error(`wav: ${msg}`);
+};
+
+// → Buffer holding a whole WAV file: RIFF/WAVE, fmt (16 bytes, tag 1; 18 bytes, tag 3 for float32), fact (float32
+// only: the frame count), data, and the pad byte if the data size is odd.
+export function encodeWav({ sampleRate, format, channels }) {
+  if (!FORMATS.includes(format)) fail(`format ${format}: not one of ${FORMATS.join(", ")}`);
+  if (!Number.isInteger(sampleRate) || sampleRate < 1 || sampleRate > 0xffffffff) fail(`sample rate ${sampleRate}: not a positive integer`);
+  if (!Array.isArray(channels) || channels.length < 1 || channels.length > 0xffff) fail("channels: need 1 to 65535 channel arrays");
+  const frames = channels[0].length;
+  if (channels.some((c) => c.length !== frames)) fail("channels: all channels must have equal length");
+  const nch = channels.length;
+  const bytes = BYTES[format];
+  const blockAlign = nch * bytes;
+  if (sampleRate * blockAlign > 0xffffffff) fail(`sample rate ${sampleRate}: byte rate ${sampleRate * blockAlign} does not fit a WAV header`);
+  const dataSize = frames * blockAlign;
+  const isFloat = format === "float32";
+  const fmtSize = isFloat ? 18 : 16;
+  const headerSize = 12 + 8 + fmtSize + (isFloat ? 12 : 0) + 8;
+  const pad = dataSize & 1;
+  if (headerSize + dataSize + pad - 8 > 0xffffffff) fail(`${frames} frames of ${blockAlign} bytes: too long for a WAV file`);
+
+  const buf = Buffer.alloc(headerSize + dataSize + pad);
+  let o = 0;
+  const id = (s) => {
+    buf.write(s, o, "latin1");
+    o += 4;
+  };
+  id("RIFF");
+  buf.writeUInt32LE(buf.length - 8, o);
+  o += 4;
+  id("WAVE");
+  id("fmt ");
+  buf.writeUInt32LE(fmtSize, o);
+  buf.writeUInt16LE(isFloat ? TAG_FLOAT : TAG_PCM, o + 4);
+  buf.writeUInt16LE(nch, o + 6);
+  buf.writeUInt32LE(sampleRate, o + 8);
+  buf.writeUInt32LE(sampleRate * blockAlign, o + 12);
+  buf.writeUInt16LE(blockAlign, o + 16);
+  buf.writeUInt16LE(bytes * 8, o + 18);
+  o += 4 + fmtSize; // an 18-byte fmt ends with cbSize 0, already zero
+  if (isFloat) {
+    id("fact");
+    buf.writeUInt32LE(4, o);
+    buf.writeUInt32LE(frames, o + 4);
+    o += 8;
+  }
+  id("data");
+  buf.writeUInt32LE(dataSize, o);
+  o += 4;
+
+  const full = 2 ** (bytes * 8 - 1);
+  for (let c = 0; c < nch; c++) {
+    const ch = channels[c];
+    let p = o + c * bytes;
+    for (let i = 0; i < frames; i++, p += blockAlign) {
+      const x = ch[i];
+      if (!Number.isFinite(isFloat ? Math.fround(x) : x)) fail(`channel ${c} sample ${i}: ${x} is not a finite ${isFloat ? "float32" : "number"}`);
+      if (isFloat) {
+        buf.writeFloatLE(x, p);
+        continue;
+      }
+      const v = Math.min(full - 1, Math.max(-full, Math.round(x * full)));
+      if (bytes === 2) buf.writeInt16LE(v, p);
+      else if (bytes === 3) buf.writeIntLE(v, p, 3);
+      else buf.writeInt32LE(v, p);
+    }
+  }
+  return buf;
+}
+
+// → { sampleRate, format, channels, frames, channelCount, sizeFromEof }. `channel` (0-based) decodes that channel
+// only; channelCount is always the file's. A streamed header (a recorder stopped before it rewrote it) is read to
+// EOF in whole frames and sets sizeFromEof: a data size of 0xFFFFFFFF or one past the end of the file, or a size
+// of 0 with bytes after it that the RIFF size doesn't cover (that size is 0, 0xFFFFFFFF or ends before them).
+export function decodeWav(buffer, { channel } = {}) {
+  const buf = Buffer.isBuffer(buffer) ? buffer : Buffer.from(buffer);
+  if (buf.length < 12 || buf.toString("latin1", 0, 4) !== "RIFF") fail("byte 0: not a RIFF file");
+  if (buf.toString("latin1", 8, 12) !== "WAVE") fail("byte 8: RIFF form is not WAVE");
+
+  let fmt = null;
+  let o = 12;
+  for (;;) {
+    if (o + 8 > buf.length) fail(`byte ${o}: no data chunk`);
+    const cid = buf.toString("latin1", o, o + 4);
+    const size = buf.readUInt32LE(o + 4);
+    const body = o + 8;
+    const where = `${cid.trimEnd()} chunk at byte ${o}`;
+    if (cid === "data") {
+      if (!fmt) fail(`${where}: comes before fmt`);
+      const { blockAlign } = fmt;
+      const riffSize = buf.readUInt32LE(4);
+      const streamed = size === 0xffffffff || body + size > buf.length ||
+        (size === 0 && buf.length > body && (riffSize === 0 || riffSize === 0xffffffff || riffSize + 8 <= body));
+      if (!streamed && size % blockAlign) fail(`${where}: ${size} bytes is not a whole number of ${blockAlign}-byte frames`);
+      const frames = Math.floor((streamed ? buf.length - body : size) / blockAlign);
+      return { ...decodeData(buf, body, frames, fmt, channel), sizeFromEof: streamed };
+    }
+    if (body + size > buf.length) fail(`${where}: ${size} bytes run past the end of the file (${buf.length} bytes)`);
+    if (cid === "fmt ") fmt = parseFmt(buf, body, size, where);
+    o = body + size + (size & 1);
+  }
+}
+
+function parseFmt(buf, p, size, where) {
+  if (size < 16) fail(`${where}: ${size} bytes, need at least 16`);
+  let tag = buf.readUInt16LE(p);
+  const nch = buf.readUInt16LE(p + 2);
+  const sampleRate = buf.readUInt32LE(p + 4);
+  const byteRate = buf.readUInt32LE(p + 8);
+  const blockAlign = buf.readUInt16LE(p + 12);
+  const bits = buf.readUInt16LE(p + 14);
+  if (tag === TAG_EXTENSIBLE) {
+    if (size < 40) fail(`${where}: extensible format needs 40 bytes, has ${size}`);
+    const sub = buf.readUInt16LE(p + 24);
+    if (![TAG_PCM, TAG_FLOAT].includes(sub) || !buf.subarray(p + 26, p + 40).equals(SUBFORMAT_TAIL)) {
+      fail(`${where}: extensible sub-format ${buf.toString("hex", p + 24, p + 40)} is neither PCM nor IEEE float`);
+    }
+    tag = sub;
+  }
+  let format;
+  if (tag === TAG_PCM) {
+    format = { 16: "pcm16", 24: "pcm24", 32: "pcm32" }[bits];
+    if (!format) fail(`${where}: ${bits}-bit PCM is not supported (16, 24 or 32)`);
+  } else if (tag === TAG_FLOAT) {
+    if (bits !== 32) fail(`${where}: ${bits}-bit float is not supported (32)`);
+    format = "float32";
+  } else fail(`${where}: format tag ${tag} is not supported (1 PCM, 3 float, 0xFFFE extensible)`);
+  if (nch < 1) fail(`${where}: 0 channels`);
+  if (sampleRate < 1) fail(`${where}: sample rate 0`);
+  const wantAlign = nch * BYTES[format];
+  if (blockAlign !== wantAlign) fail(`${where}: block align ${blockAlign}, expected ${wantAlign} (${nch} ch × ${BYTES[format]} bytes)`);
+  if (byteRate !== sampleRate * wantAlign) fail(`${where}: byte rate ${byteRate}, expected ${sampleRate * wantAlign} (rate × block align)`);
+  return { format, nch, sampleRate, blockAlign };
+}
+
+function decodeData(buf, start, frames, { format, nch, sampleRate, blockAlign }, channel) {
+  let wanted = [...Array(nch).keys()];
+  if (channel !== undefined) {
+    if (!Number.isInteger(channel) || channel < 0 || channel >= nch) fail(`channel ${channel}: the file has ${nch} (0-based)`);
+    wanted = [channel];
+  }
+  const bytes = BYTES[format];
+  const scale = 2 ** -(bytes * 8 - 1);
+  const channels = wanted.map((c) => {
+    const out = new Float64Array(frames);
+    let p = start + c * bytes;
+    for (let i = 0; i < frames; i++, p += blockAlign) {
+      if (format === "float32") out[i] = buf.readFloatLE(p);
+      else if (bytes === 2) out[i] = buf.readInt16LE(p) * scale;
+      else if (bytes === 3) out[i] = buf.readIntLE(p, 3) * scale;
+      else out[i] = buf.readInt32LE(p) * scale;
+    }
+    return out;
+  });
+  return { sampleRate, format, channels, frames, channelCount: nch };
+}
+
+// Writes to a temp file in the same directory, then renames it over `path`, so a failure leaves the old file.
+export function writeWav(path, opts) {
+  const buf = encodeWav(opts);
+  const tmp = join(dirname(path), `.${basename(path)}.${process.pid}.tmp`);
+  try {
+    writeFileSync(tmp, buf, { flag: "wx" });
+    renameSync(tmp, path);
+  } catch (err) {
+    rmSync(tmp, { force: true });
+    throw err;
+  }
+}
+
+export function readWav(path, opts) {
+  return decodeWav(readFileSync(path), opts);
+}
diff --git a/tools/lib/wow-flutter.mjs b/tools/lib/wow-flutter.mjs
new file mode 100644
index 0000000..e0a34d1
--- /dev/null
+++ b/tools/lib/wow-flutter.mjs
@@ -0,0 +1,212 @@
+// Wow and flutter of a recorded test tone: rising zero crossings with linear interpolation, per-cycle frequency,
+// a high-pass whose passband starts at 0.5 Hz (removes the pitch offset), then peak and RMS deviation in percent.
+// Unweighted (D12). Pure: samples in, numbers out; tools/wow-flutter does the file and the printing.
+// Spec: docs/plans/2026-10-19-M3-measurement.md, section "wow-flutter algorithm" (steps 1–10 are numbered there).
+
+const MIN_RMS = 1e-3; // -60 dBFS
+const BAD_PERIOD = 0.05; // a cycle more than 5 % off the median period is bad
+const BAD_PEAK = 0.5; // … or one whose peak is below half the median cycle peak
+const GUARD = 2; // cycles excluded on each side of a bad one
+const EDGE_S = 1; // skipped at each end of the tone (filter edges)
+const MIN_GOOD_S = 3;
+const LOUD_S = 1; // the tone's level: the quietest of the loudest cycles that together last this long
+const GATE = 0.1; // cycles 20 dB below that are not the tone (noise floor, silence): trimmed at the ends
+const MIN_HZ = 20; // below this the cycles are too slow for the 0.2 Hz filter and too few to measure
+const WINDOW_S = 1;
+const HOP_S = 0.1;
+const HP_CORNER_HZ = 0.2; // -3 dB corner of one pass; run twice, 0.5 Hz keeps 97.5 % (D12)
+const PAD_S = 3;
+
+const median = (a) => {
+  const s = Float64Array.from(a).sort();
+  const m = s.length >> 1;
+  return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2;
+};
+
+const noSignal = (reason) => ({ signal: false, reason });
+
+// x: one channel's samples in [-1, 1]; rate in Hz. → { signal: true, mean_hz, peak_pct, rms_pct,
+// worst: { start_s, peak_pct, rms_pct }, dropouts, cycles } or { signal: false, reason }. Never throws on samples.
+export function analyze(x, rate) {
+  const n = x.length;
+  // 1. Level (of the signal without its DC). 2. DC, subtracted on the fly so a long recording isn't copied.
+  let sum = 0;
+  let sum2 = 0;
+  for (let i = 0; i < n; i++) {
+    sum += x[i];
+    sum2 += x[i] * x[i];
+  }
+  const dc = n ? sum / n : 0;
+  const level = n ? Math.sqrt(Math.max(0, sum2 / n - dc * dc)) : 0;
+  if (!Number.isFinite(level)) return noSignal("the samples are not all finite");
+  if (level < MIN_RMS) return noSignal(`rms ${level ? (20 * Math.log10(level)).toFixed(1) : "-inf"} dBFS, below -60`);
+
+  // 3. Rising crossings y[i] < 0 ≤ y[i+1], in samples. 4. Each cycle's peak |y| between its two crossings.
+  const cross = [];
+  const peaks = [];
+  let peak = 0;
+  for (let i = 0; i + 1 < n; i++) {
+    const a = x[i] - dc;
+    const b = x[i + 1] - dc;
+    peak = Math.max(peak, Math.abs(a));
+    if (a < 0 && b >= 0) {
+      if (cross.length) peaks.push(peak);
+      cross.push(i + a / (a - b));
+      peak = 0;
+    }
+  }
+  if (cross.length < 4) return noSignal(`${Math.max(cross.length - 1, 0)} cycles`);
+
+  // The tone is the cycles above GATE times its level; before its first and after its last such cycle is
+  // something else (a noise floor makes many more crossings than the tone), so it is cut off, not a dropout.
+  const byPeak = [...peaks.keys()].sort((a, b) => peaks[b] - peaks[a]);
+  let ref = 0;
+  for (let j = 0, s = 0; j < byPeak.length && s < LOUD_S * rate; j++) {
+    ref = peaks[byPeak[j]];
+    s += cross[byPeak[j] + 1] - cross[byPeak[j]];
+  }
+  const loud = (k) => peaks[k] >= GATE * ref;
+  let first = 0;
+  while (!loud(first)) first++;
+  let last = peaks.length - 1;
+  while (!loud(last)) last--;
+  cross.splice(last + 2);
+  cross.splice(0, first);
+  peaks.splice(last + 1);
+  peaks.splice(0, first);
+  const cycles = peaks.length;
+  if (cycles < 3) return noSignal(`${cycles} cycles above the noise`);
+  const period = new Float64Array(cycles);
+  for (let k = 0; k < cycles; k++) period[k] = (cross[k + 1] - cross[k]) / rate;
+
+  // 5. Bad cycles; each run of them is one dropout. They and GUARD cycles each side are excluded. The medians
+  // are the tone's: quiet cycles inside it (a long gap) mustn't outvote it.
+  const medPeriod = median(period.filter((_, k) => loud(k)));
+  const medPeak = median(peaks.filter((_, k) => loud(k)));
+  const bad = new Uint8Array(cycles);
+  let dropouts = 0;
+  for (let k = 0; k < cycles; k++) {
+    bad[k] = Math.abs(period[k] / medPeriod - 1) > BAD_PERIOD || peaks[k] < BAD_PEAK * medPeak ? 1 : 0;
+    if (bad[k] && (k === 0 || !bad[k - 1])) dropouts++;
+  }
+  const excluded = new Uint8Array(cycles);
+  for (let k = 0; k < cycles; k++) {
+    if (bad[k]) excluded.fill(1, Math.max(0, k - GUARD), Math.min(cycles, k + GUARD + 1));
+  }
+
+  // 6. Mean frequency over the good cycles.
+  let good = 0;
+  let goodS = 0;
+  for (let k = 0; k < cycles; k++) {
+    if (!excluded[k]) {
+      good++;
+      goodS += period[k];
+    }
+  }
+  if (goodS < MIN_GOOD_S) return noSignal(`${goodS.toFixed(3)} s of good cycles, need ${MIN_GOOD_S}`);
+  const meanHz = good / goodS;
+  if (!(meanHz >= MIN_HZ)) return noSignal(`mean ${meanHz.toFixed(3)} Hz is below ${MIN_HZ} Hz`);
+
+  // 7. Deviation per cycle, excluded cycles bridged linearly between their good neighbours (held at the ends).
+  const d = new Float64Array(cycles);
+  let prev = -1;
+  for (let k = 0; k <= cycles; k++) {
+    if (k < cycles && excluded[k]) continue;
+    if (k < cycles) d[k] = 1 / period[k] / meanHz - 1;
+    for (let j = prev + 1; j < k; j++) {
+      d[j] = prev < 0 ? d[k] : k === cycles ? d[prev] : d[prev] + ((d[k] - d[prev]) * (j - prev)) / (k - prev);
+    }
+    prev = k;
+  }
+
+  // 8. High-pass, treating the cycles as uniformly sampled at the mean frequency.
+  const f = highPass(d, meanHz);
+
+  // 9. Statistics over whole good cycles at least EDGE_S from either end of the tone. Times are in the file's.
+  const start = (k) => cross[k] / rate;
+  const from = start(0) + EDGE_S;
+  const to = start(cycles) - EDGE_S;
+  const used = (k) => !excluded[k] && start(k) >= from && start(k + 1) <= to;
+  const firstFrom = (s) => { // the first cycle starting at or after s (cycle starts increase)
+    let lo = 0;
+    let hi = cycles;
+    while (lo < hi) {
+      const mid = (lo + hi) >> 1;
+      if (start(mid) < s) lo = mid + 1;
+      else hi = mid;
+    }
+    return lo;
+  };
+  const stats = (from, to) => {
+    let m = 0;
+    let s2 = 0;
+    let c = 0;
+    for (let k = firstFrom(from); k < cycles && start(k) < to; k++) {
+      if (!used(k)) continue;
+      m = Math.max(m, Math.abs(f[k]));
+      s2 += f[k] * f[k];
+      c++;
+    }
+    return c ? { peak_pct: 100 * m, rms_pct: 100 * Math.sqrt(s2 / c) } : null;
+  };
+  const all = stats(from, to);
+  if (!all) return noSignal(`no good cycles more than ${EDGE_S} s from the ends of the tone`);
+
+  // 10. Worst 1 s window by RMS, starting on the file's 0.1 s grid, inside the same bounds.
+  let worst = null;
+  for (let j = Math.ceil(from / HOP_S - 1e-9); ; j++) {
+    const s = Math.round(j * HOP_S * 10) / 10;
+    if (s + WINDOW_S > to + 1e-9) break;
+    const w = stats(s, s + WINDOW_S);
+    if (w && (!worst || w.rms_pct > worst.rms_pct)) worst = { start_s: s, ...w };
+  }
+  if (!worst) return noSignal(`no whole ${WINDOW_S} s window between the ${EDGE_S} s edges`);
+
+  const result = { signal: true, mean_hz: meanHz, ...all, worst, dropouts, cycles };
+  if (![meanHz, all.peak_pct, all.rms_pct, worst.peak_pct, worst.rms_pct].every(Number.isFinite)) {
+    return noSignal("the measurement is not finite");
+  }
+  return result;
+}
+
+// 2nd-order Butterworth high-pass (RBJ cookbook, Q = 1/√2, corner `corner` Hz) on a series sampled at `fs` Hz,
+// run forward then backward (zero phase, net gain |H|²). Both ends get PAD_S of even (mirror) reflection, and each
+// pass starts in the steady state for its first sample, so a constant comes out as 0. Not scipy's odd reflection
+// (2·d0 − d_k): that moves the pad's mean by 2·(d0 − mean) when the series starts mid-wow, and the filter's
+// ringing from that step reached 0.118 % on a 0.1 % tone (review M3-03 #1).
+export function highPass(d, fs, corner = HP_CORNER_HZ) {
+  const n = d.length;
+  if (n === 0) return new Float64Array(0);
+  const w0 = (2 * Math.PI * corner) / fs;
+  const cos = Math.cos(w0);
+  const alpha = Math.sin(w0) / Math.SQRT2; // sin(w0) / (2Q)
+  const a0 = 1 + alpha;
+  const b0 = (1 + cos) / 2 / a0;
+  const b1 = -(1 + cos) / a0;
+  const b2 = b0;
+  const a1 = (-2 * cos) / a0;
+  const a2 = (1 - alpha) / a0;
+
+  const pad = Math.min(Math.round(PAD_S * fs), n - 1);
+  const ext = new Float64Array(n + 2 * pad);
+  for (let j = 0; j < pad; j++) ext[j] = d[pad - j];
+  ext.set(d, pad);
+  for (let j = 0; j < pad; j++) ext[pad + n + j] = d[n - 2 - j];
+
+  // Transposed direct form II, its state set so that a constant input ext[first] gives output 0 from the start.
+  const pass = (from, step) => {
+    const x0 = ext[from];
+    let z1 = (b1 + b2) * x0;
+    let z2 = b2 * x0;
+    for (let i = from; i >= 0 && i < ext.length; i += step) {
+      const x = ext[i];
+      const y = b0 * x + z1;
+      z1 = b1 * x - a1 * y + z2;
+      z2 = b2 * x - a2 * y;
+      ext[i] = y;
+    }
+  };
+  pass(0, 1);
+  pass(ext.length - 1, -1);
+  return ext.slice(pad, pad + n);
+}
diff --git a/tools/make-test-audio b/tools/make-test-audio
new file mode 100755
index 0000000..aecdcee
--- /dev/null
+++ b/tools/make-test-audio
@@ -0,0 +1,105 @@
+#!/usr/bin/env node
+// Writes a WAV test signal: a sine tone (optionally FM-modulated, for wow-and-flutter) or a click track.
+// Exit: 0 written · 1 I/O failure · 2 usage
+// Spec: docs/plans/2026-10-19-M3-measurement.md, section "make-test-audio"; signals in tools/lib/test-audio.mjs.
+import { FORMATS, encodeWav, writeWav } from "./lib/wav.mjs";
+import { tone, clicks, dbToAmplitude } from "./lib/test-audio.mjs";
+
+const USAGE = "usage: tools/make-test-audio <tone|clicks> [--seconds <s>] [--out <file.wav>|-] [options]";
+const HELP = `${USAGE}
+Both:
+  --seconds <s>        length, frames = round(s · rate), at most 600 s (default 5)
+  --out <file>|-       output (default ./<kind>.wav; - writes the WAV to stdout); replaced if it exists
+  --rate <hz>          sample rate, 8000..384000 (default 48000: the Rane One and the null sink)
+  --format <f>         ${FORMATS.join(", ")} (default pcm32)
+  --channels <n>       1 or 2, both channels identical (default 2)
+  --level-db <dBFS>    peak level, at most 0 (default -6, amplitude 0.5012)
+tone:
+  --freq <hz>          tone frequency (default 1000)
+  --fm-depth <percent> frequency modulation, peak deviation in percent of --freq (default 0)
+  --fm-rate <hz>       modulation rate, at most 200 (flutter's upper band edge; default 4)
+clicks:
+  --bpm <n>            one 1 ms click per beat from t = 0, 1..1000 (default 120)
+Exit: 0 written · 1 I/O failure · 2 usage
+`;
+
+function usage(why) {
+  if (why) process.stderr.write(`make-test-audio: ${why}\n`);
+  process.stderr.write(USAGE + "\n");
+  process.exit(2);
+}
+
+const args = process.argv.slice(2);
+if (args.length === 1 && args[0] === "--help") {
+  process.stdout.write(HELP);
+  process.exit(0);
+}
+const kind = args[0];
+if (kind !== "tone" && kind !== "clicks") usage(kind === undefined ? undefined : `unknown signal ${kind}`);
+
+const NUMBER = /^-?(\d+(\.\d*)?|\.\d+)$/;
+// Option → [signal it belongs to (null: both), check]. Values are parsed as plain decimals.
+const OPTIONS = {
+  "--seconds": [null, (v) => v > 0 && v <= 600],
+  "--rate": [null, (v) => Number.isInteger(v) && v >= 8000 && v <= 384000],
+  "--channels": [null, (v) => v === 1 || v === 2],
+  "--level-db": [null, (v) => v <= 0],
+  "--freq": ["tone", (v) => v > 0],
+  "--fm-depth": ["tone", (v) => v >= 0 && v < 100],
+  "--fm-rate": ["tone", (v) => v > 0 && v <= 200],
+  "--bpm": ["clicks", (v) => v > 0 && v <= 1000],
+};
+const opt = { "--seconds": 5, "--rate": 48000, "--channels": 2, "--level-db": -6, "--freq": 1000, "--fm-depth": 0, "--fm-rate": 4, "--bpm": 120 };
+let format = "pcm32";
+let out = null;
+const seen = new Set();
+for (let i = 1; i < args.length; i++) {
+  const a = args[i];
+  if (!a.startsWith("-") || a === "-") usage(`unexpected argument ${a}`);
+  if (seen.has(a)) usage(`${a} given twice`);
+  seen.add(a);
+  const v = args[++i];
+  if (v === undefined) usage(`${a} needs a value`);
+  if (a === "--out") {
+    if (v === "" || (v.startsWith("-") && v !== "-")) usage("--out needs a file or -");
+    out = v;
+  } else if (a === "--format") {
+    if (!FORMATS.includes(v)) usage(`--format must be one of ${FORMATS.join(", ")}`);
+    format = v;
+  } else if (Object.hasOwn(OPTIONS, a)) {
+    const [only, ok] = OPTIONS[a];
+    if (only && only !== kind) usage(`${a} is for ${only} only`);
+    if (!NUMBER.test(v) || !ok(Number(v))) usage(`bad ${a} ${v}`);
+    opt[a] = Number(v);
+  } else usage(`unknown option ${a}`);
+}
+const rate = opt["--rate"];
+const frames = Math.round(opt["--seconds"] * rate);
+if (frames < 1) usage(`--seconds ${opt["--seconds"]} is less than one frame`);
+if (kind === "tone" && opt["--freq"] * (1 + opt["--fm-depth"] / 100) >= rate / 2) {
+  usage(`--freq ${opt["--freq"]} (with --fm-depth) must stay below half of --rate ${rate}`);
+}
+if (out === null) out = `./${kind}.wav`;
+
+const amplitude = dbToAmplitude(opt["--level-db"]);
+const x = kind === "tone"
+  ? tone({ rate, frames, freq: opt["--freq"], amplitude, fmDepth: opt["--fm-depth"], fmRate: opt["--fm-rate"] })
+  : clicks({ rate, frames, bpm: opt["--bpm"], amplitude });
+const wav = { sampleRate: rate, format, channels: Array(opt["--channels"]).fill(x) };
+
+const failed = (err) => {
+  process.stderr.write(`make-test-audio: writing ${out}: ${err.message}\n`);
+  process.exit(1);
+};
+const wrote = () => process.stderr.write(`wrote ${out}: ${frames} frames, ${rate} Hz, ${format}, ${opt["--channels"]} ch\n`);
+if (out === "-") {
+  process.stdout.on("error", failed); // a reader that goes away early: EPIPE
+  process.stdout.write(encodeWav(wav), (err) => (err ? failed(err) : wrote()));
+} else {
+  try {
+    writeWav(out, wav);
+  } catch (err) {
+    failed(err);
+  }
+  wrote();
+}
diff --git a/tools/record-output b/tools/record-output
new file mode 100755
index 0000000..df1dbf7
--- /dev/null
+++ b/tools/record-output
@@ -0,0 +1,168 @@
+#!/usr/bin/env node
+// Records a null sink's monitor (default mixxx-dev.monitor) to a 48 kHz, 2 ch, s32 WAV with pw-record, so Mixxx's
+// output is measured without speakers or the Rane One. Capture only: it plays nothing and never touches defaults.
+// Exit: 0 recorded · 1 failed (no sink, short or wrong recording, timeout) · 2 usage · 3 refused target
+// Spec: docs/plans/2026-10-19-M3-measurement.md, section "record-output"; why the target is translated: D18.
+// Env: RECORD_OUTPUT_GRACE_MS (how long past --seconds pw-record may take, default 5000).
+import { spawn, spawnSync } from "node:child_process";
+import { accessSync, constants, renameSync, rmSync, statSync } from "node:fs";
+import { basename, dirname, join } from "node:path";
+import { readWav } from "./lib/wav.mjs";
+
+const RATE = 48000;
+const CHANNELS = 2;
+const FORMAT = "pcm32";
+const USAGE = "usage: tools/record-output [--seconds <s>] [--target <sink>.monitor] <out.wav>";
+const HELP = `${USAGE}
+Records <sink>'s monitor for --seconds (default 10, at most 600, to the millisecond) into <out.wav>:
+  pw-record --target <sink> -P stream.capture.sink=true --rate 48000 --format s32 --channels 2
+            --sample-count <seconds * 48000> -P node.dont-fallback=true -P node.dont-move=true <temp file>
+--target defaults to mixxx-dev.monitor (the tools/null-sink sink, which must be up). Refused (exit 3): anything
+but <name>.monitor with a plain name (letters, digits, _ and -; not auto, a number or a path), a name with rane,
+alsa_ or bluez_ in it, and a sink that pactl doesn't list as a null sink (support.null-audio-sink).
+The recording must be exactly seconds * 48000 frames of 48000 Hz, 2 ch, pcm32, or nothing is written (exit 1).
+Exit: 0 recorded · 1 failed · 2 usage · 3 refused target
+`;
+
+function usage(why) {
+  if (why) process.stderr.write(`record-output: ${why}\n`);
+  process.stderr.write(USAGE + "\n");
+  process.exit(2);
+}
+function fail(why, code = 1) {
+  process.stderr.write(`record-output: ${why}\n`);
+  process.exit(code);
+}
+
+const args = process.argv.slice(2);
+if (args.length === 1 && args[0] === "--help") {
+  process.stdout.write(HELP);
+  process.exit(0);
+}
+let out = null;
+let seconds = 10;
+let target = "mixxx-dev.monitor";
+const seen = new Set();
+for (let i = 0; i < args.length; i++) {
+  const a = args[i];
+  if (!a.startsWith("-")) {
+    if (out !== null) usage(`unexpected argument ${a}`);
+    out = a;
+    continue;
+  }
+  if (seen.has(a)) usage(`${a} given twice`);
+  seen.add(a);
+  const v = args[++i];
+  if (v === undefined) usage(`${a} needs a value`);
+  if (a === "--seconds") {
+    if (!/^(\d{1,3}(\.\d{0,3})?|\.\d{1,3})$/.test(v) || !(Number(v) > 0) || Number(v) > 600) usage(`bad --seconds ${v}`);
+    seconds = Number(v);
+  } else if (a === "--target") {
+    if (v === "") usage("--target needs a value");
+    target = v;
+  } else usage(`unknown option ${a}`);
+}
+if (out === null) usage();
+if (!/\.wav$/i.test(out)) usage(`${out} is not a .wav file`);
+
+// A capture stream on real hardware, or on the default source (the Rane One's capture) by a fallback, would
+// record the wrong thing; only a null sink's monitor is measured. pw-record also reads `auto` as "the default",
+// a number as an object serial and a WirePlumber target as an object.path (`alsa:acp:ONE:…`), so the name must be
+// plain, and pactl must list it as a null sink.
+const sink = target.endsWith(".monitor") ? target.slice(0, -".monitor".length) : "";
+if (!/^[A-Za-z][A-Za-z0-9_-]*$/.test(sink) || /^auto$/i.test(sink)) {
+  fail(`refused: --target ${target} is not <name>.monitor with a plain sink name`, 3);
+}
+if (/rane|alsa_|bluez_/i.test(sink)) {
+  fail(`refused: --target ${target} names the Rane One or real hardware; record a null sink's monitor`, 3);
+}
+
+const frames = Math.round(seconds * RATE);
+const graceMs = Number(process.env.RECORD_OUTPUT_GRACE_MS ?? 5000);
+if (!(graceMs >= 0)) fail(`RECORD_OUTPUT_GRACE_MS must be milliseconds, not '${process.env.RECORD_OUTPUT_GRACE_MS}'`);
+const outDir = dirname(out);
+let outStat = null;
+try {
+  if (!statSync(outDir).isDirectory()) fail(`${outDir} is not a directory`);
+  outStat = statSync(out, { throwIfNoEntry: false });
+} catch {
+  fail(`${outDir} does not exist`);
+}
+if (outStat?.isDirectory()) fail(`${out} is a directory`);
+try {
+  accessSync(outDir, constants.W_OK);
+} catch {
+  fail(`cannot write to ${outDir}`);
+}
+
+// Read-only: the sink list, to see that the name is a null sink that exists.
+const ls = spawnSync("pactl", ["-f", "json", "list", "sinks"], {
+  encoding: "utf8", stdio: ["ignore", "pipe", "inherit"], timeout: 5000, env: { ...process.env, LC_ALL: "C" },
+});
+let sinks;
+try {
+  if (ls.status !== 0) throw new Error(ls.error?.message ?? `exit ${ls.status}`);
+  sinks = JSON.parse(ls.stdout);
+  if (!Array.isArray(sinks)) throw new Error("not a list");
+} catch (err) {
+  fail(`cannot list sinks with pactl -f json list sinks: ${err.message}`);
+}
+const found = sinks.filter((s) => s?.name === sink);
+if (found.length === 0) {
+  fail(sink === "mixxx-dev" ? "the mixxx-dev null sink is not up; run tools/null-sink up" : `no sink named ${sink}`);
+}
+if (found.length !== 1) fail(`refused: ${found.length} sinks are named ${sink}`, 3);
+const factory = found[0].properties?.["factory.name"];
+if (factory !== "support.null-audio-sink") fail(`refused: ${sink} is not a null sink (${factory ?? "no factory.name"})`, 3);
+
+// pw-record writes a temp file beside the output; it replaces <out.wav> only once it reads back complete, so a
+// failed recording never leaves an empty file that could pass for measured silence, nor eats an older one.
+const tmp = join(outDir, `.${basename(out)}.${process.pid}.tmp.wav`);
+const pwArgs = ["--target", sink, "-P", "stream.capture.sink=true", "--rate", String(RATE), "--format", "s32",
+  "--channels", String(CHANNELS), "--sample-count", String(frames), "-P", "node.dont-fallback=true",
+  "-P", "node.dont-move=true", tmp];
+const child = spawn("pw-record", pwArgs, { stdio: ["ignore", "ignore", "inherit"] });
+let stopped = null; // why the tool stopped pw-record, if it did
+function stop(why) {
+  if (stopped) return;
+  stopped = why;
+  child.kill("SIGTERM");
+  setTimeout(() => child.kill("SIGKILL"), 1000).unref();
+}
+const limitS = seconds + graceMs / 1000;
+const timer = setTimeout(() => stop(`pw-record did not finish within ${limitS} s; stopped it. Target not linked?`),
+  limitS * 1000);
+for (const sig of ["SIGINT", "SIGTERM", "SIGHUP"]) process.on(sig, () => stop(`stopped by ${sig}; nothing recorded`));
+child.on("error", (err) => {
+  clearTimeout(timer);
+  rmSync(tmp, { force: true });
+  fail(`cannot run pw-record: ${err.message}`);
+});
+// pw-record 1.6.8 exits 1 even after --sample-count frames, so only the file it wrote counts.
+child.on("exit", () => {
+  clearTimeout(timer);
+  try {
+    if (stopped) throw new Error(stopped);
+    let wav = null;
+    try {
+      wav = readWav(tmp);
+    } catch (err) {
+      if (err.code !== "ENOENT") process.stderr.write(`record-output: ${err.message}\n`);
+    }
+    const got = wav ? wav.channels[0]?.length ?? 0 : 0;
+    if (got !== frames) throw new Error(`pw-record recorded ${got} of ${frames} frames: target not found or not linked?`);
+    if (wav.sampleRate !== RATE || wav.channels.length !== CHANNELS || wav.format !== FORMAT) {
+      throw new Error(`pw-record wrote ${wav.sampleRate} Hz, ${wav.channels.length} ch, ${wav.format}, ` +
+        `not ${RATE} Hz, ${CHANNELS} ch, ${FORMAT}`);
+    }
+    renameSync(tmp, out);
+    let peak = 0;
+    for (const ch of wav.channels) for (const v of ch) peak = Math.max(peak, Math.abs(v));
+    const peakDb = peak > 0 ? (20 * Math.log10(peak)).toFixed(2) : "-inf";
+    process.stdout.write(`recorded ${seconds.toFixed(3)} s of ${target} to ${out} ` +
+      `(${frames} frames, ${RATE} Hz, ${CHANNELS} ch, ${FORMAT}, peak ${peakDb} dBFS)\n`);
+  } catch (err) {
+    rmSync(tmp, { force: true });
+    fail(err.message);
+  }
+});
