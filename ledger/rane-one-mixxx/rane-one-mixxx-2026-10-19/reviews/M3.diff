+    const r = t.run(["--seconds", "1", join(t.out, "d.wav")]);
+    assert.equal(r.status, 1);
+    assert.match(r.stderr, /d\.wav is a directory/);
+    assert.deepEqual(t.calls(), []);
+    assert.deepEqual(readdirSync(t.out), ["d.wav"]);
+  } finally {
+    t.done();
+  }
+});
+
+test("an output directory that isn't writable exits 1 before pw-record runs", { skip: process.getuid?.() === 0 }, () => {
+  const t = setup();
+  try {
+    chmodSync(t.out, 0o555);
+    const r = t.run(["--seconds", "1", join(t.out, "x.wav")]);
+    assert.equal(r.status, 1);
+    assert.match(r.stderr, /cannot write to/);
+    assert.deepEqual(t.calls(), []);
+  } finally {
+    chmodSync(t.out, 0o755);
+    t.done();
+  }
+});
+
+test("an output directory that doesn't exist exits 1 before pw-record runs", () => {
+  const t = setup();
+  try {
+    const r = t.run(["--seconds", "1", join(t.out, "nope", "x.wav")]);
+    assert.equal(r.status, 1);
+    assert.match(r.stderr, /nope/);
+    assert.deepEqual(t.calls(), []);
+  } finally {
+    t.done();
+  }
+});
+
+test("without pw-record on PATH it exits 1 and says so", () => {
+  const t = setup();
+  try {
+    rmSync(join(t.dir, "bin", "pw-record"));
+    // node runs by its own path, and PATH holds only the stubs plus bash and cat for the pactl stub (the real
+    // pw-record is in /usr/bin).
+    const sys = join(t.dir, "sys");
+    mkdirSync(sys);
+    for (const cmd of ["bash", "cat"]) {
+      symlinkSync(spawnSync("bash", ["-c", `command -v ${cmd}`], { encoding: "utf8" }).stdout.trim(), join(sys, cmd));
+    }
+    const r = spawnSync(process.execPath, [SCRIPT, "--seconds", "1", "--target", "other.monitor", join(t.out, "x.wav")],
+      { encoding: "utf8", env: { PATH: `${join(t.dir, "bin")}:${sys}`, STUB: t.stub }, cwd: t.dir, timeout: 20000 });
+    assert.equal(r.status, 1);
+    assert.match(r.stderr, /cannot run pw-record: spawn pw-record ENOENT/);
+    assert.deepEqual(readdirSync(t.out), []);
+  } finally {
+    t.done();
+  }
+});
