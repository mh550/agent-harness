@@ -0,0 +1,287 @@
+#!/usr/bin/env node
+// Records one MIDI input port into M2 JSONL, read-only, with host microsecond timestamps (D14).
+// A child process (this file with --reader) is the only code that touches the device: it opens it read-only, blocks
+// in readSync and sends each read to the parent as a frame stamped with process.hrtime. The parent parses the
+// frames, writes JSONL through tools/lib/jsonl.mjs and handles stops. Nothing is ever written to the device.
+// Exit: 0 stopped (Ctrl-C, SIGTERM, --seconds, EOF) · 1 bad output, open failure or device gone · 2 usage
+//       4 no input port with that name · 5 the port is busy
+// Spec: docs/plans/2026-10-19-M2-capture-replay.md, section "Capture backend".
+import fs from "node:fs";
+import { spawn, exec } from "node:child_process";
+import { promisify } from "node:util";
+import { fileURLToPath } from "node:url";
+import { createParser } from "./lib/midi-parse.mjs";
+import { createJsonlWriter, toRecord } from "./lib/jsonl.mjs";
+import { parseAmidiList, findInputs } from "./lib/amidi.mjs";
+
+const USAGE = "usage: tools/capture (--port <name> | --device <path>) --out <file.jsonl> [--seconds <n>] [--wait <s>] [--force]";
+const HELP = `${USAGE}
+Records one MIDI input into M2 JSONL: one line per message, t_us = host µs since the device opened. Read-only.
+  --port <name>       the input's name exactly as \`amidi -l\` lists it, e.g. 'Rane ONE MIDI 1'. Resolved to
+                      /dev/snd/midiC<card>D<dev> on every run (card numbers change on replug).
+  --device <path>     read this rawmidi device or FIFO instead of looking a name up (tests, last resort)
+  --out <file.jsonl>  where to write; refused if it exists, unless --force
+  --seconds <n>       stop by itself n seconds after the device opened (default: run until stopped)
+  --wait <s>          with --port: poll \`amidi -l\` up to s seconds for the port to appear (power-on)
+  --force             overwrite --out
+Stop with Ctrl-C (or SIGTERM): everything read so far is kept, a summary goes to stderr, exit 0.
+Exit: 0 stopped · 1 bad output, open failure or device gone · 2 usage · 4 no such input port · 5 port busy
+`;
+
+// Frames on the reader's stdout: kind (1 byte), hrtime ns (8, big-endian), payload length (4), payload.
+const ATTEMPT = 0, OPENED = 1, DATA = 2, ERROR = 3;
+const OPEN_RETRY_MS = 2000; // ENOENT/EACCES right after the port appears: udev may not have set the node up yet
+const BUSY_MS = 2000; // a rawmidi open that blocks this long means another program holds the input
+
+function frame(kind, payload = Buffer.alloc(0)) {
+  const head = Buffer.alloc(13);
+  head[0] = kind;
+  head.writeBigUInt64BE(process.hrtime.bigint(), 1);
+  head.writeUInt32BE(payload.length, 9);
+  fs.writeSync(1, Buffer.concat([head, payload])); // not process.stdout: this event loop never runs to flush it
+}
+
+// The reader child. Blocking calls only; SIGTERM from the parent ends it wherever it is blocked.
+function reader(path) {
+  const pause = new Int32Array(new SharedArrayBuffer(4));
+  const fail = (phase, err) => {
+    frame(ERROR, Buffer.from(JSON.stringify({ phase, code: err.code ?? null, message: err.message })));
+    process.exit(1);
+  };
+  let fd;
+  for (const t0 = Date.now(); fd === undefined;) {
+    frame(ATTEMPT);
+    try {
+      fd = fs.openSync(path, "r");
+    } catch (err) {
+      if (!["ENOENT", "EACCES"].includes(err.code) || Date.now() - t0 >= OPEN_RETRY_MS) fail("open", err);
+      Atomics.wait(pause, 0, 0, 100);
+    }
+  }
+  frame(OPENED);
+  const buf = Buffer.alloc(4096);
+  for (;;) {
+    let n;
+    try {
+      n = fs.readSync(fd, buf);
+    } catch (err) {
+      if (err.code === "EAGAIN" || err.code === "EINTR") continue;
+      fail("read", err);
+    }
+    if (n === 0) process.exit(0); // EOF: a FIFO whose writer closed (a live rawmidi device never returns 0)
+    frame(DATA, buf.subarray(0, n));
+  }
+}
+
+function usage(why) {
+  if (why) process.stderr.write(`capture: ${why}\n`);
+  process.stderr.write(USAGE + "\n");
+  process.exit(2);
+}
+
+const args = process.argv.slice(2);
+if (args[0] === "--reader") {
+  if (args.length !== 2 || args[1] === "") usage("--reader takes one path");
+  reader(args[1]);
+}
+if (args.length === 1 && args[0] === "--help") {
+  process.stdout.write(HELP);
+  process.exit(0);
+}
+
+const opts = {};
+const NUMBER = /^\d+(\.\d+)?$/;
+for (let i = 0; i < args.length; i++) {
+  const a = args[i];
+  if (a === "--force") opts.force = true;
+  else if (["--port", "--device", "--out", "--seconds", "--wait"].includes(a)) {
+    const key = a.slice(2);
+    const v = args[++i];
+    if (opts[key] !== undefined) usage(`${a} given twice`);
+    if (v === undefined || v === "" || v.startsWith("-")) usage(`${a} needs a value`);
+    opts[key] = v;
+  } else usage(`unknown argument ${a}`);
+}
+if ((opts.port === undefined) === (opts.device === undefined)) usage("give exactly one of --port and --device");
+if (opts.out === undefined) usage("--out is required");
+for (const key of ["seconds", "wait"]) {
+  if (opts[key] === undefined) continue;
+  if (!NUMBER.test(opts[key]) || !(Number(opts[key]) > 0)) usage(`--${key} needs a number of seconds > 0`);
+  opts[key] = Number(opts[key]);
+}
+if (opts.wait !== undefined && opts.port === undefined) usage("--wait only applies to --port");
+
+const say = (msg) => process.stderr.write(`capture: ${msg}\n`);
+const fail = (msg, code = 1) => {
+  say(msg);
+  process.exit(code);
+};
+
+async function listPorts() {
+  let stdout;
+  try {
+    ({ stdout } = await promisify(exec)("amidi -l", { encoding: "utf8" }));
+  } catch (err) {
+    fail(`amidi -l failed: ${err.message.trim()}`);
+  }
+  return parseAmidiList(stdout);
+}
+
+let stopping = null; // why the capture stops, once a stop was asked for
+let child = null; // the reader
+for (const sig of ["SIGINT", "SIGTERM", "SIGHUP"]) process.on(sig, () => stop("stopped"));
+// Backstop for any exit that skips finish (an uncaught exception): never leave the reader holding the device.
+// Only a SIGKILL to the parent can still orphan it; the reader then ends on its next read (EPIPE).
+process.on("exit", () => {
+  if (child && child.exitCode === null && child.signalCode === null) child.kill("SIGTERM");
+});
+
+let path = opts.device;
+if (opts.port !== undefined) {
+  const deadline = Date.now() + (opts.wait ?? 0) * 1000;
+  let ports;
+  let found = [];
+  for (;;) {
+    ports = await listPorts();
+    found = findInputs(ports, opts.port);
+    if (found.length || Date.now() >= deadline || stopping) break;
+    await new Promise((resolve) => setTimeout(resolve, 100));
+  }
+  if (stopping) fail("stopped before the port appeared");
+  if (found.length === 0) {
+    const waited = opts.wait === undefined ? "" : ` after waiting ${opts.wait} s`;
+    fail(`no MIDI input port named '${opts.port}'${waited} (amidi -l lists: ${ports.map((p) => p.name).join(", ") || "nothing"})`, 4);
+  }
+  if (found.length > 1) fail(`${found.length} input ports are named '${opts.port}' (${found.map((p) => p.hw).join(", ")}); use --device`);
+  const p = found[0];
+  // /dev/snd/midiC<C>D<D> opens the first free subdevice, so only subdevice 0 can be named reliably.
+  if (p.sub !== undefined && p.sub !== "0") fail(`'${opts.port}' is subdevice ${p.sub} of hw:${p.card},${p.dev}, which the device node cannot choose`);
+  path = `${process.env.CAPTURE_SND_DIR || "/dev/snd"}/midiC${p.card}D${p.dev}`;
+  say(`'${opts.port}' is ${p.hw}, ${path}`);
+}
+
+// The output exists before the device is opened, so a bad --out fails first.
+const existed = fs.existsSync(opts.out);
+if (existed && !opts.force) fail(`${opts.out} exists; use --force to overwrite`);
+let writer;
+try {
+  writer = createJsonlWriter(opts.out, { force: opts.force });
+} catch (err) {
+  fail(`cannot write ${opts.out}: ${err.message}`);
+}
+
+const parser = createParser();
+const types = {};
+let openNs = null;
+let lastRead = 0n;
+let error = null; // the reader's ERROR frame
+let writeError = null; // the output failed (ENOSPC, EIO): stop, keep what was written
+let exitCode = 0;
+let busyTimer = null;
+let secondsTimer = null;
+let pending = Buffer.alloc(0);
+
+function record(msgs, t_us) {
+  writer.write(msgs, t_us);
+  for (const m of msgs) {
+    const { type } = toRecord(m, t_us);
+    types[type] = (types[type] ?? 0) + 1;
+  }
+}
+
+function onFrames(chunk) {
+  if (writeError) return;
+  try {
+    readFrames(chunk);
+  } catch (err) {
+    writeError = err;
+    stop("failed");
+  }
+}
+
+function readFrames(chunk) {
+  pending = pending.length ? Buffer.concat([pending, chunk]) : chunk;
+  while (pending.length >= 13) {
+    const len = pending.readUInt32BE(9);
+    if (pending.length < 13 + len) break;
+    const kind = pending[0], ns = pending.readBigUInt64BE(1), payload = pending.subarray(13, 13 + len);
+    pending = pending.subarray(13 + len);
+    if (kind === ATTEMPT) armBusyTimer();
+    else if (kind === OPENED) {
+      clearTimeout(busyTimer);
+      openNs = lastRead = ns;
+      if (opts.seconds !== undefined) secondsTimer = setTimeout(() => stop("stopped"), opts.seconds * 1000);
+    } else if (kind === DATA) {
+      lastRead = ns;
+      record(parser.feed(payload), Number((ns - openNs) / 1000n));
+    } else if (kind === ERROR) error = JSON.parse(payload.toString());
+  }
+}
+
+// Only a character device can be busy; a FIFO's open waits for its writer by design.
+function armBusyTimer() {
+  clearTimeout(busyTimer);
+  busyTimer = setTimeout(() => {
+    let chr = false;
+    try {
+      chr = fs.statSync(path).isCharacterDevice();
+    } catch {
+      // gone again: the reader reports it
+    }
+    if (chr && openNs === null) {
+      say(`${opts.port ?? path} is busy: another program has it open (Mixxx, aseqdump, arecordmidi, Serato's bridge?); close it and retry`);
+      exitCode = 5;
+      child.kill("SIGTERM");
+    }
+  }, BUSY_MS);
+}
+
+child = spawn(process.execPath, [fileURLToPath(import.meta.url), "--reader", path], { stdio: ["ignore", "pipe", "inherit"] });
+child.stdout.on("data", onFrames);
+child.on("error", (err) => error ??= { phase: "spawn", code: err.code ?? null, message: err.message });
+child.on("close", finish);
+if (stopping) stop("stopped");
+
+function stop(why) {
+  stopping ??= why;
+  if (child && child.exitCode === null && child.signalCode === null) child.kill("SIGTERM");
+}
+
+function finish(code, signal) {
+  clearTimeout(busyTimer);
+  clearTimeout(secondsTimer);
+  try {
+    if (!writeError) record(parser.flush(), openNs === null ? 0 : Number((lastRead - openNs) / 1000n)); // an open SysEx, truncated
+  } catch (err) {
+    writeError = err;
+  }
+  try {
+    writer.close();
+  } catch (err) {
+    writeError ??= err;
+  }
+  // A frame cut short means the reader died mid-write; its bytes are lost, so say so.
+  if (pending.length) say(`lost a partial frame of ${pending.length} bytes from the reader`);
+  const total = writer.count;
+  const secs = openNs === null ? 0 : Number(process.hrtime.bigint() - openNs) / 1e9;
+  const perType = Object.entries(types).map(([k, v]) => `${k} ${v}`).join(", ");
+  const what = `${total} messages (${perType || "none"}), dropped ${parser.stats.dropped}, ${secs.toFixed(1)} s`;
+  // Busy first: the timer may have fired with the reader's "opened" frame still in the pipe.
+  if (exitCode === 5 || openNs === null) {
+    if (total === 0 && !existed) fs.rmSync(opts.out, { force: true }); // nothing read: no empty file left behind
+    if (exitCode === 5) process.exit(5);
+    if (error) fail(`cannot open ${path}: ${error.message}`);
+    if (stopping) fail("stopped before the device opened");
+    fail(`the reader exited (${signal ?? `code ${code}`}) before the device opened`);
+  }
+  if (writeError) fail(`writing ${opts.out}: ${writeError.message}; ${writer.count} lines written before it`);
+  if (error) {
+    const gone = ["ENODEV", "EIO"].includes(error.code);
+    say(gone ? `device gone after ${secs.toFixed(1)} s` : `reading ${path}: ${error.message}`);
+    fail(`kept ${opts.out}: ${what}`);
+  }
+  // In a terminal, Ctrl-C reaches the reader too, and its exit may be seen before the parent's own SIGINT.
+  if (!stopping && signal && signal !== "SIGINT") fail(`the reader was killed (${signal}); kept ${opts.out}: ${what}`);
+  say(`${stopping ?? "end of input"}: ${what}`);
+  process.exit(0);
+}
diff --git a/tools/capture-convert b/tools/capture-convert
new file mode 100755
index 0000000..a1d7156
--- /dev/null
+++ b/tools/capture-convert
@@ -0,0 +1,138 @@
+#!/usr/bin/env node
+// Converts a Standard MIDI File (arecordmidi's capture, the D14 fallback) into M2 JSONL, t_us from SMF tick 0.
+//   tools/capture-convert <file.mid> [--out <file.jsonl>] [--force] [--allow-dropped]
+// Default output: the input with .mid/.midi replaced by .jsonl. Refuses to overwrite unless --force, and refuses
+// input bytes that make no message (the JSONL could not show them) unless --allow-dropped.
+// Exit: 0 written · 1 bad input or I/O failure · 2 usage
+// Spec: docs/plans/2026-10-19-M2-capture-replay.md, section "SMF library".
+import { readFileSync, existsSync, linkSync, renameSync, rmSync } from "node:fs";
+import { dirname, basename, join } from "node:path";
+import { readSmfFile, ticksToMicros } from "./lib/smf.mjs";
+import { createParser } from "./lib/midi-parse.mjs";
+import { createJsonlWriter, formatLine, toRecord } from "./lib/jsonl.mjs";
+
+const USAGE = readFileSync(new URL(import.meta.url), "utf8").split("\n")[2].replace(/^\/\/ {3}/, "usage: ");
+
+function usage(why) {
+  if (why) process.stderr.write(`capture-convert: ${why}\n`);
+  process.stderr.write(USAGE + "\n");
+  process.exit(2);
+}
+
+const args = process.argv.slice(2);
+if (args.length === 1 && args[0] === "--help") {
+  process.stdout.write(USAGE + "\n");
+  process.exit(0);
+}
+let input = null;
+let out = null;
+let force = false;
+let allowDropped = false;
+for (let i = 0; i < args.length; i++) {
+  const a = args[i];
+  if (a === "--force") force = true;
+  else if (a === "--allow-dropped") allowDropped = true;
+  else if (a === "--out") {
+    if (out !== null) usage("--out given twice");
+    const v = args[i + 1];
+    if (v === undefined || v === "" || v.startsWith("-")) usage("--out needs a file");
+    out = args[++i];
+  } else if (a.startsWith("-")) usage(`unknown option ${a}`);
+  else if (input === null) input = a;
+  else usage("one input file only");
+}
+if (input === null) usage();
+if (out === null) {
+  if (!/\.midi?$/i.test(input)) usage("the input does not end in .mid; give --out");
+  out = input.replace(/\.midi?$/i, ".jsonl");
+}
+
+const fail = (msg) => {
+  process.stderr.write(`capture-convert: ${msg}\n`);
+  process.exit(1);
+};
+const hex = (bytes) => Buffer.from(bytes).toString("hex").toUpperCase();
+
+// Convert everything in memory first, so a broken input leaves no output file.
+const batches = [];
+let total = 0;
+let dropped = 0;
+try {
+  const smf = readSmfFile(input);
+  const us = ticksToMicros(smf);
+  const parser = createParser();
+  let lastTick = 0;
+  for (const e of smf.events) {
+    if (e.kind === "meta") continue;
+    const msgs = parser.feed(e.bytes);
+    lastTick = e.tick;
+    // A channel event or a complete F0 … F7 SysEx is one message, the last one out; anything before it can only be
+    // a SysEx an earlier packet left open, now truncated. An F0 packet without F7 (a divided SysEx, SMF 1.0) and
+    // an F7 escape or continuation carry raw bytes, which may make any number of messages.
+    const whole = e.kind === "midi" || (!e.escape && e.bytes[e.bytes.length - 1] === 0xf7);
+    if (whole) {
+      const own = msgs.length ? toRecord(msgs[msgs.length - 1], 0).bytes : "";
+      const before = msgs.slice(0, -1);
+      if (own !== hex(e.bytes) || before.some((m) => !(m.status === 0xf0 && m.truncated))) {
+        throw new Error(`tick ${e.tick}: ${hex(e.bytes)} parses as ${msgs.map((m) => toRecord(m, 0).bytes).join(" ") || "nothing"}`);
+      }
+    }
+    if (msgs.length) batches.push([msgs, us(e.tick)]);
+    total += msgs.length;
+  }
+  const rest = parser.flush(); // a SysEx still open at the end, written truncated at the last event's time
+  if (rest.length) batches.push([rest, us(lastTick)]);
+  total += rest.length;
+  dropped = parser.stats.dropped;
+} catch (err) {
+  fail(err.message);
+}
+if (dropped && !allowDropped) fail(`${input}: the parser dropped ${dropped} bytes that make no message; --allow-dropped to write anyway`);
+
+function summary(what) {
+  const types = {};
+  for (const [msgs, t_us] of batches) for (const m of msgs) {
+    const { type } = toRecord(m, t_us);
+    types[type] = (types[type] ?? 0) + 1;
+  }
+  const last = batches.length ? batches[batches.length - 1][1] : 0;
+  const perType = Object.entries(types).map(([k, v]) => `${k} ${v}`).join(", ");
+  process.stderr.write(`capture-convert: ${what}: ${total} messages (${perType || "none"}), last t_us ${last}, dropped ${dropped}\n`);
+}
+
+// An existing output identical to this conversion is left alone, so re-running on a committed file is a no-op.
+if (!force && existsSync(out)) {
+  const text = batches.map(([msgs, t_us]) => msgs.map((m) => formatLine(toRecord(m, t_us))).join("")).join("");
+  let same = false;
+  try {
+    same = readFileSync(out, "utf8") === text;
+  } catch {
+    // unreadable: treated as different
+  }
+  if (!same) fail(`${out} exists and differs; use --force to overwrite`);
+  summary(`${out} is already up to date`);
+  process.exit(0);
+}
+
+// Written to a temp file next to the output, then linked (no --force: fails if the output appeared meanwhile) or
+// renamed over it (--force), so the old file survives any failure.
+const tmp = join(dirname(out), `.${basename(out)}.${process.pid}.tmp`);
+try {
+  const writer = createJsonlWriter(tmp);
+  try {
+    for (const [msgs, t_us] of batches) writer.write(msgs, t_us);
+  } finally {
+    writer.close();
+  }
+  if (force) renameSync(tmp, out);
+  else {
+    linkSync(tmp, out);
+    rmSync(tmp);
+  }
+} catch (err) {
+  rmSync(tmp, { force: true });
+  if (err.code === "EEXIST" && err.dest === out) fail(`${out} appeared meanwhile; use --force to overwrite`);
+  fail(`writing ${out}: ${err.message}`);
+}
+
+summary(`wrote ${out}`);
diff --git a/tools/capture-session b/tools/capture-session
new file mode 100755
index 0000000..1dd8175
--- /dev/null
+++ b/tools/capture-session
@@ -0,0 +1,381 @@
+#!/usr/bin/env node
+// Walks Michael through the spec §6 capture session, one tools/capture recording per step, into
+// captures/<YYYY-MM-DD>-<label>/<nn>-<step>.jsonl with a README.md line per step. It only records: nothing is sent
+// to the One and ~/.rane-armed is not read. The steps and README rules live in tools/lib/capture-session.mjs.
+// Exit: 0 every step kept or skipped · 1 refused, input ended or a failure · 2 usage · 130 Ctrl-C
+// Spec: docs/plans/2026-10-19-M2-capture-replay.md, section "Capture session".
+import fs from "node:fs";
+import { join } from "node:path";
+import { spawn, execFileSync } from "node:child_process";
+import { createInterface } from "node:readline";
+import { fileURLToPath } from "node:url";
+import { setTimeout as sleep } from "node:timers/promises";
+import { parseAmidiList, findInputs } from "./lib/amidi.mjs";
+import { STEPS, BEFORE, LABEL, plural, formatList, localDate, stepLine, readmeHeader, parseReadme, formatReadme } from "./lib/capture-session.mjs";
+
+const USAGE = "usage: tools/capture-session [--label <label>] [--resume] [--port <name> | --device <path>] [--capture-cmd <cmd>] [--captures-dir <dir>]\n       tools/capture-session --list";
+const HELP = `${USAGE}
+Walks you through the spec §6 capture session, one recording per step, into captures/<YYYY-MM-DD>-<label>/:
+<nn>-<step>.jsonl per step (tools/capture's M2 JSONL) and README.md with one line per step and your note.
+  --label <label>      the session directory's label (default census; a-z, 0-9 and -)
+  --resume             continue an existing session at the first step with no README line
+  --list               print the §6 groups, the steps and their expected minutes, then exit
+  --port <name>        the MIDI input to record (default 'Rane ONE MIDI 1'), as \`amidi -l\` names it
+  --device <path>      record this rawmidi device or FIFO instead (tests, last resort)
+  --capture-cmd <cmd>  run this instead of tools/capture, with the same arguments (tests)
+  --captures-dir <dir> where session directories go (default: this checkout's captures/)
+Keys, each followed by Enter:
+  at a step:           Enter starts the recording, s skips the step (you are asked for a note)
+  while recording:     Enter stops it (timed steps also stop by themselves, with a bell)
+  after a recording:   Enter keeps the take, r re-records it; then a one-line note (an empty take needs k)
+  after a failure:     Enter tries again, s skips; k keeps what it recorded, as a partial take
+  Ctrl-C               stops: a recording in progress is kept unreviewed and --resume offers it for review
+Takes are recorded to <nn>-<step>.jsonl.part and renamed to .jsonl when kept.
+Only tools/capture runs (read-only): nothing is sent to the One, and ~/.rane-armed is not needed.
+Exit: 0 every step kept or skipped · 1 refused, input ended or a failure · 2 usage · 130 Ctrl-C
+`;
+
+const ROOT = fileURLToPath(new URL("..", import.meta.url));
+const CAPTURE = fileURLToPath(new URL("capture", import.meta.url));
+const PORT = "Rane ONE MIDI 1";
+const READY_MS = 2000; // a stop waits up to this long for the capture to have created its output
+// How long the power-on step waits for the port to go away after Enter, then as long again after asking to unplug
+// USB. CAPTURE_SESSION_VANISH_S shortens it for the tests.
+const VANISH_S = Number(process.env.CAPTURE_SESSION_VANISH_S) || 30;
+
+function usage(why) {
+  if (why) process.stderr.write(`capture-session: ${why}\n`);
+  process.stderr.write(USAGE + "\n");
+  process.exit(2);
+}
+const say = (msg) => process.stdout.write(msg + "\n");
+const fail = (msg, code = 1) => {
+  process.stderr.write(`capture-session: ${msg}\n`);
+  process.exit(code);
+};
+
+const args = process.argv.slice(2);
+if (args.length === 1 && args[0] === "--help") {
+  process.stdout.write(HELP);
+  process.exit(0);
+}
+const opt = {};
+for (let i = 0; i < args.length; i++) {
+  const a = args[i];
+  if (a === "--resume" || a === "--list") {
+    if (opt[a.slice(2)]) usage(`${a} given twice`);
+    opt[a.slice(2)] = true;
+  } else if (["--label", "--port", "--device", "--capture-cmd", "--captures-dir"].includes(a)) {
+    const key = a.slice(2);
+    if (key in opt) usage(`${a} given twice`);
+    const v = args[i + 1];
+    if (v === undefined || v === "" || v.startsWith("--")) usage(`${a} needs a value`);
+    opt[key] = args[++i];
+  } else usage(`unknown argument ${a}`);
+}
+if (opt.list) {
+  if (Object.keys(opt).length > 1) usage("--list takes no other option");
+  process.stdout.write(formatList());
+  process.exit(0);
+}
+if ("port" in opt && "device" in opt) usage("give at most one of --port and --device");
+const label = opt.label ?? "census";
+if (!LABEL.test(label)) usage(`--label must be lowercase letters, digits and -, starting with a letter or digit`);
+const port = opt.device === undefined ? opt.port ?? PORT : null;
+const captureCmd = opt["capture-cmd"] ?? CAPTURE;
+
+// Lines from stdin. A wait can be cancelled, so a line typed later stays queued for the next question.
+const lines = (() => {
+  const queue = [], waiters = [];
+  let ended = false;
+  const rl = createInterface({ input: process.stdin, terminal: false });
+  rl.on("line", (l) => (waiters.length ? waiters.shift()(l) : queue.push(l)));
+  rl.on("close", () => {
+    ended = true;
+    while (waiters.length) waiters.shift()(null);
+  });
+  return {
+    // { promise: the line, or null at the end of input; cancel() }
+    next() {
+      if (queue.length) return { promise: Promise.resolve(queue.shift()), cancel() {} };
+      if (ended) return { promise: Promise.resolve(null), cancel() {} };
+      let w;
+      const promise = new Promise((resolve) => (w = resolve));
+      waiters.push(w);
+      return { promise, cancel: () => waiters.includes(w) && waiters.splice(waiters.indexOf(w), 1) };
+    },
+    drain: () => void queue.splice(0),
+  };
+})();
+
+let current = null; // the step being worked on, for the input-ended message
+async function ask(question, answers) {
+  // At a terminal, keys pressed before the question was shown (an extra Enter after a timed step) are dropped, so
+  // they can't answer it unseen. Piped input (the tests) is a script: every line is meant.
+  if (process.stdin.isTTY) lines.drain();
+  for (;;) {
+    process.stdout.write(question + " ");
+    const line = await lines.next().promise;
+    if (line === null) {
+      process.stdout.write("\n");
+      fail(`input ended${current ? ` at ${current.file}` : ""}; continue with: tools/capture-session --label ${label} --resume`);
+    }
+    const a = line.trim();
+    if (answers === null || answers.includes(a)) return a;
+    say(`  (type ${answers.map((x) => x === "" ? "Enter" : x).join(" or ")})`);
+  }
+}
+
+function amidiPorts() {
+  try {
+    return parseAmidiList(execFileSync("amidi", ["-l"], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }));
+  } catch (err) {
+    process.stderr.write(`capture-session: amidi -l failed: ${String(err.message).trim()}\n`);
+    return [];
+  }
+}
+const portListed = () => findInputs(amidiPorts(), port).length > 0;
+
+function gitSha() {
+  try {
+    return execFileSync("git", ["-C", ROOT, "rev-parse", "--short", "HEAD"], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim();
+  } catch {
+    return "unknown";
+  }
+}
+
+// --- The session directory -------------------------------------------------------------------------------------
+const date = localDate(new Date());
+const root = opt["captures-dir"] ?? join(ROOT, "captures");
+let name = `${date}-${label}`;
+if (opt.resume && !fs.existsSync(join(root, name))) {
+  // A session started before midnight: resume the newest one with this label.
+  const older = (fs.existsSync(root) ? fs.readdirSync(root) : []).filter((f) => f.length === 11 + label.length
+    && /^\d{4}-\d\d-\d\d-/.test(f) && f.slice(11) === label).sort();
+  if (older.length) name = older.at(-1);
+}
+const dir = join(root, name);
+const readmePath = join(dir, "README.md");
+if (fs.existsSync(dir) && !opt.resume) fail(`${dir} exists; continue it with --resume, or pick another --label`);
+if (!fs.existsSync(dir) && opt.resume) fail(`no session at ${dir} (or an earlier date with label ${label}) to resume`);
+const resumeHint = () => `tools/capture-session --label ${label} --resume`;
+
+let interrupted = false;
+let recording = null; // { child, closed } while a capture runs
+process.on("SIGINT", () => {
+  interrupted = true;
+  if (!recording) {
+    process.stdout.write("\n");
+    fail(fs.existsSync(dir) ? `stopped; continue with: ${resumeHint()}` : "stopped; nothing was recorded", 130);
+  }
+  stopRecording(); // in a terminal the capture got the Ctrl-C too; its stop is idempotent
+});
+
+// SIGINT is tools/capture's clean stop, but one sent before its handlers are set up kills it outright, losing the
+// take. Its output file appearing shows they are, so a stop waits for that (or READY_MS: it may be waiting for
+// a port to appear).
+async function stopRecording() {
+  const r = recording;
+  if (!r) return;
+  while (!r.closed() && !fs.existsSync(r.out) && Date.now() - r.t0 < READY_MS) await sleep(20);
+  if (!r.closed()) r.child.kill("SIGINT");
+}
+process.on("exit", () => {
+  if (recording && recording.child.exitCode === null && recording.child.signalCode === null) recording.child.kill("SIGINT");
+});
+
+let header, done;
+const existing = opt.resume && fs.existsSync(readmePath) ? parseReadme(fs.readFileSync(readmePath, "utf8")) : null;
+if (existing) {
+  ({ header } = existing);
+  done = existing.lines;
+} else {
+  let source;
+  if (port === null) source = `Device: ${opt.device}`;
+  else {
+    const found = findInputs(amidiPorts(), port);
+    source = found.length ? `Port: ${port} = ${found.map((p) => p.hw).join(", ")}` : `Port: ${port} (not listed by amidi -l at the start)`;
+  }
+  say(BEFORE);
+  const setup = await ask("\nSetup note (Stop Time and torque switch positions, anything unusual), then Enter:", null);
+  header = readmeHeader({ name, date, sha: gitSha(), source, setup });
+  done = new Map();
+}
+fs.mkdirSync(dir, { recursive: true });
+const writeReadme = () => fs.writeFileSync(readmePath, formatReadme(header, done));
+writeReadme();
+say(`\nSession ${dir}`);
+
+// --- One recording -----------------------------------------------------------------------------------------------
+// Each take is recorded to <file>.part and renamed to <file> only when kept, so a rejected, failed or interrupted
+// take never replaces or removes a kept one; an interrupted take stays as .part and --resume offers it for review.
+const elapsed = (t0) => (Date.now() - t0) / 1000;
+const partOf = (step) => join(dir, `${step.file}.part`);
+const countLines = (path) => fs.existsSync(path) ? fs.readFileSync(path, "utf8").split("\n").filter(Boolean).length : 0;
+
+// Runs one capture into the step's .part file; resolves with { code, signal, seconds, dropped } once it has closed.
+async function record(step, extraArgs) {
+  const out = partOf(step);
+  const capArgs = [...(port === null ? ["--device", opt.device] : ["--port", port]), "--out", out, ...extraArgs];
+  if (step.seconds) capArgs.push("--seconds", String(step.seconds));
+  // The previous attempt's .part goes first: the new capture's output appearing then shows it is running, with its
+  // stop handlers installed (tools/capture sets them up before it creates the file).
+  fs.rmSync(out, { force: true });
+  const t0 = Date.now();
+  // stdin ignored: the session owns the keyboard. Same process group, so a terminal Ctrl-C reaches it too.
+  const child = spawn(captureCmd, capArgs, { stdio: ["ignore", "ignore", "pipe"] });
+  let stderr = "";
+  child.stderr.on("data", (d) => {
+    stderr += d;
+    process.stderr.write(d);
+  });
+  let hasClosed = false;
+  const result = new Promise((resolve) => {
+    child.on("error", (err) => resolve({ code: null, error: err }));
+    child.on("close", (code, signal) => resolve({ code, signal }));
+  }).finally(() => (hasClosed = true));
+  recording = { child, out, t0, closed: () => hasClosed };
+  const timers = (step.bells ?? []).map(([at, what]) => setTimeout(() => say(`\x07  ${at} s: ${what}`), at * 1000));
+  const tick = process.stdout.isTTY ? setInterval(() => process.stdout.write(`\r  ${elapsed(t0).toFixed(0)} s `), 1000) : null;
+  if (extraArgs.includes("--wait")) say(`  RECORDING ${step.file}: waiting up to 60 s for the port, then recording ${step.seconds} s from when it appears. Don't press Enter: it cancels.`);
+  else if (step.seconds) say(`  RECORDING ${step.file}: stops by itself after ${step.seconds} s (Enter stops it early)`);
+  else say(`  RECORDING ${step.file}: Enter stops it`);
+
+  const stop = lines.next();
+  const first = await Promise.race([result.then(() => "closed"), stop.promise.then(() => "line")]);
+  const stopped = first === "line";
+  if (stopped) await stopRecording();
+  else stop.cancel();
+  const { code, signal, error } = await result;
+  timers.forEach(clearTimeout);
+  if (tick) {
+    clearInterval(tick);
+    process.stdout.write("\n");
+  }
+  recording = null;
+  if (error) fail(`cannot run ${captureCmd}: ${error.message}`);
+  if (interrupted) fail(`stopped; the take is kept unreviewed as ${out} and --resume offers it: ${resumeHint()}`, 130);
+  if (!stopped && code === 0 && step.seconds) say("\x07  time's up");
+  // capture's summary line: "stopped: 1532 messages (cc 1500, pb 32), dropped 0, 31.2 s"
+  const m = /(\d+) messages \(.*\), dropped (\d+), ([\d.]+) s\s*$/.exec(stderr);
+  return { code, signal, stopped, seconds: m ? Number(m[3]) : elapsed(t0), dropped: m ? Number(m[2]) : 0 };
+}
+
+// Waits up to s seconds for the port to leave `amidi -l`; true once it has.
+async function vanished(s) {
+  const deadline = Date.now() + s * 1000;
+  while (portListed()) {
+    if (Date.now() >= deadline) return false;
+    await sleep(250);
+  }
+  return true;
+}
+
+// The power-on step: the port has to be gone before recording starts, so the recording catches it appearing.
+// Resolves with { args, remark } for the capture, or { fail } when the port never went away.
+async function powerOn() {
+  if (port === null) {
+    say("  RECORDING: power on now");
+    return { args: [], remark: "" };
+  }
+  let remark = "";
+  if (portListed()) {
+    say("  still there: is it off? Wait for RECORDING before powering on");
+    if (!(await vanished(VANISH_S))) {
+      say(`  The port is still listed after ${VANISH_S} s: the One may be in a standby that keeps USB alive.`);
+      say("  Leave it off and unplug its USB cable; plug it back in when RECORDING shows.");
+      if (!(await vanished(VANISH_S))) return { fail: `the port never went away (${2 * VANISH_S} s)` };
+      remark = `port stayed listed ${VANISH_S} s after power-off`;
+    }
+  }
+  say(`  RECORDING: power on now${remark ? " (or plug the USB cable back in)" : ""}`);
+  return { args: ["--wait", "60"], remark };
+}
+
+function why(step, r) {
+  if (r.code === 4) return "the One's MIDI port isn't there: is it powered on, and is its USB cable plugged in?";
+  if (r.code === 5) return "the port is busy: close Mixxx (and Serato, aseqdump or arecordmidi), then try again";
+  if (r.stopped) return "it was stopped before it got going (see capture's message above)";
+  if (step.powerOn) return "see capture's message above: the port didn't appear within 60 s, or a USB re-enumeration cut the recording";
+  return "see capture's message above";
+}
+
+async function runStep(step) {
+  current = step;
+  const part = partOf(step);
+  const header = `\n[${step.nn}/${STEPS.length}] ${step.file} · §6.${step.group} ${step.title}${step.extra ? " (optional extra)" : ""} · about ${step.minutes} min`;
+  say(header);
+  say(`  ${step.prompt}`);
+  let take = null; // { messages, seconds, dropped, remark } once there is one to review
+  let a;
+  const before = countLines(part);
+  if (before > 0) {
+    // Last recorded in an interrupted run: its duration is up to its last message.
+    const last = JSON.parse(fs.readFileSync(part, "utf8").trimEnd().split("\n").at(-1)).t_us;
+    say(`  There is an unreviewed take from before: ${plural(before, "message")}.`);
+    take = { messages: before, seconds: last / 1e6, dropped: 0, remark: "unreviewed take from an interrupted run" };
+  } else a = await ask("  Enter starts the recording, s skips:", ["", "s"]);
+  for (;;) {
+    if (!take) {
+      if (a === "s") {
+        const note = await ask("  Note for the README (Enter for none):", null);
+        fs.rmSync(part, { force: true });
+        done.set(step.file, stepLine(step, { skipped: true, note }));
+        return writeReadme();
+      }
+      const p = step.powerOn ? await powerOn() : { args: [], remark: "" };
+      if (p.fail) {
+        say(`  ${p.fail}`);
+        a = await ask("  Enter tries again, s skips this step:", ["", "s"]);
+        continue;
+      }
+      const r = await record(step, p.args);
+      const got = countLines(part);
+      if (r.code !== 0) {
+        say(`  The capture failed (${r.code === null ? `killed by ${r.signal}` : `exit ${r.code}`}): ${why(step, r)}`);
+        if (r.code === 2) fail("capture refused its arguments; this is a bug in capture-session");
+        if (got > 0) {
+          a = await ask(`  Enter tries again, k keeps the partial take (${plural(got, "message")}), s skips this step:`, ["", "k", "s"]);
+          if (a !== "k") continue;
+          take = { partial: true, messages: got, seconds: r.seconds, dropped: r.dropped, remark: [p.remark, `partial: capture exit ${r.code ?? r.signal}`].filter(Boolean).join("; ") };
+        } else {
+          a = await ask("  Enter tries again, s skips this step:", ["", "s"]);
+          continue;
+        }
+      } else take = { messages: got, seconds: r.seconds, dropped: r.dropped, remark: p.remark };
+    }
+    let keep = "k"; // a partial take kept with k is not asked again
+    if (!take.partial) {
+      say(`  ${plural(take.messages, "message")} in ${take.seconds.toFixed(1)} s${take.messages ? "" : ": nothing came in. Is the One on?"}`);
+      keep = take.messages
+        ? await ask("  Enter keeps the take, r re-records it:", ["", "r"])
+        : await ask("  k keeps it anyway, r re-records it:", ["k", "r"]);
+    }
+    if (keep === "r") {
+      take = null;
+      say(`  ${step.prompt}`);
+      a = await ask("  Enter starts the recording again, s skips:", ["", "s"]);
+      continue;
+    }
+    const note = await ask("  Note for the README (Enter for none):", null);
+    fs.renameSync(part, join(dir, step.file));
+    const { messages, seconds, dropped, remark } = take;
+    done.set(step.file, stepLine(step, { messages, seconds, dropped, remark, note }));
+    return writeReadme();
+  }
+}
+
+let announcedExtras = false;
+for (const step of STEPS) {
+  if (done.has(step.file)) continue;
+  if (step.extra && !announcedExtras) {
+    announcedExtras = true;
+    say("\nThe 7 groups of spec §6 are done. What follows are optional extras: s skips each one.");
+  }
+  await runStep(step);
+}
+current = null;
+const skipped = [...done.values()].filter((l) => / · skipped · /.test(l)).length;
+say(`\nDone: ${done.size} steps in ${readmePath} (${skipped} skipped). Commit with:`);
+say(`  git add ${opt["captures-dir"] === undefined ? join("captures", name) : dir} && git commit -m "captures: ${name} (capture session, ${done.size} steps, ${skipped} skipped)"`);
+process.exit(0);
diff --git a/tools/census b/tools/census
new file mode 100755
index 0000000..5dda81c
--- /dev/null
+++ b/tools/census
@@ -0,0 +1,145 @@
+#!/usr/bin/env node
+// Census of M2 JSONL captures: one CSV row per control (the MK1 MIDI map), or with --diff, how those rows line up
+// with the MK2 djay map (a hint, D6: nothing moves from the MK2 map into the MK1 file).
+// SysEx and system messages get no row; they are counted on stderr (SysEx by its first 4 payload bytes).
+// Exit: 0 written · 1 bad input or I/O failure · 2 usage
+// Spec: docs/plans/2026-10-19-M2-capture-replay.md, section "Census"; the rules live in tools/lib/census.mjs.
+import { readFileSync, writeFileSync } from "node:fs";
+import { relative, resolve, isAbsolute } from "node:path";
+import { fileURLToPath } from "node:url";
+import { readJsonl } from "./lib/jsonl.mjs";
+import { census, formatCsv, parseCsv, readMk2, readCensusCsv, diffCensus, HEADER, DIFF_HEADER } from "./lib/census.mjs";
+
+const USAGE = [
+  "usage: tools/census <file.jsonl>… [--out <file.csv> [--force]] [--shift <ch>:<note>] [--comment <text>]",
+  "       tools/census --diff <mk2-map.csv> [<file.jsonl>…]",
+].join("\n");
+const HELP = `${USAGE}
+Writes one CSV row per control seen in the captures (columns: ${HEADER.join(",")}).
+  --out <file.csv>     write there instead of stdout; refused if it exists, unless --force
+  --shift <ch>:<note>  fill the shift column: true/false/both by whether that note (channel 1..16) was held;
+                       the MK2 map's Shift is --shift 16:50 (UNVERIFIED for the MK1)
+  --comment <text>     an extra "# <text>" line after the first comment line
+  --diff <mk2.csv>     print instead, as CSV on stdout: ${DIFF_HEADER.join(",")}
+                       (diff is only-mk1, only-mk2 or both; MK2 channels are 0-based, shown here 1-based);
+                       with no capture file, the MK1 side is reference/rane-one-mk1-midi-map.csv
+Exit: 0 written · 1 bad input or I/O failure · 2 usage
+`;
+
+const ROOT = fileURLToPath(new URL("..", import.meta.url));
+
+function usage(why) {
+  if (why) process.stderr.write(`census: ${why}\n`);
+  process.stderr.write(USAGE + "\n");
+  process.exit(2);
+}
+const fail = (msg) => {
+  process.stderr.write(`census: ${msg}\n`);
+  process.exit(1);
+};
+
+const args = process.argv.slice(2);
+if (args.length === 1 && args[0] === "--help") {
+  process.stdout.write(HELP);
+  process.exit(0);
+}
+const inputs = [];
+const opt = {};
+for (let i = 0; i < args.length; i++) {
+  const a = args[i];
+  if (a === "--force") opt.force = true;
+  else if (["--out", "--shift", "--comment", "--diff"].includes(a)) {
+    const key = a.slice(2);
+    if (key in opt) usage(`${a} given twice`);
+    const v = args[i + 1];
+    if (v === undefined || v === "" || v.startsWith("--")) usage(`${a} needs a value`);
+    opt[key] = args[++i];
+  } else if (a.startsWith("-")) usage(`unknown option ${a}`);
+  else inputs.push(a);
+}
+if (!inputs.length && !("diff" in opt)) usage("no capture file given");
+if (opt.force && !("out" in opt)) usage("--force needs --out");
+if ("diff" in opt && ["out", "force", "shift", "comment"].some((k) => k in opt)) usage("--diff prints to stdout and takes only capture files");
+if (/[\r\n]/.test(opt.comment ?? "")) usage("--comment must be one line (no line break)");
+const seen = new Set();
+for (const f of inputs) {
+  if (seen.has(resolve(f))) usage(`${f} given twice`);
+  seen.add(resolve(f));
+}
+let shift = null;
+if ("shift" in opt) {
+  const m = /^(\d+):(\d+)$/.exec(opt.shift);
+  if (!m || +m[1] < 1 || +m[1] > 16 || +m[2] > 127) usage("--shift is <channel 1..16>:<note 0..127>");
+  shift = { ch: +m[1], note: +m[2] };
+}
+
+// Repo-relative name for source_file; a file outside the repo keeps its absolute path.
+const name = (f) => {
+  const rel = relative(ROOT, resolve(f));
+  return rel.startsWith("..") || isAbsolute(rel) ? resolve(f) : rel;
+};
+
+const sources = [];
+let total = 0, system = 0;
+const sysex = new Map();
+try {
+  for (const f of inputs) {
+    const records = readJsonl(f);
+    sources.push({ file: name(f), records });
+    total += records.length;
+    for (const r of records) {
+      if (r.type === "sysex") {
+        const head = r.bytes.slice(2, 10);
+        sysex.set(head, (sysex.get(head) ?? 0) + 1);
+      } else if (r.ch === null) system++;
+    }
+  }
+} catch (err) {
+  fail(err.message);
+}
+const MK1 = "reference/rane-one-mk1-midi-map.csv";
+let rows;
+if (inputs.length) rows = census(sources, { shift, log: (text) => process.stderr.write(`census: ${text}\n`) });
+else {
+  try {
+    rows = readCensusCsv(readFileSync(new URL(`../${MK1}`, import.meta.url), "utf8"));
+  } catch (err) {
+    fail(`${MK1}: ${err.message}`);
+  }
+}
+const nSysex = [...sysex.values()].reduce((a, b) => a + b, 0);
+const heads = [...sysex].map(([h, n]) => `${h || "(empty)"} ×${n}`).join(", ");
+const counts = !inputs.length ? `${MK1}: ${rows.length} rows` : `${total} messages from ${inputs.length} file(s), ${rows.length} rows; SysEx ${nSysex}${nSysex ? ` (first payload bytes: ${heads})` : ""}, system ${system}`;
+
+if ("diff" in opt) {
+  let mk2;
+  try {
+    mk2 = readMk2(parseCsv(readFileSync(opt.diff, "utf8")));
+  } catch (err) {
+    fail(`${opt.diff}: ${err.message}`);
+  }
+  const lines = diffCensus(rows, mk2);
+  process.stdout.write(formatCsv(DIFF_HEADER, lines));
+  const n = (k) => lines.filter((d) => d.diff === k).length;
+  process.stderr.write(`census: ${counts}; diff: both ${n("both")}, only-mk1 ${n("only-mk1")}, only-mk2 ${n("only-mk2")}\n`);
+  process.exit(0);
+}
+
+// Shell-quoted where needed; a line break in a file name is shown as \n so the comment stays one line.
+const shown = args.map((a) => (/^[\w./:@%+=-]+$/.test(a) ? a : `'${a.replace(/'/g, "'\\''")}'`).replace(/\r?\n|\r/g, "\\n")).join(" ");
+const d = new Date();
+const date = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
+const comments = [`rane-one-mk1-midi-map · tools/census ${shown} · ${date}`];
+if ("comment" in opt) comments.push(opt.comment);
+const csv = formatCsv(HEADER, rows, comments);
+if ("out" in opt) {
+  try {
+    writeFileSync(opt.out, csv, { flag: opt.force ? "w" : "wx" });
+  } catch (err) {
+    fail(err.code === "EEXIST" ? `${opt.out} exists; use --force to overwrite` : `writing ${opt.out}: ${err.message}`);
+  }
+  process.stderr.write(`census: wrote ${opt.out}: ${counts}\n`);
+} else {
+  process.stdout.write(csv);
+  process.stderr.write(`census: ${counts}\n`);
+}
diff --git a/tools/lib/amidi.mjs b/tools/lib/amidi.mjs
new file mode 100644
index 0000000..c6c6345
--- /dev/null
+++ b/tools/lib/amidi.mjs
@@ -0,0 +1,14 @@
+// Reads `amidi -l` listings. Rows look like "IO  hw:2,0,0  Rane ONE MIDI 1": direction, device, then the name
+// (everything after the device column). Card numbers change on replug, so ports are always found by name.
+
+export function parseAmidiList(stdout) {
+  const ports = [];
+  for (const line of stdout.split("\n").slice(1)) {
+    const m = /^\s*(\S+)\s+hw:(\d+),(\d+)(?:,(\d+))?\s+(.*?)\s*$/.exec(line);
+    if (m) ports.push({ dir: m[1], hw: `hw:${m[2]},${m[3]}${m[4] === undefined ? "" : `,${m[4]}`}`, card: m[2], dev: m[3], sub: m[4], name: m[5] });
+  }
+  return ports;
+}
+
+// Input ports (direction I or IO) with exactly this name.
+export const findInputs = (ports, name) => ports.filter((p) => p.name === name && p.dir.includes("I"));
diff --git a/tools/lib/capture-session.mjs b/tools/lib/capture-session.mjs
new file mode 100644
index 0000000..156af87
--- /dev/null
+++ b/tools/lib/capture-session.mjs
@@ -0,0 +1,190 @@
+// The spec §6 capture session as data, plus the README rules: what tools/capture-session asks for, in what order,
+// how long each recording is expected to take, and how a step's README line looks. Pure: no I/O.
+// Plan: docs/plans/2026-10-19-M2-capture-replay.md, section "Capture session" (D15, D17).
+
+export const GROUPS = [
+  { n: 1, title: "Power-on dump" },
+  { n: 2, title: "Census" },
+  { n: 3, title: "Platter, motor off, by hand" },
+  { n: 4, title: "Platter, motor on" },
+  { n: 5, title: "Pitch fader with the motor on" },
+  { n: 6, title: "Shift+Slip and the motor" },
+  { n: 7, title: "Strip search / needle drop" },
+];
+
+// The known position the session starts from (spec §6: "write it down in the prompt").
+export const BEFORE = `Before you start (spec §6):
+  - a tape mark on each platter's edge and one on the chassis next to it
+  - motor off on both decks, both platters standing still
+  - channel faders down, crossfader centre; EQ, gain and filter knobs at 12 o'clock
+  - pitch faders at centre (the detent), 33 selected; source selectors on USB
+  - Mixxx, Serato and anything else using the One closed
+Nothing is sent to the One: this only records what it sends.`;
+
+// Deck 1's hand and motor prompts, reused for deck 2.
+const HAND = {
+  slow: ["Platter by hand, slow turns", 0.5, "Deck 1, motor off. Before pressing Enter, align the platter's tape mark with the chassis mark. Then turn the platter slowly one full turn forward, mark to mark (about 5 s), pause, then one full turn backward to the mark. Enter when done."],
+  fast: ["Platter by hand, fast turns", 0.25, "Deck 1, motor off. Before pressing Enter, align the platter's tape mark with the chassis mark. Then one fast full turn forward, mark to mark, and one fast full turn backward. Enter when done."],
+  ten: ["Platter by hand, ten turns", 0.75, "Deck 1, motor off. Before pressing Enter, align the platter's tape mark with the chassis mark. Then turn forward ten full turns, counting each one mark to mark, and stop exactly on the mark after the tenth. Enter when done."],
+  touch: ["Platter top, touch and release", 0.25, "Deck 1, motor off. Touch the platter top and lift your hand five times, without turning it. Enter when done."],
+  alt: ["Platter in other jog modes", 0.5, "Deck 1, motor off. Hold Shift and turn the platter a little each way; then any jog-mode button the deck has, turn a little each way, and set it back. Enter when done."],
+};
+const MOTOR = {
+  33: ["Motor on at 33", 1.25, "Deck 1 at 33. Press Enter to start recording, then press Play to start the motor, then hands off. Stops by itself after 65 s.", { seconds: 65 }],
+  45: ["Motor on, 33 to 45 and back", 1.4, "Deck 1, motor running at 33. Press Enter; when the bell rings at 5 s, switch to 45 and keep hands off; when it rings at 65 s, switch back to 33. Stops by itself at 75 s, so both switches are in this file. Leave the motor running.",
+    { seconds: 75, bells: [[5, "switch to 45 now"], [65, "switch back to 33 now"]] }],
+  hold: ["Motor on, record held still", 0.3, "Deck 1: if the motor isn't running at 33, press Play and wait 5 s. Then press Enter, hold the record still for 5 s while the platter spins underneath, release and wait 5 s. Enter when done."],
+  backspin: ["Motor on, backspin", 0.3, "Deck 1, motor running at 33: one backspin; let the record run back up to speed and wait 5 s. Enter when done."],
+  "stop-min": ["Motor stop, Stop Time at minimum", 0.35, "Deck 1, motor running. Press Enter, then turn the Stop Time knob to minimum, wait 2 s, press Play to stop the motor and wait until the platter stands still. Enter when done."],
+  "stop-max": ["Motor stop, Stop Time at maximum", 0.5, "Deck 1, motor stopped. Press Enter, then press Play to start the motor, turn Stop Time to maximum, wait 5 s, press Play to stop it and wait until it stands still. Then set Stop Time back to its position in your setup note. Enter when done."],
+};
+const deck = (text, d) => d === 1 ? text : text.replaceAll("Deck 1", "Deck 2").replaceAll("deck 1", "deck 2");
+const hand = (key, d, extra = false) => {
+  const [title, minutes, prompt] = HAND[key];
+  return { slug: `hand-d${d}-${key}`, group: 3, title: `${title}, deck ${d}`, minutes, prompt: deck(prompt, d), extra };
+};
+const motor = (key, d, extra = false) => {
+  const [title, minutes, prompt, timing = {}] = MOTOR[key];
+  return { slug: `motor-d${d}-${key}`, group: 4, title: `${title}, deck ${d}`, minutes, prompt: deck(prompt, d), extra, ...timing };
+};
+const pads = (d) => ({
+  slug: `census-d${d}-pads`, group: 2, title: `Census, deck ${d} pads`, minutes: 1.4,
+  prompt: `Deck ${d} pads: for each pad-mode button in turn (with and without Shift, if Shift selects other modes), press it, then press and release each pad once. Then, in the first pad mode only, each pad once more with Shift held. Enter when done.`,
+});
+const padsShift = (d) => ({
+  slug: `census-d${d}-pads-shift`, group: 2, title: `Census, deck ${d} pads with Shift in the other modes`, minutes: 1.1, extra: true,
+  prompt: `Extra. Deck ${d} pads with Shift: for every pad mode except the first, select it, then press and release each pad once with Shift held. Enter when done.`,
+});
+const pitch = (d) => ({
+  slug: `pitch-d${d}`, group: 5, title: `Pitch fader, deck ${d}`, minutes: 0.6,
+  prompt: `Deck ${d}${d === 1 ? " (stop deck 2's motor first if it still runs)" : ""}: press Play to start the motor at 33, wait 5 s, move the pitch fader slowly to one end, then to the other end, then back to centre (about 20 s in all), wait 5 s, press Play to stop. Note whether you saw the platter speed change. Enter when done.`,
+});
+
+// In the order performed. Durations (minutes) include reading the prompt. The census times are estimates
+// (pads: 8 modes × 8 pads at ≈ 1 s a press; buttons ≈ 1.7 s for press, hold 1 s, release). D17 *default* moves
+// some recordings to optional extras at the end so the main session is under 25 min.
+const ORDER = [
+  {
+    slug: "power-on", group: 1, title: "Power-on dump", minutes: 1.0, seconds: 10, powerOn: true,
+    prompt: "Power the One OFF now (rear power switch). When it is off, press Enter, then power it ON as soon as the screen says `RECORDING: power on now`. Recording stops by itself 10 s after its MIDI port appears.",
+  },
+  {
+    slug: "census-mixer", group: 2, title: "Census, mixer and FX", minutes: 2.5,
+    prompt: "Mixer and FX (centre): every button: press, hold 1 s, release; then each again while holding Shift. Every fader and knob slowly from one end to the other and back: crossfader, channel faders, EQs, filters, gains, FX knobs, cue/headphone and master knobs. Enter when done.",
+  },
+  {
+    slug: "census-d1-controls", group: 2, title: "Census, deck 1 controls", minutes: 2.5,
+    prompt: "Deck 1 (left): every button: press, hold 1 s, release, then again with Shift held, including the deck switch / layer buttons. Pitch fader and every deck knob end to end slowly. Don't touch the platter. Enter when done.",
+  },
+  pads(1),
+  {
+    slug: "census-d2-controls", group: 2, title: "Census, deck 2 controls", minutes: 2.5,
+    prompt: "Deck 2 (right): same as deck 1: every button: press, hold 1 s, release, then again with Shift held, including the deck switch / layer buttons. Pitch fader and every deck knob end to end slowly. Don't touch the platter. Enter when done.",
+  },
+  pads(2),
+  hand("slow", 1), hand("fast", 1), hand("ten", 1), hand("touch", 1), hand("alt", 1),
+  hand("slow", 2), hand("ten", 2), hand("touch", 2),
+  motor(33, 1), motor(45, 1), motor("hold", 1), motor("backspin", 1), motor("stop-min", 1), motor("stop-max", 1),
+  motor(33, 2), motor(45, 2),
+  pitch(1), pitch(2),
+  {
+    slug: "motor-toggle", group: 6, title: "Shift+Slip motor toggle and torque switch", minutes: 1.0,
+    prompt: "Deck 1: press Shift+Slip, wait 5 s, Shift+Slip again, wait 5 s. Deck 2: the same. Then press Play on deck 1 to start its motor, flip the rear torque switch to the other position and back, and press Play to stop the motor. Note anything the platter did. Enter when done.",
+  },
+  {
+    slug: "strip", group: 7, title: "Strip search", minutes: 0.75,
+    prompt: "If the One has a strip search / needle drop (press s to skip if not): on each deck touch it at the left end, the middle and the right end, 1 s each, then slide along it once. Enter when done.",
+  },
+  // Optional extras (D17 *default*): offered after §6.7, each skippable with s.
+  padsShift(1), padsShift(2),
+  hand("fast", 2, true), hand("alt", 2, true),
+  motor("hold", 2, true), motor("backspin", 2, true), motor("stop-min", 2, true), motor("stop-max", 2, true),
+];
+
+export const STEPS = ORDER.map((s, i) => {
+  const nn = String(i + 1).padStart(2, "0");
+  return { extra: false, ...s, nn, file: `${nn}-${s.slug}.jsonl` };
+});
+
+const round2 = (x) => Math.round(x * 100) / 100;
+const sum = (steps) => round2(steps.reduce((a, s) => a + s.minutes, 0));
+
+export function totals() {
+  const main = STEPS.filter((s) => !s.extra), extras = STEPS.filter((s) => s.extra);
+  return {
+    groups: GROUPS.map((g) => {
+      const steps = main.filter((s) => s.group === g.n);
+      return { ...g, count: steps.length, minutes: sum(steps) };
+    }),
+    main: sum(main), mainCount: main.length, extras: sum(extras), extraCount: extras.length,
+  };
+}
+
+export const plural = (n, word) => `${n} ${word}${n === 1 ? "" : "s"}`;
+
+export function formatList() {
+  const t = totals();
+  const out = [`Capture session: spec §6 in 7 groups, ${plural(t.mainCount, "recording")}, then ${plural(t.extraCount, "optional extra")}.`, ""];
+  for (const g of t.groups) out.push(`§6.${g.n} ${g.title}`.padEnd(42) + plural(g.count, "recording").padEnd(14) + `${g.minutes.toFixed(2).padStart(5)} min`);
+  out.push(`Total (7 groups)`.padEnd(56) + `${t.main.toFixed(2).padStart(5)} min, plus about 5 min of setup`);
+  out.push("", `Optional extras (offered after §6.7; s skips each): ${plural(t.extraCount, "recording")}, ${t.extras.toFixed(2)} min`);
+  out.push("", "Recordings:");
+  for (const s of STEPS) out.push(`  ${s.file.padEnd(34)} §6.${s.group}${s.extra ? " extra" : "      "}  ${s.minutes.toFixed(2)} min${s.seconds ? `  (stops by itself after ${s.seconds} s)` : ""}`);
+  return out.join("\n") + "\n";
+}
+
+// YYYY-MM-DD in local time (the session directory's date).
+export const localDate = (d) =>
+  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
+
+export const LABEL = /^[a-z0-9][a-z0-9-]*$/;
+
+const oneLine = (text) => text.replace(/\s+/g, " ").trim();
+
+// One README line per step, written when the step is kept or skipped.
+export function stepLine(step, { skipped = false, messages = 0, seconds = 0, dropped = 0, remark = "", note = "" }) {
+  const parts = [`\`${step.file}\``, `§6.${step.group} ${step.title}${step.extra ? " (extra)" : ""}`];
+  if (skipped) parts.push("skipped");
+  else parts.push(`${plural(messages, "message")}, ${seconds.toFixed(1)} s${dropped ? `, dropped ${dropped}` : ""}`);
+  if (remark) parts.push(oneLine(remark));
+  parts.push(`note: ${oneLine(note) || "-"}`);
+  return `- ${parts.join(" · ")}`;
+}
+
+export function readmeHeader({ name, date, sha, source, setup }) {
+  return [
+    `# Capture session ${name}`,
+    "",
+    "Recorded with `tools/capture-session` (spec §6; docs/plans/2026-10-19-M2-capture-replay.md). Nothing was sent to the One.",
+    "",
+    `- Date: ${date}`,
+    `- Tool: tools/capture-session at ${sha}`,
+    `- ${source}`,
+    `- Setup: ${oneLine(setup) || "-"}`,
+  ].join("\n");
+}
+
+const STEP_LINE = /^- `(\d\d-[a-z0-9-]+\.jsonl)` · /;
+const STEPS_HEADING = "## Steps";
+
+// Splits a README into its header (everything before "## Steps") and its step lines by file name.
+export function parseReadme(text) {
+  const at = text.indexOf(`\n${STEPS_HEADING}\n`);
+  const header = (at < 0 ? text : text.slice(0, at)).trimEnd();
+  const lines = new Map();
+  if (at >= 0) {
+    for (const line of text.slice(at).split("\n")) {
+      const m = STEP_LINE.exec(line);
+      if (m) lines.set(m[1], line);
+    }
+  }
+  return { header, lines };
+}
+
+// The README with its step lines in session order; lines for files not in STEPS (an older numbering) follow.
+export function formatReadme(header, lines) {
+  const known = new Set(STEPS.map((s) => s.file));
+  const ordered = [...STEPS.filter((s) => lines.has(s.file)).map((s) => lines.get(s.file)),
+    ...[...lines].filter(([file]) => !known.has(file)).map(([, line]) => line)];
+  return `${header}\n\n${STEPS_HEADING}\n\n${ordered.length ? ordered.join("\n") + "\n" : ""}`;
+}
diff --git a/tools/lib/census.mjs b/tools/lib/census.mjs
new file mode 100644
index 0000000..97fcc93
--- /dev/null
+++ b/tools/lib/census.mjs
@@ -0,0 +1,257 @@
+// The census: M2 JSONL records → one row per control (the MK1 MIDI map CSV), and its diff against the MK2 djay map.
+// Pure: records in, rows out; tools/census does the files.
+// Spec: docs/plans/2026-10-19-M2-capture-replay.md, section "Census".
+
+export const HEADER = ["control", "status", "channel", "number", "min", "max", "sends_on_release",
+  "pair_14bit_msb", "pair_14bit_lsb", "shift", "source_file"];
+export const DIFF_HEADER = ["diff", "status", "channel", "number", "mk1_control", "mk2_section", "mk2_keypaths", "same_kind"];
+export const MK2_HEADER = ["section", "djay_keyPath", "channel", "data", "msgType", "extra"];
+
+// Kind of a channel message: status nibble (hex, no channel), label, whether it has a number.
+const KIND = {
+  on: ["90", "note", true], off: ["90", "note", true], pat: ["A0", "pat", true], cc: ["B0", "cc", true],
+  pc: ["C0", "pc", false], cp: ["D0", "cp", false], pb: ["E0", "pb", false],
+};
+const MK2_STATUS = { 1: "90", 3: "B0", 0: null }; // msgType 0: djay's "Unknowns", kind not known
+const PAIR_SHARE = 0.9; // of the rarer CC's messages that must sit next to the other one
+
+const isRelease = (r) => r.type === "off" || (r.type === "on" && r.value === 0);
+
+// Sort key shared by the census and the diff: channel, then number (empty first), then status.
+function byPlace(a, b) {
+  return a.channel - b.channel || (a.number ?? -1) - (b.number ?? -1) || (a.status < b.status ? -1 : a.status > b.status ? 1 : 0);
+}
+
+// Finds the 14-bit pairs of one channel's message stream (one file): CC n (0–31) and CC n+32 count as a pair when
+// ≥ 90 % of the rarer one's messages sit directly next to one of the other on that channel (on a tie, of each).
+// Returns, per pair MSB number, { lsb, counts, adjacent, values }. The values msb << 7 | lsb follow the stream's
+// order: MSB first, unless LSB→MSB neighbours outnumber MSB→LSB ones. In MSB-first order each LSB completes a value
+// with the last MSB (so LSB-only updates count), in LSB-first order each MSB with the last LSB; a half that comes
+// before any of the other completes nothing (a capture opening mid-pair).
+function findPairs(stream) {
+  const count = new Map();
+  for (const r of stream) if (r.type === "cc") count.set(r.d1, (count.get(r.d1) ?? 0) + 1);
+  const is = (r, n) => r?.type === "cc" && r.d1 === n;
+  const pairs = new Map();
+  for (const [msb, nMsb] of count) {
+    const lsb = msb + 32;
+    if (msb > 31 || !count.has(lsb)) continue;
+    const nLsb = count.get(lsb);
+    const rarer = nMsb === nLsb ? [msb, lsb] : [nMsb < nLsb ? msb : lsb];
+    const adjacent = (n) => {
+      const other = n === msb ? lsb : msb;
+      return stream.filter((r, i) => is(r, n) && (is(stream[i - 1], other) || is(stream[i + 1], other))).length;
+    };
+    if (!rarer.every((n) => adjacent(n) >= PAIR_SHARE * count.get(n))) continue;
+    let msbFirst = 0, lsbFirst = 0;
+    for (let i = 1; i < stream.length; i++) {
+      if (is(stream[i - 1], msb) && is(stream[i], lsb)) msbFirst++;
+      if (is(stream[i - 1], lsb) && is(stream[i], msb)) lsbFirst++;
+    }
+    const [lead, last] = lsbFirst > msbFirst ? [lsb, msb] : [msb, lsb];
+    const values = [];
+    let held = null;
+    for (const r of stream) {
+      if (is(r, lead)) held = r.value;
+      else if (is(r, last) && held !== null) values.push(lead === msb ? (held << 7) | r.value : (r.value << 7) | held);
+    }
+    pairs.set(msb, { lsb, counts: [nMsb, nLsb], rarer: rarer[0], adjacent: adjacent(rarer[0]), values });
+  }
+  return pairs;
+}
+
+// sources: [{ file, records }] with records in time order. opts.shift: { ch, note } (1-based channel); the Shift
+// note counts as up at the start of each file. opts.log(text) hears each 14-bit pair decision.
+// → rows sorted by channel, number (empty first), status; numbers are numbers, empty cells null.
+export function census(sources, { shift = null, log = () => {} } = {}) {
+  const groups = new Map();
+  const group = (key, init) => {
+    if (!groups.has(key)) groups.set(key, { ...init, values: [], runs: new Map(), files: new Set(), held: new Set(), releases: 0 });
+    return groups.get(key);
+  };
+  for (const { file, records } of sources) {
+    const channels = new Map();
+    for (const r of records) {
+      if (r.ch === null) continue; // SysEx and system messages: no row
+      if (!channels.has(r.ch)) channels.set(r.ch, []);
+      channels.get(r.ch).push(r);
+    }
+    // Shift state before each message, in file order.
+    const held = new Map();
+    if (shift) {
+      let down = false;
+      for (const r of records) {
+        held.set(r, down);
+        if ((r.type === "on" || r.type === "off") && r.ch === shift.ch && r.d1 === shift.note) down = !isRelease(r);
+      }
+    }
+    for (const [ch, stream] of channels) {
+      const pairs = findPairs(stream);
+      const lsbOf = new Map([...pairs.keys()].map((m) => [m + 32, m]));
+      for (const r of stream) {
+        const [status, label, numbered] = KIND[r.type];
+        let number = numbered ? r.d1 : null;
+        const pairMsb = r.type === "cc" ? (pairs.has(r.d1) ? r.d1 : lsbOf.get(r.d1)) : undefined;
+        if (pairMsb !== undefined) number = pairMsb;
+        // A pair's row has its own key: CC n alone in another file stays a row of its own.
+        const g = group(`${ch}/${status}/${number}${pairMsb !== undefined ? "/pair" : ""}`, {
+          control: numbered ? `${label} ch${ch} ${number}` : `${label} ch${ch}`, status, channel: ch, number,
+          pair: pairMsb !== undefined ? [pairMsb, pairMsb + 32] : null,
+        });
+        g.files.add(file);
+        if (shift) g.held.add(held.get(r));
+        if (pairMsb !== undefined) continue; // values come from the pair
+        if (!g.runs.has(file)) g.runs.set(file, []);
+        g.runs.get(file).push(r.value);
+        if (label === "note") {
+          if (isRelease(r)) g.releases++;
+          else g.values.push(r.value);
+        } else g.values.push(r.value);
+      }
+      for (const [msb, p] of pairs) {
+        groups.get(`${ch}/B0/${msb}/pair`).values.push(...p.values);
+        log(`${file} ch${ch}: CC ${msb}/${p.lsb} taken as a 14-bit pair (CC ${msb} ×${p.counts[0]}, CC ${p.lsb} ×${p.counts[1]}; ` +
+          `${p.adjacent} of ${p.rarer === msb ? p.counts[0] : p.counts[1]} of CC ${p.rarer} adjacent)`);
+      }
+    }
+  }
+  const rows = [];
+  for (const g of groups.values()) {
+    let sendsOnRelease = false;
+    if (g.status === "90") sendsOnRelease = g.releases > 0;
+    else if (g.status === "B0" && !g.pair) {
+      // Alternation is judged within each file: a file may start on either setting.
+      const runs = [...g.runs.values()];
+      const settings = new Set(runs.flat());
+      sendsOnRelease = settings.size === 2 && settings.has(0) && runs.every((vals) => vals.every((v, i) => i === 0 || v !== vals[i - 1]));
+    }
+    rows.push({
+      control: g.control, status: g.status, channel: g.channel, number: g.number,
+      min: g.values.length ? g.values.reduce((a, b) => Math.min(a, b)) : null,
+      max: g.values.length ? g.values.reduce((a, b) => Math.max(a, b)) : null,
+      sends_on_release: sendsOnRelease,
+      pair_14bit_msb: g.pair ? g.pair[0] : null, pair_14bit_lsb: g.pair ? g.pair[1] : null,
+      shift: shift ? (g.held.size === 2 ? "both" : String([...g.held][0])) : null,
+      source_file: [...g.files].sort().join(";"),
+    });
+  }
+  return rows.sort(byPlace);
+}
+
+const csvField = (v) => {
+  const s = v === null || v === undefined ? "" : String(v);
+  return /[",\n\r]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
+};
+export const csvLine = (cells) => cells.map(csvField).join(",") + "\n";
+
+// Rows (objects with the header's keys) → CSV text, "#" comment lines first.
+export function formatCsv(header, rows, comments = []) {
+  return comments.map((c) => `# ${c}\n`).join("") + csvLine(header) + rows.map((r) => csvLine(header.map((h) => r[h]))).join("");
+}
+
+// CSV text (RFC 4180: quotes, doubled quotes, commas and newlines inside quotes) → array of string arrays.
+// A final newline ends the last record; it does not start an empty one.
+export function parseCsv(text) {
+  const table = [];
+  let row = [], field = "", quoted = false, i = 0;
+  while (i < text.length) {
+    const c = text[i++];
+    if (quoted) {
+      if (c === '"' && text[i] === '"') { field += '"'; i++; }
+      else if (c === '"') quoted = false;
+      else field += c;
+    } else if (c === '"' && field === "") quoted = true;
+    else if (c === ",") { row.push(field); field = ""; }
+    else if (c === "\n" || c === "\r") {
+      if (c === "\r" && text[i] === "\n") i++;
+      row.push(field); table.push(row); row = []; field = "";
+    } else field += c;
+  }
+  if (quoted) throw new Error("CSV ends inside a quoted field");
+  if (field !== "" || row.length) { row.push(field); table.push(row); }
+  return table;
+}
+
+// A census CSV (as formatCsv writes it, "#" lines first) → rows as census() returns them. Throws Error("line n: …").
+export function readCensusCsv(text) {
+  const lines = text.split("\n");
+  let skipped = 0;
+  while (lines[0]?.startsWith("#")) { lines.shift(); skipped++; }
+  const table = parseCsv(lines.join("\n"));
+  if (!table.length || table[0].join() !== HEADER.join()) throw new Error(`line ${skipped + 1}: header must be ${HEADER.join(",")}`);
+  return table.slice(1).map((r, i) => {
+    const where = `line ${skipped + i + 2}`;
+    if (r.length !== HEADER.length) throw new Error(`${where}: ${r.length} fields, not ${HEADER.length}`);
+    const c = Object.fromEntries(HEADER.map((h, j) => [h, r[j]]));
+    const int = (k, nullable) => {
+      if (nullable && c[k] === "") return null;
+      if (!/^\d+$/.test(c[k])) throw new Error(`${where}: ${k} must be a whole number (got ${JSON.stringify(c[k])})`);
+      return Number(c[k]);
+    };
+    if (!["true", "false"].includes(c.sends_on_release)) throw new Error(`${where}: sends_on_release must be true or false`);
+    return {
+      control: c.control, status: c.status, channel: int("channel"), number: int("number", true),
+      min: int("min", true), max: int("max", true), sends_on_release: c.sends_on_release === "true",
+      pair_14bit_msb: int("pair_14bit_msb", true), pair_14bit_lsb: int("pair_14bit_lsb", true),
+      shift: c.shift === "" ? null : c.shift, source_file: c.source_file,
+    };
+  });
+}
+
+// The MK2 djay map's table (header first) → groups { status, channel (1-based), number, section, keypaths },
+// rows with the same channel/data/msgType collapsed. Throws Error("line n: …") on anything unexpected.
+export function readMk2(table) {
+  if (!table.length || table[0].join() !== MK2_HEADER.join()) {
+    throw new Error(`header must be ${MK2_HEADER.join(",")} (got ${(table[0] ?? []).join(",")})`);
+  }
+  const groups = new Map();
+  table.slice(1).forEach((r, i) => {
+    const line = i + 2;
+    if (r.length !== MK2_HEADER.length) throw new Error(`line ${line}: ${r.length} fields, not ${MK2_HEADER.length}`);
+    const [section, keyPath, channel, data, msgType] = r;
+    const int = (s, max, name) => {
+      if (!/^\d+$/.test(s) || Number(s) > max) throw new Error(`line ${line}: ${name} must be 0..${max} (got ${JSON.stringify(s)})`);
+      return Number(s);
+    };
+    const ch = int(channel, 15, "channel") + 1;
+    const number = int(data, 127, "data");
+    if (!Object.hasOwn(MK2_STATUS, msgType)) throw new Error(`line ${line}: msgType must be 0, 1 or 3 (got ${JSON.stringify(msgType)})`);
+    const key = `${ch}/${number}/${msgType}`;
+    if (!groups.has(key)) groups.set(key, { status: MK2_STATUS[msgType], channel: ch, number, sections: [], keypaths: [] });
+    const g = groups.get(key);
+    if (!g.sections.includes(section)) g.sections.push(section);
+    if (keyPath !== "" && !g.keypaths.includes(keyPath)) g.keypaths.push(keyPath);
+  });
+  return [...groups.values()].map((g) => ({
+    status: g.status, channel: g.channel, number: g.number, section: g.sections.join("|"), keypaths: g.keypaths.join("|"),
+  }));
+}
+
+// Census rows × MK2 groups → diff lines (objects with DIFF_HEADER's keys), sorted like the census. A pair
+// matches on its MSB or LSB number. A census row matching nothing is `only-mk1`, an MK2 group matching nothing
+// `only-mk2`, and each match is one `both` line (so a row can appear more than once).
+export function diffCensus(rows, mk2) {
+  const out = [];
+  const matched = new Set();
+  for (const g of mk2) {
+    const hits = rows.filter((r) => r.channel === g.channel && r.number !== null &&
+      (r.number === g.number || r.pair_14bit_lsb === g.number));
+    for (const r of hits) {
+      matched.add(r);
+      out.push({ diff: "both", status: r.status, channel: g.channel, number: g.number, mk1_control: r.control,
+        mk2_section: g.section, mk2_keypaths: g.keypaths, same_kind: g.status === null ? "unknown" : String(g.status === r.status) });
+    }
+    if (!hits.length) {
+      out.push({ diff: "only-mk2", status: g.status, channel: g.channel, number: g.number, mk1_control: null,
+        mk2_section: g.section, mk2_keypaths: g.keypaths, same_kind: null });
+    }
+  }
+  for (const r of rows) {
+    if (matched.has(r)) continue;
+    out.push({ diff: "only-mk1", status: r.status, channel: r.channel, number: r.number, mk1_control: r.control,
+      mk2_section: null, mk2_keypaths: null, same_kind: null });
+  }
+  const text = (d) => [d.diff, d.mk1_control ?? "", d.mk2_keypaths ?? ""].join("\n");
+  return out.sort((a, b) => byPlace({ ...a, status: a.status ?? "" }, { ...b, status: b.status ?? "" }) ||
+    (text(a) < text(b) ? -1 : text(a) > text(b) ? 1 : 0));
+}
diff --git a/tools/lib/jsonl.mjs b/tools/lib/jsonl.mjs
new file mode 100644
index 0000000..0e99950
--- /dev/null
+++ b/tools/lib/jsonl.mjs
@@ -0,0 +1,116 @@
+// The M2 capture line format: one JSON object per line with exactly t_us, bytes, type, ch, d1, d2, value.
+// This module is its only implementation; capture, capture-convert, replay and census all go through it.
+// Spec: docs/plans/2026-10-19-M2-capture-replay.md, section "JSONL format".
+import { openSync, writeSync, closeSync, readFileSync } from "node:fs";
+import { createParser } from "./midi-parse.mjs";
+
+const KEYS = ["t_us", "bytes", "type", "ch", "d1", "d2", "value"];
+const CHANNEL_TYPE = { 0x80: "off", 0x90: "on", 0xa0: "pat", 0xb0: "cc", 0xc0: "pc", 0xd0: "cp", 0xe0: "pb" };
+const SYSTEM_TYPE = {
+  0xf0: "sysex", 0xf1: "mtc", 0xf2: "spp", 0xf3: "song", 0xf6: "tune",
+  0xf8: "clock", 0xfa: "start", 0xfb: "continue", 0xfc: "stop", 0xfe: "sense", 0xff: "reset",
+};
+
+const hex = (bytes) => Buffer.from(bytes).toString("hex").toUpperCase();
+
+// Parser message {status, data, truncated?} → record with the seven keys in order.
+export function toRecord(msg, t_us) {
+  const { status, data } = msg;
+  if (status === 0xf0) {
+    const bytes = hex([0xf0, ...data, ...(msg.truncated ? [] : [0xf7])]);
+    return { t_us, bytes, type: "sysex", ch: null, d1: null, d2: null, value: null };
+  }
+  const type = status < 0xf0 ? CHANNEL_TYPE[status & 0xf0] : SYSTEM_TYPE[status];
+  const d1 = data.length > 0 ? data[0] : null;
+  const d2 = data.length > 1 ? data[1] : null;
+  let value = null;
+  if (type === "pb" || type === "spp") value = d1 | (d2 << 7);
+  else if (d2 !== null) value = d2;
+  else if (d1 !== null) value = d1;
+  return { t_us, bytes: hex([status, ...data]), type, ch: status < 0xf0 ? (status & 0x0f) + 1 : null, d1, d2, value };
+}
+
+export function formatLine(rec) {
+  return JSON.stringify(Object.fromEntries(KEYS.map((k) => [k, rec[k]]))) + "\n";
+}
+
+// The record `bytes` encodes, or a reason it encodes no single message.
+function derive(bytes, t_us) {
+  const raw = Buffer.from(bytes, "hex");
+  if (raw[0] === 0xf0 && raw[raw.length - 1] !== 0xf7) {
+    // A truncated SysEx: the parser holds it open, so build it here; its payload must be all data bytes.
+    const data = [...raw.subarray(1)];
+    if (data.some((b) => b >= 0x80)) return "a status byte inside a truncated SysEx";
+    return toRecord({ status: 0xf0, data, truncated: true }, t_us);
+  }
+  const msgs = createParser().feed(raw);
+  if (msgs.length !== 1) return `${msgs.length} messages, not 1`;
+  const rec = toRecord(msgs[0], t_us);
+  if (rec.bytes !== bytes) return `not one complete message (it parses as ${rec.bytes})`;
+  return rec;
+}
+
+// Line (with or without its \n) → record; throws Error("<where>: …") on any violation of the format.
+export function parseLine(line, where) {
+  const fail = (what) => {
+    throw new Error(`${where}: ${what}`);
+  };
+  const text = line.endsWith("\n") ? line.slice(0, -1) : line;
+  let obj;
+  try {
+    obj = JSON.parse(text);
+  } catch {
+    fail("not JSON");
+  }
+  if (obj === null || typeof obj !== "object" || Array.isArray(obj)) fail("not a JSON object");
+  const keys = Object.keys(obj);
+  if (keys.join() !== KEYS.join()) fail(`keys must be exactly ${KEYS.join(", ")} in that order (got ${keys.join(", ")})`);
+  const { t_us, bytes } = obj;
+  if (!Number.isSafeInteger(t_us) || t_us < 0) fail(`t_us must be an integer ≥ 0 (got ${JSON.stringify(t_us)})`);
+  if (typeof bytes !== "string" || !/^(?:[0-9A-F]{2})+$/.test(bytes)) fail(`bytes must be uppercase hex pairs (got ${JSON.stringify(bytes)})`);
+  const rec = derive(bytes, t_us);
+  if (typeof rec === "string") fail(`bytes ${bytes}: ${rec}`);
+  for (const k of KEYS) {
+    if (obj[k] !== rec[k]) fail(`${k} is ${JSON.stringify(obj[k])} but bytes ${bytes} give ${JSON.stringify(rec[k])}`);
+  }
+  // Only the canonical spelling: no duplicate keys, whitespace, 1.0/1e3/-0 or a trailing \r.
+  if (formatLine(rec) !== text + "\n") fail("not in canonical form (as formatLine writes it)");
+  return rec;
+}
+
+// → records; errors name "path:line". t_us must not go backwards.
+export function readJsonl(path) {
+  const text = readFileSync(path, "utf8");
+  if (text === "") return [];
+  const lines = text.split("\n");
+  const out = [];
+  let last = 0;
+  for (let i = 0; i < lines.length - 1; i++) {
+    const where = `${path}:${i + 1}`;
+    if (lines[i] === "") throw new Error(`${where}: blank line`);
+    const rec = parseLine(lines[i], where);
+    if (rec.t_us < last) throw new Error(`${where}: t_us ${rec.t_us} goes backwards (after ${last})`);
+    last = rec.t_us;
+    out.push(rec);
+  }
+  if (lines[lines.length - 1] !== "") throw new Error(`${path}:${lines.length}: last line has no newline`);
+  return out;
+}
+
+// Opens `path` ("wx", or "w" with force). write(msgs, t_us) writes one line per parser message, one writeSync per
+// call, so a kill loses nothing already written.
+export function createJsonlWriter(path, { force = false } = {}) {
+  const fd = openSync(path, force ? "w" : "wx");
+  const writer = {
+    count: 0,
+    write(msgs, t_us) {
+      if (msgs.length === 0) return;
+      writeSync(fd, msgs.map((m) => formatLine(toRecord(m, t_us))).join(""));
+      writer.count += msgs.length;
+    },
+    close() {
+      closeSync(fd);
+    },
+  };
+  return writer;
+}
