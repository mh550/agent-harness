+    ["both", "90", 0, "note ch1 0", "u.x", "unknown"],
+    ["both", "B0", 6, "cc ch1 6", "a.cc", "true"],
+    ["both", "B0", 6, "cc ch1 6", "b.note", "false"],
+    ["both", "B0", 41, "cc ch1 9", "p.lsb", "true"],
+  ]);
+});
+
+test("readMk2 refuses a CSV whose header or values are not the djay map's", () => {
+  assert.throws(() => readMk2(parseCsv("a,b\n1,2\n")), /header/);
+  assert.throws(() => readMk2(parseCsv("section,djay_keyPath,channel,data,msgType,extra\nS,,16,0,1,\n")), /line 2: channel/);
+  assert.throws(() => readMk2(parseCsv("section,djay_keyPath,channel,data,msgType,extra\nS,,0,0,2,\n")), /line 2: msgType/);
+  assert.throws(() => readMk2(parseCsv("section,djay_keyPath,channel,data,msgType,extra\nS,,0,0,constructor,\n")), /line 2: msgType/);
+});
+
+test("--diff against the real MK2 map: the platter's note 0 and CC 6 sit at MK2 numbers of the other kind", () => {
+  const r = run(["--diff", "reference/rane-one-mk2-djay-midi-map.csv", PLATTER]);
+  assert.equal(r.status, 0, r.stderr);
+  const table = parseCsv(r.stdout);
+  table.shift();
+  // The MK2 map has channel 0 data 0 as a CC (libraryRotary) and data 6 as a note (loadTrack): the platter's
+  // note 0 and CC 6 on channel 1 sit at the same numbers with the other kind.
+  assert.deepEqual(table.filter((x) => x[0] === "both"), [
+    ["both", "90", "1", "0", "note ch1 0", "Deck 1", "turntable1.libraryRotary", "false"],
+    ["both", "B0", "1", "6", "cc ch1 6", "Deck 1", "turntable1.loadTrack", "false"],
+  ]);
+  assert.deepEqual(table.filter((x) => x[0] === "only-mk1").map((x) => x[4]), ["pb ch1"]);
+  // The MK2 map has 595 rows in 195 distinct channel/data/msgType groups (awk, 2026-10-21); 2 of them match.
+  assert.equal(table.filter((x) => x[0] === "only-mk2").length, 193);
+});
+
+test("--diff with no capture file diffs the committed MK1 map, the same as diffing its capture", () => {
+  const fromMap = run(["--diff", "reference/rane-one-mk2-djay-midi-map.csv"]);
+  assert.equal(fromMap.status, 0, fromMap.stderr);
+  assert.match(fromMap.stderr, /reference\/rane-one-mk1-midi-map\.csv: 3 rows/);
+  const fromCapture = run(["--diff", "reference/rane-one-mk2-djay-midi-map.csv", PLATTER]);
+  assert.equal(fromCapture.status, 0, fromCapture.stderr);
+  assert.equal(fromMap.stdout, fromCapture.stdout);
+  // readCensusCsv round-trips a census with a pair row (numbers and empty cells come back as numbers and null).
+  const rows = one(recs([0xb1, 9, 1], [0xb1, 41, 2], [0xe0, 0, 64], [0x90, 3, 0]), { shift: { ch: 16, note: 50 } });
+  assert.deepEqual(readCensusCsvRows(formatCsv(HEADER, rows, ["c"])), rows);
+});
+
+test("the committed reference/rane-one-mk1-midi-map.csv is the census of the quick platter capture: exactly three rows, marked partial", () => {
+  const csv = readCensusCsv(readFileSync(MK1, "utf8"));
