+// tools/capture-session walks Michael through spec §6, one tools/capture recording per step. These tests drive it
+// with scripted stdin and a `--capture-cmd` stub that takes tools/capture's arguments, so nothing opens a device.
+// Sessions go to a temp dir via --captures-dir; `amidi -l` is a stub printing a listing file.
+import { test, after } from "node:test";
+import assert from "node:assert/strict";
+import { spawn, spawnSync } from "node:child_process";
+import { mkdtempSync, mkdirSync, writeFileSync, readFileSync, existsSync, readdirSync, constants } from "node:fs";
+import { open } from "node:fs/promises";
+import { setTimeout as sleep } from "node:timers/promises";
+import { tmpdir } from "node:os";
+import { join, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+import { STEPS, GROUPS, totals, localDate, parseReadme, formatReadme, readmeHeader } from "../tools/lib/capture-session.mjs";
+import { readJsonl } from "../tools/lib/jsonl.mjs";
+
+const TOOL = join(dirname(fileURLToPath(import.meta.url)), "..", "tools", "capture-session");
+const RANE = "IO  hw:2,0,0  Rane ONE MIDI 1";
+const LINE = '{"t_us":0,"bytes":"B0065C","type":"cc","ch":1,"d1":6,"d2":92,"value":92}';
+
+// The stub capture: appends its arguments (JSON) to `calls`, refuses an existing --out without --force like
+// tools/capture (after setting up its signal handlers, as tools/capture does), writes as many JSONL lines as it has
+// been called times, then waits for SIGINT/SIGTERM (exit 0).
+// STUB_EXIT=<code> makes call number STUB_EXIT_CALL (default 1) exit with that code at once (after writing its
+// file with STUB_EXIT_AFTER_WRITE=1); STUB_LINES=<n> writes n lines instead; STUB_SELF_STOP=1 makes a call with
+// --seconds end by itself, like a timed capture.
+const STUB = `#!/usr/bin/env node
+const fs = require("node:fs");
+const args = process.argv.slice(2);
+const calls = process.env.STUB_CALLS;
+fs.appendFileSync(calls, JSON.stringify(args) + "\\n");
+const n = fs.readFileSync(calls, "utf8").trim().split("\\n").length;
+const failNow = process.env.STUB_EXIT && n === Number(process.env.STUB_EXIT_CALL || 1);
+if (failNow && !process.env.STUB_EXIT_AFTER_WRITE) process.exit(Number(process.env.STUB_EXIT));
+const out = args[args.indexOf("--out") + 1];
+const done = () => { console.error("capture: stopped: " + n + " messages (cc " + n + "), dropped 0, 1.5 s"); process.exit(0); };
+process.on("SIGINT", done);
+process.on("SIGTERM", done);
+if (fs.existsSync(out) && !args.includes("--force")) { console.error("capture: exists"); process.exit(1); }
+fs.writeFileSync(out, (${JSON.stringify(LINE)} + "\\n").repeat(Number(process.env.STUB_LINES ?? n)));
+if (failNow) process.exit(Number(process.env.STUB_EXIT));
+if (process.env.STUB_SELF_STOP && args.includes("--seconds")) setTimeout(done, 50);
+setInterval(() => {}, 1000);
+`;
+
+function setup({ list = "" } = {}) {
+  const dir = mkdtempSync(join(tmpdir(), "capture-session-"));
+  const bin = join(dir, "bin"), root = join(dir, "captures");
+  mkdirSync(bin);
+  const stub = join(bin, "capture-stub");
+  writeFileSync(stub, STUB, { mode: 0o755 });
+  const listing = join(dir, "amidi-list"), amidiCount = join(dir, "amidi-count");
+  writeFileSync(listing, `Dir Device    Name\n${list}\n`);
+  // `amidi -l` prints the listing; AMIDI_GONE_AFTER=n drops the Rane row from call n+1 on (it was powered off), and
+  // so does a file named "gone" in the test dir.
+  writeFileSync(join(bin, "amidi"), `#!/bin/sh
+[ "$1" = -l ] || { echo "amidi $*" >> "${join(dir, "amidi-calls")}"; exit 99; }
+echo x >> "${amidiCount}"
+n=$(wc -l < "${amidiCount}")
+if [ -f "${join(dir, "gone")}" ] || { [ -n "$AMIDI_GONE_AFTER" ] && [ "$n" -gt "$AMIDI_GONE_AFTER" ]; }; then grep -v "Rane ONE MIDI 1" "${listing}"; else cat "${listing}"; fi
+`, { mode: 0o755 });
+  const env = { ...process.env, PATH: `${bin}:${process.env.PATH}`, STUB_CALLS: join(dir, "calls") };
+  const base = ["--captures-dir", root, "--capture-cmd", stub];
+  return { dir, root, env, base, calls: () => readLines(join(dir, "calls")).map((l) => JSON.parse(l)) };
+}
+
+const readLines = (path) => existsSync(path) ? readFileSync(path, "utf8").split("\n").filter(Boolean) : [];
+const sessionDir = (t, label = "census") => join(t.root, `${localDate(new Date())}-${label}`);
+const stepLines = (dir) => readLines(join(dir, "README.md")).filter((l) => l.startsWith("- `"));
+
+// Every tool started here is killed when the tests end, so a failing expect can't leave the suite hanging.
+const children = new Set();
+after(() => {
+  for (const c of children) if (c.exitCode === null && c.signalCode === null) c.kill("SIGKILL");
+});
+function launch(t, args, env, opts = {}) {
+  const child = spawn(TOOL, [...t.base, ...args], { env: { ...t.env, ...env }, stdio: ["pipe", "pipe", "pipe"], ...opts });
+  children.add(child);
+  const timer = setTimeout(() => child.kill("SIGKILL"), 30000); // a stuck session fails its test instead of hanging
+  child.on("close", () => clearTimeout(timer));
+  return child;
+}
+
+// Runs the tool with all of stdin written at once; resolves with { status, stdout, stderr }.
+function run(t, args, input, env = {}) {
+  return new Promise((resolve) => {
+    const child = launch(t, args, env);
+    let stdout = "", stderr = "";
+    child.stdout.on("data", (d) => (stdout += d));
+    child.stderr.on("data", (d) => (stderr += d));
+    child.on("close", (status, signal) => resolve({ status, signal, stdout, stderr }));
+    child.stdin.end(input.map((l) => l + "\n").join(""));
+  });
+}
+
+// Runs the tool interactively: `expect(re)` waits for stdout to match (from where the last match ended), `send`
+// writes a line. Resolves `done` with { status, signal, stdout, stderr }.
+function interact(t, args, env = {}, opts = {}) {
+  const child = launch(t, args, env, opts);
+  let stdout = "", stderr = "", from = 0;
+  const waiters = [];
+  const check = () => {
+    for (const w of [...waiters]) {
+      const m = w.re.exec(stdout.slice(from));
+      if (m) {
+        from += m.index + m[0].length;
+        waiters.splice(waiters.indexOf(w), 1);
+        clearTimeout(w.timer);
+        w.resolve(m);
+      }
+    }
+  };
+  child.stdout.on("data", (d) => { stdout += d; check(); });
+  child.stderr.on("data", (d) => (stderr += d));
+  const done = new Promise((resolve) => child.on("close", (status, signal) => resolve({ status, signal, stdout, stderr })));
+  return {
+    child, done,
+    send: (line) => child.stdin.write(line + "\n"),
+    expect: (re) => new Promise((resolve, reject) => {
+      const w = { re, resolve, timer: setTimeout(() => reject(new Error(`timed out waiting for ${re}; stdout:\n${stdout}\nstderr:\n${stderr}`)), 5000) };
+      waiters.push(w);
+      check();
+    }),
+  };
+}
+
+// Answers for one recorded step: Enter starts, Enter stops, Enter keeps, then the note.
+const take = (note = "") => ["", "", "", note];
+
+test("the steps cover spec §6 in 7 groups, numbered 01.. in the order performed, the main session under 25 min", () => {
+  assert.deepEqual(GROUPS.map((g) => g.n), [1, 2, 3, 4, 5, 6, 7]);
+  assert.deepEqual(STEPS.map((s) => s.nn), STEPS.map((_, i) => String(i + 1).padStart(2, "0")));
+  assert.equal(new Set(STEPS.map((s) => s.file)).size, STEPS.length);
+  for (const s of STEPS) assert.match(s.file, /^\d\d-[a-z0-9-]+\.jsonl$/);
+  // Extras come after every main step, so a session that skips them is still complete through §6.7.
+  const firstExtra = STEPS.findIndex((s) => s.extra);
+  assert.ok(firstExtra > 0 && STEPS.slice(firstExtra).every((s) => s.extra));
+  for (const g of GROUPS) assert.ok(STEPS.some((s) => s.group === g.n && !s.extra), `§6.${g.n} has no main step`);
+  const t = totals();
+  assert.equal(t.groups.length, 7);
+  assert.ok(t.main < 25, `main session is ${t.main} min`);
+  assert.equal(t.main, Math.round(STEPS.filter((s) => !s.extra).reduce((a, s) => a + s.minutes, 0) * 100) / 100);
+});
+
+test("--list prints the 7 §6 groups with their expected minutes and a total under 25 min, then the extras", () => {
+  const t = setup();
+  const r = spawnSync(TOOL, ["--list"], { encoding: "utf8", env: t.env });
