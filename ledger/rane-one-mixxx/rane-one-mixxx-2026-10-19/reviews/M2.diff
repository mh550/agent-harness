+// tools/lib/amidi.mjs reads `amidi -l` listings; tools/capture and tools/capture-session both resolve ports with it.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { parseAmidiList, findInputs } from "../tools/lib/amidi.mjs";
+
+// The real listing on Michael's desktop (2026-10-20), plus a near-miss name, an output-only port and a 2-field row.
+const LIST = `Dir Device    Name
+IO  hw:1,0,0  Rane ONE MIDI 10
+IO  hw:2,0,0  Rane ONE MIDI 1
+O   hw:3,0,0  Out Only
+I   hw:4,1    Two Fields  `;
+
+test("each row gives dir, hw, card, dev, sub and the name with trailing space trimmed", () => {
+  assert.deepEqual(parseAmidiList(LIST), [
+    { dir: "IO", hw: "hw:1,0,0", card: "1", dev: "0", sub: "0", name: "Rane ONE MIDI 10" },
+    { dir: "IO", hw: "hw:2,0,0", card: "2", dev: "0", sub: "0", name: "Rane ONE MIDI 1" },
+    { dir: "O", hw: "hw:3,0,0", card: "3", dev: "0", sub: "0", name: "Out Only" },
+    { dir: "I", hw: "hw:4,1", card: "4", dev: "1", sub: undefined, name: "Two Fields" },
+  ]);
+});
+
+test("the header alone, or nothing, lists no ports", () => {
+  assert.deepEqual(parseAmidiList("Dir Device    Name\n"), []);
+  assert.deepEqual(parseAmidiList(""), []);
+});
+
+test("findInputs matches the exact name on input ports only", () => {
+  const ports = parseAmidiList(LIST);
+  assert.deepEqual(findInputs(ports, "Rane ONE MIDI 1").map((p) => p.hw), ["hw:2,0,0"]);
+  assert.deepEqual(findInputs(ports, "Out Only"), []);
+  assert.deepEqual(findInputs(ports, "Rane ONE MIDI"), []);
+});
diff --git a/tests/capture-convert.test.mjs b/tests/capture-convert.test.mjs
