index 0000000..09e4606
--- /dev/null
+++ b/tests/capture-convert.test.mjs
@@ -0,0 +1,182 @@
+// tools/capture-convert turns an SMF (arecordmidi's capture) into M2 JSONL. The first tests check the committed
+// conversion of the quick capture (captures/2026-10-19-quick/platter.jsonl); the rest run the tool in temp dirs.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { mkdtempSync, readFileSync, writeFileSync, existsSync, readdirSync, statSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+import { readJsonl } from "../tools/lib/jsonl.mjs";
+import { writeSmf } from "../tools/lib/smf.mjs";
+
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), "..");
+const TOOL = join(ROOT, "tools", "capture-convert");
+const JSONL = join(ROOT, "captures/2026-10-19-quick/platter.jsonl");
+
+const run = (args, cwd) => spawnSync(TOOL, args, { encoding: "utf8", cwd });
+
+test("the committed platter.jsonl has 58650 strict lines, t_us non-decreasing, last t_us 48.38–48.40 s", () => {
+  const recs = readJsonl(JSONL); // strict: every line re-derived from its bytes, t_us never going backwards
+  assert.equal(recs.length, 58650);
+  for (let i = 1; i < recs.length; i++) assert.ok(recs[i].t_us >= recs[i - 1].t_us, `line ${i + 1}`);
+  const last = recs[recs.length - 1].t_us;
+  assert.ok(last >= 48380000 && last <= 48400000, `last t_us ${last}`);
+  assert.equal(last, 48390000); // last tick 48,390 at 1 ms per tick (M2 plan, Evidence)
+});
+
+test("platter.jsonl holds 29323 CC 6, 29323 pitch bend and 4 notes, all on channel 1", () => {
+  const recs = readJsonl(JSONL);
+  const count = (f) => recs.filter(f).length;
+  assert.equal(count((r) => r.type === "cc" && r.d1 === 6), 29323);
+  assert.equal(count((r) => r.type === "cc"), 29323);
+  assert.equal(count((r) => r.type === "pb"), 29323);
+  assert.equal(count((r) => r.type === "on" || r.type === "off"), 4);
+  assert.equal(count((r) => r.ch === 1), 58650);
+  // The plan's example lines are the file's first three.
+  const firstLines = readFileSync(JSONL, "utf8").split("\n").slice(0, 3);
+  assert.deepEqual(firstLines, [
+    '{"t_us":2651000,"bytes":"B0065C","type":"cc","ch":1,"d1":6,"d2":92,"value":92}',
+    '{"t_us":2651000,"bytes":"E0153D","type":"pb","ch":1,"d1":21,"d2":61,"value":7829}',
+    '{"t_us":2673000,"bytes":"B0065D","type":"cc","ch":1,"d1":6,"d2":93,"value":93}',
+  ]);
+});
+
+test("converting platter.mid again reproduces the committed platter.jsonl byte for byte", () => {
+  const dir = mkdtempSync(join(tmpdir(), "capture-convert-"));
+  const out = join(dir, "platter.jsonl");
+  const r = run([join(ROOT, "captures/2026-10-19-quick/platter.mid"), "--out", out], dir);
+  assert.equal(r.status, 0, r.stderr);
+  assert.deepEqual(readFileSync(out), readFileSync(JSONL));
+  assert.match(r.stderr, /58650 messages/);
+});
+
+function fixture(events, opts = {}) {
+  const dir = mkdtempSync(join(tmpdir(), "capture-convert-"));
+  const mid = join(dir, "step.mid");
+  writeFileSync(mid, opts.raw ?? writeSmf({ division: 1000, tempo: 1000000, events }));
+  return { dir, mid, jsonl: join(dir, "step.jsonl") };
+}
+const ev = (tick, ...bytes) => ({ tick, kind: bytes[0] === 0xf0 ? "sysex" : "midi", bytes: Uint8Array.from(bytes) });
+
+test("writes next to the input with .mid → .jsonl, SysEx kept, meta skipped, and refuses to overwrite a different file unless --force", () => {
+  const f = fixture([ev(0, 0xb0, 6, 92), ev(5, 0xf0, 0x7e, 0x7f, 0x06, 0x01, 0xf7), ev(7, 0x90, 60, 0)]);
+  let r = run([f.mid], f.dir);
+  assert.equal(r.status, 0, r.stderr);
+  assert.deepEqual(readJsonl(f.jsonl).map((x) => [x.t_us, x.bytes, x.type]), [
+    [0, "B0065C", "cc"], [5000, "F07E7F0601F7", "sysex"], [7000, "903C00", "on"],
+  ]);
+  // Converting again onto an identical file is a no-op (so the step command re-runs on the committed file).
+  const mtime = statSync(f.jsonl).mtimeMs;
+  r = run([f.mid], f.dir);
+  assert.equal(r.status, 0, r.stderr);
+  assert.match(r.stderr, /already up to date/);
+  assert.equal(statSync(f.jsonl).mtimeMs, mtime);
+  // A different existing file is refused.
+  writeFileSync(f.jsonl, "");
+  r = run([f.mid], f.dir);
+  assert.equal(r.status, 1);
+  assert.match(r.stderr, /exists and differs.*--force/);
+  assert.equal(readFileSync(f.jsonl, "utf8"), "");
+  r = run([f.mid, "--force"], f.dir);
+  assert.equal(r.status, 0, r.stderr);
+  assert.equal(readJsonl(f.jsonl).length, 3);
+});
+
+test("an F7 escape event's bytes go through the same parser and may yield several messages", () => {
+  // Track by hand: F7 escape carrying a whole CC and the first byte of another, then a second escape finishing it.
