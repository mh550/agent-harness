diff --git a/tools/replay b/tools/replay
new file mode 100755
index 0000000..394a6a2
--- /dev/null
+++ b/tools/replay
@@ -0,0 +1,178 @@
+#!/usr/bin/env node
+// Replays an M2 JSONL capture into a MIDI port with its original timing: JSONL → SMF (format 0, division 1000,
+// tempo 1000000 µs, so 1 tick = 1 ms) → `tools/midi-send play <client>:0 <file.mid>`. midi-send stays the only
+// sender (CLAUDE.md), so its refusals apply here too; this tool never starts a player itself.
+// Only channel messages are replayed; SysEx, system common and real-time records are dropped and counted.
+// Exit: 0 sent or dry run done · 1 bad input, nothing selected, I/O or player failure · 2 usage
+//       3 refused (a Rane name, or a route from the port to the Rane One, armed or not) · 4 no such port
+//       128+n stopped by signal n. midi-send's refusals (3, 4) pass through; its other failures are 1.
+// Spec: docs/plans/2026-10-19-M2-capture-replay.md, section "Replay".
+import { spawn, spawnSync } from "node:child_process";
+import { mkdtempSync, rmSync, existsSync } from "node:fs";
+import { tmpdir, constants } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { readJsonl } from "./lib/jsonl.mjs";
+import { writeSmfFile } from "./lib/smf.mjs";
+
+const USAGE = "usage: tools/replay (--to-port <name> | --dry-run [--out <file.mid> [--force]] [--to-port <name>]) [--from <s>] [--to <s>] [--speed <k>] <file.jsonl>";
+const HELP = `${USAGE}
+Plays a capture's channel messages into a MIDI port through tools/midi-send, 1 ms ticks, original gaps.
+  --to-port <name>  the destination client's name exactly as \`aconnect -o\` lists it, e.g. 'Midi Through';
+                    sent to its port 0. A name with "rane" in it is refused, and so is a port from which the
+                    Rane One can be reached (aconnect -l), armed or not: replays go through Midi Through.
+                    The route is checked once, before sending; a subscription made during the replay is not seen.
+  --dry-run         send nothing: print the event count, duration and the midi-send line it would run
+                    (with --to-port, after the same checks)
+  --out <file.mid>  with --dry-run: also write the SMF there; refused if it exists, unless --force
+  --from <s>        keep records at or after s seconds (default 0); times then count from s
+  --to <s>          keep records before s seconds (default: to the end)
+  --speed <k>       play k times as fast (default 1); --speed 2 halves every gap
+Exit: 0 sent · 1 bad input, nothing selected or player failure · 2 usage · 3 refused · 4 no such port
+      128+n stopped by signal n
+`;
+
+const MIDI_SEND = fileURLToPath(new URL("./midi-send", import.meta.url));
+const ROUTE_AWK = fileURLToPath(new URL("./lib/rane-route.awk", import.meta.url));
+
+function usage(why) {
+  if (why) process.stderr.write(`replay: ${why}\n`);
+  process.stderr.write(USAGE + "\n");
+  process.exit(2);
+}
+function exit(code, msg) {
+  process.stderr.write(`replay: ${msg}\n`);
+  process.exit(code);
+}
+
+// A stop before midi-send runs removes the temp directory (if made yet) and exits; once it runs, it is passed on
+// (Ctrl-C reaches the whole process group anyway) and this process exits when midi-send has.
+let dir = null;
+let child = null;
+let stoppedBy = null;
+const cleanup = () => dir !== null && rmSync(dir, { recursive: true, force: true });
+for (const sig of ["SIGINT", "SIGTERM", "SIGHUP"]) {
+  process.on(sig, () => {
+    stoppedBy = sig;
+    if (child !== null) return void child.kill(sig);
+    cleanup();
+    process.exit(128 + constants.signals[sig]);
+  });
+}
+
+const args = process.argv.slice(2);
+if (args.length === 1 && args[0] === "--help") {
+  process.stdout.write(HELP);
+  process.exit(0);
+}
+const opt = { port: null, dryRun: false, force: false, out: null, from: null, to: null, speed: null };
+const VALUE = { "--to-port": "port", "--out": "out", "--from": "from", "--to": "to", "--speed": "speed" };
+let input = null;
+for (let i = 0; i < args.length; i++) {
+  const a = args[i];
+  if (a === "--dry-run") opt.dryRun = true;
+  else if (a === "--force") opt.force = true;
+  else if (a in VALUE) {
+    const key = VALUE[a];
+    if (opt[key] !== null) usage(`${a} given twice`);
+    const v = args[++i];
+    if (v === undefined || v === "" || v.startsWith("-")) usage(`${a} needs a value`);
+    opt[key] = v;
+  } else if (a.startsWith("-")) usage(`unknown option ${a}`);
+  else if (input === null) input = a;
+  else usage("one input file only");
+}
+if (input === null) usage();
+if (!opt.dryRun && opt.port === null) usage("give --to-port or --dry-run");
+if (opt.out !== null && !opt.dryRun) usage("--out only with --dry-run");
+if (opt.force && opt.out === null) usage("--force only with --out");
+const seconds = (name, v, dflt) => {
+  if (v === null) return dflt;
+  if (!/^\d+(\.\d+)?$/.test(v)) usage(`${name} must be a number of seconds, not '${v}'`);
+  return Number(v);
+};
+const from = seconds("--from", opt.from, 0);
+const to = seconds("--to", opt.to, Infinity);
+const speed = seconds("--speed", opt.speed, 1);
+if (to <= from) usage("--to must be after --from");
+if (speed <= 0) usage("--speed must be above 0");
+
+// Refused by name before anything runs.
+if (opt.port !== null && /rane/i.test(opt.port)) exit(3, `refusing to replay into the Rane One ('${opt.port}')`);
+
+// Selection and timing. readJsonl checks every line against the format, its bytes parsed by midi-parse.mjs, so a
+// record is exactly one message. Ticks come from absolute times, never from summed deltas: each event is within
+// 0.5 ms of its scaled t_us however long the replay runs.
+let records;
+try {
+  records = readJsonl(input);
+} catch (err) {
+  exit(1, err.message);
+}
+const fromUs = Math.round(from * 1e6);
+const toUs = to === Infinity ? Infinity : Math.round(to * 1e6);
+const events = [];
+const dropped = { sysex: 0, system: 0, "real-time": 0 };
+for (const rec of records) {
+  if (rec.t_us < fromUs || rec.t_us >= toUs) continue;
+  const bytes = Buffer.from(rec.bytes, "hex");
+  if (rec.ch === null) {
+    dropped[bytes[0] === 0xf0 ? "sysex" : bytes[0] < 0xf8 ? "system" : "real-time"]++;
+    continue;
+  }
+  events.push({ tick: Math.round((rec.t_us - fromUs) / speed / 1000), bytes });
+}
+process.stderr.write(`replay: dropped ${Object.entries(dropped).map(([k, n]) => `${n} ${k}`).join(", ")}\n`);
+if (events.length === 0) exit(1, `nothing to replay in ${input} between ${from} s and ${to} s`);
+const summary = `${events.length} events, ${(events[events.length - 1].tick / 1000).toFixed(3)} s`;
+
+// --to-port: the client by its exact name, then the route walk midi-send runs only when disarmed.
+let dest = null;
+if (opt.port !== null) {
+  const listed = spawnSync("aconnect", ["-o"], { encoding: "utf8" });
+  if (listed.status !== 0) exit(4, `aconnect -o failed, cannot find '${opt.port}'`);
+  const clients = [...listed.stdout.matchAll(/^client (\d+): '(.*)' \[[^\]]*\]$/gm)].filter((m) => m[2] === opt.port);
+  if (clients.length === 0) exit(4, `no MIDI destination named '${opt.port}' (aconnect -o)`);
+  if (clients.length > 1) exit(4, `${clients.length} clients are named '${opt.port}' (${clients.map((m) => m[1]).join(", ")}); refusing to guess`);
+  dest = `${clients[0][1]}:0`;
+  const conns = spawnSync("aconnect", ["-l"], { encoding: "utf8" });
+  if (conns.status !== 0) exit(3, "aconnect -l failed, cannot rule out a route to the Rane One");
+  const walk = spawnSync("awk", ["-v", `start=${dest}`, "-v", "card=", "-f", ROUTE_AWK], { input: conns.stdout, encoding: "utf8" });
+  if (walk.status !== 0) exit(3, "cannot parse aconnect -l, cannot rule out a route to the Rane One");
+  const rane = walk.stdout.trim();
+  if (rane) exit(3, `refusing to replay into the Rane One: '${opt.port}' (${dest}) reaches '${rane}' (aconnect -l)`);
+}
+
+if (opt.dryRun) {
+  if (opt.out !== null && !opt.force && existsSync(opt.out)) exit(1, `${opt.out} exists; use --force to overwrite`);
+  try {
+    if (opt.out !== null) writeSmfFile(opt.out, { events });
+  } catch (err) {
+    exit(1, `writing ${opt.out}: ${err.message}`);
+  }
+  process.stderr.write(`replay: ${summary}${opt.out !== null ? `, written to ${opt.out}` : ""}\n`);
+  exit(0, `would run: tools/midi-send play ${dest ?? "<client:port>"} ${opt.out ?? "<tmp>.mid"}`);
+}
+
+// The SMF lives in its own temp directory, removed once midi-send returns (or fails to start).
+dir = mkdtempSync(join(tmpdir(), "replay-"));
+const file = join(dir, "replay.mid");
+try {
+  writeSmfFile(file, { events });
+} catch (err) {
+  cleanup();
+  exit(1, `writing ${file}: ${err.message}`);
+}
+process.stderr.write(`replay: ${summary}\nreplay: running tools/midi-send play ${dest} ${file}\n`);
+child = spawn(MIDI_SEND, ["play", dest, file], { stdio: "inherit" });
+child.on("error", (err) => {
+  cleanup();
+  exit(1, `cannot run tools/midi-send: ${err.message}`);
+});
+child.on("exit", (code, signal) => {
+  cleanup();
+  if (code !== 0) process.stderr.write(`replay: tools/midi-send ${signal ? `stopped by ${signal}` : `exited ${code}`}\n`);
+  const sig = stoppedBy ?? signal;
+  if (sig !== null) process.exit(128 + constants.signals[sig]);
+  process.exit([0, 3, 4].includes(code) ? code : 1);
+});
