+test("a 14-bit pair needs ≥ 90 % of the rarer CC adjacent to the other on its channel; otherwise two rows", () => {
+  // 10 pairs, plus one stray MSB: a pair. Combined values from adjacent (MSB, LSB) messages only.
+  const msgs = [];
