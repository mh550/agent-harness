diff --git a/tools/lib/rane-route.awk b/tools/lib/rane-route.awk
new file mode 100644
index 0000000..653e481
--- /dev/null
+++ b/tools/lib/rane-route.awk
@@ -0,0 +1,28 @@
+# Prints the name of the first Rane client reachable from a start port in `aconnect -l` output, or nothing.
+# Used by tools/midi-send (when disarmed) and tools/replay (always); this file is the only copy of the walk.
+#   aconnect -l | awk -v start=<client:port or empty> -v card=<card number or empty> -f tools/lib/rane-route.awk
+# A seq port forwards to every port subscribed to it (Midi Through does so in the kernel, port by port), so follow
+# its `Connecting To` subscriptions, transitively. A user client may pass what one of its ports receives out of
+# another (a bridge, Mixxx itself), so reaching any port of a user client follows all of its ports. With `card`, the
+# walk also starts at every port of that card's kernel seq client: a virtual device (snd-virmidi) forwards what is
+# written to it to their subscribers.
+/^client [0-9]+: / { c = $2; sub(":", "", c); n = $0; sub(/^client [0-9]+: \047/, "", n)
+  sub(/\047 \[[^]]*\]$/, "", n); name[c] = n; user[c] = ($0 ~ /\[type=user/)
+  if (card != "" && $0 ~ ("\\[type=kernel,card=" card "\\]$")) of_card[c] = 1; port = ""; next }
+/^ +[0-9]+ \047/ { port = c ":" $1; ports[c] = ports[c] " " port; next }
+/^\tConnecting To: / && port != "" {
+  l = $0; sub(/^\t[^:]*: /, "", l); k = split(l, a, /, */)
+  for (i = 1; i <= k; i++) { sub(/\[.*/, "", a[i]); to[port] = to[port] " " a[i] } }
+END {
+  head = 1; tail = 0
+  if (start != "") { queue[++tail] = start; seen[start] = 1 }
+  for (c in of_card) {
+    k = split(ports[c], a, " "); for (i = 1; i <= k; i++) { queue[++tail] = a[i]; seen[a[i]] = 1 } }
+  while (head <= tail) {
+    p = queue[head++]; split(p, cp, ":")
+    next_ports = to[p]; if (user[cp[1]]) next_ports = next_ports ports[cp[1]]
+    k = split(next_ports, a, " ")
+    for (i = 1; i <= k; i++) if (!(a[i] in seen)) { seen[a[i]] = 1; queue[++tail] = a[i] }
+  }
+  for (p in seen) { split(p, cp, ":"); if (tolower(name[cp[1]]) ~ /rane/) { print name[cp[1]]; exit } }
+}
diff --git a/tools/lib/smf.mjs b/tools/lib/smf.mjs
new file mode 100644
index 0000000..50d53bd
--- /dev/null
+++ b/tools/lib/smf.mjs
@@ -0,0 +1,200 @@
+// Standard MIDI File read/write: arecordmidi's captures in (tools/capture-convert), files for aplaymidi out
+// (tools/replay). Pure apart from the two file wrappers at the end.
+// Spec: docs/plans/2026-10-19-M2-capture-replay.md, section "SMF library".
+import { readFileSync, writeFileSync, renameSync, rmSync } from "node:fs";
+import { dirname, basename, join } from "node:path";
+
+const DEFAULT_TEMPO = 500000; // µs per quarter note until the first tempo event (SMF 1.0)
+// Data-byte count per channel-message kind (status & 0xF0).
+const CHANNEL_LEN = { 0x80: 2, 0x90: 2, 0xa0: 2, 0xb0: 2, 0xc0: 1, 0xd0: 1, 0xe0: 2 };
+
+const hex = (bytes) => Buffer.from(bytes).toString("hex").toUpperCase();
+
+// → { format, division, tracks: [[event]], events: [event] }
+// event: { tick, kind: "midi"|"sysex"|"meta", bytes: Uint8Array, meta?: { type, data }, escape?: true (F7 events) }
+export function readSmf(buffer) {
+  const buf = Buffer.from(buffer.buffer ?? buffer, buffer.byteOffset ?? 0, buffer.byteLength ?? buffer.length);
+  const fail = (offset, what) => {
+    throw new Error(`SMF offset ${offset}: ${what}`);
+  };
+  if (buf.length < 14 || buf.toString("latin1", 0, 4) !== "MThd") fail(0, "not a MIDI file (no MThd)");
+  const headLen = buf.readUInt32BE(4);
+  if (headLen < 6 || 8 + headLen > buf.length) fail(4, `bad MThd length ${headLen}`);
+  const format = buf.readUInt16BE(8);
+  const division = buf.readUInt16BE(12);
+  if (format === 2) fail(8, "format 2 is not supported");
+  if (format > 2) fail(8, `unknown format ${format}`);
+  if (division & 0x8000) fail(12, "SMPTE division is not supported");
+  if (division === 0) fail(12, "division 0");
+
+  const tracks = [];
+  let pos = 8 + headLen;
+  while (pos < buf.length) {
+    if (pos + 8 > buf.length) fail(pos, "truncated chunk header");
+    const type = buf.toString("latin1", pos, pos + 4);
+    const len = buf.readUInt32BE(pos + 4);
+    const start = pos + 8;
+    const end = start + len;
+    if (end > buf.length) fail(pos, `${type} chunk runs past the end of the file`);
+    if (type === "MTrk") tracks.push(readTrack(buf, start, end, fail));
+    pos = end; // unknown chunk types are skipped
+  }
+
+  // All tracks merged by tick, stable within a tick: track order, then file order.
+  const events = tracks
+    .flatMap((t, ti) => t.map((e, i) => ({ e, ti, i })))
+    .sort((a, b) => a.e.tick - b.e.tick || a.ti - b.ti || a.i - b.i)
+    .map((x) => x.e);
+  return { format, division, tracks, events };
+}
+
+function readTrack(buf, start, end, fail) {
+  const events = [];
+  let pos = start;
+  let tick = 0;
+  let running = 0;
+  const need = (n) => {
+    if (pos + n > end) fail(pos, "track truncated mid-event");
+  };
+  const vlq = () => {
+    const at = pos;
+    let v = 0;
+    for (let n = 0; ; n++) {
+      if (n === 4) fail(at, "VLQ longer than 4 bytes");
+      need(1);
+      const b = buf[pos++];
+      v = v * 128 + (b & 0x7f);
+      if (!(b & 0x80)) return v;
+    }
+  };
+  while (pos < end) {
+    tick += vlq();
+    need(1);
+    const at = pos;
+    let status = buf[pos];
+    if (status & 0x80) pos++;
+    else if (running) status = running;
+    else fail(at, "data byte with no running status");
+
+    if (status === 0xff) {
+      running = 0;
+      need(1);
+      const type = buf[pos++];
+      const len = vlq();
+      need(len);
+      const data = Uint8Array.from(buf.subarray(pos, pos + len));
+      pos += len;
+      const lenBytes = encodeVlq(len);
+      events.push({ tick, kind: "meta", bytes: Uint8Array.of(0xff, type, ...lenBytes, ...data), meta: { type, data } });
+      if (type === 0x2f) return events; // end of track
+    } else if (status === 0xf0 || status === 0xf7) {
+      running = 0;
+      const len = vlq();
+      need(len);
+      const data = buf.subarray(pos, pos + len);
+      pos += len;
+      // F0: the SysEx (or its first packet) is F0 plus its data, the F7 included when the file has one.
+      // F7: an escape or a SysEx continuation, its raw bytes as they are, flagged so F0-first bytes stay apart.
+      if (status === 0xf0) events.push({ tick, kind: "sysex", bytes: Uint8Array.of(0xf0, ...data) });
+      else events.push({ tick, kind: "sysex", bytes: Uint8Array.from(data), escape: true });
+    } else if (status >= 0x80 && status < 0xf0) {
+      running = status;
+      const n = CHANNEL_LEN[status & 0xf0];
+      need(n);
+      const data = buf.subarray(pos, pos + n);
+      for (const d of data) if (d & 0x80) fail(pos, `status byte inside channel message ${hex([status, ...data])}`);
+      pos += n;
+      events.push({ tick, kind: "midi", bytes: Uint8Array.of(status, ...data) });
+    } else {
+      fail(at, `status 0x${status.toString(16)} is not valid in an SMF track`);
+    }
+  }
+  fail(pos, "track ends without an end of track event");
+}
+
+// → function(tick) → µs, from division and the tempo map (tempo events of every track, as SMF 1.0 says).
+export function ticksToMicros(smf) {
+  const division = BigInt(smf.division);
+  // Segments [tick, µs·division so far, tempo]; exact BigInt sums, rounded only at the end.
+  const segments = [{ tick: 0, acc: 0n, tempo: BigInt(DEFAULT_TEMPO) }];
+  for (const e of smf.events) {
+    if (e.kind !== "meta" || e.meta.type !== 0x51 || e.meta.data.length !== 3) continue;
+    const [a, b, c] = e.meta.data;
+    const last = segments[segments.length - 1];
+    const tempo = BigInt((a << 16) | (b << 8) | c);
+    const acc = last.acc + BigInt(e.tick - last.tick) * last.tempo;
+    if (e.tick === last.tick) segments[segments.length - 1] = { tick: e.tick, acc: last.acc, tempo };
+    else segments.push({ tick: e.tick, acc, tempo });
+  }
+  return (tick) => {
+    let lo = 0;
+    let hi = segments.length - 1;
+    while (lo < hi) {
+      const mid = (lo + hi + 1) >> 1;
+      if (segments[mid].tick <= tick) lo = mid;
+      else hi = mid - 1;
+    }
+    const s = segments[lo];
+    const total = s.acc + BigInt(tick - s.tick) * s.tempo;
+    return Number((total * 2n + division) / (division * 2n)); // round half up
+  };
+}
+
+function encodeVlq(v) {
+  const out = [v & 0x7f];
+  while ((v = Math.floor(v / 128)) > 0) out.unshift((v & 0x7f) | 0x80);
+  return out;
+}
+
+// Format 0, one track → Buffer. Tick 0 holds the tempo; every channel message has its status byte.
+export function writeSmf({ division = 1000, tempo = 1000000, events }) {
+  if (!Number.isInteger(division) || division < 1 || division > 0x7fff) throw new Error(`writeSmf: bad division ${division}`);
+  if (!Number.isInteger(tempo) || tempo < 1 || tempo > 0xffffff) throw new Error(`writeSmf: bad tempo ${tempo}`);
+  const body = [0x00, 0xff, 0x51, 0x03, (tempo >> 16) & 0xff, (tempo >> 8) & 0xff, tempo & 0xff];
+  let tick = 0;
+  events.forEach((e, i) => {
+    const where = `writeSmf: event ${i}`;
+    const bytes = [...e.bytes];
+    if (!Number.isInteger(e.tick) || e.tick < 0 || e.tick > 0x0fffffff) throw new Error(`${where}: bad tick ${e.tick}`);
+    if (e.tick < tick) throw new Error(`${where}: tick ${e.tick} out of order (after ${tick})`);
+    if (e.escape) throw new Error(`${where}: an F7 escape (${hex(bytes)}) can't be written to an SMF for aplaymidi`);
+    const s = bytes[0];
+    const dataOk = (xs) => xs.every((d) => Number.isInteger(d) && d >= 0 && d < 0x80);
+    let out;
+    if (s >= 0x80 && s < 0xf0) {
+      if (bytes.length !== 1 + CHANNEL_LEN[s & 0xf0] || !dataOk(bytes.slice(1))) throw new Error(`${where}: bad channel message ${hex(bytes)}`);
+      out = bytes;
+    } else if (s === 0xf0) {
+      const data = bytes.slice(1);
+      if (data[data.length - 1] !== 0xf7 || !dataOk(data.slice(0, -1))) throw new Error(`${where}: truncated SysEx ${hex(bytes)}`);
+      out = [0xf0, ...encodeVlq(data.length), ...data];
+    } else {
+      throw new Error(`${where}: ${hex(bytes) || "empty"} can't be written to an SMF for aplaymidi (channel messages and complete SysEx only)`);
+    }
+    body.push(...encodeVlq(e.tick - tick), ...out);
+    tick = e.tick;
+  });
+  body.push(0x00, 0xff, 0x2f, 0x00);
+  const head = Buffer.from([0x4d, 0x54, 0x68, 0x64, 0, 0, 0, 6, 0, 0, 0, 1, division >> 8, division & 0xff]);
+  const trk = Buffer.alloc(8);
+  trk.write("MTrk", 0, "latin1");
+  trk.writeUInt32BE(body.length, 4);
+  return Buffer.concat([head, trk, Buffer.from(body)]);
+}
+
+export function readSmfFile(path) {
+  return readSmf(readFileSync(path));
+}
+
+// Writes to a temp file in the same directory, then renames it over `path`.
+export function writeSmfFile(path, opts) {
+  const buf = writeSmf(opts);
+  const tmp = join(dirname(path), `.${basename(path)}.${process.pid}.tmp`);
+  try {
+    writeFileSync(tmp, buf, { flag: "wx" });
+    renameSync(tmp, path);
+  } catch (err) {
+    rmSync(tmp, { force: true });
+    throw err;
+  }
+}
