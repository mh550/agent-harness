+// tools/capture records a MIDI input into M2 JSONL, read-only. These tests read FIFOs (`--device <fifo>`, or a
+// stubbed `amidi -l` plus CAPTURE_SND_DIR pointing at a temp dir), so they never open a real rawmidi device.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { spawn, spawnSync } from "node:child_process";
+import { mkdtempSync, writeFileSync, readFileSync, existsSync, mkdirSync, constants } from "node:fs";
+import { open } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+import { setTimeout as sleep } from "node:timers/promises";
+import { readJsonl } from "../tools/lib/jsonl.mjs";
+
+const TOOL = join(dirname(fileURLToPath(import.meta.url)), "..", "tools", "capture");
+
+// The real listing on Michael's desktop (2026-10-20), plus a near-miss name and an output-only port around it.
+const AMIDI_LIST = `Dir Device    Name
+IO  hw:1,0,0  Rane ONE MIDI 10
+IO  hw:2,0,0  Rane ONE MIDI 1
+O   hw:3,0,0  Out Only`;
+
+function setup({ list = AMIDI_LIST } = {}) {
+  const dir = mkdtempSync(join(tmpdir(), "capture-"));
+  const bin = join(dir, "bin"), snd = join(dir, "snd");
+  mkdirSync(bin);
+  mkdirSync(snd);
+  const listing = join(dir, "amidi-list");
+  if (list !== null) writeFileSync(listing, list + "\n");
+  // `amidi -l` prints the listing file (absent: only the header); anything else is recorded and fails.
+  writeFileSync(join(bin, "amidi"), `#!/bin/sh
+if [ "$1" = -l ] && [ $# -eq 1 ]; then
+  if [ -f "${listing}" ]; then cat "${listing}"; else echo "Dir Device    Name"; fi
+else echo "amidi $*" >> "${join(dir, "calls")}"; exit 99; fi
+`, { mode: 0o755 });
+  const env = { ...process.env, PATH: `${bin}:${process.env.PATH}`, CAPTURE_SND_DIR: snd };
+  return { dir, snd, listing, env, out: join(dir, "x.jsonl"), calls: join(dir, "calls") };
+}
+
+const fifo = (path) => {
+  const r = spawnSync("mkfifo", [path]);
+  assert.equal(r.status, 0, String(r.stderr));
+  return path;
+};
+
+// Runs tools/capture in the background; `done` resolves with { status, signal, stdout, stderr, ms }.
+function start(args, env) {
+  const t0 = Date.now();
+  const child = spawn(TOOL, args, { env, stdio: ["ignore", "pipe", "pipe"] });
+  let stdout = "", stderr = "";
+  child.stdout.on("data", (d) => (stdout += d));
+  child.stderr.on("data", (d) => (stderr += d));
+  const done = new Promise((resolve) => child.on("close", (status, signal) =>
+    resolve({ status, signal, stdout, stderr, ms: Date.now() - t0 })));
+  return { child, done };
+}
+
+// Opens the FIFO for writing once the capture's reader has it open (O_NONBLOCK, polled, so a capture that never
+// opens fails the test instead of hanging it), then writes the chunks `gap` ms apart.
+async function feed(path, chunks, { gap = 200, close = true } = {}) {
+  let fh;
+  for (const t0 = Date.now(); !fh; await sleep(10)) {
+    try {
+      fh = await open(path, constants.O_WRONLY | constants.O_NONBLOCK);
+    } catch (err) {
+      if (err.code !== "ENXIO" || Date.now() - t0 > 5000) throw err; // ENXIO: no reader yet
+    }
+  }
+  for (const c of chunks) {
+    await sleep(gap);
+    await fh.write(Uint8Array.from(c));
+  }
+  if (close) await fh.close();
+  return fh;
+}
+
+test("three chunks from a FIFO (a split pitch bend, a SysEx, running status) give one strict line per message", async () => {
+  const t = setup();
+  const dev = fifo(join(t.dir, "dev"));
+  const run = start(["--device", dev, "--out", t.out], t.env);
+  await feed(dev, [
+    [0xb0, 0x06, 0x5c, 0xe0, 0x15], // CC 6 = 92, then the first half of a pitch bend
+    [0x3d, 0xf0, 0x7e, 0x7f, 0x06], // the pitch bend's MSB, then a SysEx begins
+    [0x01, 0xf7, 0x90, 0x3c, 0x7f, 0x3c, 0x00], // the SysEx ends; note-on, and a running-status note-on velocity 0
+  ]);
+  const r = await run.done; // the writer closed: EOF ends the capture like a stop
+  assert.equal(r.status, 0, r.stderr);
+  const recs = readJsonl(t.out); // strict: keys, hex and derived values re-checked, t_us never going backwards
+  assert.deepEqual(recs.map((x) => [x.bytes, x.type, x.ch, x.d1, x.d2, x.value]), [
+    ["B0065C", "cc", 1, 6, 92, 92],
+    ["E0153D", "pb", 1, 21, 61, 7829],
+    ["F07E7F0601F7", "sysex", null, null, null, null],
+    ["903C7F", "on", 1, 60, 127, 127],
+    ["903C00", "on", 1, 60, 0, 0],
+  ]);
+  const [cc, pb, sx, on1, on2] = recs.map((x) => x.t_us);
+  for (let i = 1; i < recs.length; i++) assert.ok(recs[i].t_us >= recs[i - 1].t_us);
+  assert.ok(cc >= 100000, `the first read came ≈ 200 ms after the open (t_us ${cc})`);
+  // A split message takes the stamp of the read that completes it; messages from one read share a stamp.
+  assert.ok(pb - cc >= 100000, `pb ${pb} cc ${cc}`);
+  assert.ok(sx - pb >= 100000, `sysex ${sx} pb ${pb}`);
+  assert.equal(on1, sx);
+  assert.equal(on2, sx);
+  assert.match(r.stderr, /5 messages \(cc 1, pb 1, sysex 1, on 2\).*dropped 0/);
+  assert.equal(r.stdout, "");
+});
+
+test("--seconds 1 ends the capture by itself, counted from the open, with exit 0", async () => {
+  const t = setup();
+  const dev = fifo(join(t.dir, "dev"));
+  const run = start(["--device", dev, "--out", t.out, "--seconds", "1"], t.env);
+  const fh = await feed(dev, [[0xb0, 0x06, 0x01]], { close: false }); // the writer stays open: no EOF
+  const r = await run.done;
+  await fh.close();
+  assert.equal(r.status, 0, r.stderr);
+  assert.ok(r.ms >= 900 && r.ms < 4000, `took ${r.ms} ms`); // two Node start-ups on top of the second
+  assert.deepEqual(readJsonl(t.out).map((x) => x.bytes), ["B00601"]);
+  assert.match(r.stderr, /1 messages \(cc 1\), dropped 0, 1\.\d s/);
+});
