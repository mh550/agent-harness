+# Test fixtures
+
+| File | Source | What it holds |
+|---|---|---|
+| `three-notes.mid` | synthetic | The M1-05 replay fixture: three note-ons on channel 1, 100 ms apart, each with a real note-off 50 ms later (`tests/fixtures-three-notes.test.mjs`). |
+| `census-small.jsonl` | **synthetic**, hand-made for `tests/census.test.mjs` (M2-05); not a capture of any device | 140 M2 JSONL lines, 1 ms apart, on two channels. Channel 1: note 10 on (127) then off (the only note with a release), note 11 on (100) never released, pitch bend 0, 8192, 16383. Channel 2: CC 7 swept 0..127, and the 14-bit pair CC 9/41 sent as adjacent MSB, LSB pairs giving 0, 8192, 16383. |
+
+JSONL lines have exactly the seven keys of the M2 format (`docs/plans/2026-10-19-M2-capture-replay.md`), so a
+fixture can't carry a `note` key; this file is where a fixture says it is synthetic.
diff --git a/tests/jsonl.test.mjs b/tests/jsonl.test.mjs
new file mode 100644
index 0000000..43374c1
--- /dev/null
+++ b/tests/jsonl.test.mjs
@@ -0,0 +1,143 @@
+// tools/lib/jsonl.mjs is the only implementation of the M2 capture line format.
+// Spec: docs/plans/2026-10-19-M2-capture-replay.md, section "JSONL format".
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync, readFileSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { toRecord, formatLine, parseLine, readJsonl, createJsonlWriter } from "../tools/lib/jsonl.mjs";
+import { createParser } from "../tools/lib/midi-parse.mjs";
+
+const KEYS = ["t_us", "bytes", "type", "ch", "d1", "d2", "value"];
+const rec = (t_us, bytes) => {
+  const msgs = createParser().feed(Buffer.from(bytes, "hex"));
+  assert.equal(msgs.length, 1, bytes);
+  return toRecord(msgs[0], t_us);
+};
+
+test("the plan's three example lines come out byte for byte", () => {
+  assert.equal(formatLine(rec(2651000, "B0065C")), '{"t_us":2651000,"bytes":"B0065C","type":"cc","ch":1,"d1":6,"d2":92,"value":92}\n');
+  assert.equal(formatLine(rec(2651000, "E0153D")), '{"t_us":2651000,"bytes":"E0153D","type":"pb","ch":1,"d1":21,"d2":61,"value":7829}\n');
+  assert.equal(formatLine(rec(2673000, "B0065D")), '{"t_us":2673000,"bytes":"B0065D","type":"cc","ch":1,"d1":6,"d2":93,"value":93}\n');
+  assert.equal(formatLine(rec(10, "F07E7F0601F7")),
+    '{"t_us":10,"bytes":"F07E7F0601F7","type":"sysex","ch":null,"d1":null,"d2":null,"value":null}\n');
+});
+
+test("every message type maps to its type, channel, data and value", () => {
+  const cases = [
+    ["803C40", "off", 1, 60, 64, 64],
+    ["9F3C00", "on", 16, 60, 0, 0],
+    ["A13C11", "pat", 2, 60, 17, 17],
+    ["C305", "pc", 4, 5, null, 5],
+    ["D028", "cp", 1, 40, null, 40],
+    ["E0007F", "pb", 1, 0, 127, 16256],
+    ["E07F7F", "pb", 1, 127, 127, 16383],
+    ["E00040", "pb", 1, 0, 64, 8192],
+    ["F105", "mtc", null, 5, null, 5],
+    ["F20102", "spp", null, 1, 2, 257],
+    ["F303", "song", null, 3, null, 3],
+    ["F6", "tune", null, null, null, null],
+    ["F8", "clock", null, null, null, null],
+    ["FA", "start", null, null, null, null],
+    ["FB", "continue", null, null, null, null],
+    ["FC", "stop", null, null, null, null],
+    ["FE", "sense", null, null, null, null],
+    ["FF", "reset", null, null, null, null],
+  ];
+  for (const [bytes, type, ch, d1, d2, value] of cases) {
+    const r = rec(7, bytes);
+    assert.deepEqual(Object.keys(r), KEYS);
+    assert.deepEqual(r, { t_us: 7, bytes, type, ch, d1, d2, value }, bytes);
+  }
+});
+
+test("a truncated SysEx has no F7 in its bytes", () => {
+  const msgs = createParser().feed(Buffer.from("F07E01B0065C", "hex"));
+  assert.equal(msgs.length, 2);
+  assert.equal(toRecord(msgs[0], 0).bytes, "F07E01");
+  assert.equal(toRecord(msgs[0], 0).type, "sysex");
+  assert.deepEqual(parseLine(formatLine(toRecord(msgs[0], 0)), "x"), toRecord(msgs[0], 0));
+});
+
+test("parseLine reads back what formatLine writes", () => {
+  for (const bytes of ["B0065C", "E0153D", "C305", "F07E7F0601F7", "F8", "F20102", "F07E"]) {
+    const r = bytes === "F07E" ? toRecord({ status: 0xf0, data: [0x7e], truncated: true }, 3) : rec(3, bytes);
+    assert.deepEqual(parseLine(formatLine(r), "x:1"), r);
+    assert.deepEqual(parseLine(formatLine(r).trimEnd(), "x:1"), r);
+  }
+});
+
+test("parseLine is strict and names where", () => {
+  const good = { t_us: 1, bytes: "B0065C", type: "cc", ch: 1, d1: 6, d2: 92, value: 92 };
+  const line = (o) => JSON.stringify(o);
+  const bad = [
+    "not json",
+    "[1,2]",
+    line({ ...good, note: "hi" }),
+    line({ t_us: 1, bytes: "B0065C", type: "cc", ch: 1, d1: 6, d2: 92 }),
+    line({ bytes: "B0065C", t_us: 1, type: "cc", ch: 1, d1: 6, d2: 92, value: 92 }), // key order
+    line({ ...good, t_us: -1 }),
+    line({ ...good, t_us: 1.5 }),
+    line({ ...good, t_us: "1" }),
+    line({ ...good, bytes: "b0065c" }),
+    line({ ...good, bytes: "B0065" }),
+    line({ ...good, bytes: "" }),
+    line({ ...good, bytes: "B0065C5D" }), // trailing running-status message: two messages
+    line({ ...good, bytes: "065C" }), // no status
+    line({ ...good, bytes: "B006" }), // incomplete
+    line({ ...good, bytes: "B0F8065C" }), // real-time inside
+    line({ ...good, type: "on" }),
+    line({ ...good, ch: 2 }),
+    line({ ...good, d1: 7 }),
+    line({ ...good, d2: 93 }),
+    line({ ...good, value: 93 }),
+    line({ ...good, bytes: "F07EF7B0", type: "sysex", ch: null, d1: null, d2: null, value: null }),
+    line({ ...good, bytes: "F07EB0", type: "sysex", ch: null, d1: null, d2: null, value: null }),
+    '{"t_us":1,"t_us":2,"bytes":"B0065C","type":"cc","ch":1,"d1":6,"d2":92,"value":92}', // duplicate key
+    '{"t_us":1.0,"bytes":"B0065C","type":"cc","ch":1,"d1":6,"d2":92,"value":92}',
+    '{"t_us":1e3,"bytes":"B0065C","type":"cc","ch":1,"d1":6,"d2":92,"value":92}',
+    '{"t_us":-0,"bytes":"B0065C","type":"cc","ch":1,"d1":6,"d2":92,"value":92}',
+    '{"t_us": 1,"bytes":"B0065C","type":"cc","ch":1,"d1":6,"d2":92,"value":92}',
+    line(good) + "\r",
+    line(good) + "\n\n",
+  ];
+  for (const l of bad) assert.throws(() => parseLine(l, "f.jsonl:9"), /^Error: f\.jsonl:9: /, l);
+});
+
+test("createJsonlWriter writes one line per message, refuses to overwrite unless force", () => {
+  const dir = mkdtempSync(join(tmpdir(), "jsonl-"));
+  const path = join(dir, "x.jsonl");
+  const p = createParser();
+  const w = createJsonlWriter(path);
+  w.write(p.feed(Buffer.from("E0153DB0065C", "hex")), 2651000); // running status B0 carries into the next feed
+  w.write(p.feed(Buffer.from("065D", "hex")), 2673000);
+  w.write([], 2700000);
+  assert.equal(w.count, 3);
+  w.close();
+  const text = readFileSync(path, "utf8");
+  assert.equal(text.split("\n").length, 4);
+  assert.ok(text.endsWith("\n"));
+  assert.deepEqual(readJsonl(path).map((r) => [r.t_us, r.bytes]), [[2651000, "E0153D"], [2651000, "B0065C"], [2673000, "B0065D"]]);
+
+  assert.throws(() => createJsonlWriter(path), /EEXIST/);
+  const w2 = createJsonlWriter(path, { force: true });
+  w2.close();
+  assert.equal(readFileSync(path, "utf8"), "");
+  assert.deepEqual(readJsonl(path), []);
+});
+
+test("readJsonl rejects blank lines, a missing final newline and t_us going backwards, naming path:line", () => {
+  const dir = mkdtempSync(join(tmpdir(), "jsonl-"));
+  const a = formatLine(rec(5, "B0065C"));
+  const b = formatLine(rec(4, "B0065D"));
+  const write = (name, text) => {
+    const path = join(dir, name);
+    writeFileSync(path, text);
+    return path;
+  };
+  assert.throws(() => readJsonl(write("back.jsonl", a + b)), /back\.jsonl:2: .*backwards/);
+  assert.throws(() => readJsonl(write("blank.jsonl", a + "\n" + a)), /blank\.jsonl:2: /);
+  assert.throws(() => readJsonl(write("noeol.jsonl", a + a.trimEnd())), /noeol\.jsonl:2: .*newline/);
+  assert.throws(() => readJsonl(write("crlf.jsonl", a.replace("\n", "\r\n"))), /crlf\.jsonl:1: /);
+  assert.equal(readJsonl(write("ok.jsonl", a + a)).length, 2);
+});
