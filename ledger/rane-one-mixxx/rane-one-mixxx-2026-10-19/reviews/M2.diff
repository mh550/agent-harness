diff --git a/tests/replay.test.mjs b/tests/replay.test.mjs
new file mode 100644
index 0000000..4b46d31
--- /dev/null
+++ b/tests/replay.test.mjs
@@ -0,0 +1,408 @@
+// tools/replay: JSONL → SMF (1 tick = 1 ms) → tools/midi-send play. The ALSA tools are stubs on PATH that log
+// every call, so these tests never touch a real MIDI port; HOME is a temp dir, so the gate is never armed.
+// Spec: docs/plans/2026-10-19-M2-capture-replay.md, section "Replay".
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { mkdtempSync, writeFileSync, readFileSync, chmodSync, existsSync, readdirSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+import { readSmfFile } from "../tools/lib/smf.mjs";
+import { readJsonl } from "../tools/lib/jsonl.mjs";
+
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), "..");
+const SCRIPT = join(ROOT, "tools", "replay");
+const QUICK = join(ROOT, "captures", "2026-10-19-quick", "platter.jsonl");
+
+const hex = (bytes) => Buffer.from(bytes).toString("hex").toUpperCase();
+
+// Canonical M2 lines for the messages the fixtures use.
+function line(t_us, bytes) {
+  const b = Buffer.from(bytes, "hex");
+  const s = b[0];
+  const ch = s < 0xf0 ? (s & 0x0f) + 1 : null;
+  let rec;
+  if (s === 0xf0) rec = { type: "sysex", ch: null, d1: null, d2: null, value: null };
+  else if ((s & 0xf0) === 0xb0) rec = { type: "cc", ch, d1: b[1], d2: b[2], value: b[2] };
+  else if ((s & 0xf0) === 0x90) rec = { type: "on", ch, d1: b[1], d2: b[2], value: b[2] };
+  else if ((s & 0xf0) === 0x80) rec = { type: "off", ch, d1: b[1], d2: b[2], value: b[2] };
+  else if ((s & 0xf0) === 0xe0) rec = { type: "pb", ch, d1: b[1], d2: b[2], value: b[1] | (b[2] << 7) };
+  else if (s === 0xf8) rec = { type: "clock", ch: null, d1: null, d2: null, value: null };
+  else if (s === 0xf2) rec = { type: "spp", ch: null, d1: b[1], d2: b[2], value: b[1] | (b[2] << 7) };
+  else throw new Error(`fixture: no line for ${bytes}`);
+  return JSON.stringify({ t_us, bytes, ...rec }) + "\n";
+}
+
+// 0–60 s: a CC 6 every 250 ms with odd µs offsets, a pitch bend between each, a note pair, and a SysEx, a clock
+// and a song position the replay must drop.
+function fixture(dir) {
+  let text = "";
+  for (let i = 0; i < 240; i++) {
+    const t = i * 250000 + (i % 7) * 137 + (i % 2 ? 499 : 501);
+    text += line(t, hex([0xb0, 0x06, i % 128]));
+    text += line(t + 1, hex([0xe0, i % 128, (i * 3) % 128]));
+    if (i === 100) text += line(t + 1, "903C7F") + line(t + 2, "F07E7F0601F7") + line(t + 2, "F8") + line(t + 2, "F21020");
+    if (i === 120) text += line(t + 5, "803C00");
+  }
+  text += line(59999999, "B00600");
+  const path = join(dir, "fixture.jsonl");
+  writeFileSync(path, text);
+  return path;
+}
+
+const ACONNECT_OUT = `client 14: 'Midi Through' [type=kernel]
+    0 'Midi Through Port-0'
+client 24: 'Rane ONE' [type=kernel,card=2]
+    0 'Rane ONE MIDI 1 '`;
+const MIXXX = `client 128: 'PortMidi' [type=user,pid=4242]
+    0 'Mixxx in        '
+	Connected From: 14:0
+    1 'Mixxx out       '`;
+const LIST_PLAIN = `${ACONNECT_OUT}
+${MIXXX}`;
+
+// Stub ALSA tools that append "<tool> <args>" to calls.log; aplaymidi also keeps a copy of the file it was given.
+function setup({ out = ACONNECT_OUT, list = LIST_PLAIN } = {}) {
+  const dir = mkdtempSync(join(tmpdir(), "replay-"));
+  const log = join(dir, "calls.log");
+  const stub = (name, body) => {
+    writeFileSync(join(dir, name), `#!/usr/bin/env bash\necho "${name} $*" >> "${log}"\n${body}\n`);
+    chmodSync(join(dir, name), 0o755);
+  };
+  stub("amidi", `echo "Dir Device    Name"; echo "IO  hw:2,0,0  Rane ONE MIDI 1"`);
+  const listing = list === null ? "exit 1" : `cat <<'EOF'\n${list}\nEOF`;
+  stub("aconnect", `if [[ $1 == -l ]]; then\n${listing}\nelse cat <<'EOF'\n${out}\nEOF\nfi`);
+  stub("aplaymidi", `cp -- "\${@: -1}" "${join(dir, "played.mid")}"`);
+  return { dir, log, calls: () => (existsSync(log) ? readFileSync(log, "utf8") : "") };
+}
+
+function replay(t, args, { env = {} } = {}) {
+  return spawnSync(SCRIPT, args, {
+    encoding: "utf8",
+    cwd: t.dir,
+    env: { ...process.env, PATH: `${t.dir}:${process.env.PATH}`, HOME: t.dir, TMPDIR: t.dir, ...env },
+  });
+}
+
+// SMF events (meta dropped) → [{ tick, bytes: hex }].
+const smfEvents = (path) =>
+  readSmfFile(path).events.filter((e) => e.kind !== "meta").map((e) => ({ tick: e.tick, bytes: hex(e.bytes) }));
+
+// The JSONL records a replay keeps (channel messages in [from, to)), with their exact scaled time in µs.
+function expected(path, { from = 0, to = Infinity, speed = 1 } = {}) {
+  return readJsonl(path)
+    .filter((r) => r.t_us >= from * 1e6 && r.t_us < to * 1e6 && r.ch !== null)
+    .map((r) => ({ bytes: r.bytes, us: (r.t_us - from * 1e6) / speed }));
+}
+
+function assertMatches(events, want) {
+  assert.equal(events.length, want.length, "event count");
+  for (let i = 0; i < want.length; i++) {
+    assert.equal(events[i].bytes, want[i].bytes, `event ${i} bytes`);
+    assert.ok(Math.abs(events[i].tick * 1000 - want[i].us) <= 500, `event ${i}: tick ${events[i].tick} vs ${want[i].us} µs`);
+  }
+}
