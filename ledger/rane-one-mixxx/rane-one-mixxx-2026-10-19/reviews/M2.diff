+import { join, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+import { toRecord } from "../tools/lib/jsonl.mjs";
+import { census, parseCsv, readMk2, diffCensus, formatCsv, HEADER, DIFF_HEADER } from "../tools/lib/census.mjs";
+import { readCensusCsv as readCensusCsvRows } from "../tools/lib/census.mjs";
+
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), "..");
+const TOOL = join(ROOT, "tools", "census");
+const SMALL = "tests/fixtures/census-small.jsonl";
+const PLATTER = "captures/2026-10-19-quick/platter.jsonl";
+const MK1 = join(ROOT, "reference/rane-one-mk1-midi-map.csv");
+
+const run = (args, cwd = ROOT) => spawnSync(TOOL, args, { encoding: "utf8", cwd });
+
+// CSV text → { comments, header, rows: [{column: value}] }; leading "#" lines are comments.
+function readCensusCsv(text) {
+  const lines = text.split("\n");
+  const comments = [];
+  while (lines[0]?.startsWith("#")) comments.push(lines.shift());
+  const table = parseCsv(lines.join("\n"));
+  const header = table.shift();
+  return { comments, header, rows: table.map((r) => Object.fromEntries(header.map((h, i) => [h, r[i]]))) };
+}
+
+// Records from [status, d1, d2?] triples, 1 ms apart.
+const recs = (...msgs) => msgs.map(([status, ...data], i) => toRecord({ status, data }, i * 1000));
+const one = (records, opts) => census([{ file: "x.jsonl", records }], opts);
+
+test("the fixture gives the plan's columns, one row per control, sorted by channel, then number (empty first)", () => {
+  const r = run([SMALL]);
+  assert.equal(r.status, 0, r.stderr);
+  const { comments, header, rows } = readCensusCsv(r.stdout);
+  assert.deepEqual(header, ["control", "status", "channel", "number", "min", "max", "sends_on_release",
+    "pair_14bit_msb", "pair_14bit_lsb", "shift", "source_file"]);
+  assert.deepEqual(header, HEADER);
+  assert.match(comments[0], /^# rane-one-mk1-midi-map · tools\/census tests\/fixtures\/census-small\.jsonl · \d{4}-\d{2}-\d{2}$/);
+  assert.deepEqual(rows.map((x) => [x.control, x.status, x.channel, x.number]), [
+    ["pb ch1", "E0", "1", ""],
+    ["note ch1 10", "90", "1", "10"],
+    ["note ch1 11", "90", "1", "11"],
+    ["cc ch2 7", "B0", "2", "7"],
+    ["cc ch2 9", "B0", "2", "9"],
+  ]);
+  const by = Object.fromEntries(rows.map((x) => [x.control, x]));
+  // Only the note with a release sends on release.
+  assert.deepEqual(rows.filter((x) => x.sends_on_release === "true").map((x) => x.control), ["note ch1 10"]);
+  assert.deepEqual(rows.map((x) => x.sends_on_release), ["false", "true", "false", "false", "false"]);
+  // The sweep is 0/127; the pair is one row, MSB/LSB filled, combined 14-bit range; CC 41 has no row of its own.
+  assert.deepEqual([by["cc ch2 7"].min, by["cc ch2 7"].max], ["0", "127"]);
+  assert.deepEqual([by["cc ch2 7"].pair_14bit_msb, by["cc ch2 7"].pair_14bit_lsb], ["", ""]);
+  const pair = by["cc ch2 9"];
+  assert.deepEqual([pair.pair_14bit_msb, pair.pair_14bit_lsb, pair.min, pair.max], ["9", "41", "0", "16383"]);
+  assert.equal(rows.some((x) => x.number === "41"), false);
+  assert.deepEqual([by["pb ch1"].min, by["pb ch1"].max], ["0", "16383"]);
+  assert.deepEqual([by["note ch1 10"].min, by["note ch1 10"].max], ["127", "127"]);
+  assert.deepEqual([by["note ch1 11"].min, by["note ch1 11"].max], ["100", "100"]);
+  // No --shift: the column is empty. Every row came from the fixture.
+  assert.ok(rows.every((x) => x.shift === "" && x.source_file === SMALL));
+  assert.match(r.stderr, /140 messages/);
