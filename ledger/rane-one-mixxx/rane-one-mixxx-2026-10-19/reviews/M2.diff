+  const t = setup();
+  const dev = fifo(join(t.dir, "dev"));
+  const t0 = Date.now();
+  const child = spawn(TOOL, ["--device", dev, "--out", t.out], { env: t.env, stdio: ["ignore", "ignore", "pipe"], detached: true });
+  let stderr = "";
