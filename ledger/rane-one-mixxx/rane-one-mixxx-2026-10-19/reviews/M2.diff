+// tools/lib/smf.mjs reads and writes Standard MIDI Files: arecordmidi's captures in, files for aplaymidi out.
+// Spec: docs/plans/2026-10-19-M2-capture-replay.md, section "SMF library".
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync, readFileSync, readdirSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { readSmf, writeSmf, ticksToMicros, readSmfFile, writeSmfFile } from "../tools/lib/smf.mjs";
+
+const chunk = (type, body) => {
+  const head = Buffer.alloc(8);
+  head.write(type, 0, "latin1");
+  head.writeUInt32BE(body.length, 4);
+  return Buffer.concat([head, Buffer.from(body)]);
+};
+const mthd = (format, ntrks, division) => chunk("MThd", [0, format, 0, ntrks, division >> 8, division & 0xff]);
+const smf = (format, division, ...tracks) =>
+  Buffer.concat([mthd(format, tracks.length, division), ...tracks.map((t) => chunk("MTrk", t))]);
+
+// A hand-made format-0 file the way arecordmidi writes one, plus running status and a SysEx.
+const TRACK = [
+  0x00, 0xff, 0x51, 0x03, 0x0f, 0x42, 0x40, // tick 0: tempo 1000000 µs per quarter
+  0x00, 0xff, 0x58, 0x04, 0x04, 0x02, 0x18, 0x08, // tick 0: time signature 4/4
+  0x94, 0x5b, 0xb0, 0x06, 0x5c, // tick 2651 (VLQ 94 5B): CC 6 = 92
+  0x00, 0xe0, 0x15, 0x3d, // tick 2651: pitch bend 7829
+  0x16, 0x90, 0x3c, 0x64, // tick 2673: note on 60
+  0x7f, 0x3c, 0x00, // tick 2800: running status, note on 60 velocity 0
+  0x81, 0x00, 0xf0, 0x05, 0x7e, 0x7f, 0x06, 0x01, 0xf7, // tick 2928 (VLQ 81 00): SysEx F0 7E 7F 06 01 F7
+  0x00, 0xff, 0x2f, 0x00, // end of track
+];
+const HAND = smf(0, 1000, TRACK);
+
+const hex = (bytes) => Buffer.from(bytes).toString("hex").toUpperCase();
+const summary = (events) => events.map((e) => [e.tick, e.kind, hex(e.bytes)]);
+
+test("a hand-made format-0 file reads with its header, ticks, running status resolved and SysEx", () => {
+  const s = readSmf(HAND);
+  assert.equal(s.format, 0);
+  assert.equal(s.division, 1000);
+  assert.equal(s.tracks.length, 1);
+  assert.deepEqual(summary(s.events), [
+    [0, "meta", "FF51030F4240"],
+    [0, "meta", "FF580404021808"],
+    [2651, "midi", "B0065C"],
+    [2651, "midi", "E0153D"],
+    [2673, "midi", "903C64"],
+    [2800, "midi", "903C00"],
+    [2928, "sysex", "F07E7F0601F7"],
+    [2928, "meta", "FF2F00"],
+  ]);
+  assert.deepEqual(s.events[0].meta.type, 0x51);
+  assert.deepEqual([...s.events[0].meta.data], [0x0f, 0x42, 0x40]);
+});
+
+test("readSmf → writeSmf → readSmf round-trips with identical events and ticks", () => {
+  const first = readSmf(HAND);
+  const notMeta = first.events.filter((e) => e.kind !== "meta");
+  const written = writeSmf({ division: 1000, tempo: 1000000, events: notMeta });
+  const second = readSmf(written);
+  assert.equal(second.format, 0);
+  assert.equal(second.division, 1000);
+  assert.deepEqual(summary(second.events.filter((e) => e.kind !== "meta")), summary(notMeta));
+  // The writer puts the tempo at tick 0 and the end of track after the last event.
+  const metas = second.events.filter((e) => e.kind === "meta").map((e) => [e.tick, hex(e.bytes)]);
+  assert.deepEqual(metas, [[0, "FF51030F4240"], [2928, "FF2F00"]]);
+  // Writing what was read again gives the same bytes.
+  assert.deepEqual(writeSmf({ division: 1000, tempo: 1000000, events: second.events.filter((e) => e.kind !== "meta") }), written);
+});
+
+test("the writer always writes the status byte (no running status) and a SysEx as F0 <len> <data…F7>", () => {
+  const events = readSmf(HAND).events.filter((e) => e.kind !== "meta");
+  const buf = writeSmf({ events });
+  const body = [...buf.subarray(22)]; // past MThd (14) and the MTrk header (8)
+  assert.deepEqual(body.slice(0, 7), [0x00, 0xff, 0x51, 0x03, 0x0f, 0x42, 0x40]);
+  assert.deepEqual(body.slice(7), [
+    0x94, 0x5b, 0xb0, 0x06, 0x5c, 0x00, 0xe0, 0x15, 0x3d, 0x16, 0x90, 0x3c, 0x64, 0x7f, 0x90, 0x3c, 0x00,
+    0x81, 0x00, 0xf0, 0x05, 0x7e, 0x7f, 0x06, 0x01, 0xf7, 0x00, 0xff, 0x2f, 0x00,
+  ]);
+  assert.deepEqual([...buf.subarray(0, 14)], [...mthd(0, 1, 1000)]);
+});
+
+// Delta-time VLQs of exactly 1, 2 and 3 bytes, at both ends of each length.
+const VLQ = [
+  [0x00, [0x00]],
+  [0x7f, [0x7f]],
+  [0x80, [0x81, 0x00]],
+  [0x3fff, [0xff, 0x7f]],
+  [0x4000, [0x81, 0x80, 0x00]],
+  [0x1fffff, [0xff, 0xff, 0x7f]],
+];
+
+test("variable-length quantities of 1, 2 and 3 bytes read correctly", () => {
+  for (const [value, enc] of VLQ) {
+    const s = readSmf(smf(0, 96, [...enc, 0xb0, 0x01, 0x02, 0x00, 0xff, 0x2f, 0x00]));
+    assert.deepEqual(summary(s.events), [[value, "midi", "B00102"], [value, "meta", "FF2F00"]], `VLQ ${value}`);
+  }
+});
+
+test("variable-length quantities of 1, 2 and 3 bytes are written correctly", () => {
+  for (const [value, enc] of VLQ) {
+    const buf = writeSmf({ division: 96, tempo: 500000, events: [{ tick: value, kind: "midi", bytes: Uint8Array.of(0xb0, 1, 2) }] });
+    const body = [...buf.subarray(22 + 7)]; // past the headers and the tick-0 tempo
+    assert.deepEqual(body.slice(0, enc.length + 3), [...enc, 0xb0, 0x01, 0x02], `VLQ ${value}`);
+  }
+  // A 4-byte VLQ is still allowed when reading; a 5-byte one is an error.
+  const four = readSmf(smf(0, 96, [0x81, 0x80, 0x80, 0x00, 0xb0, 1, 2, 0x00, 0xff, 0x2f, 0x00]));
+  assert.equal(four.events[0].tick, 0x200000);
+  assert.throws(() => readSmf(smf(0, 96, [0x81, 0x80, 0x80, 0x80, 0x00, 0xb0, 1, 2, 0x00, 0xff, 0x2f, 0x00])), /VLQ/);
+});
+
+test("division 1000 + tempo 1000000 gives 1000 µs per tick", () => {
+  const us = ticksToMicros(readSmf(HAND));
+  assert.equal(us(0), 0);
+  assert.equal(us(1), 1000);
+  assert.equal(us(2651), 2651000);
+  assert.equal(us(48390), 48390000);
+  const written = readSmf(writeSmf({ division: 1000, tempo: 1000000, events: [] }));
+  assert.equal(ticksToMicros(written)(7), 7000);
+});
+
+test("no tempo event means 500000 µs per quarter; a mid-file tempo change applies from its tick on", () => {
+  const plain = readSmf(smf(0, 96, [0x00, 0xb0, 1, 2, 0x00, 0xff, 0x2f, 0x00]));
+  assert.equal(ticksToMicros(plain)(96), 500000);
+  assert.equal(ticksToMicros(plain)(1), 5208); // 500000 / 96 = 5208.33, rounded
+  assert.equal(ticksToMicros(plain)(2), 10417); // 10416.67 rounds up, floor would give 10416
+  assert.equal(ticksToMicros(readSmf(smf(0, 2, [0x00, 0xff, 0x51, 0x03, 0, 0, 3, 0x00, 0xff, 0x2f, 0x00])))(1), 2); // 1.5 rounds half up
+  const changing = readSmf(smf(0, 100, [
+    0x00, 0xff, 0x51, 0x03, 0x0f, 0x42, 0x40, // tick 0: 1000000 µs per quarter → 10000 µs per tick
+    0x32, 0xff, 0x51, 0x03, 0x07, 0xa1, 0x20, // tick 50: 500000 µs per quarter → 5000 µs per tick
+    0x32, 0xb0, 1, 2, // tick 100
+    0x00, 0xff, 0x2f, 0x00,
+  ]));
+  const us = ticksToMicros(changing);
+  assert.equal(us(50), 500000);
+  assert.equal(us(100), 750000);
+  assert.equal(us(25), 250000);
+  assert.equal(us(51), 505000);
+});
+
+test("an F7 escape is kind sysex with escape: true, its raw bytes as they are, even when they start with F0", () => {
+  const s = readSmf(smf(0, 96, [0x00, 0xf7, 0x02, 0xf0, 0x7e, 0x0a, 0xf7, 0x02, 0x01, 0xf7, 0x00, 0xf0, 0x02, 0x01, 0xf7, 0x00, 0xff, 0x2f, 0x00]));
+  assert.deepEqual(s.events.map((e) => [e.tick, e.kind, hex(e.bytes), e.escape === true]), [
+    [0, "sysex", "F07E", true], [10, "sysex", "01F7", true], [10, "sysex", "F001F7", false], [10, "meta", "FF2F00", false],
+  ]);
+  // The writer can't carry an escape (aplaymidi may not honour it).
+  assert.throws(() => writeSmf({ events: [s.events[0]] }), /escape/);
+});
+
+test("format 1 tracks merge by tick, stable in track order", () => {
+  const s = readSmf(smf(1, 96,
+    [0x00, 0xff, 0x51, 0x03, 0x07, 0xa1, 0x20, 0x0a, 0xb0, 1, 1, 0x00, 0xff, 0x2f, 0x00],
+    [0x0a, 0xb1, 2, 2, 0x05, 0xb1, 3, 3, 0x00, 0xff, 0x2f, 0x00]));
+  assert.equal(s.format, 1);
+  assert.equal(s.tracks.length, 2);
+  assert.deepEqual(summary(s.events.filter((e) => e.kind === "midi")), [[10, "midi", "B00101"], [10, "midi", "B10202"], [15, "midi", "B10303"]]);
+});
+
+test("unknown chunks and extra header bytes are skipped", () => {
+  const head = chunk("MThd", [0, 0, 0, 1, 0x03, 0xe8, 0xaa, 0xbb]);
+  const buf = Buffer.concat([head, chunk("XFIH", [1, 2, 3]), chunk("MTrk", [0x05, 0xb0, 6, 7, 0x00, 0xff, 0x2f, 0x00])]);
+  const s = readSmf(buf);
+  assert.equal(s.division, 1000);
+  assert.deepEqual(summary(s.events), [[5, "midi", "B00607"], [5, "meta", "FF2F00"]]);
+});
+
+test("meta and SysEx events cancel running status", () => {
+  assert.throws(() => readSmf(smf(0, 96, [0x00, 0xb0, 1, 2, 0x00, 0xff, 0x01, 0x00, 0x00, 3, 4, 0x00, 0xff, 0x2f, 0x00])), /running status/);
+  assert.throws(() => readSmf(smf(0, 96, [0x00, 0xb0, 1, 2, 0x00, 0xf0, 0x01, 0xf7, 0x00, 3, 4, 0x00, 0xff, 0x2f, 0x00])), /running status/);
+  assert.throws(() => readSmf(smf(0, 96, [0x00, 0xb0, 1, 2, 0x00, 0xf7, 0x01, 0xf8, 0x00, 3, 4, 0x00, 0xff, 0x2f, 0x00])), /running status/);
+});
+
+test("errors: a truncated track, SMPTE division, format 2, a missing MThd, data with no status", () => {
+  assert.throws(() => readSmf(smf(0, 1000, [0x00, 0xb0, 0x06])), /truncated|end of track/);
+  assert.throws(() => readSmf(smf(0, 1000, [0x00, 0xb0, 0x06, 0x5c])), /end of track/);
+  assert.throws(() => readSmf(smf(0, 0xe728, [0x00, 0xff, 0x2f, 0x00])), /SMPTE/);
+  assert.throws(() => readSmf(smf(2, 96, [0x00, 0xff, 0x2f, 0x00])), /format 2/);
+  assert.throws(() => readSmf(Buffer.from("RIFF0000")), /MThd/);
+  assert.throws(() => readSmf(smf(0, 96, [0x00, 0x06, 0x5c, 0x00, 0xff, 0x2f, 0x00])), /status/);
+  // Errors name the byte offset.
+  assert.throws(() => readSmf(smf(0, 0xe728, [0x00, 0xff, 0x2f, 0x00])), /offset 12/);
+});
+
+test("the writer rejects what an SMF for aplaymidi can't carry, and out-of-order ticks", () => {
+  const w = (bytes, tick = 0) => () => writeSmf({ events: [{ tick, kind: bytes[0] === 0xf0 ? "sysex" : "midi", bytes: Uint8Array.from(bytes) }] });
+  assert.throws(w([0xf8]), /F8/);
+  assert.throws(w([0xf2, 1, 2]), /F2/);
+  assert.throws(w([0xf0, 0x7e, 0x01]), /truncated SysEx/);
+  assert.throws(w([0xb0, 0x06]), /B006/);
+  assert.throws(w([0xb0, 0x06, 0x80]), /B00680/);
+  assert.throws(w([0xb0, 0x06, 0x5c], -1), /tick/);
+  assert.throws(() => writeSmf({ events: [
+    { tick: 5, kind: "midi", bytes: Uint8Array.of(0xb0, 6, 1) },
+    { tick: 4, kind: "midi", bytes: Uint8Array.of(0xb0, 6, 2) },
+  ] }), /order/);
+  assert.throws(() => writeSmf({ division: 0x8000, events: [] }), /division/);
+  assert.throws(() => writeSmf({ tempo: 0x1000000, events: [] }), /tempo/);
+});
+
+test("readSmfFile/writeSmfFile go through a temp file and rename", () => {
+  const dir = mkdtempSync(join(tmpdir(), "smf-"));
+  const path = join(dir, "x.mid");
+  const events = readSmf(HAND).events.filter((e) => e.kind !== "meta");
+  writeSmfFile(path, { division: 1000, tempo: 1000000, events });
+  assert.deepEqual(readdirSync(dir), ["x.mid"]);
+  assert.deepEqual(readFileSync(path), writeSmf({ division: 1000, tempo: 1000000, events }));
+  assert.deepEqual(summary(readSmfFile(path).events.filter((e) => e.kind !== "meta")), summary(events));
+});
