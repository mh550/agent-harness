+  // A message on another channel in between does not break adjacency; any other message on the same channel does
+  // (a CC or, as the plan says "on that channel", a note).
+  rows = one(recs([0xb0, 2, 1], [0xb1, 5, 5], [0xb0, 34, 1], [0xb0, 2, 2], [0xb0, 7, 0], [0xb0, 34, 2]));
