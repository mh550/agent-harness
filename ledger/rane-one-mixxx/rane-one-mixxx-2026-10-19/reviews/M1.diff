+    END {
+      queue[1] = start; seen[start] = 1; head = 1; tail = 1
+      while (head <= tail) {
+        p = queue[head++]; split(p, cp, ":")
+        next_ports = to[p]; if (user[cp[1]]) next_ports = next_ports ports[cp[1]]
+        k = split(next_ports, a, " ")
+        for (i = 1; i <= k; i++) if (!(a[i] in seen)) { seen[a[i]] = 1; queue[++tail] = a[i] }
+      }
+      for (p in seen) { split(p, cp, ":"); if (tolower(name[cp[1]]) ~ /rane/) { print name[cp[1]]; exit } }
+    }' <<< "$conns") || { echo "refused: cannot parse aconnect -l, cannot rule out a route to the Rane One" >&2
+    exit 3; }
+  [[ -z $rane ]] || {
+    echo "refused: $dest is subscribed onward to '$rane' and $ARM is absent (aconnect -l)" >&2; exit 3; }
+fi
 case $mode in
   raw)  exec amidi -p "$dest" -S "$*" ;;
-  play) exec aplaymidi -p "$dest" "$@" ;;
+  play) exec aplaymidi -p "$dest" -- "$1" ;;
 esac
diff --git a/tools/mixxx-dev b/tools/mixxx-dev
new file mode 100755
index 0000000..7f10017
--- /dev/null
+++ b/tools/mixxx-dev
@@ -0,0 +1,285 @@
+#!/usr/bin/env bash
+# The dev Mixxx: Flatpak org.mixxx.Mixxx on the dev profile, its audio routed to the mixxx-dev null sink (D7, D9).
+# It only ever stops the instance it started, by the id in $PROFILE/mixxx-dev.instance.
+#   tools/mixxx-dev start|stop|status|log [n]
+# start: seed the profile, launch detached, then wait for a new mixxx.log and the version line on stdout and check
+#   that every mixxx-dev stream is on the mixxx-dev sink; any failure after the launch stops that Mixxx again.
+# stop: `flatpak kill <id>`, never by app name. status: `<id> running` (exit 0) or exactly `stopped` (exit 1),
+#   which tools/null-sink relies on. log: the last n (default 50) lines of $PROFILE/mixxx.log.
+# Env: MIXXX_DEV_PROFILE, MIXXX_DEV_NULL_SINK (the null-sink tool), MIXXX_DEV_PROC (default /proc), and the
+#   whole-second timeouts MIXXX_DEV_LOG_TIMEOUT (60), MIXXX_DEV_ROUTE_TIMEOUT (30), MIXXX_DEV_STOP_TIMEOUT (10).
+# start and stop hold $PROFILE/mixxx-dev.lock; while it is held, start and stop refuse and status prints `busy`.
+# Exit: 0 ok · 1 failed, refused or stopped · 2 usage · 3 refused (the real Mixxx profile, a symlink)
+set -euo pipefail
+export LC_ALL=C # pactl and flatpak labels are parsed below
+here=$(cd "$(dirname "$0")" && pwd)
+# shellcheck source=lib/profile.sh
+source "$here/lib/profile.sh"
+APP=org.mixxx.Mixxx
+SINK=mixxx-dev
+usage() { sed -n 4p "$0" >&2; exit 2; }
+case ${1:-} in
+  start|stop|status) (( $# == 1 )) || usage ;;
+  log) (( $# <= 2 )) && [[ ${2:-50} =~ ^[1-9][0-9]*$ ]] || usage ;;
+  *) usage ;;
+esac
+for t in LOG:60 ROUTE:30 STOP:10; do
+  var=MIXXX_DEV_${t%%:*}_TIMEOUT
+  val=${!var:-${t#*:}}
+  [[ $val =~ ^(0|[1-9][0-9]{0,3})$ ]] || { echo "$var must be whole seconds, not '$val'" >&2; usage; }
+  printf -v "${t%%:*}_TIMEOUT" %s "$val"
+done
+profile_guard
+inst_file=$PROFILE/mixxx-dev.instance
+lock_file=$PROFILE/mixxx-dev.lock
+log_file=$PROFILE/mixxx.log
+proc=${MIXXX_DEV_PROC:-/proc}
+for f in "$inst_file" "$lock_file"; do
+  [[ ! -L $f ]] || { echo "refused: $f is a symlink" >&2; exit 3; }
+done
+
+now() { echo "${EPOCHREALTIME//[.,]/}"; } # µs
+# The id in the instance file, or empty when there is none. Anything but one number is an error, never guessed
+# at: `flatpak kill` also takes an app name, which would kill every Mixxx.
+read_id() {
+  [[ -e $inst_file ]] || return 0
+  local id
+  id=$(< "$inst_file") || exit 1
+  [[ $id =~ ^[0-9]+$ ]] || { echo "$inst_file holds no instance id; fix or remove it by hand" >&2; exit 1; }
+  echo "$id"
+}
+# 0 when `flatpak ps` lists instance $1 as a running org.mixxx.Mixxx, 1 when it does not, 2 when `flatpak ps`
+# failed: that is "maybe running", never "not running".
+is_running() {
+  local ps
+  ps=$(flatpak ps --columns=instance,application) || { echo "flatpak ps failed" >&2; return 2; }
+  awk -v id="$1" -v app=$APP '$1 == id && $2 == app { f = 1 } END { exit !f }' <<< "$ps"
+}
+# Takes the lock on fd 9 (start and stop), or refuses. The launch closes fd 9 so Mixxx does not inherit it.
+lock() {
+  mkdir -p -- "$PROFILE"
+  exec 9>> "$lock_file"
+  flock -n 9 || { echo "refused: another tools/mixxx-dev start or stop holds $lock_file" >&2; exit 1; }
+}
+stop_id() {
+  flatpak kill "$1" || true
+  local end=$(( $(now) + STOP_TIMEOUT * 1000000 )) rc
+  while :; do
+    rc=0; is_running "$1" || rc=$?
+    (( rc != 1 )) || break
+    (( $(now) < end )) || { echo "instance $1 may still run ${STOP_TIMEOUT}s after flatpak kill; kept $inst_file" >&2
+      return 1; }
+    sleep 0.2
+  done
+  rm -f -- "$inst_file"
+  echo "stopped $1"
+}
+
+case $1 in
+  log)
+    [[ -f $log_file ]] || { echo "no $log_file" >&2; exit 1; }
+    tail -n "${2:-50}" -- "$log_file"
+    exit 0 ;;
+
+  status)
+    if [[ -e $lock_file ]] && ! flock -n "$lock_file" true; then echo "busy (a start or stop is running)"; exit 0; fi
+    id=$(read_id)
+    rc=1
+    [[ -z $id ]] || { is_running "$id" && rc=0 || rc=$?; }
+    case $rc in
+      0) echo "$id running"; exit 0 ;;
+      1) echo stopped; exit 1 ;;
+      *) exit 1 ;;
+    esac ;;
+
+  stop)
+    [[ -d $PROFILE ]] || { echo "no $PROFILE; nothing stopped"; exit 0; }
+    lock # a start in progress has no instance file yet: wait for nothing, refuse
+    id=$(read_id)
+    [[ -n $id ]] || { echo "no $inst_file; nothing stopped"; exit 0; }
+    rc=0; is_running "$id" || rc=$?
+    (( rc != 2 )) || exit 1
+    if (( rc == 1 )); then
+      rm -f -- "$inst_file"
+      echo "instance $id is not a running $APP; forgot it, nothing stopped"
+      exit 0
+    fi
+    stop_id "$id" || exit 1
+    exit 0 ;;
+esac
+
+# --- start ---------------------------------------------------------------------------------------------------
+# The sandbox sees only its own data dir (and HOME is the real home inside), so a profile elsewhere would make
+# Mixxx fall back to a fresh profile somewhere we do not check.
+sandbox=$(realpath -m -- "$HOME/.var/app/$APP")
+[[ $PROFILE == "$sandbox"/?* ]] || { echo "refused: $PROFILE is outside $sandbox, which the Flatpak can see" >&2
+  exit 3; }
+for f in mixxx.cfg soundconfig.xml mixxxdb.sqlite mixxx.log mixxx-dev.stdout controllers music; do
+  [[ ! -L $PROFILE/$f ]] || { echo "refused: $PROFILE/$f is a symlink" >&2; exit 3; }
+done
+[[ -n ${WAYLAND_DISPLAY:-} ]] || { echo "refused: WAYLAND_DISPLAY is unset; Mixxx needs the desktop session" >&2
+  exit 1; }
+"${MIXXX_DEV_NULL_SINK:-$here/null-sink}" status > /dev/null || {
+  echo "refused: the $SINK null sink is not up (tools/null-sink up); Mixxx would play to the default sink" >&2
+  exit 1; }
+# Mixxx opens Midi Through's output too: a subscription from (or to) a Rane client would connect it to the
+# controller (D9 night rule).
+conns=$(aconnect -l) || { echo "aconnect -l failed" >&2; exit 1; }
+rane=$(awk '
+  /^client [0-9]+: / { c = $2; sub(":", "", c); n = $0; sub(/^client [0-9]+: \047/, "", n); sub(/\047.*/, "", n)
+    name[c] = n; port = ""; next }
+  /^ +[0-9]+ \047/ { port = $1; next }
+  /^\t(Connecting To|Connected From): / && name[c] == "Midi Through" && port == "0" {
+    l = $0; sub(/^\t[^:]*: /, "", l); k = split(l, a, /, */)
+    for (i = 1; i <= k; i++) { split(a[i], cp, ":"); peer[cp[1]] } }
+  END { for (p in peer) if (tolower(name[p]) ~ /rane/) print name[p] }' <<< "$conns")
+[[ -z $rane ]] || { echo "refused: Midi Through Port-0 is connected to '$rane' (aconnect -l)" >&2; exit 1; }
+
+lock
+id=$(read_id)
+if [[ -n $id ]]; then
+  rc=0; is_running "$id" || rc=$?
+  (( rc != 0 )) || { echo "already running: $id"; exit 0; }
+  (( rc == 1 )) || exit 1
+fi
+
+# ok: at least one mixxx-dev stream, all on the mixxx-dev sink · none: no such stream yet · bad <sinks>: one is
+# elsewhere · error: pactl failed. A stream not linked yet (Sink 4294967295, PA_INVALID_INDEX; seen live right
+# after launch) plays nowhere: it is neither routed nor misrouted. Streams with another application.name (a Mixxx Michael runs) are ignored.
+route() {
+  local sinks inputs
+  sinks=$(pactl list short sinks) && inputs=$(pactl list sink-inputs) || { echo error; return; }
+  awk -F'\t' -v n=$SINK '
+    function flush() {
+      if (ours && sink != "4294967295") { if (sink in dev) good++; else bad = bad " " sink }
+      ours = 0 }
+    FNR == NR { if ($2 == n) dev[$1]; next }
+    /^Sink Input #/ { flush(); sink = ""; next }
+    /^\tSink: / { sink = substr($0, 8); next }
+    $0 == "\t\tapplication.name = \"" n "\"" { ours = 1 }
+    END { flush(); if (bad != "") print "bad" bad; else print (good ? "ok" : "none") }' \
+    <(printf '%s\n' "$sinks") - <<< "$inputs"
+}
+
+# A mixxx-dev stream before the launch is a dev Mixxx we do not track: it would pass the routing check for us.
+case $(route) in
+  none) ;;
+  error) echo "pactl failed" >&2; exit 1 ;;
+  *) echo "refused: a $SINK stream already plays (pactl list sink-inputs); an untracked dev Mixxx?" >&2; exit 1 ;;
+esac
+version=$(flatpak info "$APP" | awk '$1 == "Version:" { print $2; exit }')
+[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+ ]] || { echo "flatpak info $APP gave no version ('$version')" >&2; exit 1; }
+node "$here/lib/dev-seed.mjs" "$PROFILE" "$version"
+old_inode=$(stat -c %i -- "$log_file" 2> /dev/null || true)
+before=$(flatpak ps --columns=instance,application) || { echo "flatpak ps failed" >&2; exit 1; }
+
+# From the launch on, every exit that is not the final success (a failed check, set -e, a signal) stops the
+# instance, or, before its id is known, names any new org.mixxx.Mixxx instance for a human to check.
+id= launcher= tmp_inst= done=
+on_exit() {
+  [[ -z $done ]] || return 0
+  if [[ -n $id ]]; then
+    echo "start did not finish; stopping instance $id" >&2
+    stop_id "$id" >&2 || true
+  else
+    [[ -z $launcher ]] || kill "$launcher" 2> /dev/null || true
+    local new
+    new=$(flatpak ps --columns=instance,application | awk -v app=$APP 'NR == FNR { seen[$1]; next }
+      $2 == app && !($1 in seen) { print $1 }' <(printf '%s\n' "$before") - | paste -sd' ') || new="(flatpak ps failed)"
+    echo "flatpak run gave no instance id; new $APP instances, not stopped: ${new:-none}." \
+      "See $PROFILE/mixxx-dev.stdout" >&2
+  fi
+  [[ -z $tmp_inst ]] || rm -f -- "$tmp_inst"
+}
+trap on_exit EXIT
+trap 'exit 1' INT TERM HUP
+fail() {
+  echo "FAIL: $*" >&2
+  exit 1
+}
+
+rm -f -- "$inst_file"
+tmp_inst=$(mktemp -- "$PROFILE/.mixxx-dev.instance.XXXXXX")
+# Detached (setsid, no --die-with-parent) so Mixxx outlives this shell; fd 3 receives the instance id, fd 9 (the
+# lock) is closed so Mixxx does not hold it.
+setsid flatpak run --env=PULSE_SINK=$SINK --env=PULSE_PROP_OVERRIDE=application.name=$SINK --instance-id-fd=3 \
+  "$APP" --settings-path "$PROFILE" --controller-debug --controller-abort-on-warning --developer \
+  --log-flush-level debug \
+  3> "$tmp_inst" > "$PROFILE/mixxx-dev.stdout" 2>&1 < /dev/null 9>&- &
+launcher=$!
+t0=$(now)
+log_end=$(( t0 + LOG_TIMEOUT * 1000000 ))
+route_end=$(( t0 + ROUTE_TIMEOUT * 1000000 ))
+
+while :; do
+  got=$(< "$tmp_inst") || got=
+  if [[ $got =~ ^[0-9]+$ ]]; then
+    mv -f -T -- "$tmp_inst" "$inst_file"
+    tmp_inst= id=$got
+    break
+  fi
+  (( $(now) < log_end )) && kill -0 "$launcher" 2> /dev/null || exit 1
+  sleep 0.1
+done
+# Started: a new mixxx.log (Mixxx renames the old one to mixxx.log.1), and the version line on this launch's
+# stdout. Mixxx 2.5.6 logs its version only at Debug in the default category, which --controller-debug keeps out
+# of mixxx.log (src/util/logging.cpp); upgrade.cpp prints this line before logging starts, once mixxx.cfg's
+# Version (set by the seed) equals the running binary's (D10).
+started() {
+  local ino
+  [[ ! -L $log_file ]] || fail "$log_file is a symlink"
+  ino=$(stat -c %i -- "$log_file" 2> /dev/null) || return 1
+  [[ $ino != "$old_inode" && -s $log_file ]] &&
+    grep -qxF "Configuration file is at the current version \"$version\"" -- "$PROFILE/mixxx-dev.stdout"
+}
+log_ok= route_ok=
+while :; do
+  [[ -n $log_ok ]] || ! started || log_ok=1
+  state=$(route)
+  case $state in
+    ok) route_ok=1 ;;
+    error) fail "pactl failed" ;;
+    bad*) fail "a $SINK stream is on sink(s)${state#bad}, not on $SINK (pactl list sink-inputs)" ;;
+  esac
+  [[ -n $log_ok && -n $route_ok ]] && break
+  t=$(now)
+  [[ -n $log_ok ]] || (( t < log_end )) || fail "no new $log_file, or no Mixxx $version line in $PROFILE/mixxx-dev.stdout, in ${LOG_TIMEOUT}s"
+  [[ -n $route_ok ]] || (( t < route_end )) ||
+    fail "no stream named $SINK on the $SINK sink in ${ROUTE_TIMEOUT}s (pactl list sink-inputs)"
+  rc=0; is_running "$id" || rc=$?
+  (( rc != 1 )) || fail "Mixxx exited during startup; see $log_file and $PROFILE/mixxx-dev.stdout"
+  (( rc != 2 )) || fail "flatpak ps failed"
+  sleep 0.25
+done
+
+# Second, independent check: the sandbox has devices=all, so Mixxx could open the Rane ONE's PCM directly,
+# which pactl would not show. No Rane playback substream may be owned by a process of this instance.
+pids=$(flatpak ps --columns=instance,pid,child-pid | awk -v id="$id" '$1 == id { print $2; print $3 }') ||
+  fail "flatpak ps failed"
+[[ -n $pids ]] || fail "flatpak ps lists no pid for instance $id"
+cards=$(awk '/^ *[0-9]+ \[/ && tolower($0) ~ /rane/ { print $1 }' "$proc/asound/cards" 2> /dev/null || true)
+for card in $cards; do
+  for status in "$proc/asound/card$card"/pcm*p/sub*/status; do
+    [[ -f $status ]] || continue
+    p=$(sed -n 's/^owner_pid[[:space:]]*:[[:space:]]*\([0-9]\+\).*/\1/p' "$status")
+    # Walk up from the owner: a process of this instance descends from its wrapper or sandbox pid.
+    for (( i = 0; i < 64; i++ )); do
+      [[ $p =~ ^[0-9]+$ ]] && (( p > 1 )) || break
+      ! grep -qx -- "$p" <<< "$pids" || fail "Mixxx holds the Rane ONE playback PCM directly ($status)"
+      stat=$(cat -- "$proc/$p/stat" 2> /dev/null) || break
+      read -r _ p _ <<< "${stat##*) }"
+    done
+  done
+done
+
+# Mixxx writes its sound config back after setup; a different API or device means our routing was not used.
+sc=$PROFILE/soundconfig.xml
+api=$(sed -n 's/.*<SoundManagerConfig[^>]* api="\([^"]*\)".*/\1/p' "$sc" | sort -u | paste -sd,) || api=
+devices=$(grep -o '<SoundDevice [^>]*' "$sc" | sed -n 's/.* name="\([^"]*\)".*/\1/p' | sort -u | paste -sd,) ||
+  devices=
+[[ $api == ALSA && $devices == pulse ]] ||
+  fail "soundconfig.xml now says api '$api', devices '$devices' (written: ALSA, pulse)"
+state=$(route)
+[[ $state == ok ]] || fail "the $SINK stream moved off the $SINK sink"
+done=1
+echo "running: $id (stream on $SINK; log $log_file)"
diff --git a/tools/null-sink b/tools/null-sink
new file mode 100755
index 0000000..6f5f2c9
--- /dev/null
+++ b/tools/null-sink
@@ -0,0 +1,110 @@
+#!/usr/bin/env bash
+# The mixxx-dev PipeWire null sink that unattended Mixxx audio goes to (D7, D9). Never changes the default sink.
+#   tools/null-sink up|down|status
+# up: load module-null-sink (48 kHz, 2 ch) unless a mixxx-dev sink exists; its id goes to $PROFILE/null-sink.module.
+# down: unload only that id; refuses while a stream is on mixxx-dev or the dev Mixxx may run (PipeWire would move
+#   the stream to the default sink, the Rane One). status: `mixxx-dev <id>`, `mixxx-dev (not ours)` or `absent`.
+# Env: NULL_SINK_SETTLE (whole seconds `up` watches the default sink, default 2), MIXXX_DEV_LAUNCHER.
+# Exit: 0 ok · 1 failed, refused or absent · 2 usage · 3 refused (the real Mixxx profile)
+set -euo pipefail
+here=$(cd "$(dirname "$0")" && pwd)
+# shellcheck source=lib/profile.sh
+source "$here/lib/profile.sh"
+SINK=mixxx-dev
+usage() { sed -n 3p "$0" >&2; exit 2; }
+(( $# == 1 )) || usage
+case $1 in up|down|status) ;; *) usage ;; esac
+settle=${NULL_SINK_SETTLE:-2}
+[[ $settle =~ ^[0-9]+$ ]] || { echo "NULL_SINK_SETTLE must be whole seconds, not '$settle'" >&2; usage; }
+profile_guard
+module_file=$PROFILE/null-sink.module
+[[ ! -L $module_file ]] || { echo "refused: $module_file is a symlink" >&2; exit 3; }
+
+# Every sink named mixxx-dev, one index per line (normally one). A pactl failure exits the tool via pipefail
+# when the caller assigns the result.
+sink_indexes() { pactl list short sinks | awk -F'\t' -v n="$SINK" '$2 == n { print $1 }'; }
+default_sink() { pactl info | sed -n 's/^Default Sink: //p'; }
+# The id in the module file, or empty when there is no file; a file without an id is an error (exit 1), never
+# silently treated as absent, so an id we may still own is not forgotten.
+our_id() {
+  [[ -e $module_file ]] || return 0
+  local id
+  id=$(sed -n '1{/^[0-9]\+$/p}' "$module_file") || exit 1
+  [[ -n $id ]] || { echo "$module_file holds no module id; fix or remove it by hand" >&2; exit 1; }
+  echo "$id"
+}
+# True when module id $1 is still a module-null-sink with sink_name=mixxx-dev (ids are reused after unload).
+# A pactl failure exits the tool (never read as "not ours", which would forget the id).
+is_our_module() {
+  local mods
+  mods=$(pactl list short modules) || exit 1
+  awk -F'\t' -v id="$1" -v n=" sink_name=$SINK " '
+    $1 == id && $2 == "module-null-sink" && index(" " $3 " ", n) { f = 1 } END { exit !f }' <<< "$mods"
+}
+# The dev Mixxx counts as stopped only when its launcher answers exactly that; any other answer, or a launcher
+# named in MIXXX_DEV_LAUNCHER that is missing, counts as possibly running. Without tools/mixxx-dev (before
+# M1-04) only the stream check guards `down`.
+mixxx_stopped() {
+  local launcher=${MIXXX_DEV_LAUNCHER:-$here/mixxx-dev} out rc=0
+  if [[ ! -x $launcher ]]; then [[ -z ${MIXXX_DEV_LAUNCHER:-} && ! -e $launcher ]]; return; fi
+  out=$("$launcher" status 2> /dev/null) || rc=$?
+  (( rc == 1 )) && [[ $out == stopped ]]
+}
+write_id() {
+  local tmp
+  tmp=$(mktemp -- "$PROFILE/.null-sink.module.XXXXXX") || return 1
+  echo "$1" > "$tmp" && mv -f -T -- "$tmp" "$module_file" || { rm -f -- "$tmp"; return 1; }
+}
+
+case $1 in
+  status)
+    idx=$(sink_indexes)
+    [[ -n $idx ]] || { echo absent; exit 1; }
+    id=$(our_id)
+    if [[ -n $id ]] && is_our_module "$id"; then echo "$SINK $id"; else echo "$SINK (not ours)"; fi ;;
+
+  up)
+    idx=$(sink_indexes)
+    if [[ -n $idx ]]; then echo "$SINK already exists; nothing loaded"; exit 0; fi
+    # Everything that can fail before the load does, so a loaded module always ends up recorded or unloaded.
+    mkdir -p -- "$PROFILE"
+    [[ -w $PROFILE && ( ! -e $module_file || -f $module_file ) ]] || {
+      echo "cannot record the module id in $module_file" >&2; exit 1; }
+    before=$(default_sink)
+    id=$(pactl load-module module-null-sink sink_name=$SINK rate=48000 channels=2 \
+      sink_properties=device.description=$SINK)
+    [[ $id =~ ^[0-9]+$ ]] || { echo "pactl load-module printed '$id', not a module id" >&2; exit 1; }
+    if ! write_id "$id"; then
+      pactl unload-module "$id"
+      echo "could not write $module_file; unloaded module $id" >&2; exit 1
+    fi
+    # WirePlumber may pick a new default asynchronously: compare now and every 0.25 s for $settle seconds.
+    for (( i = 0; i <= settle * 4; i++ )); do
+      (( i == 0 )) || sleep 0.25
+      if [[ $(default_sink) != "$before" ]]; then
+        pactl unload-module "$id" && rm -f -- "$module_file"
+        echo "the default sink changed from '$before' after loading $SINK; unloaded module $id" >&2
+        exit 1
+      fi
+    done
+    echo "$SINK up (module $id); default sink still $before" ;;
+
+  down)
+    id=$(our_id)
+    if [[ -z $id ]]; then echo "no $module_file; nothing unloaded"; exit 0; fi
+    if ! is_our_module "$id"; then
+      echo "module $id is no longer our $SINK null sink; nothing unloaded" >&2
+      rm -f -- "$module_file"; exit 0
+    fi
+    mixxx_stopped || { echo "refused: the dev Mixxx may be running; run tools/mixxx-dev stop first" >&2; exit 1; }
+    idx=$(sink_indexes)
+    inputs=$(pactl list short sink-inputs)
+    if awk -F'\t' 'NR == FNR { s[$1]; next } $2 in s { f = 1 } END { exit !f }' <(echo "$idx") - <<< "$inputs"
+    then
+      echo "refused: a stream is playing to $SINK; removing it would move that stream to the default sink" >&2
+      exit 1
+    fi
+    pactl unload-module "$id"
+    rm -f -- "$module_file"
+    echo "$SINK down (unloaded module $id)" ;;
+esac
