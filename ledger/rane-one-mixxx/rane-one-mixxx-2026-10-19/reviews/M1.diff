@@ -11,15 +12,46 @@ usage() { sed -n 4,5p "$0" >&2; exit 2; }
 mode=$1 dest=$2; shift 2
 case $mode in
   raw)  name=$(amidi -l | awk -v d="$dest" '$2 == d { $1 = ""; $2 = ""; sub(/^ +/, ""); print; exit }') ;;
-  play) [[ $dest =~ ^([0-9]+):[0-9]+$ ]] || usage
-        name=$(aconnect -o | sed -n "s/^client ${BASH_REMATCH[1]}: '\\(.*\\)'.*/\\1/p" | head -1) ;;
+  play) # One file, never an option: aplaymidi would read `-p 24:0` or `--port=24:0` anywhere as more ports.
+        (( $# == 1 )) && [[ $1 != -* ]] || usage
+        [[ $dest =~ ^([0-9]{1,3}):([0-9]{1,3})$ ]] || usage
+        # Normalised (no leading zeros), so the route check and aplaymidi see the same address.
+        dest=$((10#${BASH_REMATCH[1]})):$((10#${BASH_REMATCH[2]}))
+        name=$(aconnect -o | sed -n "s/^client ${dest%%:*}: '\\(.*\\)' \\[.*/\\1/p" | head -1) ;;
   *)    usage ;;
 esac
 [[ -n $name ]] || { echo "refused: $dest is not a known MIDI destination" >&2; exit 4; }
 if [[ ${name,,} == *rane* && ! -f $ARM ]]; then
   echo "refused: $dest is '$name' and $ARM is absent (Michael must be at the controller)" >&2; exit 3
 fi
+# A seq port forwards to every port subscribed to it (Midi Through does so in the kernel, port by port), so
+# follow its `Connecting To` subscriptions, transitively, and refuse if any reaches a Rane client. A user client
+# may pass what one of its ports receives out of another (a bridge, Mixxx itself), so reaching any port of a user
+# client follows all of its ports. Fails closed.
