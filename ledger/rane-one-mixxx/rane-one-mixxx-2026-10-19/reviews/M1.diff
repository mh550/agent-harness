+// tools/lib/dev-seed.mjs writes the files a fresh dev Mixxx needs so it starts without a modal dialog
+// (plan "Dev profile seed"): the mixxx.cfg keys, a launcher-owned soundconfig.xml and the library database.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync, mkdirSync, writeFileSync, readFileSync, existsSync, readdirSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import { applyCfg, SOUNDCONFIG, seed } from "../tools/lib/dev-seed.mjs";
+
+// mixxx.cfg as Mixxx writes it: `[Group]`, then `Key Value` lines, a blank line between groups.
+const parse = (text) => {
+  const out = {};
+  let group = null;
+  for (const line of text.split("\n")) {
+    const m = /^\[(.*)\]$/.exec(line);
+    if (m) { group = m[1]; out[group] ??= {}; continue; }
+    if (!line.trim()) continue;
+    const i = line.indexOf(" ");
+    out[group][i < 0 ? line : line.slice(0, i)] = i < 0 ? "" : line.slice(i + 1);
+  }
+  return out;
+};
+const MAPPING = "/home/x/.var/app/org.mixxx.Mixxx/dev-profile/controllers/Rane-One.midi.xml";
+
+test("applyCfg on an empty file sets the version, both dialog keys and the Midi Through binding", () => {
