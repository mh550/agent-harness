+++ b/tests/midi-parse.test.mjs
@@ -0,0 +1,251 @@
+// tools/lib/midi-parse.mjs turns a raw MIDI byte stream into messages; capture, replay and census share it.
+// The last tests run it over the real quick capture (captures/2026-10-19-quick/platter.mid).
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { join, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+import { createParser, describe } from "../tools/lib/midi-parse.mjs";
+
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), "..");
+
+const parseAll = (...feeds) => {
+  const p = createParser();
+  return feeds.flatMap((bytes) => p.feed(bytes));
+};
+
+test("three-byte channel messages: CC, note on/off, pitch bend", () => {
+  assert.deepEqual(parseAll([0xb0, 6, 92, 0x90, 60, 100, 0x80, 60, 0, 0xe0, 0x15, 0x3d]), [
+    { status: 0xb0, data: [6, 92] },
+    { status: 0x90, data: [60, 100] },
+    { status: 0x80, data: [60, 0] },
+    { status: 0xe0, data: [0x15, 0x3d] },
+  ]);
+});
+
+test("two-byte channel messages: program change and channel pressure", () => {
+  assert.deepEqual(parseAll([0xc3, 5, 0xd0, 40]), [
+    { status: 0xc3, data: [5] },
+    { status: 0xd0, data: [40] },
+  ]);
+});
+
+test("note-on with velocity 0 stays a note-on", () => {
+  assert.deepEqual(parseAll([0x90, 60, 0]), [{ status: 0x90, data: [60, 0] }]);
+});
+
+test("running status reuses the last channel status, also across a feed boundary", () => {
+  const p = createParser();
+  assert.deepEqual(p.feed([0xb0, 6, 92, 6]), [{ status: 0xb0, data: [6, 92] }]);
+  assert.deepEqual(p.feed([93, 6, 94]), [
+    { status: 0xb0, data: [6, 93] },
+    { status: 0xb0, data: [6, 94] },
+  ]);
+  assert.deepEqual(p.feed([0xc0, 1, 2]), [
+    { status: 0xc0, data: [1] },
+    { status: 0xc0, data: [2] },
+  ]);
+});
+
+test("bytes split mid-message complete on the next feed, one byte at a time", () => {
+  const bytes = [0xb0, 6, 92, 0xe0, 0x15, 0x3d, 0x90, 0, 127];
+  const p = createParser();
+  const out = bytes.flatMap((b) => p.feed(Uint8Array.of(b)));
+  assert.deepEqual(out, parseAll(bytes));
+  assert.equal(out.length, 3);
+});
+
+test("a SysEx split across two feeds is emitted once, payload without F0/F7", () => {
+  const p = createParser();
+  assert.deepEqual(p.feed([0xf0, 0x00, 0x20, 0x7f]), []);
+  assert.deepEqual(p.feed(Buffer.from([0x01, 0x02, 0x03, 0xf7, 0xb0, 6, 1])), [
+    { status: 0xf0, data: [0x00, 0x20, 0x7f, 0x01, 0x02, 0x03] },
+    { status: 0xb0, data: [6, 1] },
+  ]);
+});
+
+test("SysEx clears running status; a status byte inside SysEx truncates it", () => {
+  // Data byte 5 after the SysEx has no running status: dropped.
+  assert.deepEqual(parseAll([0xb0, 6, 1, 0xf0, 1, 0xf7, 5]), [
+    { status: 0xb0, data: [6, 1] },
+    { status: 0xf0, data: [1] },
+  ]);
+  assert.deepEqual(parseAll([0xf0, 1, 2, 0x90, 60, 1]), [
+    { status: 0xf0, data: [1, 2], truncated: true },
+    { status: 0x90, data: [60, 1] },
+  ]);
+});
+
+test("SysEx payload is capped at 65536 bytes and emitted truncated", () => {
+  const p = createParser();
+  const out = p.feed([0xf0, ...new Array(65536 + 10).fill(1), 0xf7]);
+  assert.equal(out.length, 1);
+  assert.equal(out[0].data.length, 65536);
+  assert.equal(out[0].truncated, true);
+});
+
+test("real-time 0xF8 inside running status and mid-message emits at once and does not reset status", () => {
+  assert.deepEqual(parseAll([0xb0, 6, 0xf8, 92, 6, 0xf8], [93, 0xfe, 0xf0, 1, 0xf8, 2, 0xf7]), [
+    { status: 0xf8, data: [] },
+    { status: 0xb0, data: [6, 92] },
+    { status: 0xf8, data: [] },
+    { status: 0xb0, data: [6, 93] },
+    { status: 0xfe, data: [] },
+    { status: 0xf8, data: [] },
+    { status: 0xf0, data: [1, 2] },
+  ]);
+});
+
+test("system common messages take their data bytes and clear running status", () => {
+  assert.deepEqual(parseAll([0xb0, 6, 1, 0xf2, 0x52, 0x09, 0xf1, 0x12, 0xf3, 3, 0xf6, 7, 7]), [
+    { status: 0xb0, data: [6, 1] },
+    { status: 0xf2, data: [0x52, 0x09] },
+    { status: 0xf1, data: [0x12] },
+    { status: 0xf3, data: [3] },
+    { status: 0xf6, data: [] },
+  ]);
+});
+
+test("errors never throw: stray data, undefined bytes and stray F7 are dropped and counted", () => {
+  const p = createParser();
+  assert.deepEqual(p.feed([1, 2, 0xf4, 0xf5, 0xf7, 0xb0, 6, 9]), [{ status: 0xb0, data: [6, 9] }]);
+  assert.equal(p.stats.dropped, 5);
+  assert.equal(p.stats.messages, 1);
+  // A status byte in the middle of a message abandons the partial message; dropped counts its 2 bytes.
+  assert.deepEqual(p.feed([0x90, 60, 0xb0, 7, 8]), [{ status: 0xb0, data: [7, 8] }]);
+  assert.equal(p.stats.dropped, 7);
+  // A non-byte element mid-message abandons it too, so its neighbours never form a fake CC 1=3.
+  assert.deepEqual(p.feed([0xb0, 1, 2.5, 3]), []);
+  assert.equal(p.stats.dropped, 10);
+  assert.deepEqual(p.feed([0x100, -1, NaN, undefined]), []);
+  assert.deepEqual(p.feed(42), []);
+  assert.deepEqual(p.feed(null), []);
+  const hostile = { [Symbol.iterator]: () => { throw new Error("x"); } };
+  assert.deepEqual(p.feed(hostile), []);
+  assert.deepEqual(p.feed(new Proxy({}, { get() { throw new Error("g"); } })), []);
+  p.reset();
+  assert.deepEqual(p.stats, { messages: 0, dropped: 0 });
+  assert.deepEqual(p.feed([6, 92]), []);
+});
+
+test("pitch bend decodes 14 bits to 0..16383 (lsb | msb << 7)", () => {
+  assert.equal(describe({ status: 0xe0, data: [0, 0] }), "pb ch1 0");
+  assert.equal(describe({ status: 0xe0, data: [0, 0x40] }), "pb ch1 8192");
+  assert.equal(describe({ status: 0xef, data: [0x7f, 0x7f] }), "pb ch16 16383");
+  assert.equal(describe({ status: 0xe0, data: [0x15, 0x3d] }), "pb ch1 7829");
+});
+
+test("describe renders every message kind", () => {
+  const cases = [
+    [{ status: 0xb0, data: [6, 92] }, "cc ch1 6=92"],
+    [{ status: 0x90, data: [60, 100] }, "on ch1 60=100"],
+    [{ status: 0x83, data: [60, 0] }, "off ch4 60=0"],
+    [{ status: 0xa0, data: [60, 12] }, "pat ch1 60=12"],
+    [{ status: 0xc0, data: [5] }, "pc ch1 5"],
+    [{ status: 0xd0, data: [40] }, "cp ch1 40"],
+    [{ status: 0xf0, data: [0x00, 0x20, 0x7f, 0x01, 0x02, 0x03] }, "sysex 6: 00 20 7f 01 02 03"],
+    [{ status: 0xf0, data: [1], truncated: true }, "sysex 1: 01 truncated"],
+    [{ status: 0xf1, data: [0x12] }, "mtc 0x12"],
+    [{ status: 0xf2, data: [0x52, 0x09] }, "spp 1234"],
+    [{ status: 0xf3, data: [3] }, "song 3"],
+    [{ status: 0xf6, data: [] }, "tune"],
+    [{ status: 0xf8, data: [] }, "clock"],
+    [{ status: 0xfa, data: [] }, "start"],
+    [{ status: 0xfb, data: [] }, "continue"],
+    [{ status: 0xfc, data: [] }, "stop"],
+    [{ status: 0xfe, data: [] }, "sense"],
+    [{ status: 0xff, data: [] }, "reset"],
+  ];
+  for (const [msg, text] of cases) assert.equal(describe(msg), text);
+  assert.equal(describe({ status: 0xf0, data: [] }), "sysex 0:");
+  for (const bad of [null, {}, { status: 0xb0, data: null }, { status: 0xb0, data: 5 }, { status: 0xf0, data: "ab" }]) {
+    assert.equal(describe(bad), "invalid");
+  }
+  const long = describe({ status: 0xf0, data: new Array(40).fill(0x7f) });
+  assert.equal(long, `sysex 40: ${new Array(32).fill("7f").join(" ")} …`);
+});
+
+// Minimal SMF walk: concatenates the channel-event bytes of every track, skipping delta times, meta and SysEx
+// events. This is a reconstruction: the capture went through the ALSA sequencer, so whether the Rane used
+// running status (or note-on velocity 0 for note-off) on the wire is unknown. arecordmidi writes a status byte
+// on every event.
+function smfChannelBytes(file) {
+  const out = [];
+  let pos = 14; // past MThd
+  while (pos < file.length) {
+    const end = pos + 8 + file.readUInt32BE(pos + 4);
+    pos += 8;
+    let status = 0;
+    const varLen = () => { let v = 0, b; do { b = file[pos++]; v = (v << 7) | (b & 0x7f); } while (b & 0x80); return v; };
+    while (pos < end) {
+      varLen(); // delta time
+      if (file[pos] & 0x80) status = file[pos++];
+      if (status === 0xff) { pos++; const len = varLen(); pos += len; continue; } // meta (read len first: `pos += f()` reads pos before f runs)
+      if (status === 0xf0 || status === 0xf7) { const len = varLen(); pos += len; continue; } // SysEx
+      const n = (status & 0xe0) === 0xc0 ? 1 : 2;
+      out.push(status, ...file.subarray(pos, pos + n));
+      pos += n;
+    }
+  }
+  return out;
+}
+
+const CAPTURE = "captures/2026-10-19-quick/platter.mid";
+
+function counts(messages) {
+  const c = { cc: 0, pb: 0, on: 0, off: 0, other: 0 };
+  for (const m of messages) {
+    const kind = m.status & 0xf0;
+    if (kind === 0xb0) c.cc++;
+    else if (kind === 0xe0) c.pb++;
+    else if (kind === 0x90) c.on++;
+    else if (kind === 0x80) c.off++;
+    else c.other++;
+  }
+  return c;
+}
+
+test(`the quick capture (${CAPTURE}) parses to 29323 CC, 29323 pitch bend and 4 notes`, () => {
+  const bytes = smfChannelBytes(readFileSync(join(ROOT, CAPTURE)));
+  const p = createParser();
+  const messages = p.feed(Uint8Array.from(bytes));
+  assert.equal(messages.length, 58650);
+  assert.deepEqual(counts(messages), { cc: 29323, pb: 29323, on: 2, off: 2, other: 0 });
+  assert.equal(p.stats.dropped, 0);
+  // Cross-check with the aseqdump listing (platter.txt): first events are CC 6 = 92, then pitch bend -363.
+  assert.equal(describe(messages[0]), "cc ch1 6=92");
+  assert.equal(describe(messages[1]), `pb ch1 ${8192 - 363}`);
+});
+
+// Feeds `bytes` in chunks of 1..7 bytes (deterministic LCG) and collects the messages.
+function feedInChunks(p, bytes) {
+  const got = [];
+  let seed = 1;
+  for (let i = 0; i < bytes.length; ) {
+    seed = (seed * 1103515245 + 12345) % 2 ** 31;
+    const n = 1 + (seed % 7);
+    got.push(...p.feed(bytes.slice(i, i + n)));
+    i += n;
+  }
+  return got;
+}
+
+test("the quick capture parses identically in random feed splits with clock bytes interleaved", () => {
+  const bytes = smfChannelBytes(readFileSync(join(ROOT, CAPTURE)));
+  const expected = createParser().feed(bytes);
+  const withClock = bytes.flatMap((b, i) => (i % 5 === 2 ? [0xf8, b] : [b]));
+  const got = feedInChunks(createParser(), withClock);
+  assert.equal(got.filter((m) => m.status === 0xf8).length, Math.ceil((bytes.length - 2) / 5));
+  assert.deepEqual(got.filter((m) => m.status !== 0xf8), expected);
+});
+
+test("the capture's CC 6 stream re-encoded with running status parses to the same messages", () => {
+  // CC and pitch bend alternate in the capture, so running status only shortens a single-status stream.
+  const bytes = smfChannelBytes(readFileSync(join(ROOT, CAPTURE)));
+  const cc = createParser().feed(bytes).filter((m) => m.status === 0xb0);
+  const rs = [0xb0, ...cc.flatMap((m) => m.data)];
+  const p = createParser();
+  assert.deepEqual(feedInChunks(p, rs), cc);
+  assert.equal(cc.length, 29323);
+  assert.equal(p.stats.dropped, 0);
+});
