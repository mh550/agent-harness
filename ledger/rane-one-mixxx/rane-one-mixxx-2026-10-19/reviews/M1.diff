+
+test("seed rewrites soundconfig.xml every time but leaves an existing database alone", () => {
+  const profile = join(mkdtempSync(join(tmpdir(), "dev-seed-")), "dev-profile");
+  mkdirSync(profile);
+  writeFileSync(join(profile, "soundconfig.xml"), '<SoundManagerConfig api="JACK Audio Connection Kit"/>');
+  writeFileSync(join(profile, "mixxxdb.sqlite"), "Mixxx's own database");
+  seed(profile, "2.5.6");
+  assert.equal(readFileSync(join(profile, "soundconfig.xml"), "utf8"), SOUNDCONFIG);
+  assert.equal(readFileSync(join(profile, "mixxxdb.sqlite"), "utf8"), "Mixxx's own database");
+});
diff --git a/tests/fixtures-three-notes.test.mjs b/tests/fixtures-three-notes.test.mjs
new file mode 100644
index 0000000..40392b2
--- /dev/null
+++ b/tests/fixtures-three-notes.test.mjs
@@ -0,0 +1,53 @@
+// tests/fixtures/three-notes.mid is the M1-05 replay fixture: SMF format 0, 480 ticks per quarter at 120 bpm,
+// three Note-ons on channel 1 (status 90) 100 ms apart, each with a real Note-off (status 80) 50 ms later.
+// Real Note-offs, not Note-on velocity 0, so Mixxx's log shows exactly three status-90 lines.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { join, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const FIXTURE = join(dirname(fileURLToPath(import.meta.url)), "fixtures", "three-notes.mid");
+
+// Reads a format-0 SMF with explicit status bytes; returns its events with absolute times in ms.
+function readSmf(buf) {
+  assert.equal(buf.toString("latin1", 0, 4), "MThd");
+  assert.equal(buf.readUInt32BE(4), 6);
+  const [format, tracks, division] = [buf.readUInt16BE(8), buf.readUInt16BE(10), buf.readUInt16BE(12)];
+  assert.equal(buf.toString("latin1", 14, 18), "MTrk");
+  const end = 22 + buf.readUInt32BE(18);
+  assert.equal(end, buf.length, "track length covers the rest of the file");
+  let i = 22, ticks = 0, tempo = 500000;
+  const events = [];
+  const vlq = () => { let v = 0, b; do { b = buf[i++]; v = (v << 7) | (b & 0x7f); } while (b & 0x80); return v; };
+  while (i < end) {
+    ticks += vlq();
+    const ms = (ticks * tempo) / division / 1000;
+    const status = buf[i++];
+    if (status === 0xff) {
+      const type = buf[i++], len = vlq(), data = [...buf.subarray(i, i + len)];
+      i += len;
+      if (type === 0x51) tempo = (data[0] << 16) | (data[1] << 8) | data[2];
+      events.push({ ms, meta: type, data });
+    } else {
+      assert.ok(status >= 0x80 && status < 0xf0, `channel status at ${i - 1}`);
+      events.push({ ms, status, data: [buf[i++], buf[i++]] });
+    }
+  }
+  return { format, tracks, division, events };
+}
+
+test("three-notes.mid: three Note-ons on channel 1, 100 ms apart, each followed by its Note-off", () => {
+  const { format, tracks, division, events } = readSmf(readFileSync(FIXTURE));
+  assert.deepEqual([format, tracks, division], [0, 1, 480]);
+  const channel = events.filter((e) => e.status !== undefined);
+  assert.deepEqual(channel, [
+    { ms: 0, status: 0x90, data: [60, 100] },
+    { ms: 50, status: 0x80, data: [60, 64] },
+    { ms: 100, status: 0x90, data: [64, 100] },
+    { ms: 150, status: 0x80, data: [64, 64] },
+    { ms: 200, status: 0x90, data: [67, 100] },
+    { ms: 250, status: 0x80, data: [67, 64] },
+  ]);
+  assert.deepEqual(events.at(-1), { ms: 250, meta: 0x2f, data: [] }, "ends with End of Track");
+});
