diff --git a/tests/install-mapping.test.mjs b/tests/install-mapping.test.mjs
new file mode 100644
index 0000000..38a337f
--- /dev/null
+++ b/tests/install-mapping.test.mjs
@@ -0,0 +1,164 @@
+// tools/install-mapping copies mapping/ into the dev profile's controllers/ (the Flatpak cannot see the
+// worktree, so it copies, never symlinks) and refuses Michael's real Mixxx profile.
+// Each test runs a copy of the tool in a temp repo layout (tools/ + mapping/) with HOME set to a temp dir,
+// so a broken guard could never write into the real ~/.var/app/org.mixxx.Mixxx/.mixxx.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import {
+  mkdtempSync, mkdirSync, writeFileSync, readFileSync, readdirSync, existsSync, copyFileSync, symlinkSync,
+  lstatSync, statSync, chmodSync,
+} from "node:fs";
+import { tmpdir } from "node:os";
+import { join, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const TOOLS = join(dirname(fileURLToPath(import.meta.url)), "..", "tools");
+const FILES = {
+  "Rane-One.midi.xml": "<MixxxControllerPreset/>\n",
+  "rane-one-platter.js": "var RaneOnePlatter = {};\n",
+  "Rane-One-scripts.js": "var RaneOne = {};\n",
+};
+
+// The tool's own env, without anything the caller's shell may export (e.g. MIXXX_DEV_PROFILE).
+const BASE_ENV = Object.fromEntries(Object.entries(process.env).filter(([k]) => !k.startsWith("MIXXX_DEV_")));
+
+function setup({ files = FILES } = {}) {
+  const dir = mkdtempSync(join(tmpdir(), "install-mapping-"));
+  const repo = join(dir, "repo"), home = join(dir, "home");
+  mkdirSync(join(repo, "tools", "lib"), { recursive: true });
+  mkdirSync(join(repo, "mapping"));
+  mkdirSync(home);
+  copyFileSync(join(TOOLS, "install-mapping"), join(repo, "tools", "install-mapping"));
+  chmodSync(join(repo, "tools", "install-mapping"), 0o755);
+  copyFileSync(join(TOOLS, "lib", "profile.sh"), join(repo, "tools", "lib", "profile.sh"));
+  for (const [name, body] of Object.entries(files)) writeFileSync(join(repo, "mapping", name), body);
+  const real = join(home, ".var/app/org.mixxx.Mixxx/.mixxx");
+  mkdirSync(real, { recursive: true });
+  const run = (profile, ...args) => spawnSync(join(repo, "tools", "install-mapping"), args, {
+    encoding: "utf8",
+    env: { ...BASE_ENV, HOME: home, ...(profile === undefined ? {} : { MIXXX_DEV_PROFILE: profile }) },
+  });
+  return { dir, repo, home, real, run };
+}
+
+test("copies every file from mapping/ into <profile>/controllers/, creating it", () => {
+  const t = setup();
+  const profile = join(t.dir, "profile");
+  const r = t.run(profile);
+  assert.equal(r.status, 0, r.stderr);
+  const dest = join(profile, "controllers");
+  assert.deepEqual(readdirSync(dest).sort(), Object.keys(FILES).sort());
+  for (const [name, body] of Object.entries(FILES)) {
+    assert.equal(readFileSync(join(dest, name), "utf8"), body);
+    assert.equal(lstatSync(join(dest, name)).isSymbolicLink(), false);
+  }
+});
+
+test("overwrites a stale copy and replaces a stale symlink with a real file", () => {
+  const t = setup();
+  const profile = join(t.dir, "profile");
+  const dest = join(profile, "controllers");
+  mkdirSync(dest, { recursive: true });
+  writeFileSync(join(dest, "Rane-One-scripts.js"), "// stale\n");
+  writeFileSync(join(t.dir, "elsewhere.js"), "// elsewhere\n");
+  symlinkSync(join(t.dir, "elsewhere.js"), join(dest, "rane-one-platter.js"));
+  const r = t.run(profile);
+  assert.equal(r.status, 0, r.stderr);
+  assert.equal(readFileSync(join(dest, "Rane-One-scripts.js"), "utf8"), FILES["Rane-One-scripts.js"]);
+  assert.equal(lstatSync(join(dest, "rane-one-platter.js")).isSymbolicLink(), false);
+  assert.equal(readFileSync(join(dest, "rane-one-platter.js"), "utf8"), FILES["rane-one-platter.js"]);
+  assert.equal(readFileSync(join(t.dir, "elsewhere.js"), "utf8"), "// elsewhere\n");
+});
+
+test("replaces each file by rename (new inode), never by rewriting it in place", () => {
+  const t = setup();
+  const profile = join(t.dir, "profile");
+  const dest = join(profile, "controllers");
+  mkdirSync(dest, { recursive: true });
+  writeFileSync(join(dest, "Rane-One-scripts.js"), "// stale\n");
+  const before = statSync(join(dest, "Rane-One-scripts.js")).ino;
+  assert.equal(t.run(profile).status, 0);
+  assert.notEqual(statSync(join(dest, "Rane-One-scripts.js")).ino, before);
+  assert.equal(statSync(join(dest, "Rane-One-scripts.js")).mode & 0o777, 0o644);
+});
+
+test("refuses (exit 3) a controllers/ that is a symlink into the real profile", () => {
+  const t = setup();
+  const profile = join(t.dir, "profile");
+  mkdirSync(join(t.real, "controllers"));
+  mkdirSync(profile);
+  symlinkSync(join(t.real, "controllers"), join(profile, "controllers"));
+  const r = t.run(profile);
+  assert.equal(r.status, 3, r.stderr);
+  assert.deepEqual(readdirSync(join(t.real, "controllers")), []);
+});
+
+test("refuses (exit 3) an ancestor of the real profile when .mixxx itself is a symlink", () => {
+  const t = setup();
+  const parent = join(t.home, ".var/app/org.mixxx.Mixxx");
+  const moved = join(t.dir, "elsewhere-mixxx");
+  mkdirSync(moved);
+  spawnSync("rmdir", [t.real]);
+  symlinkSync(moved, t.real);
+  const r = t.run(parent);
+  assert.equal(r.status, 3, r.stderr);
+  assert.equal(existsSync(join(parent, "controllers")), false);
+});
+
+test("leaves no temp files behind and keeps unrelated files in controllers/", () => {
+  const t = setup();
+  const profile = join(t.dir, "profile");
+  const dest = join(profile, "controllers");
+  mkdirSync(dest, { recursive: true });
+  writeFileSync(join(dest, "Other.midi.xml"), "<other/>\n");
+  assert.equal(t.run(profile).status, 0);
+  assert.deepEqual(readdirSync(dest).sort(), [...Object.keys(FILES), "Other.midi.xml"].sort());
+});
+
+test("defaults to ~/.var/app/org.mixxx.Mixxx/dev-profile", () => {
+  const t = setup();
+  const r = t.run(undefined);
+  assert.equal(r.status, 0, r.stderr);
+  const dest = join(t.home, ".var/app/org.mixxx.Mixxx/dev-profile/controllers");
+  assert.deepEqual(readdirSync(dest).sort(), Object.keys(FILES).sort());
+});
+
+for (const [what, rel] of [
+  ["the real profile itself", ".var/app/org.mixxx.Mixxx/.mixxx"],
+  ["a directory inside it", ".var/app/org.mixxx.Mixxx/.mixxx/dev"],
+  ["a path that only lexically leaves it", ".var/app/org.mixxx.Mixxx/.mixxx/a/../b"],
+  ["an ancestor of it", ".var/app/org.mixxx.Mixxx"],
+]) {
+  test(`refuses (exit 3) ${what}`, () => {
+    const t = setup();
+    const r = t.run(join(t.home, rel));
+    assert.equal(r.status, 3, r.stderr);
+    assert.deepEqual(readdirSync(t.real), []);
+    assert.equal(existsSync(join(t.home, ".var/app/org.mixxx.Mixxx/controllers")), false);
+  });
+}
+
+test("refuses (exit 3) a symlink that resolves inside the real profile", () => {
+  const t = setup();
+  const link = join(t.dir, "sneaky");
+  symlinkSync(t.real, link);
+  const r = t.run(join(link, "dev"));
+  assert.equal(r.status, 3, r.stderr);
+  assert.deepEqual(readdirSync(t.real), []);
+});
+
+test("fails (exit 1) when mapping/ is empty, installing nothing", () => {
+  const t = setup({ files: {} });
+  const profile = join(t.dir, "profile");
+  const r = t.run(profile);
+  assert.equal(r.status, 1);
+  assert.equal(existsSync(join(profile, "controllers")), false);
+});
+
+test("usage: any argument exits 2", () => {
+  const t = setup();
+  const profile = join(t.dir, "profile");
+  assert.equal(t.run(profile, "now").status, 2);
+  assert.equal(existsSync(profile), false);
+});
diff --git a/tests/mapping-xml.test.mjs b/tests/mapping-xml.test.mjs
new file mode 100644
index 0000000..8aa3d88
--- /dev/null
+++ b/tests/mapping-xml.test.mjs
@@ -0,0 +1,179 @@
+// The mapping as Mixxx loads it: mapping/Rane-One.midi.xml plus its plain scripts (M1 plan, Mapping skeleton).
+// The XML is checked with a small well-formedness parser (zero dependencies, D5), enough for the mapping's
+// subset: declaration, comments, elements, attributes, text. No DTD, CDATA or processing instructions.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { readFileSync, readdirSync } from "node:fs";
+import { join, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+import vm from "node:vm";
+
+const MAPPING = join(dirname(fileURLToPath(import.meta.url)), "..", "mapping");
+const XML = join(MAPPING, "Rane-One.midi.xml");
+
+// Returns the root element as { name, attrs, children } (text dropped); throws on anything not well-formed.
+function parseXml(src) {
+  let i = 0;
+  const fail = (why) => { throw new Error(`${why} at offset ${i}`); };
+  const NAME = /[A-Za-z_][\w.-]*/y;
+  const name = () => { NAME.lastIndex = i; const m = NAME.exec(src) ?? fail("expected a name"); i = NAME.lastIndex; return m[0]; };
+  const ws = () => { while (/\s/.test(src[i] ?? "")) i++; };
+  const skipMisc = () => {
+    for (;;) {
+      ws();
+      if (src.startsWith("<!--", i)) {
+        const end = src.indexOf("-->", i + 4);
+        if (end < 0 || src.slice(i + 4, end).includes("--")) fail("bad comment");
+        i = end + 3;
+      } else return;
+    }
+  };
+  const text = (s) => { if (/[<&]/.test(s.replace(/&(amp|lt|gt|quot|apos|#\d+|#x[\da-fA-F]+);/g, ""))) fail("bad text"); };
+  const element = () => {
+    if (src[i++] !== "<") fail("expected <");
+    const el = { name: name(), attrs: {}, children: [] };
+    for (;;) {
+      const before = i;
+      ws();
+      if (src.startsWith("/>", i)) { i += 2; return el; }
+      if (src[i] === ">") { i++; break; }
+      if (i === before) fail("expected whitespace before an attribute");
+      const key = name();
+      ws(); if (src[i++] !== "=") fail("expected =");
+      ws(); const q = src[i++]; if (q !== '"' && q !== "'") fail("expected a quote");
+      const end = src.indexOf(q, i); if (end < 0) fail("unterminated attribute");
+      const value = src.slice(i, end); text(value);
+      if (Object.hasOwn(el.attrs, key)) fail(`duplicate attribute ${key}`);
+      el.attrs[key] = value; i = end + 1;
+    }
+    for (;;) {
+      const lt = src.indexOf("<", i); if (lt < 0) fail(`unclosed <${el.name}>`);
+      text(src.slice(i, lt)); i = lt;
+      if (src.startsWith("<!--", i)) { skipMisc(); continue; }
+      if (src.startsWith("</", i)) {
+        i += 2; if (name() !== el.name) fail(`mismatched </…> for <${el.name}>`);
+        ws(); if (src[i++] !== ">") fail("expected >");
+        return el;
+      }
+      el.children.push(element());
+    }
+  };
+  if (src.startsWith("﻿")) i = 1;
+  if (src.startsWith("<?xml", i)) { const end = src.indexOf("?>", i); if (end < 0) fail("bad declaration"); i = end + 2; }
+  skipMisc();
+  const root = element();
+  skipMisc();
+  if (i !== src.length) fail("content after the root element");
+  return root;
+}
+
+const all = (el, name) => [...(el.name === name ? [el] : []), ...el.children.flatMap((c) => all(c, name))];
+const child = (el, name) => el.children.find((c) => c.name === name);
+
+test("parseXml rejects malformed XML", () => {
+  for (const bad of ["<a>", "<a></b>", "<a><b></a></b>", "<a x='1' x='2'/>", "<a/><b/>", "<a>&</a>", "<a x=1/>", "<a><!-- -- --></a>"]) {
+    assert.throws(() => parseXml(bad), undefined, bad);
+  }
+  assert.equal(parseXml("<?xml version='1.0'?>\n<!-- c --><a x=\"1\"><b/>t&amp;<c></c></a>\n").children.length, 2);
+});
+
+test("Rane-One.midi.xml parses as a Mixxx controller mapping for the Rane ONE", () => {
+  const root = parseXml(readFileSync(XML, "utf8"));
+  assert.equal(root.name, "MixxxControllerPreset");
+  assert.equal(root.attrs.schemaVersion, "1");
+  const controller = child(root, "controller");
+  assert.equal(controller?.attrs.id, "Rane ONE");
+  assert.ok(child(root, "info") && child(child(root, "info"), "name"), "<info><name> present");
+});
+
+test("the script list is rane-one-platter.js then Rane-One-scripts.js (prefix RaneOne) and matches mapping/", () => {
+  const files = all(parseXml(readFileSync(XML, "utf8")), "file").map((f) => [f.attrs.filename, f.attrs.functionprefix ?? ""]);
+  assert.deepEqual(files, [["rane-one-platter.js", ""], ["Rane-One-scripts.js", "RaneOne"]]);
+  const onDisk = readdirSync(MAPPING).filter((f) => f.endsWith(".js")).sort();
+  assert.deepEqual(files.map(([f]) => f).sort(), onDisk);
+});
+
+test("the mapping has no output element (D9: nothing is sent to the controller)", () => {
+  const root = parseXml(readFileSync(XML, "utf8"));
+  assert.deepEqual(all(root, "outputs"), []);
+  assert.deepEqual(all(root, "output"), []);
+  assert.doesNotMatch(readFileSync(XML, "utf8"), /<\s*outputs?\b/);
+});
+
+test("node --check passes on both scripts", () => {
+  for (const f of ["rane-one-platter.js", "Rane-One-scripts.js"]) {
+    const r = spawnSync(process.execPath, ["--check", join(MAPPING, f)], { encoding: "utf8" });
+    assert.equal(r.status, 0, `${f}: ${r.stderr}`);
+  }
+});
+
+// Strips // and /* */ comments; good enough for these plain scripts, which keep no comment markers in strings.
+const code = (f) => readFileSync(join(MAPPING, f), "utf8").replace(/\/\*[\s\S]*?\*\//g, "").replace(/\/\/.*$/gm, "");
+
+test("rane-one-platter.js is pure: no engine, midi, print or console reference", () => {
+  assert.doesNotMatch(code("rane-one-platter.js"), /\b(engine|midi|print|console|script|components)\b/);
+  assert.doesNotMatch(code("rane-one-platter.js"), /\b(import|export|require)\b/);
+  const ctx = vm.createContext({});
+  vm.runInContext(readFileSync(join(MAPPING, "rane-one-platter.js"), "utf8"), ctx);
+  assert.equal(typeof ctx.RaneOnePlatter, "object");
+  assert.notEqual(ctx.RaneOnePlatter, null);
+});
+
+test("no script sends MIDI (no midi.send* call)", () => {
+  for (const f of readdirSync(MAPPING).filter((f) => f.endsWith(".js"))) {
+    assert.doesNotMatch(code(f), /\bmidi\s*\.\s*send/, f);
+  }
+});
+
+// Loads both scripts into one context, in Mixxx's order. Mixxx's own objects throw on any use, so a handler that
+// reaches them unguarded would throw here.
+function load(log, warn = log) {
+  const hostile = new Proxy({}, { get() { throw new Error("Mixxx object used"); } });
+  const ctx = vm.createContext({ console: { log, warn }, engine: hostile, midi: hostile, script: hostile });
+  for (const f of ["rane-one-platter.js", "Rane-One-scripts.js"]) vm.runInContext(readFileSync(join(MAPPING, f), "utf8"), ctx);
+  return ctx;
+}
+
+test("RaneOne.init and RaneOne.shutdown each log exactly one line", () => {
+  const lines = [];
+  const { RaneOne } = load((...a) => lines.push(a.join(" ")));
+  RaneOne.init("Midi Through Port-0", true);
+  assert.deepEqual(lines, ["RaneOne: init Midi Through Port-0"]);
+  RaneOne.shutdown();
+  assert.deepEqual(lines, ["RaneOne: init Midi Through Port-0", "RaneOne: shutdown"]);
+});
+
+test("no RaneOne handler can throw, even when logging and Mixxx's objects throw", () => {
+  const { RaneOne } = load(() => { throw new Error("console broken"); });
+  // Every function reachable from RaneOne, nested objects and arrays included (later decks, components).
+  const handlers = [];
+  const walk = (obj, path, seen) => {
+    if (obj === null || typeof obj !== "object" || seen.has(obj)) return;
+    seen.add(obj);
+    for (const k of Object.keys(obj)) {
+      if (obj === RaneOne && k === "guard") continue;
+      if (typeof obj[k] === "function") handlers.push([`${path}.${k}`, obj, k]);
+      else walk(obj[k], `${path}.${k}`, seen);
+    }
+  };
+  walk(RaneOne, "RaneOne", new Set());
+  assert.ok(["RaneOne.init", "RaneOne.shutdown"].every((n) => handlers.some(([p]) => p === n)));
+  for (const [path, obj, k] of handlers) {
+    assert.doesNotThrow(() => obj[k](0, 0x90, 0x3c, 0x7f, "[Channel1]"), path);
+    assert.doesNotThrow(() => obj[k](), path);
+  }
+});
+
+// At Warning level (console.warn), so the dev loop's "loads cleanly" check and a gig's default log both show it.
+test("guard warns once about a handler's failure and returns undefined", () => {
+  const lines = [], warnings = [];
+  const { RaneOne } = load((...a) => lines.push(a.join(" ")), (...a) => warnings.push(a.join(" ")));
+  const h = RaneOne.guard("probe", () => { throw new Error("boom"); });
+  assert.equal(h(), undefined);
+  assert.equal(h(), undefined);
+  assert.deepEqual(warnings, ["RaneOne: probe failed: Error: boom"]);
+  assert.deepEqual(lines, []);
+  const self = {};
+  assert.equal(RaneOne.guard("this", function() { return this; }).call(self), self);
+});
