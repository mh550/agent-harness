+  assert.match(SOUNDCONFIG, /<SoundDevice name="pulse" portAudioIndex="-1">/);
+  assert.equal(SOUNDCONFIG.match(/<output /g).length, 1);
+  assert.match(SOUNDCONFIG, /<output type="Master" index="0" channel="0" channel_count="2"\/>/);
+  assert.doesNotMatch(SOUNDCONFIG, /<input /);
