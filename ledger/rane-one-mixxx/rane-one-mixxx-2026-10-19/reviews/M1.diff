+  const r = run(["play", "14:0", "x.mid"], { list });
+  assert.equal(r.status, 3);
+  assert.doesNotMatch(r.stdout, /SENT/);
+});
+
+test("play: a quote inside a client name does not hide the Rane in it", () => {
+  const list = RANE_LIST("130:0").replace("client 24: 'Rane ONE'", "client 24: 'Bob's Rane'").replace("130:0", "24:0");
+  const r = run(["play", "14:0", "x.mid"], { list });
+  assert.equal(r.status, 3);
+  assert.match(r.stderr, /Bob's Rane/);
+});
diff --git a/tests/mixxx-dev.test.mjs b/tests/mixxx-dev.test.mjs
new file mode 100644
index 0000000..d5ad658
--- /dev/null
+++ b/tests/mixxx-dev.test.mjs
@@ -0,0 +1,598 @@
+// tools/mixxx-dev starts a Flatpak Mixxx on the dev profile routed to the mixxx-dev null sink, tracks its
+// instance id and stops only that instance (D9). `flatpak`, `pactl`, `aconnect` and tools/null-sink are stubs,
+// HOME is a temp dir and /proc is a fixture, so no test can start a real Mixxx or reach the real profile.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { spawnSync, spawn } from "node:child_process";
+import {
+  mkdtempSync, mkdirSync, writeFileSync, readFileSync, existsSync, chmodSync, symlinkSync, rmSync,
+} from "node:fs";
+import { tmpdir } from "node:os";
+import { join, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const TOOLS = join(dirname(fileURLToPath(import.meta.url)), "..", "tools");
+const SCRIPT = join(TOOLS, "mixxx-dev");
+const ID = "1458203367";
+const OTHER_ID = "3141592653"; // a Mixxx Michael started himself: never touched
+// Mixxx 2.5.6 logs its own version only at Debug in the default category, which --controller-debug filters out of
+// mixxx.log (src/util/logging.cpp, controllerDebugCategoryFilter). Seen live in M1-04. Its stdout gets this line
+// from src/preferences/upgrade.cpp before logging starts, once mixxx.cfg's Version matches the binary (D10).
+const VERSION_LINE = 'Configuration file is at the current version "2.5.6"';
+const LOG_LINE = "16:54:11.100 Info [Main] SoundSourceFFmpeg - Disabling untested input formats: aa";
+
+// State under $STUB: inst/<id> (running instances: app name), next-id, inputs (long sink-inputs listing, shown
+// while one of our instances runs; inputs2 replaces it after the first listing), and flags: no-log, no-version,
+// fail-ps, stuck, jack, nodevice, die (run starts nothing), no-id (run gives no id), ps-fail-after-run,
+// inputs-always (streams listed before the launch too).
+const FLATPAK = `#!/usr/bin/env bash
+echo "flatpak $*" >> "$STUB/calls.log"
+s=$STUB
+case $1 in
+  info) printf 'Mixxx DJ Software\\n\\n            ID: org.mixxx.Mixxx\\n       Version: 2.5.6\\n' ;;
+  ps)
+    [[ -f $s/fail-ps ]] && { echo "ps failed" >&2; exit 1; }
+    for f in "$s"/inst/*; do
+      [[ -e $f ]] || continue
+      case $2 in
+        --columns=instance,application) printf '%s\\t%s\\n' "\${f##*/}" "$(cat "$f")" ;;
+        --columns=instance,pid,child-pid) printf '%s\\t%s\\t%s\\n' "\${f##*/}" "$(sed -n 2p "$f.pids")" "$(sed -n 3p "$f.pids")" ;;
+        *) exit 97 ;;
+      esac
+    done ;;
+  kill)
+    [[ $2 == org.mixxx.Mixxx ]] && exit 99
+    [[ -f $s/stuck ]] || rm -f "$s/inst/$2" ;;
+  run)
+    prof=; fd=
+    for ((i = 2; i <= $#; i++)); do
+      a=\${!i}
+      [[ $a == --instance-id-fd=* ]] && fd=\${a#*=}
+      [[ $a == --settings-path ]] && { j=$((i + 1)); prof=\${!j}; }
+    done
+    id=$(cat "$s/next-id")
+    [[ $fd == 3 && ! -f $s/no-id ]] && { printf '%s\\n' "$id" >&3; exec 3>&-; }
+    [[ -f $s/die ]] || { echo org.mixxx.Mixxx > "$s/inst/$id"; printf 'pids\\n5000\\n5001\\n' > "$s/inst/$id.pids"; }
+    [[ -f $s/ps-fail-after-run ]] && touch "$s/fail-ps"
+    # the launcher's lock must not be inherited by Mixxx (it would stay held for Mixxx's lifetime)
+    [[ -e /proc/$$/fd/9 ]] && touch "$s/inherited-fd9"
+    [[ -f $s/no-version ]] || echo '${VERSION_LINE}'
+    if [[ ! -f $s/no-log ]]; then
+      [[ -e $prof/mixxx.log ]] && mv "$prof/mixxx.log" "$prof/mixxx.log.1"
+      echo '${LOG_LINE}' > "$prof/mixxx.log"
+    fi
+    [[ -f $s/jack ]] && sed -i 's/api="ALSA"/api="JACK Audio Connection Kit"/' "$prof/soundconfig.xml"
+    [[ -f $s/nodevice ]] && echo '<SoundManagerConfig api="ALSA" samplerate="48000"/>' > "$prof/soundconfig.xml"
+    true ;;
+  *) echo "flatpak stub: unexpected: $*" >&2; exit 98 ;;
+esac
+`;
+
+const PACTL = `#!/usr/bin/env bash
+echo "pactl $*" >> "$STUB/calls.log"
+s=$STUB
+case "$*" in
+  set-default-*) exit 99 ;;
+  "list short sinks")
+    printf '172\\talsa_output.pci-0000_00_1f.3.analog-stereo\\tPipeWire\\ts32le 2ch 48000Hz\\tSUSPENDED\\n'
+    printf '779\\talsa_output.usb-Rane_Rane_ONE_A-00.analog-surround-40\\tPipeWire\\ts32le 4ch 48000Hz\\tIDLE\\n'
+    printf '901\\tmixxx-dev\\tPipeWire\\tfloat32le 2ch 48000Hz\\tRUNNING\\n' ;;
+  "list sink-inputs")
+    if [[ -f $s/inputs-always ]] || compgen -G "$s/inst/${ID}" > /dev/null; then
+      if [[ -f $s/inputs2 && -f $s/shown ]]; then cat "$s/inputs2"; elif [[ -f $s/inputs ]]; then cat "$s/inputs"; touch "$s/shown"; fi
+    fi; true ;;
+  *) echo "pactl stub: unexpected: $*" >&2; exit 98 ;;
+esac
+`;
+
+const sinkInput = (n, sink, app) => `Sink Input #${n}
+\tDriver: PipeWire
+\tOwner Module: n/a
+\tClient: 77
+\tSink: ${sink}
+\tSample Specification: float32le 2ch 48000Hz
+\tProperties:
+\t\tclient.api = "pipewire-pulse"
+\t\tapplication.name = "${app}"
+\t\tmedia.name = "ALSA Playback"
+`;
+const ON_DEV = sinkInput(88, 901, "mixxx-dev");
+
+const ACONNECT_CLEAN = `client 0: 'System' [type=kernel]
+    0 'Timer           '
+\tConnecting To: 144:0
+client 14: 'Midi Through' [type=kernel]
+    0 'Midi Through Port-0'
+client 24: 'Rane ONE' [type=kernel,card=2]
+    0 'Rane ONE MIDI 1 '
+client 144: 'PipeWire-System' [type=user,pid=1908]
+    0 'input           '
+\tConnected From: 0:1, 0:0
+`;
+const ACONNECT_RANE = ACONNECT_CLEAN.replace("    0 'Midi Through Port-0'\n",
+  "    0 'Midi Through Port-0'\n\tConnecting To: 144:0, 24:0[real:0]\n");
+
+// The tools' own env, without anything the caller's shell may export (e.g. MIXXX_DEV_PROFILE).
+const BASE_ENV = Object.fromEntries(Object.entries(process.env).filter(([k]) => !/^(MIXXX_DEV_|NULL_SINK_|WAYLAND_)/.test(k)));
+
+function exe(path, body) {
+  writeFileSync(path, body);
+  chmodSync(path, 0o755);
+}
+
+function setup({ state = {}, inputs = ON_DEV, aconnect = ACONNECT_CLEAN, sink = "mixxx-dev 536870916" } = {}) {
+  const dir = mkdtempSync(join(tmpdir(), "mixxx-dev-"));
+  const bin = join(dir, "bin"), stub = join(dir, "stub"), home = join(dir, "home"), proc = join(dir, "proc");
+  for (const d of [bin, join(stub, "inst"), home, join(proc, "asound")]) mkdirSync(d, { recursive: true });
+  exe(join(bin, "flatpak"), FLATPAK);
+  exe(join(bin, "pactl"), PACTL);
+  exe(join(bin, "aconnect"), `#!/usr/bin/env bash\necho "aconnect $*" >> "$STUB/calls.log"\ncat "$STUB/aconnect"\n`);
+  for (const tool of ["wpctl", "pw-metadata", "pkill", "killall"]) {
+    exe(join(bin, tool), `#!/usr/bin/env bash\necho "${tool} $*" >> "$STUB/calls.log"\nexit 99\n`);
+  }
+  const nullSink = join(bin, "null-sink");
+  exe(nullSink, `#!/usr/bin/env bash\necho "null-sink $*" >> "$STUB/calls.log"\n${
+    sink ? `echo "${sink}"; exit 0` : "echo absent; exit 1"}\n`);
+  writeFileSync(join(stub, "next-id"), ID);
+  writeFileSync(join(stub, "aconnect"), aconnect);
+  if (inputs !== null) writeFileSync(join(stub, "inputs"), inputs);
+  for (const [k, v] of Object.entries(state)) writeFileSync(join(stub, k), v);
+  // The Rane ONE is card 2; its playback substream is closed unless a test opens it.
+  writeFileSync(join(proc, "asound", "cards"),
+    " 0 [PCH            ]: HDA-Intel - HDA Intel PCH\n                      HDA Intel PCH at 0xdf340000 irq 138\n" +
+    " 2 [ONE            ]: USB-Audio - Rane ONE\n                      Rane Rane ONE at usb-0000:00:14.0-2, high speed\n");
+  mkdirSync(join(proc, "asound", "card2", "pcm0p", "sub0"), { recursive: true });
+  writeFileSync(join(proc, "asound", "card2", "pcm0p", "sub0", "status"), "closed\n");
+  const profile = join(home, ".var/app/org.mixxx.Mixxx/dev-profile");
+  // run("start") or run("start", { ENV: "override" }): a trailing plain object is extra env, not an argument.
+  const run = (...args) => {
+    const extra = args.find((a) => typeof a === "object") ?? {};
+    const env = { ...BASE_ENV, PATH: `${bin}:${process.env.PATH}`, HOME: home, STUB: stub,
+      WAYLAND_DISPLAY: "wayland-1", MIXXX_DEV_NULL_SINK: nullSink, MIXXX_DEV_PROC: proc,
+      MIXXX_DEV_LOG_TIMEOUT: "2", MIXXX_DEV_ROUTE_TIMEOUT: "1", MIXXX_DEV_STOP_TIMEOUT: "1", ...extra };
+    for (const [k, v] of Object.entries(env)) if (v === undefined) delete env[k];
+    return spawnSync(SCRIPT, args.filter((a) => typeof a === "string"), { encoding: "utf8", env, timeout: 30000 });
+  };
+  const calls = () => (existsSync(join(stub, "calls.log")) ? readFileSync(join(stub, "calls.log"), "utf8") : "");
+  const instanceFile = join(profile, "mixxx-dev.instance");
+  const running = (id) => existsSync(join(stub, "inst", id));
+  const launch = (id, app = "org.mixxx.Mixxx") => {
+    writeFileSync(join(stub, "inst", id), `${app}\n`);
+    writeFileSync(join(stub, "inst", `${id}.pids`), "pids\n5000\n5001\n");
+  };
+  return { dir, stub, home, proc, profile, run, calls, instanceFile, running, launch };
+}
+
+const lines = (log, prefix) => log.split("\n").filter((l) => l.startsWith(prefix));
+const kills = (log) => lines(log, "flatpak kill");
+const runs = (log) => lines(log, "flatpak run");
+const neverKillsAll = (log) => assert.doesNotMatch(log, /flatpak kill org\.mixxx\.Mixxx|pkill|killall/);
+
+test("start seeds a missing dev profile, launches with the CLAUDE.md flags on the null sink and records the id", () => {
+  const t = setup();
+  assert.equal(existsSync(t.profile), false);
+  const r = t.run("start");
+  assert.equal(r.status, 0, r.stderr);
+  for (const f of ["mixxx.cfg", "soundconfig.xml", "mixxxdb.sqlite"]) assert.ok(existsSync(join(t.profile, f)), f);
+  for (const d of ["controllers", "music"]) assert.ok(existsSync(join(t.profile, d)), d);
+  const [run] = runs(t.calls());
+  assert.ok(run, "flatpak run was called");
+  const argv = run.split(" ");
+  const app = argv.indexOf("org.mixxx.Mixxx");
+  const before = argv.slice(0, app), after = argv.slice(app + 1);
+  assert.ok(before.includes("--env=PULSE_SINK=mixxx-dev"));
+  assert.ok(before.includes("--env=PULSE_PROP_OVERRIDE=application.name=mixxx-dev"));
+  assert.ok(before.includes("--instance-id-fd=3"));
+  assert.ok(!before.includes("--die-with-parent"));
+  assert.deepEqual(after,
+    ["--settings-path", t.profile, "--controller-debug", "--controller-abort-on-warning", "--developer",
+      "--log-flush-level", "debug"]);
+  assert.equal(readFileSync(t.instanceFile, "utf8").trim(), ID);
+  assert.match(r.stdout, new RegExp(ID));
+  assert.ok(t.running(ID));
+  neverKillsAll(t.calls());
+  assert.doesNotMatch(t.calls(), /set-default/);
+});
+
+test("stop runs `flatpak kill <that id>` only, never `flatpak kill org.mixxx.Mixxx`, and forgets the id", () => {
+  const t = setup();
+  t.launch(OTHER_ID);
+  assert.equal(t.run("start").status, 0);
+  const r = t.run("stop");
+  assert.equal(r.status, 0, r.stderr);
+  assert.deepEqual(kills(t.calls()), [`flatpak kill ${ID}`]);
+  assert.equal(t.running(ID), false);
+  assert.equal(t.running(OTHER_ID), true);
+  assert.equal(existsSync(t.instanceFile), false);
+  neverKillsAll(t.calls());
+});
+
+test("stop with no instance file exits 0 and kills nothing", () => {
+  const t = setup();
+  t.launch(OTHER_ID);
+  const r = t.run("stop");
+  assert.equal(r.status, 0, r.stderr);
+  assert.deepEqual(kills(t.calls()), []);
+  assert.equal(t.running(OTHER_ID), true);
+});
+
+test("stop with a stale id (not a running org.mixxx.Mixxx) deletes the file and kills nothing", () => {
+  for (const [id, app] of [[ID, null], [ID, "com.protonvpn.www"]]) {
+    const t = setup();
+    if (app) t.launch(id, app);
+    mkdirSync(t.profile, { recursive: true });
+    writeFileSync(t.instanceFile, `${id}\n`);
+    const r = t.run("stop");
+    assert.equal(r.status, 0, r.stderr);
+    assert.deepEqual(kills(t.calls()), []);
+    assert.equal(existsSync(t.instanceFile), false);
+  }
+});
+
+test("stop refuses an instance file that holds no numeric id, and kills nothing", () => {
+  for (const content of ["org.mixxx.Mixxx\n", "\n", `${ID} ${OTHER_ID}\n`, "-1\n"]) {
+    const t = setup();
+    t.launch(OTHER_ID);
+    mkdirSync(t.profile, { recursive: true });
+    writeFileSync(t.instanceFile, content);
+    const r = t.run("stop");
+    assert.equal(r.status, 1, `${JSON.stringify(content)}: ${r.stderr}`);
+    assert.deepEqual(kills(t.calls()), []);
+    assert.equal(existsSync(t.instanceFile), true);
+  }
+});
+
+test("stop keeps the instance file and fails when `flatpak ps` fails (the instance may still run)", () => {
+  const t = setup();
+  assert.equal(t.run("start").status, 0);
+  writeFileSync(join(t.stub, "fail-ps"), "");
+  assert.notEqual(t.run("stop").status, 0);
+  assert.deepEqual(kills(t.calls()), []);
+  assert.equal(existsSync(t.instanceFile), true);
+});
+
+test("stop fails and keeps the file when the instance outlives the kill", () => {
+  const t = setup({ state: { stuck: "" } });
+  assert.equal(t.run("start").status, 0);
+  const r = t.run("stop");
+  assert.equal(r.status, 1);
+  assert.equal(existsSync(t.instanceFile), true);
+});
+
+for (const [name, profile] of [
+  ["the real profile", ".var/app/org.mixxx.Mixxx/.mixxx"],
+  ["inside the real profile", ".var/app/org.mixxx.Mixxx/.mixxx/dev"],
+  ["an ancestor of the real profile", ".var/app/org.mixxx.Mixxx"],
+  ["outside the Flatpak's data dir (the sandbox cannot see it)", "projects/dev-profile"],
+]) {
+  test(`start refuses (exit 3) a profile that is ${name}, before seeding or launching`, () => {
+    const t = setup();
+    mkdirSync(join(t.home, ".var/app/org.mixxx.Mixxx/.mixxx"), { recursive: true });
+    const r = t.run("start", { MIXXX_DEV_PROFILE: join(t.home, profile) });
+    assert.equal(r.status, 3, r.stderr);
+    assert.deepEqual(runs(t.calls()), []);
+    assert.equal(existsSync(join(t.home, profile, "mixxx.cfg")), false);
+  });
+}
+
+test("start refuses (exit 3) a profile that is a symlink into the real profile", () => {
+  const t = setup();
+  const real = join(t.home, ".var/app/org.mixxx.Mixxx/.mixxx");
+  mkdirSync(real, { recursive: true });
+  symlinkSync(real, join(t.home, ".var/app/org.mixxx.Mixxx/dev-profile"));
+  assert.equal(t.run("start").status, 3);
+  assert.deepEqual(runs(t.calls()), []);
+  assert.equal(existsSync(join(real, "mixxx.cfg")), false);
+});
+
+for (const f of ["mixxx.cfg", "soundconfig.xml", "mixxxdb.sqlite", "mixxx-dev.instance", "mixxx.log",
+  "mixxx-dev.stdout", "controllers", "music", "mixxx-dev.lock"]) {
+  test(`start refuses (exit 3) when ${f} is a symlink`, () => {
+    const t = setup();
+    mkdirSync(t.profile, { recursive: true });
+    writeFileSync(join(t.dir, "elsewhere"), "");
+    symlinkSync(join(t.dir, "elsewhere"), join(t.profile, f));
+    assert.equal(t.run("start").status, 3);
+    assert.deepEqual(runs(t.calls()), []);
+    assert.equal(readFileSync(join(t.dir, "elsewhere"), "utf8"), "");
+  });
+}
+
+for (const [name, opts, env] of [
+  ["WAYLAND_DISPLAY is unset", {}, { WAYLAND_DISPLAY: undefined }],
+  ["the null sink is absent", { sink: null }, {}],
+  ["Midi Through is subscribed to the Rane ONE", { aconnect: ACONNECT_RANE }, {}],
+  ["the Rane ONE is subscribed to Midi Through", { aconnect: ACONNECT_CLEAN.replace("    0 'Midi Through Port-0'\n",
+    "    0 'Midi Through Port-0'\n\tConnected From: 24:0\n") }, {}],
+  ["a mixxx-dev stream already plays (an untracked dev Mixxx)", { state: { "inputs-always": "" } }, {}],
+]) {
+  test(`start refuses (exit 1) when ${name}, without launching`, () => {
+    const t = setup(opts);
+    const r = t.run("start", env);
+    assert.equal(r.status, 1, r.stderr);
+    assert.deepEqual(runs(t.calls()), []);
+  });
+}
+
+test("start with our instance already running does not launch a second Mixxx", () => {
+  const t = setup();
+  assert.equal(t.run("start").status, 0);
+  const r = t.run("start");
+  assert.equal(r.status, 0, r.stderr);
+  assert.equal(runs(t.calls()).length, 1);
+  assert.match(r.stdout, /already running/);
+});
+
+test("start ignores another Mixxx's instance id; only its own file counts", () => {
+  const t = setup();
+  t.launch(OTHER_ID);
+  assert.equal(t.run("start").status, 0);
+  assert.equal(runs(t.calls()).length, 1);
+});
+
+for (const [name, inputs] of [
+  ["its stream is on the Rane ONE sink", sinkInput(88, 779, "mixxx-dev")],
+  ["one of its streams is on a PCI sink", ON_DEV + sinkInput(89, 172, "mixxx-dev")],
+  ["no mixxx-dev stream appears", sinkInput(90, 901, "Firefox")],
+  ["there is no stream at all", null],
+]) {
+  test(`start stops its Mixxx and exits 1 when ${name}`, () => {
+    const t = setup({ inputs });
+    t.launch(OTHER_ID);
+    const r = t.run("start");
+    assert.equal(r.status, 1, r.stderr);
+    assert.deepEqual(kills(t.calls()), [`flatpak kill ${ID}`]);
+    assert.equal(t.running(ID), false);
+    assert.equal(t.running(OTHER_ID), true);
+    assert.equal(existsSync(t.instanceFile), false);
+  });
+}
+
+// PipeWire lists a new stream with Sink 4294967295 (PA_INVALID_INDEX) until it is linked: seen live on the
+// first launch (M1-04). Such a stream plays nowhere, so it counts as "not yet", never as misrouted or as routed.
+test("start waits through a stream that is not linked to a sink yet (Sink: 4294967295)", () => {
+  const t = setup({ inputs: sinkInput(87, 4294967295, "mixxx-dev") + ON_DEV });
+  const r = t.run("start");
+  assert.equal(r.status, 0, r.stderr);
+  assert.deepEqual(kills(t.calls()), []);
+});
+
+test("start does not count an unlinked stream as routed: none on mixxx-dev in time stops the Mixxx", () => {
+  const t = setup({ inputs: sinkInput(87, 4294967295, "mixxx-dev") });
+  const r = t.run("start");
+  assert.equal(r.status, 1, r.stderr);
+  assert.match(r.stderr, /no stream named mixxx-dev/);
+  assert.deepEqual(kills(t.calls()), [`flatpak kill ${ID}`]);
+});
+
+test("start ignores a Mixxx stream that is not ours (application.name not mixxx-dev)", () => {
+  const t = setup({ inputs: sinkInput(70, 779, "Mixxx") + ON_DEV });
+  const r = t.run("start");
+  assert.equal(r.status, 0, r.stderr);
+  assert.deepEqual(kills(t.calls()), []);
+});
+
+test("start does not count a stale mixxx.log; no new log stops the Mixxx", () => {
+  const t = setup({ state: { "no-log": "" } });
+  mkdirSync(t.profile, { recursive: true });
+  writeFileSync(join(t.profile, "mixxx.log"), `${LOG_LINE}\n`);
+  const r = t.run("start");
+  assert.equal(r.status, 1, r.stderr);
+  assert.deepEqual(kills(t.calls()), [`flatpak kill ${ID}`]);
+  assert.match(r.stderr, /mixxx\.log/);
+});
+
+test("start stops the Mixxx when its stdout never shows the expected version (stale stdout does not count)", () => {
+  const t = setup({ state: { "no-version": "" } });
+  mkdirSync(t.profile, { recursive: true });
+  writeFileSync(join(t.profile, "mixxx-dev.stdout"), `${VERSION_LINE}\n`);
+  const r = t.run("start");
+  assert.equal(r.status, 1, r.stderr);
+  assert.deepEqual(kills(t.calls()), [`flatpak kill ${ID}`]);
+  assert.match(r.stderr, /2\.5\.6/);
+});
+
+test("start accepts a rotated log: the old one becomes mixxx.log.1, the new one has the version line", () => {
+  const t = setup();
+  mkdirSync(t.profile, { recursive: true });
+  writeFileSync(join(t.profile, "mixxx.log"), `${LOG_LINE}\nold run\n`);
+  assert.equal(t.run("start").status, 0);
+  assert.match(readFileSync(join(t.profile, "mixxx.log.1"), "utf8"), /old run/);
+});
+
+test("start stops its Mixxx and exits 1 when Mixxx rewrote soundconfig.xml to another API", () => {
+  const t = setup({ state: { jack: "" } });
+  const r = t.run("start");
+  assert.equal(r.status, 1, r.stderr);
+  assert.deepEqual(kills(t.calls()), [`flatpak kill ${ID}`]);
+  assert.match(r.stderr, /soundconfig/);
+});
+
+// /proc fixture: pid 7001 is mixxx.bin, child of 5001 (sandbox), child of 5000 (the instance's wrapper pid).
+function procTree(t, owner) {
+  for (const [pid, ppid, comm] of [[5000, 1, "bwrap"], [5001, 5000, "bwrap"], [7001, 5001, "mixxx.bin"],
+    [1908, 1, "pipewire"]]) {
+    mkdirSync(join(t.proc, String(pid)), { recursive: true });
+    writeFileSync(join(t.proc, String(pid), "stat"), `${pid} (${comm}) S ${ppid} ${pid} ${pid} 0 -1 4194560\n`);
+  }
+  writeFileSync(join(t.proc, "asound", "card2", "pcm0p", "sub0", "status"),
+    `state: RUNNING\nowner_pid   : ${owner}\ntrigger_time: 1.0\n`);
+}
+
+test("start stops its Mixxx and exits 1 when it holds the Rane ONE's playback PCM directly", () => {
+  const t = setup();
+  procTree(t, 7001);
+  const r = t.run("start");
+  assert.equal(r.status, 1, r.stderr);
+  assert.deepEqual(kills(t.calls()), [`flatpak kill ${ID}`]);
+  assert.match(r.stderr, /Rane/);
+});
+
+test("start does not blame its Mixxx for a Rane ONE PCM held by another process (PipeWire)", () => {
+  const t = setup();
+  procTree(t, 1908);
+  const r = t.run("start");
+  assert.equal(r.status, 0, r.stderr);
+});
+
+// Exits after the launch that bypassed `fail` (Opus review of M1-04): each must still stop the Mixxx.
+for (const [name, state, env] of [
+  ["Mixxx rewrites soundconfig.xml without a <SoundDevice>", { nodevice: "" }, {}],
+  ["the stream moves off mixxx-dev after the first check", { inputs2: sinkInput(88, 779, "mixxx-dev") }, {}],
+  ["Mixxx exits during startup", { die: "", "no-log": "" }, {}],
+]) {
+  test(`start exits 1 and stops (or finds stopped) its Mixxx when ${name}`, () => {
+    const t = setup({ state });
+    t.launch(OTHER_ID);
+    const r = t.run("start", env);
+    assert.equal(r.status, 1, r.stderr);
+    assert.equal(t.running(ID), false);
+    assert.equal(t.running(OTHER_ID), true);
+    assert.equal(existsSync(t.instanceFile), false);
+    neverKillsAll(t.calls());
+  });
+}
+
+test("start sends `flatpak kill <id>` when `flatpak ps` starts failing after the launch, and keeps the id", () => {
+  const t = setup({ state: { "ps-fail-after-run": "" } });
+  const r = t.run("start");
+  assert.equal(r.status, 1, r.stderr);
+  assert.deepEqual(kills(t.calls()), [`flatpak kill ${ID}`]);
+  assert.equal(readFileSync(t.instanceFile, "utf8").trim(), ID, "kept: the instance may still run");
+  neverKillsAll(t.calls());
+});
+
+test("start without an instance id reports a new org.mixxx.Mixxx instance and kills nothing", () => {
+  const t = setup({ state: { "no-id": "" } });
+  t.launch(OTHER_ID);
+  const r = t.run("start");
+  assert.equal(r.status, 1, r.stderr);
+  assert.match(r.stderr, new RegExp(ID));
+  assert.doesNotMatch(r.stderr, new RegExp(OTHER_ID));
+  assert.deepEqual(kills(t.calls()), []);
+});
+
+test("start does not leak its lock into Mixxx", () => {
+  const t = setup();
+  assert.equal(t.run("start").status, 0);
+  assert.equal(existsSync(join(t.stub, "inherited-fd9")), false);
+  assert.equal(t.run("stop").status, 0, "the lock is free again");
+});
+
+test("SIGTERM during start stops the Mixxx it launched", async () => {
+  const t = setup({ state: { "no-log": "" } });
+  const env = { ...BASE_ENV, PATH: `${join(t.dir, "bin")}:${process.env.PATH}`, HOME: t.home, STUB: t.stub,
+    WAYLAND_DISPLAY: "wayland-1", MIXXX_DEV_NULL_SINK: join(t.dir, "bin", "null-sink"), MIXXX_DEV_PROC: t.proc,
+    MIXXX_DEV_LOG_TIMEOUT: "20", MIXXX_DEV_ROUTE_TIMEOUT: "20", MIXXX_DEV_STOP_TIMEOUT: "1" };
+  const child = spawn(SCRIPT, ["start"], { env, stdio: "ignore" });
+  const exited = new Promise((res) => child.on("exit", (c, sig) => res(c ?? sig)));
+  const t0 = Date.now();
+  while (!t.running(ID) && Date.now() - t0 < 10000) await new Promise((res) => setTimeout(res, 50));
+  await new Promise((res) => setTimeout(res, 300));
+  child.kill("SIGTERM");
+  const code = await exited;
+  assert.notEqual(code, 0);
+  assert.equal(t.running(ID), false);
+  assert.deepEqual(kills(t.calls()), [`flatpak kill ${ID}`]);
+});
+
+test("while another start or stop holds the lock: start and stop refuse, status is not `stopped`", () => {
+  const t = setup();
+  mkdirSync(t.profile, { recursive: true });
+  const lock = join(t.profile, "mixxx-dev.lock"), ready = join(t.dir, "locked");
+  const holder = spawn("flock", [lock, "-c", `touch '${ready}'; sleep 20`], { stdio: "ignore" });
+  try {
+    const t0 = Date.now();
+    while (!existsSync(ready) && Date.now() - t0 < 5000) spawnSync("sleep", ["0.05"]);
+    assert.equal(t.run("start").status, 1);
+    assert.deepEqual(runs(t.calls()), []);
+    assert.equal(t.run("stop").status, 1);
+    assert.notEqual(t.run("status").stdout.trim(), "stopped");
+  } finally {
+    holder.kill("SIGKILL");
+  }
+});
+
+test("status prints `<id> running` (exit 0) or exactly `stopped` (exit 1), the contract null-sink relies on", () => {
+  const t = setup();
+  let r = t.run("status");
+  assert.equal(r.status, 1);
+  assert.equal(r.stdout, "stopped\n");
+  assert.equal(t.run("start").status, 0);
+  r = t.run("status");
+  assert.equal(r.status, 0);
+  assert.equal(r.stdout, `${ID} running\n`);
+  assert.equal(t.run("stop").status, 0);
+  r = t.run("status");
+  assert.equal(r.status, 1);
+  assert.equal(r.stdout, "stopped\n");
+});
+
+test("status never says `stopped` when `flatpak ps` fails", () => {
+  const t = setup();
+  assert.equal(t.run("start").status, 0);
+  writeFileSync(join(t.stub, "fail-ps"), "");
+  assert.notEqual(t.run("status").stdout.trim(), "stopped");
+});
+
+test("tools/null-sink down refuses while the real tools/mixxx-dev reports our Mixxx running", () => {
+  const t = setup();
+  assert.equal(t.run("start").status, 0);
+  const ns = (env = {}) => spawnSync(join(TOOLS, "null-sink"), ["down"], { encoding: "utf8",
+    env: { ...BASE_ENV, PATH: `${join(t.dir, "bin")}:${process.env.PATH}`, HOME: t.home, STUB: t.stub,
+      MIXXX_DEV_LAUNCHER: SCRIPT, ...env } });
+  mkdirSync(t.profile, { recursive: true });
+  writeFileSync(join(t.profile, "null-sink.module"), "536870916\n");
+  // our module is listed, so only the launcher check stands between `down` and the unload
+  exe(join(t.dir, "bin", "pactl"), PACTL.replace('"list short sinks")',
+    `"list short modules") printf '536870916\\tmodule-null-sink\\tsink_name=mixxx-dev\\n' ;;\n  "unload-module 536870916") echo unloaded >> "$STUB/calls.log" ;;\n  "list short sink-inputs") true ;;\n  "list short sinks")`));
+  let r = ns();
+  assert.equal(r.status, 1, r.stderr);
+  assert.match(r.stderr, /may be running/);
+  assert.equal(t.run("stop").status, 0);
+  r = ns();
+  assert.equal(r.status, 0, r.stderr);
+  assert.match(t.calls(), /^unloaded$/m);
+});
+
+test("log prints the last 50 lines of the dev profile's mixxx.log, or the last n", () => {
+  const t = setup();
+  mkdirSync(t.profile, { recursive: true });
+  writeFileSync(join(t.profile, "mixxx.log"), Array.from({ length: 80 }, (_, i) => `line ${i + 1}`).join("\n") + "\n");
+  let r = t.run("log");
+  assert.equal(r.status, 0, r.stderr);
+  const out = r.stdout.trimEnd().split("\n");
+  assert.equal(out.length, 50);
+  assert.equal(out[0], "line 31");
+  assert.equal(out.at(-1), "line 80");
+  r = t.run("log", "5");
+  assert.equal(r.stdout, "line 76\nline 77\nline 78\nline 79\nline 80\n");
+});
+
+test("log without a mixxx.log exits 1", () => {
+  const t = setup();
+  assert.equal(t.run("log").status, 1);
+});
+
+for (const args of [[], ["bogus"], ["log", "x"], ["log", "0"], ["log", "-5"], ["start", "extra"], ["stop", "1"]]) {
+  test(`usage error (exit 2): ${JSON.stringify(args)}`, () => {
+    const t = setup();
+    const r = t.run(...args);
+    assert.equal(r.status, 2, r.stderr);
+    assert.deepEqual(runs(t.calls()), []);
+    assert.deepEqual(kills(t.calls()), []);
+  });
+}
+
+for (const [k, v] of [["MIXXX_DEV_LOG_TIMEOUT", "1.5"], ["MIXXX_DEV_LOG_TIMEOUT", "08"],
+  ["MIXXX_DEV_STOP_TIMEOUT", "09"], ["MIXXX_DEV_ROUTE_TIMEOUT", "123456"], ["MIXXX_DEV_ROUTE_TIMEOUT", "a[$(touch pwned)]"],
+  ["MIXXX_DEV_STOP_TIMEOUT", "-1"]]) {
+  test(`start rejects ${k}=${v} (exit 2) before launching`, () => {
+    const t = setup();
+    const r = t.run("start", { [k]: v });
+    assert.equal(r.status, 2);
+    assert.deepEqual(runs(t.calls()), []);
+    assert.equal(existsSync(join(t.dir, "pwned")), false);
+    rmSync(t.dir, { recursive: true, force: true });
+  });
+}
