+// Rane One (MK1) glue between Mixxx and the platter core (rane-one-platter.js, loaded first).
+// M1 skeleton: no controls are mapped yet, and nothing here sends to the controller (D9: no outputs, no
+// midi.send* calls).
+
+var RaneOne = {};
+
+// Wraps a handler so it never throws into Mixxx: an exception is swallowed and logged once per handler name, at
+// Warning level so it shows in Mixxx's default log. Every function Mixxx calls (init, shutdown, input handlers)
+// is built with it. TODO(M7): platter handlers also need a fallback here (scratch off, play at the pitch
+// fader's rate), per CLAUDE.md.
+RaneOne.guard = function(name, handler) {
+    return function() {
+        try {
+            return handler.apply(this, arguments);
+        } catch (e) {
+            if (!RaneOne.guard.failed[name]) {
+                RaneOne.guard.failed[name] = true;
+                try {
+                    console.warn("RaneOne: " + name + " failed: " + e);
+                } catch (ignored) {
+                    // Logging is best effort; the handler still must not throw.
+                }
+            }
+            return undefined;
+        }
+    };
+};
+RaneOne.guard.failed = {};
+
+RaneOne.init = RaneOne.guard("init", function(id) {
+    console.log("RaneOne: init " + id);
+});
+
+RaneOne.shutdown = RaneOne.guard("shutdown", function() {
+    console.log("RaneOne: shutdown");
+});
