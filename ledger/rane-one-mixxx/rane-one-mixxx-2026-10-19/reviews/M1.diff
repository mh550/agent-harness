+// tools/null-sink creates and removes the mixxx-dev null sink that unattended Mixxx audio goes to (D9).
+// `pactl` is a stateful stub on PATH, so these tests never load a real module or touch a real sink.
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { spawnSync } from "node:child_process";
+import { mkdtempSync, mkdirSync, writeFileSync, readFileSync, existsSync, chmodSync, symlinkSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const SCRIPT = join(dirname(fileURLToPath(import.meta.url)), "..", "tools", "null-sink");
+const RANE = "alsa_output.usb-Rane_Rane_ONE_A-00.analog-surround-40";
+const MODULE_ID = "536870913";
+
+// State lives in files under $STUB: `loaded` (our module id), `default` (default sink), `inputs` (short
+// sink-inputs listing), `foreign` (a mixxx-dev sink someone else loaded), `hijack` (load changes the default).
+const PACTL = `#!/usr/bin/env bash
+echo "pactl $*" >> "$STUB/pactl.log"
+s=$STUB
+[[ $1 == list && -f $s/fail-$3 ]] && { echo "Connection failure" >&2; exit 1; }
+case "$*" in
+  set-default-*) exit 99 ;;
+  "list short sinks")
+    printf '172\\talsa_output.pci-0000_00_1f.3.analog-stereo\\tPipeWire\\ts32le 2ch 48000Hz\\tSUSPENDED\\n'
+    printf '779\\t${RANE}\\tPipeWire\\ts32le 4ch 48000Hz\\tSUSPENDED\\n'
+    if [[ -f $s/second ]]; then
+      [[ -f $s/foreign ]] && printf '901\\tmixxx-dev\\tPipeWire\\tfloat32le 2ch 48000Hz\\tIDLE\\n'
+      [[ -f $s/loaded ]] && printf '903\\tmixxx-dev\\tPipeWire\\tfloat32le 2ch 48000Hz\\tIDLE\\n'; true
+    elif [[ -f $s/loaded || -f $s/foreign ]]; then printf '901\\tmixxx-dev\\tPipeWire\\tfloat32le 2ch 48000Hz\\tIDLE\\n'; fi ;;
+  "list short modules")
+    printf '536870912\\tlibpipewire-module-protocol-pulse\\t\\n'
+    if [[ -f $s/loaded ]]; then printf '%s\\tmodule-null-sink\\tsink_name=mixxx-dev rate=48000 channels=2\\n' "$(cat "$s/loaded")"; fi
+    if [[ -f $s/foreign ]]; then printf '536870999\\tmodule-null-sink\\tsink_name=mixxx-dev\\n'; fi
+    if [[ -f $s/other ]]; then printf '%s\\tmodule-null-sink\\tsink_name=something-else\\n' "$(cat "$s/other")"; fi ;;
+  "list short sink-inputs") [[ -f $s/inputs ]] && cat "$s/inputs"; true ;;
+  info) echo "Server Name: PulseAudio (on PipeWire 1.5.85)"; echo "Default Sink: $(cat "$s/default")" ;;
+  load-module*)
+    [[ -f $s/loaded ]] && { echo "already loaded" >&2; exit 1; }
+    echo ${MODULE_ID} > "$s/loaded"; echo ${MODULE_ID}
+    [[ -f $s/hijack ]] && echo mixxx-dev > "$s/default"; true ;;
+  "unload-module ${MODULE_ID}") rm -f "$s/loaded" ;;
+  unload-module*) true ;;
+  *) echo "pactl stub: unexpected: $*" >&2; exit 98 ;;
+esac
+`;
+
+// The tools' own env, without anything the caller's shell may export (e.g. MIXXX_DEV_PROFILE).
+const BASE_ENV = Object.fromEntries(Object.entries(process.env).filter(([k]) => !/^(MIXXX_DEV_|NULL_SINK_)/.test(k)));
+
+const LAUNCHERS = {
+  stopped: `echo stopped; exit 1`,
+  running: `echo "abc running"; exit 0`,
+  broken: `exit 127`,
+  "says running, exits 1": `echo running; exit 1`,
+};
+
+function setup({ state = {}, launcher = "stopped", env = {} } = {}) {
+  const dir = mkdtempSync(join(tmpdir(), "null-sink-"));
+  const bin = join(dir, "bin"), stub = join(dir, "stub"), home = join(dir, "home");
+  for (const d of [bin, stub, home]) mkdirSync(d);
+  writeFileSync(join(bin, "pactl"), PACTL);
+  chmodSync(join(bin, "pactl"), 0o755);
+  // Other ways to change the default sink: stubbed so a regression logs and fails instead of running for real.
+  for (const tool of ["wpctl", "pw-metadata", "pw-cli", "pw-link"]) {
+    writeFileSync(join(bin, tool), `#!/usr/bin/env bash\necho "${tool} $*" >> "$STUB/pactl.log"\nexit 99\n`);
+    chmodSync(join(bin, tool), 0o755);
+  }
+  const devTool = join(bin, "mixxx-dev");
+  writeFileSync(devTool, `#!/usr/bin/env bash\necho "mixxx-dev $*" >> "$STUB/pactl.log"\n${LAUNCHERS[launcher]}\n`);
+  chmodSync(devTool, 0o755);
+  writeFileSync(join(stub, "default"), RANE);
+  for (const [k, v] of Object.entries(state)) writeFileSync(join(stub, k), v);
+  const profile = join(dir, "profile");
+  // run("up") or run("up", { ENV: "override" }): a trailing plain object is extra env, not an argument.
+  const run = (...args) => spawnSync(SCRIPT, args.filter((a) => typeof a === "string"), {
+    encoding: "utf8",
+    env: { ...BASE_ENV, PATH: `${bin}:${process.env.PATH}`, HOME: home, STUB: stub,
+      MIXXX_DEV_PROFILE: profile, MIXXX_DEV_LAUNCHER: devTool, NULL_SINK_SETTLE: "0", ...env,
+      ...args.find((a) => typeof a === "object") },
+  });
+  const log = () => (existsSync(join(stub, "pactl.log")) ? readFileSync(join(stub, "pactl.log"), "utf8") : "");
+  const moduleFile = join(profile, "null-sink.module");
+  return { dir, stub, home, profile, run, log, moduleFile };
+}
+
+const loads = (log) => log.split("\n").filter((l) => l.startsWith("pactl load-module")).length;
+const unloads = (log) => log.split("\n").filter((l) => l.startsWith("pactl unload-module"));
+const noDefaultChange = (log) => assert.doesNotMatch(log, /set-default|wpctl|pw-metadata/);
+
+test("up: loads module-null-sink as mixxx-dev at 48 kHz and records the module id", () => {
+  const t = setup();
+  const r = t.run("up");
+  assert.equal(r.status, 0, r.stderr);
+  const load = t.log().split("\n").find((l) => l.startsWith("pactl load-module"));
+  assert.match(load, /^pactl load-module module-null-sink /);
+  assert.match(load, / sink_name=mixxx-dev( |$)/);
+  assert.match(load, / rate=48000( |$)/);
+  assert.match(load, / channels=2( |$)/);
+  assert.equal(readFileSync(t.moduleFile, "utf8").trim(), MODULE_ID);
+  noDefaultChange(t.log());
+});
+
+test("up twice loads the module once", () => {
+  const t = setup();
+  assert.equal(t.run("up").status, 0);
+  const r = t.run("up");
+  assert.equal(r.status, 0, r.stderr);
+  assert.equal(loads(t.log()), 1);
+  assert.equal(readFileSync(t.moduleFile, "utf8").trim(), MODULE_ID);
+});
+
+test("up does not load a second sink when a mixxx-dev it did not load already exists", () => {
+  const t = setup({ state: { foreign: "" } });
+  const r = t.run("up");
+  assert.equal(r.status, 0, r.stderr);
+  assert.equal(loads(t.log()), 0);
+  assert.equal(existsSync(t.moduleFile), false);
+});
+
+test("up: if the default sink changed, unloads its own module at once and fails", () => {
+  const t = setup({ state: { hijack: "" } });
+  const r = t.run("up");
+  assert.equal(r.status, 1);
+  assert.deepEqual(unloads(t.log()), [`pactl unload-module ${MODULE_ID}`]);
+  assert.equal(existsSync(t.moduleFile), false);
+  noDefaultChange(t.log());
+});
+
+test("down unloads only the module id it loaded, then forgets it", () => {
+  const t = setup({ state: { other: "536870950" } });
+  assert.equal(t.run("up").status, 0);
+  const r = t.run("down");
+  assert.equal(r.status, 0, r.stderr);
+  assert.deepEqual(unloads(t.log()), [`pactl unload-module ${MODULE_ID}`]);
+  assert.equal(existsSync(t.moduleFile), false);
+  assert.equal(existsSync(join(t.stub, "loaded")), false);
+  noDefaultChange(t.log());
+});
+
+test("down with no module file unloads nothing, even when a mixxx-dev sink exists", () => {
+  const t = setup({ state: { foreign: "" } });
+  const r = t.run("down");
+  assert.equal(r.status, 0, r.stderr);
+  assert.deepEqual(unloads(t.log()), []);
+});
+
+test("down does not unload an id that is no longer our null sink", () => {
+  const t = setup({ state: { other: "536870950" } });
+  mkdirSync(t.profile, { recursive: true });
+  writeFileSync(t.moduleFile, "536870950\n"); // the id now belongs to someone else's null sink
+  const r = t.run("down");
+  assert.equal(r.status, 0, r.stderr);
+  assert.deepEqual(unloads(t.log()), []);
+  assert.equal(existsSync(t.moduleFile), false);
+});
+
+test("down refuses while a stream is on mixxx-dev (PipeWire would move it to the Rane One)", () => {
+  const t = setup();
+  assert.equal(t.run("up").status, 0);
+  writeFileSync(join(t.stub, "inputs"), "77\t901\t88\tPipeWire\tfloat32le 2ch 48000Hz\n");
+  const r = t.run("down");
+  assert.equal(r.status, 1);
+  assert.match(r.stderr, /stream/);
+  assert.deepEqual(unloads(t.log()), []);
+  assert.equal(existsSync(t.moduleFile), true);
+});
+
+test("down ignores streams on other sinks", () => {
+  const t = setup();
+  assert.equal(t.run("up").status, 0);
+  writeFileSync(join(t.stub, "inputs"), "77\t779\t88\tPipeWire\ts32le 4ch 48000Hz\n");
+  assert.equal(t.run("down").status, 0);
+  assert.deepEqual(unloads(t.log()), [`pactl unload-module ${MODULE_ID}`]);
+});
+
+for (const what of ["sink-inputs", "modules", "sinks"]) {
+  test(`down: a failing \`pactl list short ${what}\` unloads nothing and keeps the module id`, () => {
+    const t = setup();
+    assert.equal(t.run("up").status, 0);
+    writeFileSync(join(t.stub, `fail-${what}`), "");
+    const r = t.run("down");
+    assert.notEqual(r.status, 0);
+    assert.deepEqual(unloads(t.log()), []);
+    assert.equal(readFileSync(t.moduleFile, "utf8").trim(), MODULE_ID);
+  });
+}
+
+for (const launcher of ["broken", "says running, exits 1"]) {
+  test(`down refuses when the launcher's status is not a clean "stopped" (${launcher})`, () => {
+    const t = setup({ launcher });
+    assert.equal(t.run("up").status, 0);
+    assert.equal(t.run("down").status, 1);
+    assert.deepEqual(unloads(t.log()), []);
+  });
+}
+
+test("down refuses when MIXXX_DEV_LAUNCHER names a missing tool", () => {
+  const t = setup();
+  assert.equal(t.run("up").status, 0);
+  const r = t.run("down", { MIXXX_DEV_LAUNCHER: join(t.dir, "nope") });
+  assert.equal(r.status, 1);
+  assert.deepEqual(unloads(t.log()), []);
+});
+
+test("down refuses while a stream is on any sink named mixxx-dev, not just the first", () => {
+  // a foreign mixxx-dev at index 901, listed before ours at 903, and a stream on ours
+  const t = setup({ state: { foreign: "", second: "", loaded: MODULE_ID,
+    inputs: "77\t903\t88\tPipeWire\tfloat32le 2ch 48000Hz\n" } });
+  mkdirSync(t.profile, { recursive: true });
+  writeFileSync(t.moduleFile, `${MODULE_ID}\n`);
+  assert.equal(t.run("status").stdout.trim(), `mixxx-dev ${MODULE_ID}`);
+  const r = t.run("down");
+  assert.equal(r.status, 1);
+  assert.deepEqual(unloads(t.log()), []);
+});
+
+test("down refuses (exit 1) and keeps a module file that holds no id", () => {
+  const t = setup({ state: { loaded: MODULE_ID } });
+  mkdirSync(t.profile, { recursive: true });
+  writeFileSync(t.moduleFile, "garbage\n");
+  assert.equal(t.run("down").status, 1);
+  assert.equal(readFileSync(t.moduleFile, "utf8"), "garbage\n");
+  assert.deepEqual(unloads(t.log()), []);
+});
+
+for (const v of ["0.5", "-1", "a[$(touch pwned)]"]) {
+  test(`up rejects NULL_SINK_SETTLE=${v} (exit 2) before loading anything`, () => {
+    const t = setup({ state: { hijack: "" } });
+    const r = t.run("up", { NULL_SINK_SETTLE: v });
+    assert.equal(r.status, 2);
+    assert.equal(loads(t.log()), 0);
+    assert.equal(existsSync(join(t.dir, "pwned")), false);
+  });
+}
+
+test("up loads nothing when the profile cannot hold the module file", () => {
+  const t = setup();
+  writeFileSync(t.profile, "a file, not a directory");
+  assert.notEqual(t.run("up").status, 0);
+  assert.equal(loads(t.log()), 0);
+});
+
+test("up leaves no orphan module when writing the id fails after the load", () => {
+  const t = setup();
+  mkdirSync(t.moduleFile, { recursive: true }); // a directory where the id file goes
+  assert.notEqual(t.run("up").status, 0);
+  assert.equal(existsSync(join(t.stub, "loaded")), false);
+});
+
+test("up refuses (exit 3) a module file that is a symlink into the real profile", () => {
+  const t = setup();
+  const real = join(t.home, ".var/app/org.mixxx.Mixxx/.mixxx");
+  mkdirSync(real, { recursive: true });
+  writeFileSync(join(real, "mixxx.cfg"), "[Config]\n");
+  mkdirSync(t.profile, { recursive: true });
+  symlinkSync(join(real, "mixxx.cfg"), t.moduleFile);
+  assert.equal(t.run("up").status, 3);
+  assert.equal(readFileSync(join(real, "mixxx.cfg"), "utf8"), "[Config]\n");
+  assert.equal(loads(t.log()), 0);
+});
+
+test("down refuses while the dev Mixxx is running", () => {
+  const t = setup({ launcher: "running" });
+  assert.equal(t.run("up").status, 0);
+  const r = t.run("down");
+  assert.equal(r.status, 1);
+  assert.match(r.stderr, /Mixxx/);
+  assert.deepEqual(unloads(t.log()), []);
+});
+
+test("status prints the sink name and our module id", () => {
+  const t = setup();
+  assert.equal(t.run("up").status, 0);
+  const r = t.run("status");
+  assert.equal(r.status, 0);
+  assert.equal(r.stdout.trim(), `mixxx-dev ${MODULE_ID}`);
+});
+
+test("status reports a mixxx-dev it did not load as not ours", () => {
+  const r = setup({ state: { foreign: "" } }).run("status");
+  assert.equal(r.status, 0);
+  assert.equal(r.stdout.trim(), "mixxx-dev (not ours)");
+});
+
+test("status: absent, exit 1", () => {
+  const r = setup().run("status");
+  assert.equal(r.status, 1);
+  assert.equal(r.stdout.trim(), "absent");
+});
+
+test("no invocation ever changes the default sink or source", () => {
+  const t = setup();
+  for (const a of ["status", "up", "up", "status", "down", "down", "status"]) t.run(a);
+  noDefaultChange(t.log());
+});
+
+test("usage: bad or missing argument exits 2", () => {
+  const t = setup();
+  assert.equal(t.run().status, 2);
+  assert.equal(t.run("sideways").status, 2);
+  assert.equal(t.log(), "");
+});
+
+test("refuses (exit 3) a profile inside the real Mixxx profile", () => {
+  const t = setup();
+  const real = join(t.home, ".var/app/org.mixxx.Mixxx/.mixxx");
+  mkdirSync(real, { recursive: true });
+  const r = spawnSync(SCRIPT, ["up"], {
+    encoding: "utf8",
+    env: { ...BASE_ENV, PATH: `${join(t.dir, "bin")}:${process.env.PATH}`, HOME: t.home, STUB: t.stub,
+      MIXXX_DEV_PROFILE: join(real, "sub"), NULL_SINK_SETTLE: "0" },
+  });
+  assert.equal(r.status, 3);
+  assert.equal(t.log(), "");
+});
diff --git a/tools/install-mapping b/tools/install-mapping
new file mode 100755
index 0000000..5788bde
--- /dev/null
+++ b/tools/install-mapping
@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+# Copies every file in mapping/ into the dev profile's controllers/ (MIXXX_DEV_PROFILE, default
+# ~/.var/app/org.mixxx.Mixxx/dev-profile). Always copies, never symlinks: the Flatpak cannot see this checkout.
+#   tools/install-mapping
+# Exit: 0 installed · 1 nothing to install · 2 usage · 3 refused (the real Mixxx profile)
+set -euo pipefail
+here=$(cd "$(dirname "$0")" && pwd)
+# shellcheck source=lib/profile.sh
+source "$here/lib/profile.sh"
+(( $# == 0 )) || { sed -n 4p "$0" >&2; exit 2; }
+profile_guard
+src=$here/../mapping
+files=()
+for f in "$src"/*; do
+  if [[ -f $f && ! -L $f ]]; then files+=("$f"); elif [[ -e $f ]]; then echo "skipped (not a file): $f" >&2; fi
+done
+(( ${#files[@]} )) || { echo "nothing to install: no files in $(realpath -m "$src")" >&2; exit 1; }
+dest=$PROFILE/controllers
+[[ ! -L $dest ]] || { echo "refused: $dest is a symlink" >&2; exit 3; }
+mkdir -p "$dest"
+guard_path "$dest"
+tmp=
+trap '[[ -n $tmp ]] && rm -f -- "$tmp"' EXIT
+for f in "${files[@]}"; do
+  name=${f##*/}
+  # A fresh temp file plus rename in the same directory, so a running Mixxx's file watcher never reads half a
+  # script and a stale symlink in controllers/ is replaced, never written through.
+  tmp=$(mktemp -- "$dest/.$name.XXXXXX")
+  cp -- "$f" "$tmp"
+  chmod 644 -- "$tmp"
+  mv -f -T -- "$tmp" "$dest/$name"
+  tmp=
+  echo "installed $dest/$name"
+done
diff --git a/tools/lib/dev-seed.mjs b/tools/lib/dev-seed.mjs
new file mode 100644
index 0000000..fd5ef9d
--- /dev/null
+++ b/tools/lib/dev-seed.mjs
@@ -0,0 +1,109 @@
+// Seeds the dev Mixxx profile so a fresh Mixxx 2.5 starts without a modal dialog (plan "Dev profile seed", D9).
+//   node tools/lib/dev-seed.mjs <profile> <mixxx version>
+// Run by tools/mixxx-dev before every launch, after its profile guard. Every file goes through a temp file plus
+// rename in the profile, so a symlink in its place is replaced, never written through.
+import { mkdirSync, readFileSync, writeFileSync, renameSync, existsSync, rmSync } from "node:fs";
+import { join } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+
+const THROUGH = "Midi_Through_Port-0"; // sanitizeDeviceName("Midi Through Port-0"), controllermanager.cpp
+const CONTROLLER_GROUPS = ["Controller", "ControllerPreset"];
+
+// Launcher-owned: Main (Mixxx still calls it "Master") to the ALSA `pulse` device, which honours PULSE_SINK.
+export const SOUNDCONFIG = `<!DOCTYPE SoundManagerConfig>
+<SoundManagerConfig api="ALSA" samplerate="48000" latency="5" sync_buffers="2" force_network_clock="0" deck_count="4">
+  <SoundDevice name="pulse" portAudioIndex="-1">
+    <output type="Master" index="0" channel="0" channel_count="2"/>
+  </SoundDevice>
+</SoundManagerConfig>
+`;
+
+// Sets our keys in mixxx.cfg text, leaving every other line as Mixxx wrote it. `mapping` is the absolute path of
+// the installed Rane-One.midi.xml, or null: then Midi Through is neither enabled nor bound. Any Controller or
+// ControllerPreset key naming a Rane device is removed (D9: the real controller is never bound at night).
+export function applyCfg(text, { version, mapping }) {
+  const want = {
+    Config: { Version: version, show_menubar_hint: "0" },
+    Controller: mapping ? { [THROUGH]: "1" } : {},
+    ControllerPreset: mapping ? { [THROUGH]: mapping } : {},
+    "Direct Rendering": { Warned: "yes" },
+  };
+  const drop = (group, key) =>
+    CONTROLLER_GROUPS.includes(group) && (/rane/i.test(key) || (!mapping && key === THROUGH));
+
+  const groups = [{ name: null, lines: [] }];
+  for (const line of text.split("\n")) {
+    const m = /^\[(.*)\]\s*$/.exec(line);
+    if (m) groups.push({ name: m[1], lines: [] });
+    else groups.at(-1).lines.push(line);
+  }
+  const done = new Set();
+  for (const g of groups) {
+    const keys = want[g.name] ?? {};
+    g.lines = g.lines.flatMap((line) => {
+      const key = line.split(" ", 1)[0];
+      if (!line.trim()) return [];
+      if (drop(g.name, key)) return [];
+      if (Object.hasOwn(keys, key)) {
+        if (done.has(`${g.name}\n${key}`)) return [];
+        done.add(`${g.name}\n${key}`);
+        return [`${key} ${keys[key]}`];
+      }
+      return [line];
+    });
+  }
+  for (const [name, keys] of Object.entries(want)) {
+    let g = groups.find((x) => x.name === name);
+    const missing = Object.keys(keys).filter((k) => !done.has(`${name}\n${k}`));
+    if (!missing.length) continue;
+    if (!g) groups.push((g = { name, lines: [] }));
+    for (const k of missing) g.lines.push(`${k} ${keys[k]}`);
+  }
+  return groups
+    .filter((g) => g.name !== null || g.lines.length)
+    .map((g) => [...(g.name === null ? [] : [`[${g.name}]`]), ...g.lines].join("\n"))
+    .join("\n\n") + "\n";
+}
+
+function writeAtomic(profile, name, content) {
+  const tmp = join(profile, `.${name}.${process.pid}.tmp`);
+  try {
+    writeFileSync(tmp, content, { mode: 0o644, flag: "wx" });
+    renameSync(tmp, join(profile, name));
+  } finally {
+    rmSync(tmp, { force: true });
+  }
+}
+
+export function seed(profile, version) {
+  for (const d of [profile, join(profile, "controllers"), join(profile, "music")]) mkdirSync(d, { recursive: true });
+  const cfgPath = join(profile, "mixxx.cfg");
+  const mapping = join(profile, "controllers", "Rane-One.midi.xml");
+  const cfg = existsSync(cfgPath) ? readFileSync(cfgPath, "utf8") : "";
+  writeAtomic(profile, "mixxx.cfg", applyCfg(cfg, { version, mapping: existsSync(mapping) ? mapping : null }));
+  writeAtomic(profile, "soundconfig.xml", SOUNDCONFIG);
+  // The library chooser shows while the DB table `directories` is empty (coreservices.cpp); Mixxx's own schema
+  // migration creates it IF NOT EXISTS and keeps the row. An existing database is Mixxx's: never touched.
+  const db = join(profile, "mixxxdb.sqlite");
+  if (!existsSync(db)) {
+    const tmp = join(profile, `.mixxxdb.sqlite.${process.pid}.tmp`);
+    try {
+      const sql = new DatabaseSync(tmp);
+      sql.exec("CREATE TABLE directories (directory TEXT UNIQUE)");
+      sql.prepare("INSERT INTO directories VALUES (?)").run(join(profile, "music"));
+      sql.close();
+      renameSync(tmp, db);
+    } finally {
+      rmSync(tmp, { force: true });
+    }
+  }
+}
+
+if (import.meta.main) {
+  const [profile, version, ...rest] = process.argv.slice(2);
+  if (!profile?.startsWith("/") || !/^\d+\.\d+\.\d+/.test(version ?? "") || rest.length) {
+    console.error("usage: node tools/lib/dev-seed.mjs <absolute profile> <mixxx version>");
+    process.exit(2);
+  }
+  seed(profile, version);
+}
diff --git a/tools/lib/midi-parse.mjs b/tools/lib/midi-parse.mjs
new file mode 100644
index 0000000..fe6f6bb
--- /dev/null
+++ b/tools/lib/midi-parse.mjs
@@ -0,0 +1,160 @@
+// Pure MIDI 1.0 byte-stream parser shared by capture, replay, census and the tests. No I/O.
+// Spec: docs/plans/2026-10-19-M1-dev-loop.md, section "MIDI parser".
+
+const SYSEX_MAX = 65536;
+
+// Data-byte count per channel-message kind (status & 0xF0).
+const CHANNEL_LEN = { 0x80: 2, 0x90: 2, 0xa0: 2, 0xb0: 2, 0xc0: 1, 0xd0: 1, 0xe0: 2 };
+// Data-byte count for system common; 0xF4, 0xF5 (undefined) and a stray 0xF7 are absent and get dropped.
+const COMMON_LEN = { 0xf1: 1, 0xf2: 2, 0xf3: 1, 0xf6: 0 };
+
+export function createParser() {
+  let running = 0; // last channel status, 0 = none
+  let status = 0; // status of the message being collected, 0 = none
+  let need = 0; // data bytes the current message takes
+  let data = [];
+  let pending = 0; // bytes buffered for the current message (its status byte too, unless running status)
+  let sysex = null; // payload array while inside F0 … F7
+  // `dropped` counts input bytes (or invalid elements) that ended up in no emitted message.
+  const stats = { messages: 0, dropped: 0 };
+
+  const abandon = () => {
+    stats.dropped += pending;
+    status = need = pending = 0;
+    data = [];
+  };
+
+  function feed(bytes) {
+    const out = [];
+    const emit = (msg) => {
+      out.push(msg);
+      stats.messages++;
+    };
+    const endSysex = (truncated) => {
+      emit(truncated ? { status: 0xf0, data: sysex, truncated: true } : { status: 0xf0, data: sysex });
+      sysex = null;
+    };
+
+    try {
+      if (bytes != null && typeof bytes[Symbol.iterator] === "function") for (const b of bytes) step(b);
+    } catch {
+      // Never throw: a hostile iterable ends the feed; what was parsed so far is returned.
+    }
+    return out;
+
+    function step(b) {
+      if (!Number.isInteger(b) || b < 0 || b > 0xff) {
+        // Not a byte: breaks whatever was in progress, so its neighbours never join into a fake message.
+        stats.dropped++;
+        abandon();
+        if (sysex) endSysex(true);
+        return;
+      }
+      if (b >= 0xf8) {
+        // Real-time: emitted at once, leaves everything around it untouched.
+        emit({ status: b, data: [] });
+        return;
+      }
+      if (sysex) {
+        if (b < 0x80) {
+          if (sysex.length < SYSEX_MAX) sysex.push(b);
+          else {
+            endSysex(true);
+            stats.dropped++; // the rest of this SysEx has no status to belong to
+          }
+          return;
+        }
+        if (b === 0xf7) {
+          endSysex(false);
+          return;
+        }
+        endSysex(true); // any other status byte ends it, then is processed below
+      }
+      if (b < 0x80) {
+        if (!status) {
+          if (!running) {
+            stats.dropped++;
+            return;
+          }
+          status = running;
+          need = CHANNEL_LEN[running & 0xf0];
+          data = [];
+        }
+        data.push(b);
+        pending++;
+        if (data.length === need) {
+          emit({ status, data });
+          status = need = pending = 0;
+          data = [];
+        }
+        return;
+      }
+      // A new status byte abandons any partial message.
+      abandon();
+      if (b < 0xf0) {
+        running = b;
+        status = b;
+        need = CHANNEL_LEN[b & 0xf0];
+        pending = 1;
+        return;
+      }
+      running = 0; // SysEx and system common clear running status
+      if (b === 0xf0) {
+        sysex = [];
+      } else if (b in COMMON_LEN) {
+        if (COMMON_LEN[b] === 0) emit({ status: b, data: [] });
+        else {
+          status = b;
+          need = COMMON_LEN[b];
+          pending = 1;
+        }
+      } else {
+        stats.dropped++; // 0xF4, 0xF5, stray 0xF7
+      }
+    }
+  }
+
+  function reset() {
+    running = status = need = pending = 0;
+    data = [];
+    sysex = null;
+    stats.messages = stats.dropped = 0;
+  }
+
+  return { feed, reset, stats };
+}
+
+const hex = (b) => b.toString(16).padStart(2, "0");
+
+const REALTIME = { 0xf8: "clock", 0xfa: "start", 0xfb: "continue", 0xfc: "stop", 0xfe: "sense", 0xff: "reset" };
+
+// One-line text for a message; channels are shown 1-based.
+export function describe(msg) {
+  const { status, data } = msg ?? {};
+  if (!Number.isInteger(status) || !Array.isArray(data)) return "invalid";
+  const [d1, d2] = data;
+  if (status < 0xf0) {
+    const ch = `ch${(status & 0x0f) + 1}`;
+    switch (status & 0xf0) {
+      case 0x80: return `off ${ch} ${d1}=${d2}`;
+      case 0x90: return `on ${ch} ${d1}=${d2}`;
+      case 0xa0: return `pat ${ch} ${d1}=${d2}`;
+      case 0xb0: return `cc ${ch} ${d1}=${d2}`;
+      case 0xc0: return `pc ${ch} ${d1}`;
+      case 0xd0: return `cp ${ch} ${d1}`;
+      case 0xe0: return `pb ${ch} ${d1 | (d2 << 7)}`;
+      default: return `status 0x${hex(status)}`;
+    }
+  }
+  switch (status) {
+    case 0xf0: {
+      const shown = data.slice(0, 32).map((b) => (Number.isInteger(b) ? hex(b) : "??")).join(" ");
+      return `sysex ${data.length}:${shown ? " " + shown : ""}${data.length > 32 ? " …" : ""}${msg.truncated ? " truncated" : ""}`;
+    }
+    case 0xf1: return `mtc 0x${hex(d1)}`;
+    case 0xf2: return `spp ${d1 | (d2 << 7)}`;
+    case 0xf3: return `song ${d1}`;
+    case 0xf6: return "tune";
+    default: return REALTIME[status] ?? `status 0x${hex(status)}`;
+  }
+}
diff --git a/tools/lib/profile.sh b/tools/lib/profile.sh
new file mode 100644
index 0000000..d21683d
--- /dev/null
+++ b/tools/lib/profile.sh
@@ -0,0 +1,22 @@
+# Sourced by the dev-loop tools. profile_guard sets PROFILE to the dev Mixxx profile (MIXXX_DEV_PROFILE, default
+# ~/.var/app/org.mixxx.Mixxx/dev-profile), resolved through symlinks; guard_path checks a path a tool is about to
+# write. Both exit 3 when the path is Michael's real profile ~/.var/app/org.mixxx.Mixxx/.mixxx, inside it, or an
+# ancestor of it, compared both as written and with symlinks resolved (D3, plan "Profile guard").
+guard_path() {
+  local real p r
+  for real in "$(realpath -ms -- "$HOME/.var/app/org.mixxx.Mixxx/.mixxx")" \
+              "$(realpath -m -- "$HOME/.var/app/org.mixxx.Mixxx/.mixxx")"; do
+    for p in "$(realpath -ms -- "$1")" "$(realpath -m -- "$1")"; do
+      r=${p%/}
+      if [[ $p == "$real" || $p/ == "$real"/* || $real/ == "$r"/* ]]; then
+        echo "refused: $1 is (or contains) the real Mixxx profile $real" >&2
+        exit 3
+      fi
+    done
+  done
+}
+
+profile_guard() {
+  PROFILE=$(realpath -m -- "${MIXXX_DEV_PROFILE:-$HOME/.var/app/org.mixxx.Mixxx/dev-profile}")
+  guard_path "${MIXXX_DEV_PROFILE:-$HOME/.var/app/org.mixxx.Mixxx/dev-profile}"
+}
diff --git a/tools/midi-send b/tools/midi-send
index 9adfefa..8503af6 100755
--- a/tools/midi-send
+++ b/tools/midi-send
@@ -3,7 +3,8 @@
 # (he runs `touch ~/.rane-armed` while he is at the controller and removes it when he leaves).
 #   tools/midi-send raw  <rawmidi device, e.g. hw:3,0,0> <hex bytes…>    (amidi -S)
 #   tools/midi-send play <seq client:port, e.g. 14:0>    <file.mid>       (aplaymidi)
-# Exit: 0 sent · 2 usage · 3 refused (Rane One, not armed) · 4 refused (unknown destination)
+# Exit: 0 sent · 2 usage · 3 refused (Rane One or a route to it, not armed) · 4 refused (unknown destination)
+# `play` checks the subscriptions once, before playback; a subscription added while aplaymidi plays is not seen.
 set -euo pipefail
