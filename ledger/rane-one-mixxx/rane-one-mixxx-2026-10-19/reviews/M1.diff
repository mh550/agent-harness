+
+test("seed fills a missing profile: mixxx.cfg, soundconfig.xml, controllers/, music/ and the library row", () => {
+  const profile = join(mkdtempSync(join(tmpdir(), "dev-seed-")), "dev-profile");
+  seed(profile, "2.5.6");
