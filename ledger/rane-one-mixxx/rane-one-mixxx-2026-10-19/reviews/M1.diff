+    /^ +[0-9]+ \047/ { port = c ":" $1; ports[c] = ports[c] " " port; next }
+    /^\tConnecting To: / && port != "" {
+      l = $0; sub(/^\t[^:]*: /, "", l); k = split(l, a, /, */)
