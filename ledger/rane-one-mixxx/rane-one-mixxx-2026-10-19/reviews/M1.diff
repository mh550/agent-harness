+  assert.equal(readFileSync(join(profile, "soundconfig.xml"), "utf8"), SOUNDCONFIG);
+  assert.ok(existsSync(join(profile, "controllers")));
+  assert.ok(existsSync(join(profile, "music")));
+  const db = new DatabaseSync(join(profile, "mixxxdb.sqlite"), { readOnly: true });
+  assert.deepEqual(db.prepare("SELECT directory FROM directories").all().map((r) => r.directory), [join(profile, "music")]);
+  db.close();
+  assert.deepEqual(readdirSync(profile).filter((n) => n.startsWith(".")), [], "no temp files left behind");
+});
+
+test("seed binds Midi Through only once the mapping is installed in controllers/", () => {
+  const profile = join(mkdtempSync(join(tmpdir(), "dev-seed-")), "dev-profile");
+  seed(profile, "2.5.6");
+  assert.equal(parse(readFileSync(join(profile, "mixxx.cfg"), "utf8")).ControllerPreset, undefined);
+  writeFileSync(join(profile, "controllers", "Rane-One.midi.xml"), "<MixxxControllerPreset/>\n");
+  seed(profile, "2.5.6");
+  assert.equal(parse(readFileSync(join(profile, "mixxx.cfg"), "utf8")).ControllerPreset["Midi_Through_Port-0"],
+    join(profile, "controllers", "Rane-One.midi.xml"));
