{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(docker compose:*)",
      "Bash(docker image ls:*)",
      "Bash(sqlite3 /srv/docker/:*)",
      "Bash(git:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git branch -D:*)",
      "Bash(git worktree remove:*)",
      "Bash(git worktree prune:*)",
      "Bash(gh pr:*)",
      "Bash(gh pr merge:*)",
      "Bash(npm:*)",
      "Bash(node:*)",
      "Bash(harness:*)",
      "mcp__n8n-docs",
      "mcp__n8n__search_workflows",
      "mcp__n8n__get_workflow_details",
      "mcp__n8n__get_workflow_history",
      "mcp__n8n__get_workflow_version",
      "mcp__n8n__get_workflow_versions_diff",
      "mcp__n8n__search_projects",
      "mcp__n8n__search_folders",
      "mcp__n8n__list_workflow_tags",
      "mcp__n8n__get_workflow_execution",
      "mcp__n8n__search_workflow_executions",
      "mcp__n8n__list_credentials",
      "mcp__n8n__get_instance_context",
      "mcp__n8n__get_instance_activity",
      "mcp__n8n__expand_instance_activity",
      "mcp__n8n__get_node_usage",
      "mcp__n8n__get_workflow_sdk_reference",
      "mcp__n8n__search_nodes",
      "mcp__n8n__get_node_types",
      "mcp__n8n__get_workflow_best_practices"
    ],
    "deny": [
      "Bash(*fetch*--approve*)",
      "Edit(//srv/incoming/**)",
      "Read(//**/.env)",
      "Read(//etc/restic/**)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --mirror:*)",
      "Bash(git push * :main)",
      "Bash(git push * :refs/heads/main)",
      "Bash(git push * --delete main)",
      "Bash(git push * -d main)",
      "Bash(git push --delete * main)",
      "Bash(git push -d * main)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(git reflog expire:*)",
      "Bash(git reflog delete:*)",
      "Bash(git gc --prune:*)",
      "Bash(gh repo delete:*)"
    ],
    "defaultMode": "auto"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "linear-cli@linear-cli": false,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "context7@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "linear-cli": {
      "source": {
        "source": "github",
        "repo": "schpet/linear-cli"
      }
    },
    "n8n-io": {
      "source": {
        "source": "github",
        "repo": "n8n-io/skills"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-opus-4-8": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "autoCompactEnabled": true,
  "autoContinueAtUsageLimit": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "model": "opus",
  "enabledMcpjsonServers": [
    "n8n",
    "n8n-docs"
  ]
}
