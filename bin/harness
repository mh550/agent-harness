#!/usr/bin/env bash
# harness — long-running agent harness (initializer + one fresh session per feature), reusable across projects.
#
#   harness start <project> [<run-id>] [--spec "<files>"] [--brief "<text>" | --brief-file <f>] [--base <ref>]
#                 [--until HH:MM] [--now] [--no-supervisor] [--foreground]
#                               a new run (worktree + branch harness/<run-id>), or resume an existing one. With
#                               MAX_PARALLEL_RUNS runs already going, it is queued instead (--now: start anyway)
#   harness continue <run-id> [--brief …] [--until HH:MM] [--now]
#                               resume a run with fresh attempts for every feature that isn't passing
#   harness queue [list]                         what is queued, running and done
#   harness queue add <project> [<run-id>] [start options] | add --continue <run-id> [options]
#   harness queue rm <n> | clear | start [--until HH:MM] | stop
#   harness status [<run-id>]                    every run: running / ended (why), features, last log lines
#   harness report [<run-id>…]                   the writeup: passing, tests, spend (total, per feature, by role), causes
#   harness trends                               every recorded run in one table (the harness ledger)
#   harness debrief [--dry-run]                  after a queue: one short read-only session writes the debrief
#                               (ledger/debrief.md; NOTIFY_CMD gets its headline). The queue runner starts it as it exits
#   harness merge <run-id>                       merge the run's verified milestones into main now (a PR each)
#   harness attach <run-id>                      the run's tmux session (driver · log · supervisor)
#   harness pause|resume|stop <run-id>           between sessions; the current session finishes first
#   harness answer <run-id> <text>               an answer for the sessions (lands in the run's INBOX.md)
#   harness parked [<run-id>] [--json]           what parked features wait on: why, the INBOX question, the next commands
#   harness desk <run> [--why "…"] | --debrief   a Remote Control session that briefs you and takes your answers (tmux h-desk)
#   harness desk --list | --close <run>|--all    the open desks: window, run, URL, age · close them
#   harness init <project> [--draft]             CLAUDE.md + .harness/config.sh for a new project (--draft: Claude drafts
#                                                CLAUDE.md from the repo's docs for you to edit)
#   harness gc <project> [--all-merged] [--dry-run]
#                               delete merged harness branches and their clean worktrees, locally and on origin;
#                               close the project's desks idle for 24 h
#
# Where things live:  worktree ~/worktrees/<project>/<run-id> · branch harness/<run-id>
#   committed run record  <worktree>/.harness/runs/<run-id>/{feature_list.json,progress.md,INBOX.md,harness-log.md,
#                         metrics.jsonl,brief.md,summary.json,report.md,retro.md}
#   local state           ~/.local/state/harness/<project>/<run-id>/{run.log,logs/*.jsonl,attempts.json,port,driver.pid,ended,…}
#   queue                 ~/.local/state/harness/queue/   · shared usage-limit window: ~/.local/state/harness/LIMIT_UNTIL
#   ledger                <harness>/ledger/{runs.jsonl,<project>/<run-id>/,debrief.md}
#   scratch               /tmp/harness/<project>/<run-id>/
#   config layers         harness defaults → ~/.config/harness/config.sh → <project>/.harness/config.sh → the run's options
set -euo pipefail
HARNESS_HOME=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd); export HARNESS_HOME
STATE_ROOT=${HARNESS_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/harness}
WT_ROOT=${HARNESS_WORKTREES:-$HOME/worktrees}
Q=$STATE_ROOT/queue
# shellcheck source=lib/config.sh
source "$HARNESS_HOME/lib/config.sh"

die() { echo "harness: $*" >&2; exit 1; }
toplevel() { git -C "$1" rev-parse --show-toplevel 2>/dev/null || die "$1 is not a git repository"; }
state_of() {   # run-id → state dir
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "no run '$1' (run-id: letters, digits, . _ - only)"   # compgen globs
  local d; d=$(compgen -G "$STATE_ROOT/*/$1" | head -1 || true)
  [[ -n $d && -f $d/meta.env ]] || die "no run '$1' (see: harness status)"; echo "$d"
}
tmux_name() { echo "h-${1//./-}"; }
port_taken() { (echo > "/dev/tcp/127.0.0.1/$1") 2>/dev/null || grep -qsx "$1" "$STATE_ROOT"/*/*/port; }
alive() { local p; p=$(cat "$1/driver.pid" 2>/dev/null) && [[ -n $p ]] && kill -0 "$p" 2>/dev/null; }
runner_up() { [[ -f $Q/runner.pid ]] && kill -0 "$(cat "$Q/runner.pid")" 2>/dev/null; }
alive_count() { local d n=0; for d in "$STATE_ROOT"/*/*/; do alive "$d" && n=$(( n + 1 )); done; echo "$n"; }
to_epoch() { [[ $1 =~ ^[0-9]{9,}$ ]] && { echo "$1"; return; }   # HH:MM → the next such time
  local e; e=$(date -d "$1" +%s) || die "bad time '$1'"; (( e <= $(date +%s) )) && e=$(( e + 86400 )); echo "$e"; }

cmd_init() {
  local p draft=0; p=$(toplevel "${1:?usage: harness init <project> [--draft]}"); [[ ${2:-} == --draft ]] && draft=1
  mkdir -p "$p/.harness"
  [[ -e $p/.harness/config.sh ]] && echo "keep    .harness/config.sh" \
    || { cp "$HARNESS_HOME/templates/project/config.sh" "$p/.harness/config.sh"; echo "created .harness/config.sh (POLICY=build-only)"; }
  if [[ -e $p/CLAUDE.md ]]; then echo "keep    CLAUDE.md"
  elif (( draft )); then
    echo "drafting CLAUDE.md from the repo's README and docs (one Sonnet session)…"
    (cd "$p" && claude -p "$(cat "$HARNESS_HOME/prompts/draft-claude-md.md")" --model "$(node "$HARNESS_HOME/lib/features.mjs" model sonnet)" \
      --permission-mode auto --max-turns 40 > /dev/null) && echo "drafted CLAUDE.md: read it, edit it, commit it"
  else cp "$HARNESS_HOME/templates/project/CLAUDE.md" "$p/CLAUDE.md"; echo "created CLAUDE.md (template: fill it in)"; fi
  harness_config "$p"
  echo "detected: suite '${CHECK_CMD:-none — set CHECK_CMD in .harness/config.sh}' · smoke '$SMOKE_CMD' · init '$INIT_CMD'"
  echo "permissions: your user settings apply. A project needing extra allows can keep them in .claude/settings.json"
  echo "             (example: $HARNESS_HOME/templates/project/settings.example.json); the harness never writes it."
  echo "next: commit CLAUDE.md and .harness/ to main, then: harness start $p --spec <files> [--brief '<scope>']"
}

auto_id() {   # project → <project>-<date>[-n], not used before
  local base n=1 id; base=$(basename "$1")-$(date +%F); id=$base
  while compgen -G "$STATE_ROOT/*/$id" > /dev/null || [[ -d $WT_ROOT/$(basename "$1")/$id ]]; do n=$(( n + 1 )); id=$base-$n; done
  echo "$id"
}

queue_add() {   # verb args… → a queue entry (one argument per line)
  mkdir -p "$Q/done"
  local n; n=$(( $(ls "$Q" | sed -n 's/^\([0-9]\{4\}\)-.*\.args$/\1/p' | sort -n | tail -1 | sed 's/^0*//' || true) + 1 ))
  local f; f=$Q/$(printf '%04d' "$n")-$1-${2##*/}.args
  printf '%s\n' "$@" > "$f"; echo "$f"
}

queue_ensure_runner() {
  [[ ${HARNESS_NO_RUNNER:-} ]] && return 0   # tests
  runner_up && return 0
  tmux has-session -t h-queue 2>/dev/null && tmux kill-session -t h-queue
  tmux new-session -d -s h-queue -n runner "env HARNESS_HOME=$(printf %q "$HARNESS_HOME") HARNESS_STATE=$(printf %q "$STATE_ROOT") $(printf %q "$HARNESS_HOME/lib/queue.sh") ${1:-0}; echo '[queue runner exited]'; exec bash"
  echo "queue runner started (tmux h-queue)"
}

cmd_start() {
  local p run="" base="" supervisor=1 fg=0 now=0 spec="" brief="" until="" orig=("$@")
  p=$(toplevel "${1:?usage: harness start <project> [<run-id>] [options]}"); shift
  [[ ${1:-} && $1 != --* ]] && { run=$1; shift; }
  while (( $# )); do case $1 in
    --base) base=$2; shift 2 ;; --spec) spec=$2; shift 2 ;; --brief) brief=$2; shift 2 ;;
    --brief-file) brief=$(cat "$2") || die "can't read $2"; shift 2 ;;
    --until) until=$(to_epoch "$2"); shift 2 ;; --until-epoch) until=$2; shift 2 ;;
    --no-supervisor) supervisor=0; shift ;; --foreground) fg=1; supervisor=0; shift ;; --now) now=1; shift ;;
    *) die "unknown option $1" ;; esac; done
  harness_config "$p"
  if [[ -z $run ]] && (( ! now && ! fg )) && (( $(alive_count) >= MAX_PARALLEL_RUNS )); then
    local args=("$p"); [[ -n $base ]] && args+=(--base "$base"); [[ -n $spec ]] && args+=(--spec "$spec")
    [[ -n $brief ]] && args+=(--brief "$brief"); [[ -n $until ]] && args+=(--until-epoch "$until")
    queue_add start "${args[@]}" > /dev/null   # no run id yet: it is chosen when the run starts
    echo "$(alive_count) run(s) going (MAX_PARALLEL_RUNS=$MAX_PARALLEL_RUNS): a new $(basename "$p") run is queued"; queue_ensure_runner; return
  fi
  run=${run:-$(auto_id "$p")}
  [[ $run =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "run-id: letters, digits, . _ - only"
  [[ $run == desk || $run == debrief ]] && die "run-id '$run' is taken by the desk (tmux h-desk, <state>/queue/desk)"
  local proj branch=harness/$run wt state
  proj=$(basename "$p"); wt=$WT_ROOT/$proj/$run; state=$STATE_ROOT/$proj/$run
  if alive "$state"; then die "run $run is already running (harness attach $run)"; fi
  if (( ! now && ! fg )) && (( $(alive_count) >= MAX_PARALLEL_RUNS )); then
    local args=("$p" "$run"); [[ -n $base ]] && args+=(--base "$base"); [[ -n $spec ]] && args+=(--spec "$spec")
    [[ -n $brief ]] && args+=(--brief "$brief"); [[ -n $until ]] && args+=(--until-epoch "$until")
    queue_add start "${args[@]}" > /dev/null
    echo "$(alive_count) run(s) going (MAX_PARALLEL_RUNS=$MAX_PARALLEL_RUNS): $run is queued"; queue_ensure_runner; return
  fi
  if [[ -d $wt ]]; then
    echo "resuming $run in $wt"
  else
    [[ -n $spec || -n $SPEC_FILES || -n $brief ]] || die "a new run needs --spec <files> or --brief <text> (or SPEC_FILES in .harness/config.sh)"
    git -C "$p" fetch -q origin
    if git -C "$p" rev-parse -q --verify "refs/remotes/origin/$branch" > /dev/null; then
      git -C "$p" worktree add -q "$wt" -B "$branch" "origin/$branch"
    else
      git -C "$p" worktree add -q -b "$branch" "$wt" "${base:-origin/main}"
    fi
    echo "worktree $wt on $branch (from ${base:-origin/main})"
  fi
  mkdir -p "$state"
  if [[ ! -f $state/port ]]; then
    local port=$BASE_PORT; while port_taken "$port"; do port=$(( port + 1 )); done
    echo "$port" > "$state/port"
  fi
  printf 'PROJECT_DIR=%q\nWT=%q\nRUN_ID=%q\nSTATE=%q\n' "$p" "$wt" "$run" "$state" > "$state/meta.env"
  [[ -n ${HARNESS_RUNNER_ID:-} ]] && echo "$HARNESS_RUNNER_ID" >> "$state/runners"   # started by that queue runner (its debrief covers it)
  # the run's own settings: --spec persists across resumes; --until applies to this start only
  local kept=() l; [[ -f $state/run.env ]] && mapfile -t kept < "$state/run.env"
  { for l in "${kept[@]}"; do [[ $l == DEADLINE_AT=* || ( -n $spec && $l == SPEC_FILES=* ) ]] || echo "$l"; done
    [[ -z $spec ]] || printf 'SPEC_FILES=%q\n' "$spec"; [[ -z $until ]] || printf 'DEADLINE_AT=%q\n' "$until"; } > "$state/run.env"
  [[ -n $brief ]] && printf '%s\n' "$brief" >> "$state/brief.md"
  rm -f "$state/STOP"
  local env="WT=$(printf %q "$wt") RUN_ID=$run STATE=$(printf %q "$state") PROJECT_DIR=$(printf %q "$p") HARNESS_HOME=$(printf %q "$HARNESS_HOME")"
  # tmux starts commands in its server's environment, not this shell's: pass the harness overrides along
  local v; for v in HARNESS_CLAUDE HARNESS_GH HARNESS_SCRATCH_ROOT HARNESS_PW HARNESS_PAUSE_POLL HARNESS_CONFIG HARNESS_LEDGER \
    HARNESS_STATE HARNESS_WORKTREES HARNESS_LIMIT_SLEEP HARNESS_MERGE_ONLY HARNESS_CURL HARNESS_DESK_SESSION HARNESS_DESK_WAIT; do
    [[ -n ${!v:-} ]] && env+=" $v=$(printf %q "${!v}")"; done
  if (( fg )); then eval "env $env $(printf %q "$HARNESS_HOME/lib/driver.sh")"; return; fi

  local s; s=$(tmux_name "$run")
  tmux has-session -t "$s" 2> /dev/null && tmux kill-session -t "$s"   # a finished run's windows (its driver is gone)
  tmux new-session -d -s "$s" -n driver -c "$wt" "env $env $(printf %q "$HARNESS_HOME/lib/driver.sh"); echo; echo '[driver exited — this window stays open]'; exec bash"
  tmux new-window -d -t "$s" -n log "touch $(printf %q "$state/run.log"); tail -n 100 -F $(printf %q "$state/run.log")"
  if (( supervisor )); then
    HARNESS_RUN_ID=$run HARNESS_STATE=$state HARNESS_WT=$wt HARNESS_BRANCH=$branch HARNESS_PROJECT_DIR=$p \
      node "$HARNESS_HOME/lib/render.mjs" "$HARNESS_HOME/prompts/supervisor.md" > "$state/supervisor-prompt.md"
    tmux new-window -d -t "$s" -n supervisor -c "$p" \
      "claude --model $(printf %q "$(node "$HARNESS_HOME/lib/features.mjs" model "$SUPERVISOR_MODEL")") \"\$(cat $(printf %q "$state/supervisor-prompt.md"))\"; exec bash"
  fi
  echo "started tmux session $s (windows: driver, log$( (( supervisor )) && echo ', supervisor'))"
  echo "  watch:   harness attach $run      (Ctrl-b n = next window, Ctrl-b d = detach)"
  echo "  status:  harness status $run      steer from the phone: $branch → .harness/runs/$run/INBOX.md"
}

cmd_continue() {   # run-id [--keep-attempts] [--queued] [start options]
  local run=${1:?usage: harness continue <run-id> [options]} st keep=0 queued=0 rest=(); shift
  while (( $# )); do case $1 in --keep-attempts) keep=1 ;; --queued) queued=1 ;; *) rest+=("$1") ;; esac; shift; done
  st=$(state_of "$run")
  alive "$st" && die "$run is running; continue it after it ends (or harness stop $run)"
  if (( queued )) && grep -qs '^stopped by Michael' "$st/ended"; then echo "skipping queued continuation of $run: Michael stopped it"; return 0; fi
  # shellcheck source=/dev/null
  ( source "$st/meta.env"
    # a continuation you start gives every feature that isn't passing fresh attempts; an automatic one doesn't
    (( keep )) || { [[ -f $WT/.harness/runs/$RUN_ID/feature_list.json ]] && node "$HARNESS_HOME/lib/features.mjs" reset "$STATE/attempts.json" "$WT/.harness/runs/$RUN_ID/feature_list.json"
      rm -f "$STATE"/needs-* "$STATE"/verify-rounds-*; }
    rm -f "$STATE/PAUSE" "$STATE/STOP" "$STATE/ended"
    cmd_start "$PROJECT_DIR" "$RUN_ID" ${rest[@]+"${rest[@]}"} )
}

cmd_merge() {
  local st; st=$(state_of "${1:?usage: harness merge <run-id>}")
  alive "$st" && die "$1 is running; its driver merges verified milestones itself"
  # shellcheck source=/dev/null
  ( source "$st/meta.env"; local keep; keep=$(cat "$STATE/ended" 2>/dev/null || true)
    HARNESS_MERGE_ONLY=1 cmd_start "$PROJECT_DIR" "$RUN_ID" --foreground
    [[ -n $keep ]] && echo "$keep" > "$STATE/ended"; true )
}

cmd_status() {
  local d want=${1:-} any=0
  for d in "$STATE_ROOT"/*/*/; do
    [[ -f $d/meta.env ]] || continue
    [[ -n $want && $(basename "$d") != "$want" ]] && continue
    any=1
    # shellcheck source=/dev/null
    ( source "$d/meta.env"
      local state list upto
      list=$WT/.harness/runs/$RUN_ID/feature_list.json
      if alive "$STATE"; then state=running
        [[ -f $STATE/PAUSE ]] && state="$state, paused"
        upto=$(cat "$STATE_ROOT/LIMIT_UNTIL" 2>/dev/null || echo 0); (( upto > $(date +%s) )) && state="$state, waiting for the usage limit until $(date -d "@$upto" '+%H:%M')"
      elif [[ -f $STATE/ended ]]; then state="ended: $(cat "$STATE/ended")"
      else state="not running"; fi
      echo "$RUN_ID ($(basename "$PROJECT_DIR")) · $state · port $(cat "$STATE/port") · $( [[ -f $list ]] && node "$HARNESS_HOME/lib/features.mjs" summary "$list" || echo 'no feature list yet')"
      [[ -f $STATE/run.log ]] && tail -n "${N:-3}" "$STATE/run.log" | sed 's/^/    /'
    )
  done
  (( any )) || echo "no runs under $STATE_ROOT"
}

cmd_report() {
  local d ids=("$@") out=()
  (( ${#ids[@]} )) || for d in "$STATE_ROOT"/*/*/; do [[ -f $d/meta.env ]] && ids+=("$(basename "$d")"); done
  local run
  for run in "${ids[@]}"; do
    d=$(state_of "$run")
    # shellcheck source=/dev/null
    ( source "$d/meta.env"
      if [[ -d $WT ]]; then node "$HARNESS_HOME/lib/summary.mjs" build "$WT" "$RUN_ID" "$STATE" > "$STATE/summary.json"; fi
      [[ -f $STATE/summary.json ]] && node "$HARNESS_HOME/lib/summary.mjs" report "$STATE/summary.json" || echo "## $RUN_ID: no record" )
    echo
  done
}

cmd_queue() {
  local sub=${1:-list}; shift || true
  mkdir -p "$Q/done"
  case $sub in
    list)
      local f n=0
      echo "queue ($( runner_up && echo "runner going" || echo "runner not running: harness queue start"); MAX_PARALLEL_RUNS=$(harness_config /nonexistent; echo "$MAX_PARALLEL_RUNS")):"
      for f in "$Q"/*.args; do [[ -f $f ]] || continue; n=$(( n + 1 )); echo "  $n. $(paste -sd' ' "$f" | sed "s|$HOME|~|g")"; done
      (( n )) || echo "  (empty)"
      echo "running: $(for d in "$STATE_ROOT"/*/*/; do alive "$d" && basename "$d"; done | paste -sd' ' -)"
      if [[ -f $Q/runner.log ]]; then echo "recent:"; tail -n 5 "$Q/runner.log" | sed 's/^/  /'; fi ;;
    add)
      if [[ ${1:-} == --continue ]]; then
        local run=${2:?usage: harness queue add --continue <run-id>}; shift 2; state_of "$run" > /dev/null
        compgen -G "$Q/*-continue-$run.args" > /dev/null && { echo "already queued: continue $run"; return; }
        echo "queued: $(basename "$(queue_add continue "$run" --queued "$@")")"
      else
        local p; p=$(toplevel "${1:?usage: harness queue add <project> [<run-id>] [options]}"); shift
        echo "queued: $(basename "$(queue_add start "$p" "$@")")"
      fi ;;
    rm) local f; f=$(ls "$Q"/*.args 2>/dev/null | sed -n "${1:?usage: harness queue rm <n>}p"); [[ -n $f ]] || die "no entry $1"; rm "$f"; echo "removed $(basename "$f")" ;;
    clear) rm -f "$Q"/*.args; echo "queue cleared" ;;
    start) local until=0; [[ ${1:-} == --until ]] && until=$(to_epoch "$2"); queue_ensure_runner "$until" ;;
    stop) touch "$Q/STOP"; echo "the runner stops after its current start (running runs carry on)" ;;
    *) die "usage: harness queue [list|add|rm|clear|start|stop]" ;;
  esac
}

cmd_control() {   # pause|resume|stop run-id
  local st; st=$(state_of "${2:?usage: harness $1 <run-id>}")
  case $1 in
    pause) touch "$st/PAUSE"; echo "pausing $2 after the current session" ;;
    resume) rm -f "$st/PAUSE"; echo "resuming $2 (within a minute)" ;;
    stop) touch "$st/STOP"; echo "stopping $2 after the current session" ;;
  esac
}

cmd_parked() {   # [<run-id>] [--json]: read-only (no harness_config, no mkdir: a phone session runs it to look)
  local want="" json=() d runner=0
  while (( $# )); do case $1 in --json) json=(--json) ;; -*) die "unknown option $1" ;; *) [[ -z $want ]] || die "usage: harness parked [<run-id>] [--json]"; want=$1 ;; esac; shift; done
  [[ -n $want ]] && state_of "$want" > /dev/null
  runner_up && runner=1
  for d in "$STATE_ROOT"/*/*/; do
    [[ -f $d/meta.env ]] || continue
    [[ -n $want && $(basename "$d") != "$want" ]] && continue
    # shellcheck source=/dev/null
    # a gc'd worktree: nothing left to answer or continue. One broken meta.env doesn't cut the others off
    ( source "$d/meta.env"; [[ -d $WT ]] || exit 0
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$RUN_ID" "$(basename "$PROJECT_DIR")" "$STATE" "$WT/.harness/runs/$RUN_ID" "$(alive "$STATE" && { [[ -f $STATE/ended ]] && echo 2 || echo 1; } || echo 0)" \
        "$(compgen -G "$Q/*-continue-$RUN_ID.args" > /dev/null && echo 1 || echo 0)" ) || true   # 2: ending (finish)
  done | node "$HARNESS_HOME/lib/parked.mjs" report "${json[@]}" --runner "$runner" --run "$want"
}

cmd_answer() {
  local st; st=$(state_of "${1:?usage: harness answer <run-id> <text>}"); shift
  printf '%s\n' "$*" >> "$st/inbox.md"; echo "queued for the next session"
}

cmd_gc() {
  local p all=0 dry=0 b pattern; p=$(toplevel "${1:?usage: harness gc <project>}"); shift
  while (( $# )); do case $1 in --all-merged) all=1 ;; --dry-run) dry=1 ;; *) die "unknown option $1" ;; esac; shift; done
  act() { if (( dry )); then echo "would: $*"; else echo "+ $*"; "$@"; fi; }
  git -C "$p" fetch -q --prune origin
  local main=origin/main
  # A run branch is done when main has all of it except run-record bookkeeping (.harness/runs/, which the ledger
  # keeps): the commits after its last merged milestone. Then its worktree and branch go, unless its driver runs.
  record_only() { local r=$1 base; base=$(git -C "$p" merge-base "$main" "$r") || return 1
    git -C "$p" diff --quiet "$base" "$r" -- . ':!.harness/runs'; }
  running() { local d r=${1#harness/}; d=$(compgen -G "$STATE_ROOT/*/$r" | head -1) && alive "$d" && return 0
    compgen -G "$Q/*-continue-$r.args" > /dev/null; }   # running, or a continuation is queued
  while read -r wt; do
    [[ $wt == "$WT_ROOT"/* ]] || continue
    b=$(git -C "$wt" branch --show-current)
    [[ -n $b && -z $(git -C "$wt" status --porcelain) ]] || continue
    running "$b" && continue
    if git -C "$p" merge-base --is-ancestor "$b" "$main" || { [[ $b == harness/* ]] && record_only "$b"; }; then
      act git -C "$p" worktree remove "$wt"
    fi
  done < <(git -C "$p" worktree list --porcelain | sed -n 's/^worktree //p')
  for b in $(git -C "$p" for-each-ref --format='%(refname:short)' 'refs/heads/harness/*'); do   # record-only tails
    [[ $b == "$(git -C "$p" branch --show-current)" ]] && continue
    running "$b" && continue
    git -C "$p" merge-base --is-ancestor "$b" "$main" && continue
    record_only "$b" && ! git -C "$p" worktree list --porcelain | grep -qx "branch refs/heads/$b" \
      && { act git -C "$p" branch -D "$b"; git -C "$p" rev-parse -q --verify "origin/$b" > /dev/null && act git -C "$p" push -q origin --delete "$b"; }
  done
  for pattern in 'harness/*' 'harness-merge/*'; do
    (( all )) && pattern='*'
    # local branches: -d refuses anything unmerged, so this can never drop work
    for b in $(git -C "$p" for-each-ref --format='%(refname:short)' "refs/heads/$pattern"); do
      [[ $b == main || $b == "$(git -C "$p" branch --show-current)" ]] && continue
      git -C "$p" merge-base --is-ancestor "$b" "$main" && act git -C "$p" branch -d "$b"
    done
    # remote branches fully contained in origin/main
    for b in $(git -C "$p" for-each-ref --format='%(refname:lstrip=3)' "refs/remotes/origin/$pattern"); do
      [[ $b == main || $b == HEAD ]] && continue
      git -C "$p" merge-base --is-ancestor "origin/$b" "$main" && act git -C "$p" push -q origin --delete "$b"
    done
    (( all )) && break
  done
  local dd=(); (( dry )) && dd=(--dry-run)
  "$HARNESS_HOME/lib/desk.sh" --gc "$(basename "$p")" "${dd[@]}" || echo "harness: could not check the desks"   # never fails gc
  return 0
}

case ${1:-help} in
  init) shift; cmd_init "$@" ;;
  start) shift; cmd_start "$@" ;;
  continue) shift; cmd_continue "$@" ;;
  merge) shift; cmd_merge "$@" ;;
  queue) shift; cmd_queue "$@" ;;
  status) shift; cmd_status "$@" ;;
  parked) shift; cmd_parked "$@" ;;
  report) shift; cmd_report "$@" ;;
  trends) node "$HARNESS_HOME/lib/summary.mjs" trends "${HARNESS_LEDGER:-$HARNESS_HOME/ledger}/runs.jsonl" ;;
  attach) tmux attach -t "$(tmux_name "${2:?usage: harness attach <run-id>}")" ;;
  pause|resume|stop) cmd_control "$1" "${2:-}" ;;
  answer) shift; cmd_answer "$@" ;;
  gc) shift; cmd_gc "$@" ;;
  debrief) shift; exec "$HARNESS_HOME/lib/debrief.sh" "$@" ;;
  desk) shift; exec "$HARNESS_HOME/lib/desk.sh" "$@" ;;
  *) sed -n '2,38p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
