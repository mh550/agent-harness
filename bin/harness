#!/usr/bin/env bash
# harness — long-running agent harness (initializer + one fresh session per feature), reusable across projects.
#
#   harness start <project> [<run-id>] [--spec "<files>"] [--brief "<text>" | --brief-file <f>] [--base <ref>]
#                 [--until HH:MM] [--now] [--no-supervisor] [--foreground]
#                               a new run (worktree + branch harness/<run-id>), or resume an existing one. With
#                               MAX_PARALLEL_RUNS runs already going, it is queued instead (--now: start anyway)
#   harness continue <run-id> [--brief …] [--until HH:MM] [--now]
#                               resume a run with fresh attempts for every feature that isn't passing
#   harness queue [list]                         what is queued, parked, running and done lately
#   harness queue show <n> [--parked]            one entry whole: its spec, brief, until, mark, why and file
#   harness queue add <project> [<run-id>] [start options] | add --continue <run-id> [--automatic] [options]
#                                                a continuation queued here is a request (--requested: it starts even
#                                                after a stop); --automatic (the driver's, the debrief's) is skipped then
#   harness queue rm <n> | clear | start [--until HH:MM] | stop
#   harness queue park <n> [<why>] | unpark <n> set an entry aside (listed with its reason, skipped) · back at the end
#   harness sync                                 the live checkout level with origin: pull merged PRs, push ledger
#                                                commits (the queue runner does it whenever no run is alive)
#   harness backlog [list]                       the retro backlog (ledger/retro-backlog.jsonl): proposed first, most seen first
#   harness backlog set <id> <status> [--spec <path>] [--pr <url>] [--note <text>]
#                                                move an item: proposed|specced|queued|merged|dropped (a ledger commit)
#   harness backlog import <file.jsonl>          merge rows by id (the seed: docs/specs/2026-10-25-memory.backlog-seed.jsonl)
#   harness status [-a|--all] [--since <d>] [-p|--project <p>] [-v] [--json]
#                                                one screen: NEEDS YOU, RUNNING, QUEUED, FINISHED (the last 24h,
#                                                STATUS_SINCE or --since; 3 to 10) and how to see the older runs;
#                                                -v (or N=<lines>): units, lane lines, the last N run.log lines
#   harness status <run-id> [-v] [--json]        one run's card: state, now or ended (why), milestones, lanes, spend,
#                                                branch, worktree, needs you, units, next; -v (or N): the log tail
#                                                --json: one v1 document (lib/status.mjs), or that run's object
#   harness report [<run-id>…]                   the writeup: passing, tests, spend (total, per feature, by role), causes
#   harness trends [--by version]                every recorded run in one table (the harness ledger), or one row per
#                                                harness version (runs, passing, $/feature, cache hit, orientation)
#   harness debrief [--dry-run]                  after a queue: one short read-only session writes the debrief
#                               (ledger/debrief.md; NOTIFY_CMD gets its headline). The queue runner starts it as it exits
#   harness merge <run-id>                       merge the run's verified milestones into main now (a PR each)
#   harness attach <run-id>                      the run's tmux session (driver · log · supervisor)
#   harness pause|resume|stop <run-id>           between sessions; the current session finishes first
#   harness stop <run-id> --why "<text>"         the same, and harness-log.md and ended say "stopped by Michael: <text>"
#   harness answer <run-id> <text>               an answer for the sessions (lands in the run's INBOX.md)
#   harness parked [<run-id>] [--json]           what parked features wait on: why, the INBOX question, the next commands
#   harness needs [<run-id>] [--json]            the same, for now (U2 makes it every open item)
#   harness desk <run> [--why "…"] | --debrief   a Remote Control session that briefs you and takes your answers (tmux h-desk)
#   harness desk --list | --close <run>|--all    the open desks: window, run, URL, age · close them
#   harness init <project> [--draft]             CLAUDE.md + .harness/config.sh for a new project (--draft: Claude drafts
#                                                CLAUDE.md from the repo's docs for you to edit), and the Vercel/Netlify
#                                                guard that keeps run branches from deploying
#   harness memlint <project>                    the lint each run starts with (lib/memlint.mjs): one finding per line
#                                                about its CLAUDE.md, .harness/project.md and decisions store
#   harness gc <project> [--all-merged] [--deps] [--dry-run]
#                               delete merged harness branches and their clean worktrees, locally and on origin
#                               (--all-merged: every merged branch, whatever its name; --deps: DEPS_DIRS in ended runs' worktrees);
#                               close the project's desks idle for 24 h (an open one keeps its worktree)
#   harness eval run [--set <name|file>] [--harness <ref>] [--label <L>] [--repeat <N>]
#                               replay a task set (evals/) with that harness version's driver on throwaway clones,
#                               nothing posted or merged; results in evals/results/. Real sessions: it costs money,
#                               so no task starts past EVAL_BUDGET_USD (default $10) or the 7-day WEEKLY_STOP_AT
#   harness eval compare <A> <B>  two results (paths, or names under evals/results/): per task and in total, pass
#                               rate, $ and tokens per verified feature, cache, orientation, context peak, wall time,
#                               rework, each with B's verdict against A (better · worse · within noise · one sample)
#   harness eval probes <task result dir>
#                               ask one tool-less PROBE_MODEL session (haiku, one turn) the handoff questions the task's
#                               record answers, given only the prompt its next session would get; prints score <n>/<m>
#
# Where things live:  worktree ~/worktrees/<project>/<run-id> · branch harness/<run-id>
#   committed run record  <worktree>/.harness/runs/<run-id>/{feature_list.json,progress.md,INBOX.md,harness-log.md,
#                         metrics.jsonl,brief.md,summary.json,report.md,retro.md}
#   local state           ~/.local/state/harness/<project>/<run-id>/{run.log,logs/*.jsonl,attempts.json,port,driver.pid,ended,…}
#   queue                 ~/.local/state/harness/queue/   · shared usage-limit window: ~/.local/state/harness/LIMIT_UNTIL
#   ledger                <harness>/ledger/{runs.jsonl,<project>/<run-id>/,debrief.md}
#   scratch               /tmp/harness/<project>/<run-id>/
#   config layers         harness defaults → ~/.config/harness/config.sh → <project>/.harness/config.sh → the run's options
set -euo pipefail
HARNESS_HOME=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd); export HARNESS_HOME
STATE_ROOT=${HARNESS_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/harness}
WT_ROOT=${HARNESS_WORKTREES:-$HOME/worktrees}
Q=$STATE_ROOT/queue
# shellcheck source=lib/config.sh
source "$HARNESS_HOME/lib/config.sh"
# shellcheck source=lib/deploy.sh
source "$HARNESS_HOME/lib/deploy.sh"
# shellcheck source=lib/scope.sh
source "$HARNESS_HOME/lib/scope.sh"   # scope_unit, scope_owns, scope_stop: gc's unit step and status's unit lines
# shellcheck source=lib/tmux.sh
source "$HARNESS_HOME/lib/tmux.sh"   # tmux_name, tmux_reap: start's session and gc's reaper

die() { echo "harness: $*" >&2; exit 1; }
toplevel() { git -C "$1" rev-parse --show-toplevel 2>/dev/null || die "$1 is not a git repository"; }
state_of() {   # run-id → state dir
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "no run '$1' (run-id: letters, digits, . _ - only)"   # compgen globs
  local d; d=$(compgen -G "$STATE_ROOT/*/$1" | head -1 || true)
  [[ -n $d && -f $d/meta.env ]] || die "no run '$1' (see: harness status)"; echo "$d"
}
alive() { local p; p=$(cat "$1/driver.pid" 2>/dev/null) && [[ -n $p ]] && kill -0 "$p" 2>/dev/null; }
# <state dir> → "<m> <pid>" of its first lane whose process lives (a SIGKILLed driver's lane works on); 1 when none
# (a pid that is lib/lane.sh: a recycled one would keep its run busy, and its units and slots, for good)
lane_live() { local f p; for f in "$1"/lanes/*/pid; do p=$(cat "$f" 2>/dev/null) && [[ -n $p ]] && kill -0 "$p" 2>/dev/null \
  && tr '\0' ' ' < "/proc/$p/cmdline" 2> /dev/null | grep "lib/lane.sh" > /dev/null && { f=${f%/pid}; echo "${f##*/} $p"; return 0; }; done; return 1; }
runner_up() { [[ -f $Q/runner.pid ]] && kill -0 "$(cat "$Q/runner.pid")" 2>/dev/null; }
alive_count() { local d n=0; for d in "$STATE_ROOT"/*/*/; do alive "$d" && n=$(( n + 1 )); done; echo "$n"; }
to_epoch() { [[ $1 =~ ^[0-9]{9,}$ ]] && { echo "$1"; return; }   # HH:MM → the next such time
  local e; e=$(date -d "$1" +%s) || die "bad time '$1'"; (( e <= $(date +%s) )) && e=$(( e + 86400 )); echo "$e"; }

cmd_init() {
  local p draft=0; p=$(toplevel "${1:?usage: harness init <project> [--draft]}"); [[ ${2:-} == --draft ]] && draft=1
  mkdir -p "$p/.harness"
  [[ -e $p/.harness/config.sh ]] && echo "keep    .harness/config.sh" \
    || { cp "$HARNESS_HOME/templates/project/config.sh" "$p/.harness/config.sh"; echo "created .harness/config.sh (POLICY=build-only)"; }
  if [[ -e $p/CLAUDE.md ]]; then echo "keep    CLAUDE.md"
  elif (( draft )); then
    echo "drafting CLAUDE.md from the repo's README and docs (one Sonnet session)…"
    (cd "$p" && claude -p "$(cat "$HARNESS_HOME/prompts/draft-claude-md.md")" --model "$(node "$HARNESS_HOME/lib/features.mjs" model sonnet)" \
      --permission-mode auto --max-turns 40 > /dev/null) && echo "drafted CLAUDE.md: read it, edit it, commit it"
  else cp "$HARNESS_HOME/templates/project/CLAUDE.md" "$p/CLAUDE.md"; echo "created CLAUDE.md (template: fill it in)"; fi
  harness_config "$p"
  deploy_guard "$p"   # a host that builds every branch would make a preview per session (E0b)
  echo "detected: suite '${CHECK_CMD:-none — set CHECK_CMD in .harness/config.sh}' · smoke '$SMOKE_CMD' · init '$INIT_CMD'"
  echo "permissions: your user settings apply. A project needing extra allows can keep them in .claude/settings.json"
  echo "             (example: $HARNESS_HOME/templates/project/settings.example.json); the harness never writes it."
  echo "next: commit CLAUDE.md and .harness/ to main, then: harness start $p --spec <files> [--brief '<scope>']"
}

auto_id() {   # project → <project>-<date>[-n], not used before
  local base n=1 id; base=$(basename "$1")-$(date +%F); id=$base
  while compgen -G "$STATE_ROOT/*/$id" > /dev/null || [[ -d $WT_ROOT/$(basename "$1")/$id ]]; do n=$(( n + 1 )); id=$base-$n; done
  echo "$id"
}

queue_add() {   # verb args… → a queue entry (one argument per line), numbered past the parked ones too
  mkdir -p "$Q/done" "$Q/held"
  local n; n=$(( $(ls "$Q" "$Q/held" | sed -n 's/^\([0-9]\{4\}\)-.*\.args$/\1/p' | sort -n | tail -1 | sed 's/^0*//' || true) + 1 ))
  local f; f=$Q/$(printf '%04d' "$n")-$1-${2##*/}.args
  printf '%s\n' "$@" > "$f"; echo "$f"
}

queue_ensure_runner() {
  [[ ${HARNESS_NO_RUNNER:-} ]] && return 0   # tests
  runner_up && return 0
  tmux has-session -t =h-queue 2>/dev/null && tmux kill-session -t =h-queue   # exact: never a run's h-queue-x
  tmux new-session -d -s h-queue -n runner "env HARNESS_HOME=$(printf %q "$HARNESS_HOME") HARNESS_STATE=$(printf %q "$STATE_ROOT") $(printf %q "$HARNESS_HOME/lib/queue.sh") ${1:-0}; echo '[queue runner exited]'; exec bash"
  echo "queue runner started (tmux h-queue)"
}

# <project> <run worktree> <run> <state dir> [<--base given now>]: a run from before lanes has code on harness/<run>
# that main (or the run's --base, BASE_REF) doesn't have. Lanes keep code on lane branches and only the record on
# harness/<run>, so it can't go on as a lanes run: refused with the three ways forward, said in run.log and a
# high-priority notification too (a queued continuation runs with nobody watching). The branch merged into its base
# (merge-tree), then diffed outside the record: the base's own later changes and the record are no code of the run's.
# `harness merge` is never refused.
legacy_refuse() {
  local p=$1 wt=$2 run=$3 st=$4 ref tree files n why base
  ref=${5:-$( [[ -f $st/run.env ]] && source "$st/run.env" 2> /dev/null; echo "${BASE_REF:-}" )}
  ref=${ref:-origin/$MAIN_BRANCH}; [[ $ref == "origin/$MAIN_BRANCH" ]] && base=$MAIN_BRANCH || base="$ref (its --base)"
  git -C "$wt" fetch -q origin 2> /dev/null || true
  git -C "$wt" rev-parse -q --verify "$ref^{commit}" > /dev/null || return 0
  # a --base run's segments merge main into its branch too: measured against its base with main merged (when they merge
  # cleanly; a commit object no ref points at), so main's own later files are no code of the run's
  if [[ $ref != "origin/$MAIN_BRANCH" ]] && tree=$(git -C "$wt" merge-tree --write-tree "$ref" "origin/$MAIN_BRANCH" 2> /dev/null); then
    tree=$(git -C "$wt" commit-tree "${tree%%$'\n'*}" -p "$ref" -p "origin/$MAIN_BRANCH" -m "base and main" 2> /dev/null) && ref=$tree
  fi
  tree=$(git -C "$wt" merge-tree --write-tree "$ref" HEAD 2> /dev/null | head -1) || true   # a conflict still writes its tree
  [[ -n $tree ]] || return 0
  files=$(git -C "$wt" diff --name-only "$ref" "$tree" -- . ':!.harness/runs') || return 0
  [[ -n $files ]] || return 0
  n=$(grep -c . <<< "$files")
  why="harness/$run has code $base does not have ($n file$( (( n == 1 )) || echo s) outside .harness/runs/: $(head -3 <<< "$files" | paste -sd' ')$( (( n <= 3 )) || echo ' …'))"
  { echo "harness: continue refused: $why"
    echo "  Lanes keep a run's code on harness-lane/$run/<m> and only its record on harness/$run, so a run from before lanes can't go on. Three ways forward:"
    echo "  1. harness merge $run"
    echo "       merges its verified milestones (tags run/$run/<m>) into $MAIN_BRANCH"
    echo "  2. harness start $p --brief \"finish <what is left>; harness/$run is the source\""
    echo "       a new run for what is left, from $MAIN_BRANCH"
    echo "  3. finish it by hand on harness/$run, then merge it into $MAIN_BRANCH yourself"; } >&2
  ( set +e   # notify always returns 0, and a failed post or log line must not turn the refusal's exit 1 into another code
    log() { echo "$(date '+%F %T') $*" >> "$st/run.log"; } 2> /dev/null
    # shellcheck source=lib/notify.sh
    source "$HARNESS_HOME/lib/notify.sh"; NOTIFY_TAG=$run
    log "continue refused: $why"
    notify "continue refused: $why. Ways forward: harness merge $run; a new run with --brief naming harness/$run; or by hand" \
      title="[$run] continue refused: a pre-lanes run" priority=high )
  exit 1
}

cmd_start() {
  local p run="" base="" supervisor=1 fg=0 now=0 spec="" brief="" until="" orig=("$@")
  p=$(toplevel "${1:?usage: harness start <project> [<run-id>] [options]}"); shift
  [[ ${1:-} && $1 != --* ]] && { run=$1; shift; }
  while (( $# )); do case $1 in
    --base) base=$2; shift 2 ;; --spec) spec=$2; shift 2 ;; --brief) brief=$2; shift 2 ;;
    --brief-file) brief=$(cat "$2") || die "can't read $2"; shift 2 ;;
    --until) until=$(to_epoch "$2"); shift 2 ;; --until-epoch) until=$2; shift 2 ;;
    --no-supervisor) supervisor=0; shift ;; --foreground) fg=1; supervisor=0; shift ;; --now) now=1; shift ;;
    *) die "unknown option $1" ;; esac; done
  harness_config "$p"
  if [[ -z $run ]] && (( ! now && ! fg )) && (( $(alive_count) >= MAX_PARALLEL_RUNS )); then
    local args=("$p"); [[ -n $base ]] && args+=(--base "$base"); [[ -n $spec ]] && args+=(--spec "$spec")
    [[ -n $brief ]] && args+=(--brief "$brief"); [[ -n $until ]] && args+=(--until-epoch "$until")
    queue_add start "${args[@]}" > /dev/null   # no run id yet: it is chosen when the run starts
    echo "$(alive_count) run(s) going (MAX_PARALLEL_RUNS=$MAX_PARALLEL_RUNS): a new $(basename "$p") run is queued"; queue_ensure_runner; return
  fi
  run=${run:-$(auto_id "$p")}
  [[ $run =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "run-id: letters, digits, . _ - only"
  [[ $run == desk || $run == debrief ]] && die "run-id '$run' is taken by the desk (tmux h-desk, <state>/queue/desk)"
  [[ $run == queue ]] && die "run-id 'queue' is taken by the queue runner (tmux h-queue)"
  [[ $run == lanes ]] && die "run-id 'lanes' is taken by the lane slots (<worktrees>/<project>/lanes)"
  local proj branch=harness/$run wt state
  proj=$(basename "$p"); wt=$WT_ROOT/$proj/$run; state=$STATE_ROOT/$proj/$run
  if alive "$state"; then die "run $run is already running (harness attach $run)"; fi
  # tmux names are lossy (a.b and a-b; one id in two projects): never take, and so kill, a session another run holds
  tmux_shared "$state" "$STATE_ROOT" "$(tmux_name "$run")" && die "run id $run shares tmux session $(tmux_name "$run") with $TMUX_OTHER, which has not ended: pick another id"
  if (( ! now && ! fg )) && (( $(alive_count) >= MAX_PARALLEL_RUNS )); then
    local args=("$p" "$run"); [[ -n $base ]] && args+=(--base "$base"); [[ -n $spec ]] && args+=(--spec "$spec")
    [[ -n $brief ]] && args+=(--brief "$brief"); [[ -n $until ]] && args+=(--until-epoch "$until")
    queue_add start "${args[@]}" > /dev/null
    echo "$(alive_count) run(s) going (MAX_PARALLEL_RUNS=$MAX_PARALLEL_RUNS): $run is queued"; queue_ensure_runner; return
  fi
  if [[ -d $wt ]]; then
    [[ ${HARNESS_MERGE_ONLY:-} ]] || legacy_refuse "$p" "$wt" "$run" "$state" "$base"
    echo "resuming $run in $wt"
  else
    [[ -n $spec || -n $SPEC_FILES || -n $brief ]] || die "a new run needs --spec <files> or --brief <text> (or SPEC_FILES in .harness/config.sh)"
    git -C "$p" fetch -q origin
    if git -C "$p" rev-parse -q --verify "refs/remotes/origin/$branch" > /dev/null; then
      git -C "$p" worktree add -q "$wt" -B "$branch" "origin/$branch"
    else
      git -C "$p" worktree add -q -b "$branch" "$wt" "${base:-origin/main}"
    fi
    echo "worktree $wt on $branch (from ${base:-origin/main})"
  fi
  mkdir -p "$state"
  if [[ ! -f $state/port ]]; then   # port_taken (lib/config.sh), under the lock the lanes' search takes too
    local port=$BASE_PORT; { flock 7; while port_taken "$port"; do port=$(( port + 1 )); done
      echo "$port" > "$state/port"; } 7> "$STATE_ROOT/port.lock"
  fi
  printf 'PROJECT_DIR=%q\nWT=%q\nRUN_ID=%q\nSTATE=%q\n' "$p" "$wt" "$run" "$state" > "$state/meta.env"
  [[ -n ${HARNESS_RUNNER_ID:-} ]] && echo "$HARNESS_RUNNER_ID" >> "$state/runners"   # started by that queue runner (its debrief covers it)
  # the run's own settings: --spec persists across resumes; --until applies to this start only
  local kept=() l; [[ -f $state/run.env ]] && mapfile -t kept < "$state/run.env"
  # --base persists too: it replaces origin/main for the record branch and every lane (lib/record.sh slot_open)
  { for l in "${kept[@]}"; do [[ $l == DEADLINE_AT=* || ( -n $spec && $l == SPEC_FILES=* ) || ( -n $base && $l == BASE_REF=* ) ]] || echo "$l"; done
    [[ -z $spec ]] || printf 'SPEC_FILES=%q\n' "$spec"; [[ -z $until ]] || printf 'DEADLINE_AT=%q\n' "$until"
    [[ -z $base ]] || printf 'BASE_REF=%q\n' "$base"; } > "$state/run.env"
  [[ -n $brief ]] && printf '%s\n' "$brief" >> "$state/brief.md"
  rm -f "$state/STOP"
  local env="WT=$(printf %q "$wt") RUN_ID=$run STATE=$(printf %q "$state") PROJECT_DIR=$(printf %q "$p") HARNESS_HOME=$(printf %q "$HARNESS_HOME")"
  # tmux starts commands in its server's environment, not this shell's: pass the harness overrides along
  local v; for v in HARNESS_CLAUDE HARNESS_GH HARNESS_SCRATCH_ROOT HARNESS_PW HARNESS_PAUSE_POLL HARNESS_CONFIG HARNESS_LEDGER \
    HARNESS_STATE HARNESS_WORKTREES HARNESS_LIMIT_SLEEP HARNESS_MERGE_ONLY HARNESS_CURL HARNESS_DESK_SESSION HARNESS_DESK_WAIT \
    HARNESS_SYSTEMD_RUN HARNESS_SYSTEMCTL HARNESS_MEMINFO HARNESS_MEM_POLL HARNESS_LANE_POLL HARNESS_RECORD_DELAY; do
    [[ -n ${!v:-} ]] && env+=" $v=$(printf %q "${!v}")"; done
  if (( fg )); then eval "env $env $(printf %q "$HARNESS_HOME/lib/driver.sh")"; return; fi

  local s; s=$(tmux_name "$run")
  tmux has-session -t "=$s" 2> /dev/null && tmux kill-session -t "=$s"   # a finished run's windows (its driver is gone)
  local model=""   # rendered before the session starts: only tmux calls stand between the driver's start and its windows
  if (( supervisor )); then
    HARNESS_RUN_ID=$run HARNESS_STATE=$state HARNESS_WT=$wt HARNESS_BRANCH=$branch HARNESS_PROJECT_DIR=$p \
      node "$HARNESS_HOME/lib/render.mjs" "$HARNESS_HOME/prompts/supervisor.md" > "$state/supervisor-prompt.md"
    model=$(node "$HARNESS_HOME/lib/features.mjs" model "$SUPERVISOR_MODEL")
  fi
  # when the driver exits: its scrollback to the state dir, the supervisor goes, then the session after the keep window
  # (whole hours, baked in at start: a resume picks up a change; decisions/2026-10-25-tmux-driver-window). `trap : INT`:
  # a Ctrl-C in the window ends the driver or the wait, never the cleanup (a handler, not an ignore: the driver keeps INT)
  local keep=$TMUX_KEEP_HOURS out=$state/tmux-driver.txt after; [[ $keep =~ ^[0-9]{1,4}$ ]] && keep=$(( 10#$keep )) || keep=24
  after="tmux capture-pane -pJ -S - -t \"\$TMUX_PANE\" > $(printf %q "$out") 2> /dev/null; tmux kill-window -t $(printf %q "=$s:supervisor") 2> /dev/null; echo"
  after+="; echo '[driver exited — scrollback saved to '$(printf %q "$out")'; this session self-destructs in $keep h, or sooner on harness gc]'"   # %q on the path only: a C locale's %q makes the dash $'…', bash-only
  after+="; sleep $(( keep * 3600 )); tmux kill-session -t $(printf %q "=$s")"
  tmux new-session -d -s "$s" -n driver -c "$wt" "trap : INT; env $env $(printf %q "$HARNESS_HOME/lib/driver.sh"); $after"
  tmux new-window -d -t "=$s:" -n log "touch $(printf %q "$state/run.log"); tail -n 100 -F $(printf %q "$state/run.log")"
  (( supervisor )) && tmux new-window -d -t "=$s:" -n supervisor -c "$p" \
    "claude --model $(printf %q "$model") \"\$(cat $(printf %q "$state/supervisor-prompt.md"))\"; exec bash"
  echo "started tmux session $s (windows: driver, log$( (( supervisor )) && echo ', supervisor'))"
  echo "  watch:   harness attach $run      (Ctrl-b n = next window, Ctrl-b d = detach)"
  echo "  status:  harness status $run      steer from the phone: $branch → .harness/runs/$run/INBOX.md"
}

cmd_continue() {   # run-id [--keep-attempts] [--queued [--requested]] [start options]
  local run=${1:?usage: harness continue <run-id> [options]} st keep=0 queued=0 requested=0 rest=(); shift
  while (( $# )); do case $1 in --keep-attempts) keep=1 ;; --queued) queued=1 ;; --requested) requested=1 ;; *) rest+=("$1") ;; esac; shift; done
  st=$(state_of "$run")
  alive "$st" && die "$run is running; continue it after it ends (or harness stop $run)"
  # an automatic continuation never undoes Michael's stop; one queued by request does (decisions/2026-10-26-requested-continuations)
  if (( queued && ! requested )) && grep -qs '^stopped by Michael' "$st/ended"; then echo "skipping queued continuation of $run: Michael stopped it"; return 0; fi
  # shellcheck source=/dev/null
  ( source "$st/meta.env"
    # before anything changes its state: a refused run stays as it ended
    [[ -d $WT ]] && { harness_config "$PROJECT_DIR"; legacy_refuse "$PROJECT_DIR" "$WT" "$RUN_ID" "$STATE"; }
    # a continuation you start gives every feature that isn't passing fresh attempts; an automatic one doesn't
    (( keep )) || { [[ -f $WT/.harness/runs/$RUN_ID/feature_list.json ]] && node "$HARNESS_HOME/lib/features.mjs" reset "$STATE/attempts.json" "$WT/.harness/runs/$RUN_ID/feature_list.json"
      rm -f "$STATE"/needs-* "$STATE"/verify-rounds-* "$STATE"/refused-* "$STATE"/rebase-rounds-* "$STATE"/moved-*; }
    # a phone stop that ended the last segment would end this one at once: its line goes back to run (the driver notes it)
    local inbox=$WT/.harness/runs/$RUN_ID/INBOX.md s n
    if grep -qs '^stopped by Michael' "$STATE/ended" && s=$(grep -n -m1 '^status:' "$inbox" 2> /dev/null) && [[ ${s#*:} =~ ^status:[[:space:]]*stop ]]; then
      n=${s%%:*}; sed -i "${n}s/.*/status: run/" "$inbox" && echo "${s#*:}" > "$STATE/inbox-unstopped"; fi
    rm -f "$STATE/PAUSE" "$STATE/STOP" "$STATE/ended"
    cmd_start "$PROJECT_DIR" "$RUN_ID" ${rest[@]+"${rest[@]}"} )
}

cmd_merge() {
  local st; st=$(state_of "${1:?usage: harness merge <run-id>}")
  alive "$st" && die "$1 is running; its driver merges verified milestones itself"
  rm -f "$st"/moved-*   # Michael asks again: a milestone whose main moved gets one more re-base on today's main
  # shellcheck source=/dev/null
  ( source "$st/meta.env"; local keep; keep=$(cat "$STATE/ended" 2>/dev/null || true)
    HARNESS_MERGE_ONLY=1 cmd_start "$PROJECT_DIR" "$RUN_ID" --foreground
    [[ -n $keep ]] && echo "$keep" > "$STATE/ended"; true )
}

# One line per run for lib/status.mjs: run, project, state dir, worktree, record dir, alive 0|1|2 (2: ending, in finish)
# and, with <units> 1 and a live driver, its units as <unit>=<MemoryCurrent bytes>,… One broken meta.env doesn't cut the
# others off (cmd_parked's loop). With <run>, that run's line only (a card asks no other run's units)
run_rows() {   # <units 0|1> [<run>]
  local d
  for d in "$STATE_ROOT"/*/*/; do
    [[ -f $d/meta.env ]] || continue
    [[ -n ${2:-} && $(basename "$d") != "$2" ]] && continue
    # shellcheck source=/dev/null
    ( source "$d/meta.env"; a=0 us=""
      alive "$STATE" && { [[ -f $STATE/ended ]] && a=2 || a=1; }
      if (( $1 && a )); then   # a missing bus or a unit gone just now: none
        while read -r u _; do
          scope_owns "$RUN_ID" "$u" || continue
          b=$("${HARNESS_SYSTEMCTL:-systemctl}" --user show -p MemoryCurrent "$u" 2> /dev/null | sed -n 's/^MemoryCurrent=//p' || true)
          [[ $b =~ ^[0-9]+$ ]] && us+="${us:+,}${u%.scope}=$b"
        done < <("${HARNESS_SYSTEMCTL:-systemctl}" --user list-units "$(scope_unit "$RUN_ID")-*" --plain --no-legend 2> /dev/null || true)
      fi
      printf '%s\t%s\t%s\t%s\t%s\t%s%s\n' "$RUN_ID" "${PROJECT_DIR##*/}" "$STATE" "$WT" "$WT/.harness/runs/$RUN_ID" "$a" "${us:+$'\t'$us}" ) || true
  done
}

cmd_status() {   # [<run>] [-a|--all] [--since <d>] [-p|--project <p>] [-v] [--json]: read-only (no harness_config writes, no mkdir)
  local want="" json=0 v=0 o=() use="usage: harness status [<run>] [-a|--all] [--since <d>] [-p|--project <p>] [-v] [--json]"
  while (( $# )); do case $1 in
    --json) json=1 ;;
    -v|--verbose) v=1 ;;
    -a|--all) o+=(--all) ;;
    --since|-p|--project) (( $# > 1 )) || die "$use"; [[ $1 == --since ]] && o+=(--since "$2") || o+=(--project "$2"); shift ;;
    -*) die "$use" ;;
    *) [[ -z $want ]] || die "$use"; want=$1 ;;
  esac; shift; done
  local n=3; [[ ${N:-} =~ ^[0-9]+$ ]] && v=1 n=$N   # the supervisor's N=20 and the debrief's N=3 keep working: N implies -v
  [[ -n $want ]] && (( ! json && ${#o[@]} )) && die "status <run>: -a, --since and --project list runs (harness status --all)"
  [[ -n $want ]] && state_of "$want" > /dev/null
  # the whole picture, or one run's card, in one node process (decisions/2026-10-27-read-views); a card shows its units
  local cfg r=0 u=$(( json || v )) mode=(view); cfg=$(harness_config /nonexistent; echo "$MAX_PARALLEL_RUNS ${STATUS_SINCE:-24h}"); runner_up && r=1
  [[ -n $want ]] && mode=(card "$want") u=1
  (( json )) && o+=(--json); (( v && ! json )) && o+=(--verbose "$n")
  run_rows "$u" "$want" | node "$HARNESS_HOME/lib/status.mjs" "${mode[@]}" ${o[@]+"${o[@]}"} --runner "$r" --queue "$Q" \
    --ledger "${HARNESS_LEDGER:-$HARNESS_HOME/ledger}" --state-root "$STATE_ROOT" --max-parallel "${cfg%% *}" --since-default "${cfg#* }"
}

cmd_report() {
  local d ids=("$@") out=()
  (( ${#ids[@]} )) || for d in "$STATE_ROOT"/*/*/; do [[ -f $d/meta.env ]] && ids+=("$(basename "$d")"); done
  local run
  for run in "${ids[@]}"; do
    d=$(state_of "$run")
    # shellcheck source=/dev/null
    ( source "$d/meta.env"
      # metrics.jsonl beside it: report's memory peaks read it from there, also once gc has removed the worktree
      if [[ -d $WT ]]; then node "$HARNESS_HOME/lib/summary.mjs" build "$WT" "$RUN_ID" "$STATE" > "$STATE/summary.json"
        cp "$WT/.harness/runs/$RUN_ID/metrics.jsonl" "$STATE/metrics.jsonl" 2> /dev/null; fi
      [[ -f $STATE/summary.json ]] && node "$HARNESS_HOME/lib/summary.mjs" report "$STATE/summary.json" || echo "## $RUN_ID: no record" )
    echo
  done
}

cmd_queue() {
  local sub=${1:-list}; shift || true
  mkdir -p "$Q/done"
  case $sub in
    list|show)   # through status.mjs (decisions/2026-10-27-read-views); parked entries are listed, never silent: a
                 # parked run nobody remembers is a run that never happens
      local r=0 m=(queue) use="usage: harness queue show <n> [--parked]"; runner_up && r=1
      if [[ $sub == show ]]; then [[ ${1:-} =~ ^[1-9][0-9]*$ ]] || die "$use"; m=(entry "$1")
        case ${2:-} in --parked) m+=(--parked) ;; "") ;; *) die "$use" ;; esac; fi
      run_rows 0 | node "$HARNESS_HOME/lib/status.mjs" "${m[@]}" --runner "$r" --queue "$Q" --ledger "${HARNESS_LEDGER:-$HARNESS_HOME/ledger}" \
        --state-root "$STATE_ROOT" --max-parallel "$(harness_config /nonexistent; echo "$MAX_PARALLEL_RUNS")" ;;
    add)
      if [[ ${1:-} == --continue ]]; then
        local run=${2:?usage: harness queue add --continue <run-id>}; shift 2; state_of "$run" > /dev/null
        local mark=(--requested) o=() a; for a in "$@"; do [[ $a == --automatic ]] && mark=() || o+=("$a"); done
        # a request is the later word: a queued entry becomes this request, its options included (an automatic one's
        # --until-epoch is a past night's deadline); an automatic add leaves what is queued alone
        local q; q=$(compgen -G "$Q/*-continue-$run.args" | head -1) && {
          if (( ${#mark[@]} )); then local was; grep -qx -- --requested "$q" && was="replaced by this request" || was="now requested, with this request's options"
            printf '%s\n' continue "$run" --queued --requested ${o[@]+"${o[@]}"} > "$q" && echo "already queued: continue $run ($was)"
          else echo "already queued: continue $run"; fi; return; }
        echo "queued: $(basename "$(queue_add continue "$run" --queued ${mark[@]+"${mark[@]}"} ${o[@]+"${o[@]}"})")"
      else
        local p; p=$(toplevel "${1:?usage: harness queue add <project> [<run-id>] [options]}"); shift
        echo "queued: $(basename "$(queue_add start "$p" "$@")")"
      fi ;;
    rm) local f; f=$(ls "$Q"/*.args 2>/dev/null | sed -n "${1:?usage: harness queue rm <n>}p"); [[ -n $f ]] || die "no entry $1"; rm "$f"; echo "removed $(basename "$f")" ;;
    park)
      local f; f=$(ls "$Q"/*.args 2>/dev/null | sed -n "${1:?usage: harness queue park <n> [<why>]}p"); [[ -n $f ]] || die "no entry $1"; shift
      [[ -e $Q/held/$(basename "$f") ]] && die "$(basename "$f") already parked (harness queue unpark it or rm queue/held/$(basename "$f"))"
      mkdir -p "$Q/held"; mv "$f" "$Q/held/"
      echo "${*:-no reason given} ($(date '+%F %H:%M'))" > "$Q/held/$(basename "$f" .args).why"
      echo "parked $(basename "$f"): the runner skips it until harness queue unpark" ;;
    unpark)   # back at the end of the queue, renumbered so it can't collide with what was added meanwhile
      local f a; f=$(ls "$Q"/held/*.args 2>/dev/null | sed -n "${1:?usage: harness queue unpark <n>}p"); [[ -n $f ]] || die "no parked entry $1"
      mapfile -t a < "$f"; echo "unparked $(basename "$f") as $(basename "$(queue_add "${a[@]}")")"; rm -f "$f" "${f%.args}.why" ;;
    clear) rm -f "$Q"/*.args; echo "queue cleared" ;;
    start) local until=0; [[ ${1:-} == --until ]] && until=$(to_epoch "$2"); queue_ensure_runner "$until" ;;
    stop) touch "$Q/STOP"; echo "the runner stops after its current start (running runs carry on)" ;;
    *) die "usage: harness queue [list|show|add|rm|park|unpark|clear|start|stop]" ;;
  esac
}

cmd_control() {   # pause|resume|stop run-id [--why "<text>"] (stop only)
  local st; st=$(state_of "${2:?usage: harness $1 <run-id>}")
  [[ $1 == stop ]] || (( $# <= 2 )) || die "usage: harness $1 <run-id>"
  case $1 in
    pause) touch "$st/PAUSE"; echo "pausing $2 after the current session" ;;
    resume) rm -f "$st/PAUSE"; echo "resuming $2 (within a minute)" ;;
    stop)   # the reason goes in STOP, on one line: the driver ends with "stopped by Michael: <why>" (decisions/2026-10-26-stop-reason)
      local why=""
      if (( $# > 2 )); then
        [[ $3 == --why && $# == 4 ]] || die "usage: harness stop <run-id> [--why \"<text>\"]"
        why=$(tr -s '\n\t\r' '   ' <<< "$4" | sed 's/^ *//; s/ *$//'); [[ -n $why ]] || die "harness stop: --why needs a reason"
      fi
      if [[ -n $why ]]; then printf '%s\n' "$why" > "$st/STOP"; else touch "$st/STOP"; fi
      echo "stopping $2 after the current session" ;;
  esac
}

cmd_parked() {   # [<run-id>] [--json]: read-only (no harness_config, no mkdir: a phone session runs it to look)
  local want="" json=() d runner=0
  while (( $# )); do case $1 in --json) json=(--json) ;; -*) die "unknown option $1" ;; *) [[ -z $want ]] || die "usage: harness parked [<run-id>] [--json]"; want=$1 ;; esac; shift; done
  [[ -n $want ]] && state_of "$want" > /dev/null
  runner_up && runner=1
  for d in "$STATE_ROOT"/*/*/; do
    [[ -f $d/meta.env ]] || continue
    [[ -n $want && $(basename "$d") != "$want" ]] && continue
    # shellcheck source=/dev/null
    # a gc'd worktree: nothing left to answer or continue. One broken meta.env doesn't cut the others off
    ( source "$d/meta.env"; [[ -d $WT ]] || exit 0
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$RUN_ID" "$(basename "$PROJECT_DIR")" "$STATE" "$WT/.harness/runs/$RUN_ID" "$(alive "$STATE" && { [[ -f $STATE/ended ]] && echo 2 || echo 1; } || echo 0)" \
        "$(compgen -G "$Q/*-continue-$RUN_ID.args" > /dev/null && echo 1 || echo 0)" ) || true   # 2: ending (finish)
  done | node "$HARNESS_HOME/lib/parked.mjs" report "${json[@]}" --runner "$runner" --run "$want"
}

cmd_answer() {
  local st; st=$(state_of "${1:?usage: harness answer <run-id> <text>}"); shift
  printf '%s\n' "$*" >> "$st/inbox.md"; echo "queued for the next session"
}

cmd_gc() {
  local p all=0 dry=0 deps=0 b pattern; p=$(toplevel "${1:?usage: harness gc <project>}"); shift
  while (( $# )); do case $1 in --all-merged) all=1 ;; --dry-run) dry=1 ;; --deps) deps=1 ;; *) die "unknown option $1" ;; esac; shift; done
  # a refusal (branch -d of a branch merged into origin/main but not into HEAD, with no upstream) is said, never the
  # end of gc under set -e: every later step still runs (decisions/2026-10-25-gc-all-merged)
  act() { if (( dry )); then echo "would: $*"; else echo "+ $*"; "$@" || echo "! failed: $*"; fi; }
  # A SIGKILLed driver ran no trap and left its units (decisions/2026-10-25-gc-orphan-units): stop those of this
  # project's runs with no live driver, first (before a fetch that may fail, before their worktree goes). A dead
  # driver.pid is enough: the driver removes ended at start, only finish and the trap write it. Two ids may reduce to
  # one prefix (a.b, a-b), so every project's runs are candidates and a live one keeps the unit.
  local u d r mine busy why err
  while read -r u _; do
    [[ $u == harness-*.scope ]] || continue
    mine="" busy=0
    for d in "$STATE_ROOT"/*/*/; do
      [[ -f $d/meta.env ]] && scope_owns "$(basename "$d")" "$u" || continue
      { alive "$d" || lane_live "$d" > /dev/null; } && busy=1
      [[ -z $mine && $d == "$STATE_ROOT/$(basename "$p")/"* ]] && mine=$d
    done
    [[ -n $mine ]] || { echo "? $u (no run of this project)"; continue; }
    (( busy )) && continue
    r=$(basename "$mine"); why="$r ended"; [[ -f $mine/ended ]] || why="$r: driver gone"
    if (( dry )); then echo "would: systemctl --user stop $u ($why)"
    elif scope_stop "${u%.scope}"; then echo "+ stopped $u ($why)"
    else echo "! could not stop $u ($why)"; fi
  done < <("${HARNESS_SYSTEMCTL:-systemctl}" --user list-units 'harness-*' --plain --no-legend 2> /dev/null || true)
  # the tmux sessions of this project's ended runs (a window kept for TMUX_KEEP_HOURS; no ended, no reap): before the
  # fetch, which has nothing to do with them; h-queue and the desk are no run's name (decisions/2026-10-25-tmux-reaper)
  tmux_reap "$dry" "$STATE_ROOT/$(basename "$p")"/*/
  git -C "$p" fetch -q --prune origin
  local main=origin/main
  # A run branch is done when main has all of it except run-record bookkeeping (.harness/runs/, which the ledger
  # keeps): the commits after its last merged milestone. Then its worktree and branch go, unless its driver runs.
  record_only() { local r=$1 base; base=$(git -C "$p" merge-base "$main" "$r") || return 1
    git -C "$p" diff --quiet "$base" "$r" -- . ':!.harness/runs'; }
  # running (its driver or a lane), or a continuation is queued; harness/<run> or a lane's harness-lane/<run>/<m>
  running() { local d r=${1#harness/}; r=${r#harness-lane/}; r=${r%%/*}
    d=$(compgen -G "$STATE_ROOT/*/$r" | head -1) && { alive "$d" || lane_live "$d" > /dev/null; } && return 0
    compgen -G "$Q/*-continue-$r.args" > /dev/null; }
  # a record PR left open (under pr, or a refused merge; the driver's state/record-pr names it) keeps harness/<run>:
  # deleting its head would close it. gh decides; one gh can't answer keeps it too (P2 review 2)
  record_pr_open() { local r=${1#harness/} d u; d=$(compgen -G "$STATE_ROOT/*/$r" | head -1) && [[ -s $d/record-pr ]] || return 1
    u=$(cd "$p" && "${HARNESS_GH:-gh}" pr view "$1" --json state,title -q "select(.state == \"OPEN\" and .title == \"$r: run record\") | .url" 2> /dev/null) || return 0
    [[ $u == http* ]]; }
  # a desk Michael may be talking to keeps its run's worktree (its --add-dir, the INBOX it reads); idle ones go first
  desk_open() { local d r=${1#harness/}; d=$(compgen -G "$STATE_ROOT/*/$r" | head -1) && [[ -s $d/desk/url ]] \
    && ! grep -qxF "would close idle desk $r" <<< "$dg" \
    && "$HARNESS_HOME/lib/desk.sh" --list 2> /dev/null | awk -v r="$r" '$1 == r && $3 ~ /^https:/ { f = 1 } END { exit !f }'; }
  local dd=() dg; (( dry )) && dd=(--dry-run)   # a dry run counts the desks it would close as closed
  dg=$("$HARNESS_HOME/lib/desk.sh" --gc "$(basename "$p")" "${dd[@]}") || echo "harness: could not check the desks"   # never fails gc
  [[ -n $dg ]] && echo "$dg"
  listed() { git -C "$p" worktree list --porcelain | grep -qxF "worktree $1"; }
  # --force loses only ignored files (the tree is clean): build output, never work. A directory git let go of goes with
  # rm -rf; one git refused (locked) is never rm -rf'd; one that stays is said and gc goes on to the next
  # (decisions/2026-10-25-gc-removal-finishes)
  rm_wt() { local wt=$1 err
    (( dry )) && { echo "would: git -C $p worktree remove --force $wt"; return 0; }
    echo "+ git -C $p worktree remove --force $wt"
    err=$(git -C "$p" worktree remove --force "$wt" 2>&1) || true
    git -C "$p" worktree prune || true
    if [[ -e $wt ]] && ! listed "$wt"; then echo "+ rm -rf $wt"; err=$(rm -rf "$wt" 2>&1) || true; fi
    if [[ -e $wt ]] || listed "$wt"; then echo "! could not remove $wt: $(head -1 <<< "${err:-still listed}")"; fi   # git's first line is the why
  }
  # A lane's slot (<worktrees>/<project>/lanes/<run>/slot-<k>) goes once its run has no live driver or lane, no queued
  # continuation and no open desk, and it is clean, whatever its branch's merge state: the branch keeps the work and
  # `harness continue` makes the slot again. Known by its path: a closed lane's slot is detached (lane_branch_gone)
  local slots=$WT_ROOT/$(basename "$p")/lanes
  slot_gc() { local wt=$1 r d l st
    r=${wt%/slot-*}; r=${r##*/}; d=$STATE_ROOT/$(basename "$p")/$r
    alive "$d" && return 0
    l=$(lane_live "$d") && { echo "keeps $wt: lane ${l% *}'s process ${l#* } is alive"; return 0; }
    compgen -G "$Q/*-continue-$r.args" > /dev/null && return 0
    desk_open "harness/$r" && { echo "keeps $wt: its desk is open (harness desk --close $r)"; return 0; }
    st=$(git -C "$wt" status --porcelain --untracked-files=normal 2> /dev/null) || return 0
    [[ -z $st ]] || { echo "keeps $wt: uncommitted work"; return 0; }
    rm_wt "$wt"
    (( dry )) || rmdir "${wt%/*}" "$slots" 2> /dev/null || true   # lanes/<run>, then lanes/, once empty
  }
  local st
  while read -r wt; do
    # never the checkout itself (rm -rf below); a listed worktree whose directory is gone (a locked one) is skipped
    [[ $wt == "$WT_ROOT"/* && $wt != "$p" && -d $wt ]] || continue
    [[ $wt == "$slots"/*/slot-* ]] && { slot_gc "$wt"; continue; }
    b=$(git -C "$wt" branch --show-current 2> /dev/null) || continue
    # clean means nothing untracked either, whatever status.showUntrackedFiles says; a status that fails isn't clean
    st=$(git -C "$wt" status --porcelain --untracked-files=normal 2> /dev/null) || continue
    [[ -n $b && -z $st ]] || continue
    running "$b" && continue
    if git -C "$p" merge-base --is-ancestor "$b" "$main" || { [[ $b == harness/* ]] && record_only "$b"; }; then
      # the harness makes its worktrees on harness/<run>: one on any other branch is a session's of Michael's
      [[ $b == harness/* ]] || { echo "keeps $wt: not a run worktree (branch $b)"; continue; }
      desk_open "$b" && { echo "keeps $wt: its desk is open (harness desk --close ${b#harness/})"; continue; }
      record_pr_open "$b" && { echo "keeps $wt: its record PR is open ($(cat "$(compgen -G "$STATE_ROOT/*/${b#harness/}" | head -1)/record-pr"))"; continue; }
      rm_wt "$wt"
    fi
  done < <(git -C "$p" worktree list --porcelain | sed -n 's/^worktree //p')
  # --deps: an ended run's dependency directories, merged or not (the branch keeps the work; the next init reinstalls).
  # Only a worktree of this project under WT_ROOT whose run says so (its meta.env names it), never the checkout, never
  # a live, queued or desk-open run's; never a symlink, a path out of the tree or anything git tracks (decisions/2026-10-25-gc-deps)
  (( deps )) && { local proj wr x n got rp ds=(); proj=$(basename "$p")
    read -ra ds <<< "$(harness_config "$p" > /dev/null; echo "$DEPS_DIRS")"
    while read -r wt; do
      [[ $wt == "$WT_ROOT/$proj/"* && $wt != "$p" && -d $wt ]] || continue
      r=$(basename "$wt") d=$STATE_ROOT/$proj/$(basename "$wt")
      if [[ $wt == "$slots"/*/slot-* ]]; then   # a slot gc kept (dirty): its run's, by its path
        r=${wt%/slot-*}; r=${r##*/} d=$STATE_ROOT/$proj/$r
        [[ -f $d/ended ]] && ! lane_live "$d" > /dev/null || continue
      else
        [[ -f $d/ended && $( ( source "$d/meta.env"; echo "$WT" ) 2> /dev/null ) == "$wt" ]] || continue
      fi
      alive "$d" || compgen -G "$Q/*-continue-$r.args" > /dev/null && continue
      desk_open "harness/$r" && { echo "keeps the deps of $wt: its desk is open"; continue; }
      got=() wr=$(realpath -e "$wt")
      for x in "${ds[@]}"; do
        [[ -d $wt/$x && ! -L $wt/$x ]] && rp=$(realpath -e "$wt/$x") && [[ $rp == "$wr/"* ]] || continue
        [[ -z $(git -C "$wt" ls-files -- "$x" | head -1) ]] && got+=("$x")
      done
      (( ${#got[@]} )) || continue
      n=$( (cd "$wt" && du -smc -- "${got[@]}" 2> /dev/null) | tail -1 | cut -f1) || true   # an unreadable dir: a partial count
      (( dry )) && { echo "would: freed $n MB in $wt: ${got[*]}"; continue; }
      if err=$( (cd "$wt" && rm -rf -- "${got[@]}") 2>&1); then echo "+ freed $n MB in $wt: ${got[*]}"
      else echo "! could not free $wt: $(tail -1 <<< "$err")"; fi
    done < <(git -C "$p" worktree list --porcelain | sed -n 's/^worktree //p'); }
  for b in $(git -C "$p" for-each-ref --format='%(refname:short)' refs/heads/harness/); do   # record-only tails
    [[ $b == "$(git -C "$p" branch --show-current)" ]] && continue
    running "$b" && continue
    git -C "$p" merge-base --is-ancestor "$b" "$main" && continue
    record_only "$b" && ! record_pr_open "$b" && ! git -C "$p" worktree list --porcelain | grep -qx "branch refs/heads/$b" \
      && { act git -C "$p" branch -D "$b"; git -C "$p" rev-parse -q --verify "origin/$b" > /dev/null && act git -C "$p" push -q origin --delete "$b"; }
  done
  # One pass per prefix, harness/, harness-merge/ and harness-lane/; --all-merged's is the bare prefix, every branch.
  # Prefixes, never a `*`: in a for-each-ref pattern it doesn't cross a `/` (decisions/2026-10-25-gc-all-merged). main,
  # the origin's default branch and a running run's branch are never candidates; full ref names, so a tag of the same
  # name can't stand in.
  local pre prefixes=(harness/ harness-merge/ harness-lane/) keep
  keep=$(git -C "$p" symbolic-ref -q --short refs/remotes/origin/HEAD 2> /dev/null) || keep=origin/main; keep=${keep#origin/}
  (( all )) && prefixes=('')
  for pre in "${prefixes[@]}"; do
    # local branches: -d refuses anything unmerged, so this can never drop work; one checked out in a worktree (kept,
    # live, the checkout's) -d refuses too, so it isn't tried
    for b in $(git -C "$p" for-each-ref --format='%(refname:lstrip=2)' "refs/heads/$pre"); do
      [[ $b == main || $b == "$keep" ]] && continue
      git -C "$p" worktree list --porcelain | grep -qxF "branch refs/heads/$b" && continue
      running "$b" && continue
      git -C "$p" merge-base --is-ancestor "refs/heads/$b" "$main" || continue
      # a lane branch has no upstream (lanes push without -u), so -d would judge it by HEAD: the test above is the guard
      if [[ $b == harness-lane/* ]]; then act git -C "$p" branch -D "$b"; else act git -C "$p" branch -d "$b"; fi
    done
    # remote branches fully contained in origin/main
    for b in $(git -C "$p" for-each-ref --format='%(refname:lstrip=3)' "refs/remotes/origin/$pre"); do
      [[ $b == main || $b == HEAD || $b == "$keep" ]] && continue
      running "$b" && continue
      git -C "$p" merge-base --is-ancestor "refs/remotes/origin/$b" "$main" && act git -C "$p" push -q origin --delete "$b"
    done
  done
  return 0
}

case ${1:-help} in
  init) shift; cmd_init "$@" ;;
  start) shift; cmd_start "$@" ;;
  continue) shift; cmd_continue "$@" ;;
  merge) shift; cmd_merge "$@" ;;
  queue) shift; cmd_queue "$@" ;;
  status) shift; cmd_status "$@" ;;
  needs) shift; cmd_parked "$@" ;;   # the status card's hint; U2's harness needs (every open item) replaces it
  parked) shift; cmd_parked "$@" ;;
  report) shift; cmd_report "$@" ;;
  trends) node "$HARNESS_HOME/lib/summary.mjs" trends "${HARNESS_LEDGER:-$HARNESS_HOME/ledger}/runs.jsonl" "${@:2}" ;;
  attach) tmux attach -t "=$(tmux_name "${2:?usage: harness attach <run-id>}")" ;;
  pause|resume|stop) cmd_control "$1" "${2:-}" "${@:3}" ;;
  answer) shift; cmd_answer "$@" ;;
  gc) shift; cmd_gc "$@" ;;
  memlint) p=$(toplevel "${2:?usage: harness memlint <project>}") && node "$HARNESS_HOME/lib/memlint.mjs" "$p" ;;
  debrief) shift; exec "$HARNESS_HOME/lib/debrief.sh" "$@" ;;
  sync) shift; exec "$HARNESS_HOME/lib/sync.sh" "$@" ;;
  backlog) shift; exec "$HARNESS_HOME/lib/backlog.sh" "$@" ;;
  desk) shift; exec "$HARNESS_HOME/lib/desk.sh" "$@" ;;
  eval) shift; exec "$HARNESS_HOME/lib/eval.sh" "$@" ;;
  *) sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;   # the header, whatever its length
esac
